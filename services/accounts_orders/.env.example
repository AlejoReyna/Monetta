# Copy to .env for local development. Never commit a real .env.

# Postgres connection string. Port 5434 (not catalog_monitor's 5433) so both
# services' docker-compose stacks can run side by side.
DATABASE_URL=postgres://accounts_orders:accounts_orders@localhost:5434/accounts_orders

# HTTP API port. 8082, not catalog_monitor's 8081.
PORT=8082

# The Shopify app's API secret key (Partner dashboard → this app → API
# credentials), used only to verify the X-Shopify-Hmac-Sha256 header on
# incoming webhooks. This is NOT the Customer Account API mobile client's
# clientId used by the Flutter app for login — that client is public and has
# no secret at all. See src/config.ts and lib/data/customer_auth/README.md.
SHOPIFY_APP_CLIENT_SECRET=

NODE_ENV=development
