# Copy to .env for local development. Never commit a real .env.

# Postgres connection string. Port 5434 (not catalog_monitor's 5433) so both
# services' docker-compose stacks can run side by side.
DATABASE_URL=postgres://accounts_orders:accounts_orders@localhost:5434/accounts_orders

# HTTP API port. 8082, not catalog_monitor's 8081.
PORT=8082

# Optional for now. When empty, Shopify webhook routes fail closed with 401,
# while first-party /accounts routes remain available.
# This is the CLI-managed app's *client secret* (shpss_…), entered only on the
# host — never in Flutter, never in git, never in chat.
# Source: Shopify Dev Dashboard → the Monetta staging/production app → API credentials.
SHOPIFY_APP_CLIENT_SECRET=

# Optional public client id of the same CLI app (not secret). Useful for
# multi-store / app-uninstall bookkeeping later; unused by the HMAC path today.
SHOPIFY_APP_CLIENT_ID=

# Public HTTPS origin of this service in the current environment. Must match
# the absolute webhook URIs in shopify/shopify.app.<env>.toml.
# Example staging: https://accounts-staging.example.com
PUBLIC_BASE_URL=

NODE_ENV=development

