# Copy to .env for local development. Never commit a real .env.

# Postgres connection string. Port 5434 (not catalog_monitor's 5433) so both
# services' docker-compose stacks can run side by side.
DATABASE_URL=postgres://accounts_orders:accounts_orders@localhost:5434/accounts_orders

# HTTP API port. 8082, not catalog_monitor's 8081.
PORT=8082

# Optional for now. When empty, Shopify webhook routes fail closed with 401,
# while first-party /accounts routes remain available.
SHOPIFY_APP_CLIENT_SECRET=

NODE_ENV=development
