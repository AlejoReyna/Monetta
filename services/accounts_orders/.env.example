# Copy to .env for local development. Never commit a real .env.

# Postgres connection string. Port 5434 (not catalog_monitor's 5433) so both
# services' docker-compose stacks can run side by side.
DATABASE_URL=postgres://accounts_orders:accounts_orders@localhost:5434/accounts_orders

# HTTP API port. 8082, not catalog_monitor's 8081.
PORT=8082

# Optional for now. When empty, Shopify webhook routes fail closed with 401,
# while first-party /accounts routes remain available.
# This is the CLI-managed app's *client secret* (shpss_…), entered only on the
# host — never in Flutter, never in git, never in chat.
# Source: Shopify Dev Dashboard → the Monetta staging/production app → API credentials.
SHOPIFY_APP_CLIENT_SECRET=

# Optional public client id of the same CLI app (not secret). Useful for
# multi-store / app-uninstall bookkeeping later; unused by the HMAC path today.
SHOPIFY_APP_CLIENT_ID=
SHOPIFY_ADMIN_API_VERSION=2026-07
# Discovered on the staging store and kept server-side. Required before the
# Shopify-backed admin product projection can be enabled.
SHOPIFY_HEADLESS_PUBLICATION_ID=
SHOPIFY_FEATURED_COLLECTION_ID=

# Global and Shopify-specific kill switches. Keep both false until staging
# scope approval and the mutation smoke suite are complete.
ADMIN_MUTATIONS_ENABLED=false
ADMIN_SHOPIFY_WRITES_ENABLED=false
ADMIN_EXTERNAL_WRITES_ENABLED=false

# Server-to-server adapter for catalog_monitor. Keep empty until the adapter
# is deployed with the same 32+ character secret on both services.
CATALOG_MONITOR_BASE_URL=
CATALOG_MONITOR_SERVICE_SECRET=

# Public storefront domain used to discover the Customer Account API. The
# backend verifies shopper bearer tokens against this API before serving
# orders or accepting push tokens.
SHOPIFY_STORE_DOMAIN=monetta-staging.myshopify.com

# Public HTTPS origin of this service in the current environment. Must match
# the absolute webhook URIs in shopify/shopify.app.<env>.toml.
# Example staging: https://accounts-staging.example.com
PUBLIC_BASE_URL=

# Engagement/push. Keep disabled until the Firebase project, APNs key and
# service account belong to the business and staging device tests pass.
NOTIFICATIONS_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Use literal \\n sequences when setting this as a one-line environment secret.
FIREBASE_PRIVATE_KEY=
# 32+ random characters in production. Encrypts provider registration ids.
PUSH_TOKEN_ENCRYPTION_SECRET=
# HMAC secret shared only with catalog_monitor's durable outbox worker.
INTERNAL_CATALOG_EVENT_SECRET=

# Server-side authorization. The Flutter allow-list is visibility only.
OWNER_ADMIN_EMAILS=
OWNER_SHOPIFY_CUSTOMER_IDS=

NODE_ENV=development
