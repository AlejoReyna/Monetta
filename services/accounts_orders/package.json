{
  "name": "@monetta/accounts-orders",
  "version": "0.1.0",
  "private": true,
  "description": "Receives Shopify webhooks (orders, mandatory compliance topics) and mirrors order/customer state for the app's account features. See docs/ACCOUNTS_AND_SYNC_PLAN.md Phase 2.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "start": "tsx --env-file-if-exists=.env src/api/server.ts",
    "worker": "tsx --env-file-if-exists=.env src/engagement/worker.ts",
    "worker:rewards": "tsx --env-file-if-exists=.env src/rewards/worker.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "express": "^4.21.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "overrides": {
    "qs": "6.16.0"
  }
}
