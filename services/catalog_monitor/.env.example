# Copy to .env for local development. Never commit a real .env.
# This service is a research-only internal prototype — see README.md.

# Postgres connection string. Port 5433 matches docker-compose.yml's
# host-mapped port. Using a native/Homebrew Postgres instead? That's normally
# on 5432 — see README.md § "Local demo without Docker".
DATABASE_URL=postgres://catalog_monitor:catalog_monitor@localhost:5433/catalog_monitor

# HTTP API port.
PORT=8081

# Cron expression for the daily monitor run. Default: once a day at 03:17
# local time (minute offset chosen to avoid every service on the box waking
# at the top of the hour).
CATALOG_CRON=17 3 * * *

# Master switch for any real network crawl. Defaults to false everywhere:
# tests, `npm install`, and a fresh checkout must never make a live request.
# Set to true only in an environment authorized to crawl the public
# coach.com / michaelkors.com catalogs.
LIVE_CRAWL_ENABLED=false

# Truthful, contactable user agent. Do not impersonate a browser — the goal
# is a good-faith research crawler that a site operator can identify and
# reach, not evasion of bot detection.
#
# The placeholder contact address below (crawler-contact@example.invalid) is
# intentionally not a real mailbox — it is rejected at startup whenever
# LIVE_CRAWL_ENABLED=true (see src/config.ts). Before enabling a real crawl,
# replace it with a real, monitored address.
USER_AGENT=MonettaCatalogMonitor/0.1 (+https://monetta.mx; internal research prototype; contact: crawler-contact@example.invalid)

# Minimum delay between two requests to the *same* domain, in milliseconds.
REQUEST_DELAY_MS=1000

# Whether the Playwright-rendered fallback may run when static HTML/JSON-LD
# parsing fails to extract the required fields. Off by default: it is slower,
# heavier, and only needed for pages that require client-side rendering.
PLAYWRIGHT_FALLBACK_ENABLED=false

# Required (in addition to NODE_ENV != production and a loopback DATABASE_URL
# host) to run `npm run seed-demo` — see src/cli/seedDemoData.ts. Leave unset
# outside local development; the seed script exits before touching the
# database if any of the three guards fail.
ALLOW_DEMO_SEED=false

# Standard Node environment marker. `seed-demo` refuses to run when this is
# "production", regardless of the other two guards.
NODE_ENV=development
