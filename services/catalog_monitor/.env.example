# Copy to .env for local development. Never commit a real .env.
# This service is a research-only internal prototype — see README.md.

# Postgres connection string. Port 5433 matches docker-compose.yml's
# host-mapped port. Using a native/Homebrew Postgres instead? That's normally
# on 5432 — see README.md § "Local demo without Docker".
DATABASE_URL=postgres://catalog_monitor:catalog_monitor@localhost:5433/catalog_monitor

# HTTP API port.
PORT=8081

# Cron expression for the daily monitor run. Default: once a day at 03:17
# local time (minute offset chosen to avoid every service on the box waking
# at the top of the hour).
CATALOG_CRON=17 3 * * *

# Comma-separated sources to crawl, report in health, and expose in the feed.
# Remove a source without a working US discovery path instead of letting it
# degrade the whole service. Available IDs are documented in README.md.
ENABLED_SOURCE_IDS=coach_us,michael_kors_us,guess_us,steve_madden_us,marc_jacobs_us,tory_burch_us,kate_spade_us,guess_factory_us,gp_mcallen_perfumes

# Master switch for any real network crawl. Defaults to false everywhere:
# tests, `npm install`, and a fresh checkout must never make a live request.
# Set to true only in an environment authorized to crawl the public
# coach.com / michaelkors.com catalogs.
LIVE_CRAWL_ENABLED=false

# Truthful, contactable user agent. Do not impersonate a browser — the goal
# is a good-faith research crawler that a site operator can identify and
# reach, not evasion of bot detection.
#
# The placeholder contact address below (crawler-contact@example.invalid) is
# intentionally not a real mailbox — it is rejected at startup whenever
# LIVE_CRAWL_ENABLED=true (see src/config.ts). Before enabling a real crawl,
# replace it with a real, monitored address.
USER_AGENT=MonettaCatalogMonitor/0.1 (+https://monetta.mx; internal research prototype; contact: crawler-contact@example.invalid)

# Minimum delay between two requests to the *same* domain, in milliseconds.
REQUEST_DELAY_MS=1000

# Whether the Playwright-rendered fallback may run when static HTML/JSON-LD
# parsing fails to extract the required fields. Off by default: it is slower,
# heavier, and only needed for pages that require client-side rendering.
PLAYWRIGHT_FALLBACK_ENABLED=false

# Optional durable notification hand-off. Point this at accounts_orders'
# signed internal ingress. Both services must use the same 32+ character
# secret. When URL is empty the outbox remains durable but no requests run.
NOTIFICATION_EVENTS_URL=http://localhost:8082/internal/catalog-events
NOTIFICATION_EVENTS_SECRET=replace-with-at-least-32-random-characters

# Optional signed service boundary for the accounts_orders admin BFF. Leave
# empty until both services are deployed with the same 32+ character secret.
CATALOG_MONITOR_SERVICE_SECRET=

# Storefront curation. These caps keep the external feed intentionally small;
# eligible in-stock candidates are ranked per source and then interleaved so
# one large brand cannot consume the entire feed.
FASHION_ITEMS_PER_SOURCE=8
PERFUME_ITEMS_PER_SOURCE=12
MAXIMUM_CATALOG_ITEMS=52

# Suggested retail pricing. No exchange rate is hardcoded: set a current USD
# to MXN rate in the deployment to enable MXN quotes. Without it, source USD
# prices and inventory still work, while `suggestedRetailPrice` is null.
USD_TO_MXN_RATE=

# Rates are integer basis points: 2200 = 22%, 1400 = 14%. The lower rate is
# used when converted source cost is strictly greater than MXN 4,000.
COMMISSION_DEFAULT_BPS=2200
COMMISSION_HIGH_VALUE_THRESHOLD_MXN=4000
COMMISSION_HIGH_VALUE_BPS=1400

# Optional variations. Product overrides use `<source>:<external id>` and win
# over the high-value/source/default rules. Keep these as valid JSON objects.
COMMISSION_SOURCE_RATES_JSON={}
COMMISSION_PRODUCT_RATES_JSON={}

# Required (in addition to NODE_ENV != production and a loopback DATABASE_URL
# host) to run `npm run seed-demo` — see src/cli/seedDemoData.ts. Leave unset
# outside local development; the seed script exits before touching the
# database if any of the three guards fail.
ALLOW_DEMO_SEED=false

# Standard Node environment marker. `seed-demo` refuses to run when this is
# "production", regardless of the other two guards.
NODE_ENV=development

# Dashboard console (WP-60, CATALOG_DASHBOARD.md §§ 3–4). Exact origins only —
# never `*`, never `*.vercel.app`. Empty until the Vercel project exists.
DASHBOARD_ORIGINS=http://localhost:5173
# Verifier printed by `npm run dashboard:passphrase`. The passphrase itself
# is never stored. Leave empty until the owner sets it on the server.
DASHBOARD_PASSPHRASE_VERIFIER=
# Browser session lifetime in hours.
DASHBOARD_SESSION_TTL_HOURS=12
