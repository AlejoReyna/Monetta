{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:monetta:editorial-content:1.0.0",
  "title": "Monetta shared editorial content 1.0.0",
  "description": "Normalized read model. Missing fields in content-baseline are intentional readiness gaps. No store entities are created by this schema.",
  "type": "object",
  "properties": {
    "contractVersion": {
      "const": "1.0.0"
    },
    "locale": {
      "const": "es-MX"
    },
    "campaigns": {
      "type": "object",
      "properties": {},
      "additionalProperties": {
        "$ref": "#/$defs/campaign"
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tile"
      },
      "minItems": 1
    },
    "brands": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tile"
      },
      "minItems": 1
    },
    "productSelections": {
      "type": "object",
      "properties": {},
      "additionalProperties": {
        "$ref": "#/$defs/selection"
      }
    },
    "wholesale": {
      "$ref": "#/$defs/wholesale"
    },
    "services": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/service"
      },
      "minItems": 1
    },
    "contact": {
      "$ref": "#/$defs/contact"
    },
    "socialLinks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/link"
      },
      "minItems": 1
    },
    "catalogs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/catalog"
      },
      "minItems": 1
    },
    "signup": {
      "$ref": "#/$defs/signup"
    },
    "footer": {
      "$ref": "#/$defs/footer"
    },
    "preferences": {
      "$ref": "#/$defs/preferences"
    },
    "rewards": {
      "$ref": "#/$defs/rewards"
    },
    "home": {
      "type": "object",
      "required": [
        "moduleOrder"
      ],
      "properties": {
        "moduleOrder": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "kind",
              "contentRef"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "campaign",
                  "categories",
                  "brands",
                  "product_selection",
                  "wholesale",
                  "services",
                  "signup",
                  "footer"
                ]
              },
              "contentRef": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false,
            "anyOf": [
              {
                "properties": {
                  "kind": {
                    "const": "campaign"
                  },
                  "contentRef": {
                    "pattern": "^campaigns\\.[^.]+$"
                  }
                }
              },
              {
                "properties": {
                  "kind": {
                    "const": "product_selection"
                  },
                  "contentRef": {
                    "pattern": "^productSelections\\.[^.]+$"
                  }
                }
              },
              {
                "properties": {
                  "kind": {
                    "const": "categories"
                  },
                  "contentRef": {
                    "pattern": "^categories$"
                  }
                }
              },
              {
                "properties": {
                  "kind": {
                    "const": "brands"
                  },
                  "contentRef": {
                    "pattern": "^brands$"
                  }
                }
              },
              {
                "properties": {
                  "kind": {
                    "const": "wholesale"
                  },
                  "contentRef": {
                    "pattern": "^wholesale$"
                  }
                }
              },
              {
                "properties": {
                  "kind": {
                    "const": "services"
                  },
                  "contentRef": {
                    "pattern": "^services$"
                  }
                }
              },
              {
                "properties": {
                  "kind": {
                    "const": "signup"
                  },
                  "contentRef": {
                    "pattern": "^signup$"
                  }
                }
              },
              {
                "properties": {
                  "kind": {
                    "const": "footer"
                  },
                  "contentRef": {
                    "pattern": "^footer$"
                  }
                }
              }
            ]
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "locale",
    "campaigns",
    "categories",
    "brands",
    "productSelections",
    "wholesale",
    "services",
    "contact",
    "socialLinks",
    "catalogs",
    "signup",
    "footer",
    "preferences",
    "rewards",
    "home"
  ],
  "$defs": {
    "destination": {
      "type": "object",
      "properties": {
        "routeId": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "routeId"
      ]
    },
    "focal": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ]
    },
    "imageSource": {
      "type": "object",
      "properties": {
        "assetId": {
          "type": "string",
          "minLength": 1
        },
        "focal": {
          "$ref": "#/$defs/focal"
        }
      },
      "additionalProperties": false,
      "required": [
        "assetId",
        "focal"
      ]
    },
    "media": {
      "type": "object",
      "properties": {
        "alt": {
          "type": "string"
        },
        "decorative": {
          "type": "boolean"
        },
        "sources": {
          "type": "object",
          "properties": {
            "compact": {
              "$ref": "#/$defs/imageSource"
            },
            "medium": {
              "$ref": "#/$defs/imageSource"
            },
            "expanded": {
              "$ref": "#/$defs/imageSource"
            }
          },
          "additionalProperties": false,
          "required": [
            "compact",
            "medium",
            "expanded"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "alt",
        "decorative",
        "sources"
      ]
    },
    "campaign": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "eyebrow": {
          "type": "string"
        },
        "headline": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "type": "string"
        },
        "ctaLabel": {
          "type": "string",
          "minLength": 1
        },
        "destination": {
          "$ref": "#/$defs/destination"
        },
        "media": {
          "$ref": "#/$defs/media"
        },
        "active": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "headline",
        "ctaLabel",
        "destination",
        "media"
      ]
    },
    "tile": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "brandKey": {
          "type": "string",
          "minLength": 1
        },
        "imageAssetId": {
          "type": "string",
          "minLength": 1
        },
        "alt": {
          "type": "string"
        },
        "destination": {
          "$ref": "#/$defs/destination"
        },
        "nativeDestination": {
          "$ref": "#/$defs/destination"
        },
        "coverCampaignId": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "imageAssetId",
        "alt",
        "destination"
      ]
    },
    "selectionSource": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "collection",
            "newest",
            "recommendations",
            "curated"
          ]
        },
        "routeId": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "ordering": {
          "enum": [
            "created_desc",
            "editorial",
            "provider_defined",
            "collection_default",
            "best_selling"
          ]
        },
        "handles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "provider",
        "ordering"
      ],
      "anyOf": [
        {
          "properties": {
            "kind": {
              "const": "collection"
            }
          },
          "required": [
            "routeId"
          ]
        },
        {
          "properties": {
            "kind": {
              "const": "curated"
            }
          },
          "oneOf": [
            {
              "required": [
                "routeId"
              ]
            },
            {
              "required": [
                "handles"
              ]
            }
          ]
        },
        {
          "properties": {
            "kind": {
              "enum": [
                "newest",
                "recommendations"
              ]
            }
          }
        }
      ]
    },
    "selection": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "$ref": "#/$defs/selectionSource"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "source"
      ]
    },
    "step": {
      "type": "object",
      "properties": {
        "number": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "number",
        "title",
        "body"
      ]
    },
    "term": {
      "type": "object",
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "value",
        "label"
      ]
    },
    "wholesale": {
      "type": "object",
      "properties": {
        "headline": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "type": "string",
          "minLength": 1
        },
        "campaignId": {
          "type": "string",
          "minLength": 1
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          },
          "minItems": 1
        },
        "terms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/term"
          },
          "minItems": 1
        },
        "pricingMode": {
          "enum": [
            "manual_quote",
            "verified_automatic"
          ]
        },
        "supportLinkId": {
          "type": "string",
          "minLength": 1
        },
        "catalogIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "rewardsPolicyRef": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "headline",
        "body",
        "campaignId",
        "steps",
        "terms",
        "pricingMode",
        "supportLinkId",
        "catalogIds",
        "rewardsPolicyRef"
      ]
    },
    "service": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "type": "string",
          "minLength": 1
        },
        "icon": {
          "type": "string",
          "minLength": 1
        },
        "supportLinkId": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "body",
        "icon"
      ]
    },
    "link": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "whatsapp",
            "social",
            "group",
            "web_contact",
            "email",
            "voice"
          ]
        },
        "editorRole": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "url",
        "kind"
      ]
    },
    "contact": {
      "type": "object",
      "properties": {
        "headline": {
          "type": "string",
          "minLength": 1
        },
        "campaignId": {
          "type": "string",
          "minLength": 1
        },
        "channels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/link"
          },
          "minItems": 1
        },
        "groupLinkIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "hours": {
          "type": "string",
          "minLength": 1
        },
        "email": {
          "type": "string",
          "minLength": 1
        },
        "voice": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "headline",
        "campaignId",
        "channels",
        "groupLinkIds"
      ]
    },
    "catalog": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "categoryLabel": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "wholesale",
            "suggested_prices",
            "no_prices"
          ]
        },
        "destination": {
          "$ref": "#/$defs/destination"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "sortOrder": {
          "type": "integer"
        },
        "updatedLabel": {
          "type": "string",
          "minLength": 1
        },
        "active": {
          "type": "boolean"
        },
        "shareable": {
          "type": "boolean"
        },
        "imageAssetId": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "categoryLabel",
        "mode",
        "destination",
        "description",
        "sortOrder",
        "active",
        "shareable"
      ]
    },
    "signup": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "headline": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "type": "string",
          "minLength": 1
        },
        "ctaLabel": {
          "type": "string",
          "minLength": 1
        },
        "submissionAdapter": {
          "type": "string",
          "minLength": 1
        },
        "consentText": {
          "type": "string",
          "minLength": 1
        },
        "privacyRouteId": {
          "type": "string",
          "minLength": 1
        },
        "offerClaim": {
          "type": "string",
          "minLength": 1
        },
        "offerPolicyRef": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "enabled",
        "headline",
        "body",
        "ctaLabel",
        "submissionAdapter",
        "consentText",
        "privacyRouteId"
      ]
    },
    "footerColumn": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "heading": {
          "type": "string",
          "minLength": 1
        },
        "menuHandle": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "heading",
        "menuHandle"
      ]
    },
    "footer": {
      "type": "object",
      "properties": {
        "brandDescription": {
          "type": "string",
          "minLength": 1
        },
        "columns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/footerColumn"
          },
          "minItems": 1
        },
        "policyRouteIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "socialLinkIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "supportLinkId": {
          "type": "string",
          "minLength": 1
        },
        "copyrightYear": {
          "const": "runtime_year"
        }
      },
      "additionalProperties": false,
      "required": [
        "brandDescription",
        "columns",
        "policyRouteIds",
        "socialLinkIds",
        "supportLinkId",
        "copyrightYear"
      ]
    },
    "preferences": {
      "type": "object",
      "properties": {
        "purchaseTypeOptions": {
          "type": "array",
          "items": {
            "enum": [
              "retail",
              "wholesale"
            ]
          },
          "minItems": 2
        },
        "skipAllowed": {
          "type": "boolean"
        },
        "brandOptionIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "categoryOptionIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "brandOptionIds",
        "categoryOptionIds",
        "purchaseTypeOptions",
        "skipAllowed"
      ]
    },
    "rewards": {
      "type": "object",
      "properties": {
        "model": {
          "const": "mxn_balance_v1"
        },
        "currency": {
          "const": "MXN"
        },
        "authority": {
          "const": "accounts_orders"
        },
        "policyRef": {
          "const": "docs/redesign/REWARDS_CONTRACT_V1.md"
        },
        "capabilitySource": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "model",
        "currency",
        "authority",
        "policyRef",
        "capabilitySource"
      ]
    },
    "asset": {
      "type": "object",
      "required": [
        "id",
        "path",
        "sha256",
        "width",
        "height",
        "approval",
        "availableAtCapture"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "approval": {
          "enum": [
            "legacy_fallback",
            "approved_for_migration"
          ]
        },
        "availableAtCapture": {
          "type": "boolean"
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "themeAssetName": {
          "type": "string",
          "minLength": 1
        },
        "shopifyImageGid": {
          "type": "string",
          "pattern": "^gid://shopify/MediaImage/"
        }
      },
      "additionalProperties": false
    }
  },
  "$comment": "Validation revision 1.0.1: explicit selection-source alternatives and module family references. Payload contractVersion remains 1.0.0; no commerce data or frozen baseline changed."
}
