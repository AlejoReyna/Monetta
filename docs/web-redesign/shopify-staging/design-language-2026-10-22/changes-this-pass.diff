+}
+
+.article-card__media img {
+  width: 100%;
+  height: 100%;
+  object-fit: cover;
+}
+
+.article-card__body {
+  display: grid;
+  gap: var(--space-1);
+}
+
+.article-card__date,
+.article__meta,
+.comment__meta {
+  font-size: 13px;
+  color: var(--color-ink-muted);
+}
+
+.article-card__title {
+  font-family: var(--font-serif);
+  font-size: var(--type-section-title-size);
+  line-height: var(--type-section-title-lh);
+  letter-spacing: var(--type-section-title-track);
+}
+
+.article-card__excerpt {
+  font-size: 15px;
+  line-height: 1.5;
+  color: var(--color-ink-muted);
+}
+
+@media (hover: hover) {
