+  font-size: 16px;
+}
+
+.discount-form input:focus-visible {
+  outline: 2px solid var(--color-ink);
+  outline-offset: 0;
+  border-color: var(--color-ink);
+}
+
+.discount-form .btn {
+  width: 100%;
+}
+
+.discount-form .btn--text {
+  justify-self: start;
+  width: auto;
+  padding-inline: 0;
+}
+
+.discount-help {
+  margin: 0;
+  font-size: 13px;
+  line-height: 1.45;
+  color: var(--color-ink-muted);
+}
+
+.discount-message {
+  margin: 0;
+  font-size: 13px;
+  line-height: 1.5;
+}
+
+.discount-message:empty {
+  display: none;
+}
+
+.applied-codes {
+  display: flex;
+  flex-wrap: wrap;
+  gap: var(--space-2);
+  margin: 0;
+  padding: 0;
+  list-style: none;
+}
+
+.applied-codes .badge {
+  min-height: 28px;
+  background: var(--color-surface-warm);
+  color: var(--color-ink);
+  letter-spacing: 0.08em;
+}
+
+/* ============================================================ Saved products (browser-local) */
+.saved-grid {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: var(--grid-gap-y) var(--grid-gap-x);
+}
+
+.saved-note {
+  margin: 0 0 var(--space-4);
+  font-size: 13px;
+  line-height: 1.45;
+  color: var(--color-ink-muted);
+}
+
+.saved-empty {
+  display: grid;
+  justify-items: start;
+  gap: var(--space-3);
+  padding: var(--space-5) 0;
+}
+
+.saved-empty[hidden] {
+  display: none;
+}
+
+@media (max-width: 767.98px) {
+  .header-utility--saved {
+    display: none;
+  }
+}
+
+/* ============================================================ Secondary pages (page, 404, collections, blog, article, policies) */
+/* The same shell and roles as the shopping pages: screen title, readable measure for running text, warm cards, pill actions. */
