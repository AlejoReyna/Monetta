+}
+
+/* Pagination for the collections index and the blog. */
+.pagination {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  justify-content: center;
+  gap: var(--space-3);
+  margin-top: var(--space-6);
+}
+
+.pagination__status {
+  font-size: 14px;
+  color: var(--color-ink-muted);
+}
+
+/* Policies (Shopify renders their markup; layout/theme.liquid frames it): the title takes the screen-title role, the text the
