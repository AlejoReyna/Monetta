@@ -0,0 +1,145 @@
+{%- doc -%}
+  Bridge from Atelier's design variables to the Monetta tokens, for the pages that still render Atelier sections inside the Monetta
+  shell (layout/theme.liquid: contact, mayoreo, cómo vender, policies) and for the storefront password page (layout/password.liquid).
+  The merchant's content, blocks and layout settings are untouched; only what the store looks like changes: Inter and Playfair
+  instead of Atelier's fonts, the warm palette instead of Atelier's black-and-white colour schemes, pill buttons and 12px fields.
+  The theme settings (config/settings_data.json) are not edited, so the editor still shows Atelier's own values for these
+  sections. Replaces snippets/monetta-secondary-headings.liquid (22 Oct), which only swapped the heading face.
+
+  Colours are written as values because Atelier also reads each one as an "r g b" triplet for its opacities.
+{%- enddoc -%}
+<style>
+  /* Type: body copy is Inter at the body role's size; every heading preset is Playfair Display 400 (the merchant's sizes stay). */
+  body.mw-atelier {
+    --font-body--family: var(--font-sans);
+    --font-body--style: normal;
+    --font-body--weight: 400;
+    --font-subheading--family: var(--font-sans);
+    --font-subheading--style: normal;
+    --font-subheading--weight: 500;
+    --font-heading--family: var(--font-serif);
+    --font-heading--style: normal;
+    --font-heading--weight: 400;
+    --font-accent--family: var(--font-sans);
+    --font-accent--style: normal;
+    --font-accent--weight: 600;
+    --font-paragraph--family: var(--font-sans);
+    --font-paragraph--style: normal;
+    --font-paragraph--size: var(--type-body-size);
+    --font-paragraph--line-height: var(--type-body-lh);
+    {%- for level in (1..6) %}
+    --font-h{{ level }}--family: var(--font-serif);
+    --font-h{{ level }}--style: normal;
+    --font-h{{ level }}--weight: 400;
+    {%- endfor %}
