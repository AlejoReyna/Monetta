diff --git a/lib/features/catalog/catalog_query.dart b/lib/features/catalog/catalog_query.dart
index 599855f..3e3c6d3 100644
--- a/lib/features/catalog/catalog_query.dart
+++ b/lib/features/catalog/catalog_query.dart
@@ -87,3 +87,60 @@ bool productMatchesAnyTerm(
     (query) => terms.any((term) => term.contains(query)),
   );
 }
+
+/// Shared applied/draft criteria. Commercial newness is disabled unless the
+/// caller supplies an approved predicate; Shopify creation time is not approval.
+enum CatalogOrder { newest, oldest, priceAsc, priceDesc }
+
+List<Product> selectCatalogProducts(
+  CatalogStore store,
+  Iterable<Product> scope, {
+  String query = '',
+  String? color,
+  bool offersOnly = false,
+  bool availableOnly = false,
+  bool newOnly = false,
+  bool Function(Product)? approvedNewArrival,
+  CatalogOrder order = CatalogOrder.newest,
+}) {
+  final seen = <String>{};
+  final normalized = normalizeSearchText(query);
+  final result = scope.where((product) {
+    if (!seen.add(product.id)) return false;
+    if (!productMatchesNormalizedQuery(store, product, normalized))
+      return false;
+    if (newOnly && !(approvedNewArrival?.call(product) ?? false)) return false;
+    // Color, availability and offer must describe the same sellable variant.
+    return product.variants.any((variant) {
+      if (availableOnly && !variant.available) return false;
+      if (offersOnly &&
+          !(variant.compareAtPrice != null &&
+              variant.compareAtPrice! > variant.price)) return false;
+      if (color != null) {
+        if (variant.isDefault) {
+          if (!(store
+                  .facetsFor(product.id)
+                  ?.colors
+                  .any((c) => c.value == color) ??
+              false)) return false;
+        } else {
+          final terms = store.rules.colors[color] ?? const <String>[];
+          final title = normalizeSearchText(variant.title);
+          if (!terms.any((term) => title.contains(normalizeSearchText(term))))
+            return false;
+        }
+      }
+      return true;
+    });
+  }).toList();
+  result.sort((a, b) {
+    final comparison = switch (order) {
+      CatalogOrder.newest => b.createdAt.compareTo(a.createdAt),
+      CatalogOrder.oldest => a.createdAt.compareTo(b.createdAt),
+      CatalogOrder.priceAsc => a.price.compareTo(b.price),
+      CatalogOrder.priceDesc => b.price.compareTo(a.price),
+    };
+    return comparison == 0 ? a.id.compareTo(b.id) : comparison;
+  });
+  return result;
+}
