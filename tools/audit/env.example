# Copy to tools/audit/.env (gitignored) or export in your shell.
# Never commit real shop IDs that point at production, Admin tokens, or passwords.

# Exact development shop identity — numeric Shopify shop ID and/or permanent domain.
# Hostname substring "staging" is NOT sufficient verification by itself.
EXPECTED_SHOP_ID=1234567890
# Or: EXPECTED_SHOP_ID=your-dev-shop.myshopify.com

# Comma-separated explicit allowlist. EXPECTED_SHOP_ID must appear exactly.
AUDIT_SHOP_ALLOWLIST=1234567890,your-dev-shop.myshopify.com

# Remote seed/cleanup writes stay off unless BOTH flags are set for a live run.
AUDIT_ALLOW_REMOTE_WRITES=0
AUDIT_DRY_RUN=1

# Logical environment label recorded in the manifest.
AUDIT_ENVIRONMENT=local

# Disposable local PostgreSQL (see docker-compose.audit-pg.yml).
# Default compose maps host 5435 → container 5432 so it does not collide with
# services/accounts_orders compose on 5434.
AUDIT_DATABASE_URL=postgres://monetta_audit:monetta_audit@127.0.0.1:5435/monetta_audit

# Optional path for synthetic persona passwords (MUST stay gitignored).
# AUDIT_SECRETS_FILE=.audit-runs/<run-id>/secrets.json
