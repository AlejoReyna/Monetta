{% doc %}
  @prompt
    Create a Shopify OS 2.0 liquid block called "Collection carousel with static cards". The block displays a horizontal scrollable carousel of 5 cards with a consistent visual design across all cards.
    
    Cards 1–3: Collection cards (dynamic) Each card pulls data from a Shopify collection (collection picker field). It displays:
    
    The collection's featured image (full width, rounded corners 50px)
    The collection title as heading
    The collection description (optional, toggleable)
    A button that links to the collection URL
    Cards 4–5: Static image cards (custom) Each card has its own independent fields:
    
    An image picker (custom uploaded image)
    A text field for a custom heading
    A URL field + button label text field — the button links to that custom URL
    Shared card design settings (apply to ALL 5 cards equally):
    
    Card background color: #ffffff
    Card border radius: 50px
    Image border radius: 50px
    Box shadow opacity: 0.2
    Card width on desktop: 90%
    Gap between cards: 10px
    Title settings:
    
    Font picker (default: Aleo)
    Font size: 26px
    Color: #000000
    Description settings (collection cards only):
    
    Show/hide toggle checkbox
    Font picker (default: System UI)
    Font size: 15px
    Color: #666666
    Button settings (shared across all cards):
    
    Font picker (default: Andada Pro)
    Font size: 14px
    Background color: #dedede
    Text color: #000000
    Hover background: #dedede
    Hover text color: #aa7d44
    Border radius: 50px
    The carousel should be horizontally scrollable with smooth scroll snap. Hide the scrollbar. The block must be fully responsive and work in Shopify OS 2.0 theme architecture.
    
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-carousel-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    overflow: hidden;
  }

  .ai-collection-carousel__wrapper-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.card_gap }}px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 20px 0;
  }

  .ai-collection-carousel__wrapper-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-collection-carousel__card-{{ ai_gen_id }} {
    flex: 0 0 {{ block.settings.card_width_desktop }}%;
    scroll-snap-align: start;
    background-color: {{ block.settings.card_bg_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    box-shadow: 0 4px 12px rgba(0, 0, 0, {{ block.settings.shadow_opacity }});
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .ai-collection-carousel__image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-collection-carousel__image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-collection-carousel__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-collection-carousel__image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-collection-carousel__content-{{ ai_gen_id }} {
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex-grow: 1;
  }

  .ai-collection-carousel__title-{{ ai_gen_id }} {
    font-family: {{ block.settings.title_font.family }}, {{ block.settings.title_font.fallback_families }};
    font-weight: {{ block.settings.title_font.weight }};
    font-style: {{ block.settings.title_font.style }};
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0;
    line-height: 1.3;
  }

  .ai-collection-carousel__description-{{ ai_gen_id }} {
    font-family: {{ block.settings.description_font.family }}, {{ block.settings.description_font.fallback_families }};
    font-weight: {{ block.settings.description_font.weight }};
    font-style: {{ block.settings.description_font.style }};
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    margin: 0;
    line-height: 1.5;
  }

  .ai-collection-carousel__button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 12px 24px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    font-family: {{ block.settings.button_font.family }}, {{ block.settings.button_font.fallback_families }};
    font-weight: {{ block.settings.button_font.weight }};
    font-style: {{ block.settings.button_font.style }};
    font-size: {{ block.settings.button_size }}px;
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    text-align: center;
    transition: background-color 0.3s ease, color 0.3s ease;
    margin-top: auto;
  }

  .ai-collection-carousel__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    color: {{ block.settings.button_hover_text_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-collection-carousel__card-{{ ai_gen_id }} {
      flex: 0 0 85%;
    }
  }
{% endstyle %}

<collection-carousel-{{ ai_gen_id }} class="ai-collection-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-collection-carousel__wrapper-{{ ai_gen_id }}">
    {% for i in (1..3) %}
      {% liquid
        assign collection_key = 'collection_' | append: i
        assign collection = block.settings[collection_key]
      %}
      
      <div class="ai-collection-carousel__card-{{ ai_gen_id }}">
        <div class="ai-collection-carousel__image-wrapper-{{ ai_gen_id }}">
          {% if collection != blank and collection.image %}
            <img
              src="{{ collection.image | image_url: width: 800 }}"
              alt="{{ collection.image.alt | escape }}"
              loading="lazy"
              width="{{ collection.image.width }}"
              height="{{ collection.image.height }}"
              class="ai-collection-carousel__image-{{ ai_gen_id }}"
            >
          {% else %}
            <div class="ai-collection-carousel__image-placeholder-{{ ai_gen_id }}">
              {{ 'collection-1' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
        
        <div class="ai-collection-carousel__content-{{ ai_gen_id }}">
          {% if collection != blank %}
            <h3 class="ai-collection-carousel__title-{{ ai_gen_id }}">{{ collection.title }}</h3>
            
            {% if block.settings.show_description and collection.description != blank %}
              <div class="ai-collection-carousel__description-{{ ai_gen_id }}">
                {{ collection.description | strip_html | truncate: 120 }}
              </div>
            {% endif %}
            
            <a href="{{ collection.url }}" class="ai-collection-carousel__button-{{ ai_gen_id }}">
              {{ block.settings.button_label }}
            </a>
          {% else %}
            <h3 class="ai-collection-carousel__title-{{ ai_gen_id }}">Collection {{ i }}</h3>
            <div class="ai-collection-carousel__description-{{ ai_gen_id }}">
              Select a collection to display
            </div>
            <a href="#" class="ai-collection-carousel__button-{{ ai_gen_id }}">
              {{ block.settings.button_label }}
            </a>
          {% endif %}
        </div>
      </div>
    {% endfor %}

    {% for i in (4..5) %}
      {% liquid
        assign image_key = 'static_image_' | append: i
        assign heading_key = 'static_heading_' | append: i
        assign url_key = 'static_url_' | append: i
        assign button_label_key = 'static_button_label_' | append: i
        
        assign static_image = block.settings[image_key]
        assign static_heading = block.settings[heading_key]
        assign static_url = block.settings[url_key]
        assign static_button_label = block.settings[button_label_key]
      %}
      
      <div class="ai-collection-carousel__card-{{ ai_gen_id }}">
        <div class="ai-collection-carousel__image-wrapper-{{ ai_gen_id }}">
          {% if static_image %}
            <img
              src="{{ static_image | image_url: width: 800 }}"
              alt="{{ static_image.alt | escape }}"
              loading="lazy"
              width="{{ static_image.width }}"
              height="{{ static_image.height }}"
              class="ai-collection-carousel__image-{{ ai_gen_id }}"
            >
          {% else %}
            <div class="ai-collection-carousel__image-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
        
        <div class="ai-collection-carousel__content-{{ ai_gen_id }}">
          {% if static_heading != blank %}
            <h3 class="ai-collection-carousel__title-{{ ai_gen_id }}">{{ static_heading }}</h3>
          {% else %}
            <h3 class="ai-collection-carousel__title-{{ ai_gen_id }}">Custom Card {{ i }}</h3>
          {% endif %}
          
          {% if static_url != blank %}
            <a href="{{ static_url }}" class="ai-collection-carousel__button-{{ ai_gen_id }}">
              {% if static_button_label != blank %}
                {{ static_button_label }}
              {% else %}
                {{ block.settings.button_label }}
              {% endif %}
            </a>
          {% else %}
            <a href="#" class="ai-collection-carousel__button-{{ ai_gen_id }}">
              {% if static_button_label != blank %}
                {{ static_button_label }}
              {% else %}
                {{ block.settings.button_label }}
              {% endif %}
            </a>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
</collection-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class CollectionCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.wrapper = this.querySelector('.ai-collection-carousel__wrapper-{{ ai_gen_id }}');
        this.setupScrollSnap();
      }

      setupScrollSnap() {
        if (!this.wrapper) return;
        
        this.wrapper.addEventListener('scroll', () => {
          const scrollLeft = this.wrapper.scrollLeft;
          const scrollWidth = this.wrapper.scrollWidth;
          const clientWidth = this.wrapper.clientWidth;
        });
      }
    }

    customElements.define('collection-carousel-{{ ai_gen_id }}', CollectionCarousel{{ ai_gen_id }});
  })();
</script>

