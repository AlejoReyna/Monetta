{% doc %}
  @prompt
    Task: Create a Premium Custom 3-Row Collection Gallery (Safe Flexbox Layout).
    
    1. Foundation & Absolute Containment:
    
    Build a raw Custom HTML/CSS section (do not modify standard templates).
    
    Main Wrapper: Apply max-width: 100vw and strict overflow: hidden to prevent any horizontal page stretching. Add exactly 60px of padding at the top and bottom of this wrapper.
    
    Background: Pure White (#FFFFFF).
    
    2. The 3x3 Flexbox Matrix (Horizontal Scroll):
    
    Inside the wrapper, create a scrolling track with overflow-x: auto and scroll-snap-type: x mandatory.
    
    Layout Logic: Use display: flex, flex-direction: column, and flex-wrap: wrap. Set a specific fixed height on this track (e.g., 120vw or similar) to strictly force the items to wrap into exactly 3 horizontal rows.
    
    Generate exactly 9 Collection Link tags (<a>) inside this track.
    
    3. Uniform Sizing & Image-Only UI:
    
    Mobile Viewport: Set each card to width: 40vw. This ensures 2 full columns are visible, leaving a perfect 10% peek of the 3rd column to invite swiping.
    
    Uniformity: Force a strict aspect-ratio: 4 / 5 on all 9 cards so they are mathematically identical in size.
    
    Content: Show ONLY the collection image (object-fit: cover, width: 100%, height: 100%). Absolutely NO text, titles, or buttons inside or outside the cards.
    
    Aesthetics: 24px border-radius, and a very thin, elegant drop shadow strictly at the bottom of each card. Maintain a 15px gap between all cards.
    
    4. High-End Motion:
    
    Pop-Up Animation: Add a smooth CSS hover/active transition (0.5s ease). Cards should subtly scale up (1.0) when interacted with, while surrounding cards scale down slightly (0.9).
    
    Hide all scrollbars (::-webkit-scrollbar { display: none; }) for a native app feel.
    
    Strictly disable any vertical stacking on mobile; the 3-row horizontal swipe must be maintained on all devices.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-gallery-{{ ai_gen_id }} {
    display: block;
    max-width: 100vw;
    overflow: hidden;
    background-color: #FFFFFF;
    padding: 60px 0;
    width: 100%;
  }

  .ai-collection-gallery-track-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    flex-wrap: wrap;
    height: 120vw;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    gap: 15px;
    padding: 0 15px;
    -webkit-overflow-scrolling: touch;
  }

  .ai-collection-gallery-track-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-collection-gallery-track-{{ ai_gen_id }} {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  .ai-collection-gallery-card-{{ ai_gen_id }} {
    width: 40vw;
    aspect-ratio: 4 / 5;
    flex-shrink: 0;
    scroll-snap-align: start;
    border-radius: 24px;
    overflow: hidden;
    position: relative;
    transition: transform 0.5s ease;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
  }

  .ai-collection-gallery-card-{{ ai_gen_id }}:active {
    transform: scale(1.0);
  }

  .ai-collection-gallery-card-{{ ai_gen_id }}:not(:active) {
    transform: scale(0.9);
  }

  .ai-collection-gallery-track-{{ ai_gen_id }}:hover .ai-collection-gallery-card-{{ ai_gen_id }}:not(:hover) {
    transform: scale(0.9);
  }

  .ai-collection-gallery-track-{{ ai_gen_id }}:hover .ai-collection-gallery-card-{{ ai_gen_id }}:hover {
    transform: scale(1.0);
  }

  .ai-collection-gallery-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-collection-gallery-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-collection-gallery-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  @media screen and (min-width: 750px) {
    .ai-collection-gallery-card-{{ ai_gen_id }} {
      width: {{ block.settings.desktop_card_width }}vw;
    }
  }
{% endstyle %}

<collection-gallery-{{ ai_gen_id }}
  class="ai-collection-gallery-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-collection-gallery-track-{{ ai_gen_id }}">
    {% for i in (1..9) %}
      {% liquid
        assign collection_key = 'collection_' | append: i
        assign collection = block.settings[collection_key]
      %}
      
      <a
        href="{% if collection != blank %}{{ collection.url }}{% else %}#{% endif %}"
        class="ai-collection-gallery-card-{{ ai_gen_id }}"
      >
        {% if collection != blank and collection.featured_image %}
          <img
            src="{{ collection.featured_image | image_url: width: 800 }}"
            alt="{{ collection.featured_image.alt | escape }}"
            loading="lazy"
            width="800"
            height="1000"
            class="ai-collection-gallery-image-{{ ai_gen_id }}"
          >
        {% else %}
          <div class="ai-collection-gallery-placeholder-{{ ai_gen_id }}">
            {{ 'collection-apparel-1' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </a>
    {% endfor %}
  </div>
</collection-gallery-{{ ai_gen_id }}>

<script>
  (function() {
    class CollectionGallery{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.track = this.querySelector('.ai-collection-gallery-track-{{ ai_gen_id }}');
        this.cards = this.querySelectorAll('.ai-collection-gallery-card-{{ ai_gen_id }}');
        
        this.setupTouchInteraction();
      }

      setupTouchInteraction() {
        if (!this.track) return;

        this.track.addEventListener('touchstart', () => {
          this.cards.forEach(card => {
            card.style.transform = 'scale(0.9)';
          });
        });

        this.cards.forEach(card => {
          card.addEventListener('touchstart', (e) => {
            e.currentTarget.style.transform = 'scale(1.0)';
          });

          card.addEventListener('touchend', (e) => {
            setTimeout(() => {
              e.currentTarget.style.transform = 'scale(0.9)';
            }, 300);
          });
        });
      }
    }

    customElements.define('collection-gallery-{{ ai_gen_id }}', CollectionGallery{{ ai_gen_id }});
  })();
</script>

