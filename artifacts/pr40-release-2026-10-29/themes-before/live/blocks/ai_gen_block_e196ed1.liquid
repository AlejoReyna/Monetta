<script>
  (function() {
    class ExpandableDrawer{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.button = this.querySelector('.ai-expandable-drawer__button-{{ ai_gen_id }}');
        this.content = this.querySelector('.ai-expandable-drawer__content-{{ ai_gen_id }}');
        this.chevron = this.querySelector('.ai-expandable-drawer__chevron-{{ ai_gen_id }}');
        
        this.button.addEventListener('click', () => this.toggle());
      }

      toggle() {
        const isExpanded = this.content.classList.contains('expanded');
        
        if (isExpanded) {
          this.content.classList.remove('expanded');
          this.chevron.classList.remove('expanded');
          this.button.setAttribute('aria-expanded', 'false');
        } else {
          this.content.classList.add('expanded');
          this.chevron.classList.add('expanded');
          this.button.setAttribute('aria-expanded', 'true');
        }
      }
    }

    customElements.define('expandable-drawer-{{ ai_gen_id }}', ExpandableDrawer{{ ai_gen_id }});
  })();
</script>

