{% doc %}
  @prompt
    Task: Create a Premium 2-Card Social Carousel Section.
    
    1. Structural Layout (Carousel):
    
    Create a section featuring a responsive container with exactly 2 vertical cards.
    
    Desktop: Center the 2 cards horizontally with generous spacing between them.
    
    Mobile Behavior: Strictly implement a horizontal scroll (swipeable carousel/slider) for the cards. Do NOT stack them vertically on mobile. Use scroll-snap-type: x mandatory for a premium swiping experience.
    
    2. High-End Card Aesthetics:
    
    Background: Pure white cards against a very subtle off-white section background.
    
    Shape: Heavy border-radius (e.g., 24px) with a soft, elegant floating drop shadow (box-shadow: 0 15px 40px rgba(0,0,0,0.04)).
    
    
    3. Card 1 Content (WhatsApp):
    
    Top: A minimalist, thin-line monochromatic WhatsApp icon centered.
    
    Middle: A brief, centered description text matching the style of Card 1.
    
    Bottom: EXACTLY TWO (2) full-width action buttons stacked vertically (e.g., a primary solid button and a secondary outline or text-only button below it).
    
    4. Card 2 Content (Facebook):
    
    Top: A minimalist, thin-line monochromatic Facebook icon centered.
    
    Middle: A brief, centered description text using a clean Sans-serif font with elegant line-height.
    
    Bottom: EXACTLY ONE (1) large, full-width action button.
    5. Polish:
    
    Ensure both cards have the exact same height (height: 100% within a stretch flexbox/grid) regardless of the different number of buttons at the bottom.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-social-carousel-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.section_background }};
    padding: {{ block.settings.section_padding_top }}px 20px {{ block.settings.section_padding_bottom }}px;
  }

  .ai-social-carousel__container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    gap: {{ block.settings.card_gap }}px;
    justify-content: center;
    align-items: stretch;
  }

  .ai-social-carousel__card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.04);
    padding: {{ block.settings.card_padding }}px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    flex: 1;
    max-width: 500px;
    min-height: 450px;
  }

  .ai-social-carousel__icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    margin-bottom: {{ block.settings.icon_margin_bottom }}px;
    flex-shrink: 0;
  }

  .ai-social-carousel__icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    stroke: {{ block.settings.icon_color }};
    fill: none;
    stroke-width: 1.5;
  }

  .ai-social-carousel__content-{{ ai_gen_id }} {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
  }

  .ai-social-carousel__description-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.6;
    text-align: center;
    margin-bottom: 32px;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  }

  .ai-social-carousel__buttons-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
  }

  .ai-social-carousel__button-{{ ai_gen_id }} {
    width: 100%;
    padding: {{ block.settings.button_padding }}px;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_text_size }}px;
    font-weight: 500;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.3s ease;
    border: none;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    display: inline-block;
  }

  .ai-social-carousel__button--primary-{{ ai_gen_id }} {
    background-color: {{ block.settings.primary_button_bg }};
    color: {{ block.settings.primary_button_text }};
  }

  .ai-social-carousel__button--primary-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.primary_button_hover_bg }};
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
  }

  .ai-social-carousel__button--secondary-{{ ai_gen_id }} {
    background-color: transparent;
    color: {{ block.settings.secondary_button_text }};
    border: 1.5px solid {{ block.settings.secondary_button_border }};
  }

  .ai-social-carousel__button--secondary-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.secondary_button_hover_bg }};
    border-color: {{ block.settings.secondary_button_hover_border }};
    transform: translateY(-2px);
  }

  @media screen and (max-width: 749px) {
    .ai-social-carousel__container-{{ ai_gen_id }} {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      gap: 20px;
      padding: 0 20px;
      justify-content: flex-start;
    }

    .ai-social-carousel__container-{{ ai_gen_id }}::-webkit-scrollbar {
      display: none;
    }

    .ai-social-carousel__card-{{ ai_gen_id }} {
      flex: 0 0 85%;
      scroll-snap-align: center;
      max-width: none;
    }
  }
{% endstyle %}

<premium-social-carousel-{{ ai_gen_id }}
  class="ai-social-carousel-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-social-carousel__container-{{ ai_gen_id }}">
    <div class="ai-social-carousel__card-{{ ai_gen_id }}">
      <div class="ai-social-carousel__content-{{ ai_gen_id }}">
        <div class="ai-social-carousel__icon-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
          </svg>
        </div>
        <div class="ai-social-carousel__description-{{ ai_gen_id }}">
          {{ block.settings.whatsapp_description }}
        </div>
      </div>
      <div class="ai-social-carousel__buttons-{{ ai_gen_id }}">
        <a
          href="{{ block.settings.whatsapp_primary_link }}"
          class="ai-social-carousel__button-{{ ai_gen_id }} ai-social-carousel__button--primary-{{ ai_gen_id }}"
        >
          {{ block.settings.whatsapp_primary_text }}
        </a>
        <a
          href="{{ block.settings.whatsapp_secondary_link }}"
          class="ai-social-carousel__button-{{ ai_gen_id }} ai-social-carousel__button--secondary-{{ ai_gen_id }}"
        >
          {{ block.settings.whatsapp_secondary_text }}
        </a>
      </div>
    </div>

    <div class="ai-social-carousel__card-{{ ai_gen_id }}">
      <div class="ai-social-carousel__content-{{ ai_gen_id }}">
        <div class="ai-social-carousel__icon-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
          </svg>
        </div>
        <div class="ai-social-carousel__description-{{ ai_gen_id }}">
          {{ block.settings.facebook_description }}
        </div>
      </div>
      <div class="ai-social-carousel__buttons-{{ ai_gen_id }}">
        <a
          href="{{ block.settings.facebook_button_link }}"
          class="ai-social-carousel__button-{{ ai_gen_id }} ai-social-carousel__button--primary-{{ ai_gen_id }}"
        >
          {{ block.settings.facebook_button_text }}
        </a>
      </div>
    </div>
  </div>
</premium-social-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class PremiumSocialCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.container = this.querySelector('.ai-social-carousel__container-{{ ai_gen_id }}');
        this.setupMobileScroll();
      }

      setupMobileScroll() {
        if (window.innerWidth <= 749 && this.container) {
          this.container.addEventListener('touchstart', this.handleTouchStart.bind(this), { passive: true });
        }
      }

      handleTouchStart(e) {
        this.container.style.scrollBehavior = 'smooth';
      }
    }

    customElements.define('premium-social-carousel-{{ ai_gen_id }}', PremiumSocialCarousel{{ ai_gen_id }});
  })();
</script>

