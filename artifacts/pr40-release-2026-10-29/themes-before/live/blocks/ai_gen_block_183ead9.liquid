<script>
(function() {
  class VerticalTimeline{{ bid }} extends HTMLElement {
    constructor() {
      super();
      this.entries = Array.from(this.querySelectorAll('.tl-entry'));
      this.toggleBtn = this.querySelector('.tl-toggle-btn');
      this.toggleText = this.querySelector('.tl-toggle-text');
      this.isExpanded = false;
      this.observer = null;
      this.moreText = '{{ block.settings.button_text_more }}';
      this.lessText = '{{ block.settings.button_text_less }}';
    }

    connectedCallback() {
      this.setupIntersectionObserver();
      if (this.toggleBtn) {
        this.toggleBtn.addEventListener('click', () => this.toggleEntries());
      }
    }

    setupIntersectionObserver() {
      const options = {
        root: null,
        rootMargin: '0px',
        threshold: 0.1
      };

      this.observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('tl-visible');
          }
        });
      }, options);

      this.entries.forEach((entry) => {
        if (!entry.classList.contains('tl-hidden')) {
          this.observer.observe(entry);
        }
      });
    }

    toggleEntries() {
      if (!this.isExpanded) {
        this.expandEntries();
      } else {
        this.collapseEntries();
      }
    }

    expandEntries() {
      const hiddenEntries = this.entries.filter(entry => entry.classList.contains('tl-hidden'));
      
      hiddenEntries.forEach((entry, index) => {
        setTimeout(() => {
          entry.classList.remove('tl-hidden');
          this.observer.observe(entry);
        }, index * 80);
      });

      this.isExpanded = true;
      this.toggleBtn.classList.add('tl-expanded');
      this.toggleBtn.setAttribute('aria-expanded', 'true');
      this.toggleText.textContent = this.lessText;
    }

    collapseEntries() {
      this.entries.forEach((entry, index) => {
        if (index > 0) {
          entry.classList.add('tl-hidden');
          entry.classList.remove('tl-visible');
          entry.style.opacity = '0';
          entry.style.transform = 'translateY(20px)';
          this.observer.unobserve(entry);
        }
      });

      this.isExpanded = false;
      this.toggleBtn.classList.remove('tl-expanded');
      this.toggleBtn.setAttribute('aria-expanded', 'false');
      this.toggleText.textContent = this.moreText;
    }

    disconnectedCallback() {
      if (this.observer) {
        this.observer.disconnect();
      }
    }
  }

  customElements.define('vertical-timeline-{{ bid }}', VerticalTimeline{{ bid }});
})();
</script>

{% schema %}
{
  "name": "Timeline accordion",
  "settings": [
    {
      "type": "header",
      "content": "Section heading"
    },
    {
      "type": "text",
      "id": "section_heading",
      "label": "Heading"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "Heading font size",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "heading_margin_bottom",
      "label": "Heading bottom spacing",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "entry_spacing",
      "label": "Space between entries",
      "min": 16,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "header",
      "content": "Timeline line"
    },
    {
      "type": "color",
      "id": "line_color",
      "label": "Line color",
      "default": "#d4d0cb"
    },
    {
      "type": "range",
      "id": "line_offset",
      "label": "Line left offset",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Timeline dots"
    },
    {
      "type": "range",
      "id": "dot_size",
      "label": "Dot size",
      "min": 8,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "color",
      "id": "dot_color",
      "label": "Dot color",
      "default": "#2a2a2a"
    },
    {
      "type": "color",
      "id": "dot_border_color",
      "label": "Dot border color",
      "default": "#d4d0cb"
    },
    {
      "type": "range",
      "id": "dot_border_width",
