      "step": 20,
      "unit": "px",
      "default": 400
    },
    {
      "type": "range",
      "id": "image_margin_bottom",
      "label": "Bottom spacing",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "header",
      "content": "Brand name"
    },
    {
      "type": "range",
      "id": "brand_font_size",
      "label": "Font size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "color",
      "id": "brand_color",
      "label": "Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "brand_margin_bottom",
      "label": "Bottom spacing",
      "min": 5,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "header",
      "content": "Price"
    },
    {
      "type": "range",
      "id": "price_font_size",
      "label": "Font size",
      "min": 10,
      "max": 24,
