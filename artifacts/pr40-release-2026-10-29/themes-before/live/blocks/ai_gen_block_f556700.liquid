{% doc %}
  @prompt
    Task: Create a "Collection List" Mobile Carousel (Strictly NO Section Titles).
    
    1. Rigid Anti-Overflow & Spacing:
    
    No Titles: Do NOT include any section headings or titles above the carousel.
    
    Vertical Margins: Add exactly 60px of padding at the top and bottom of the section.
    
    Containment: Apply strict clipping (overflow: hidden) to the main container. The section must NEVER cause horizontal page scrolling.
    
    2. Individualized Card Layout (The Peek & Gap):
    
    Card Width: Each card must be 80% of the screen width.
    
    Isolation Gap: Add a significant gap between cards so they feel like distinct, separate elements rather than a continuous strip.
    
    Asymmetric Depth: Align the active card with a 5% left margin, leaving a clear 15% peek of the next card on the right.
    
    3. Premium Pop-Up & Fluidity:
    
    Snapping: Use an instant magnetic snap effect.
    
    Exaggerated Pop-Up: To make cards feel individual, the active card scales to 1.0, while side cards shrink significantly to 0.85 and dim slightly. Use a 0.5s ultra-fluid soft curve for the transition.
    
    4. High-End Aesthetic & 40/60 Proportions:
    
    Card Geometry: 36px border-radius, pure white cards, and a soft, high-diffusion shadow.
    
    Internal Proportions: Allocate exactly 40% of the card's height to the image and 60% to the text/buttons.
    
    Image Frame: Place the transparent product image inside a subtle rounded frame within that top 40% space to maintain visual balance.
    
    Typography: Use elegant Serif typography for "BOLSAS, CARTERAS, RELOJES". Center the text and the "EXPLORAR" button in the bottom 60%.
    
    5. Polish:
    
    Hide all scrollbars for a clean, app-like experience.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-carousel-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 60px 0;
    overflow: hidden;
  }

  .ai-collection-carousel-container-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .ai-collection-carousel-track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.card_gap }}px;
    padding-left: 5%;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .ai-collection-carousel-track-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-collection-carousel-card-{{ ai_gen_id }} {
    flex: 0 0 80%;
    scroll-snap-align: start;
    background: #ffffff;
    border-radius: 36px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.08);
    transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
    transform: scale(0.85);
    opacity: 0.6;
    overflow: hidden;
  }

  .ai-collection-carousel-card-{{ ai_gen_id }}.active {
    transform: scale(1);
    opacity: 1;
  }

  .ai-collection-carousel-card-inner-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .ai-collection-carousel-image-wrapper-{{ ai_gen_id }} {
    height: 40%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    background: linear-gradient(135deg, #f8f8f8 0%, #ffffff 100%);
  }

  .ai-collection-carousel-image-frame-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    border-radius: 24px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #ffffff;
  }

  .ai-collection-carousel-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-collection-carousel-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f4f4f4;
  }

  .ai-collection-carousel-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-collection-carousel-content-{{ ai_gen_id }} {
    height: 60%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 32px 24px;
    text-align: center;
  }

  .ai-collection-carousel-title-{{ ai_gen_id }} {
    font-family: {{ block.settings.title_font.family }}, {{ block.settings.title_font.fallback_families }};
    font-weight: {{ block.settings.title_font.weight }};
    font-size: {{ block.settings.title_size }}px;
    line-height: 1.2;
    color: {{ block.settings.title_color }};
    margin: 0 0 20px 0;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .ai-collection-carousel-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 14px 32px;
    background: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    font-family: {{ block.settings.button_font.family }}, {{ block.settings.button_font.fallback_families }};
    font-weight: {{ block.settings.button_font.weight }};
    font-size: {{ block.settings.button_size }}px;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    transition: all 0.3s ease;
  }

  .ai-collection-carousel-button-{{ ai_gen_id }}:hover {
    background: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-collection-carousel-{{ ai_gen_id }} {
      padding: 60px 0;
    }

    .ai-collection-carousel-card-{{ ai_gen_id }} {
      flex: 0 0 80%;
    }

    .ai-collection-carousel-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }

    .ai-collection-carousel-button-{{ ai_gen_id }} {
      font-size: {{ block.settings.button_size | times: 0.9 }}px;
      padding: 12px 28px;
    }
  }
{% endstyle %}

<collection-carousel-{{ ai_gen_id }} class="ai-collection-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-collection-carousel-container-{{ ai_gen_id }}">
    <div class="ai-collection-carousel-track-{{ ai_gen_id }}" data-carousel-track>
      {% for i in (1..5) %}
        {% liquid
          assign collection_key = 'collection_' | append: i
          assign collection = block.settings[collection_key]
        %}
        
        {% if collection != blank %}
          <div class="ai-collection-carousel-card-{{ ai_gen_id }}" data-card>
            <div class="ai-collection-carousel-card-inner-{{ ai_gen_id }}">
              <div class="ai-collection-carousel-image-wrapper-{{ ai_gen_id }}">
                <div class="ai-collection-carousel-image-frame-{{ ai_gen_id }}">
                  {% if collection.featured_image %}
                    <img
                      src="{{ collection.featured_image | image_url: width: 600 }}"
                      alt="{{ collection.featured_image.alt | escape }}"
                      class="ai-collection-carousel-image-{{ ai_gen_id }}"
                      loading="lazy"
                      width="600"
                      height="600"
                    >
                  {% else %}
                    <div class="ai-collection-carousel-placeholder-{{ ai_gen_id }}">
                      {{ 'collection-1' | placeholder_svg_tag }}
                    </div>
                  {% endif %}
                </div>
              </div>
              <div class="ai-collection-carousel-content-{{ ai_gen_id }}">
                <h3 class="ai-collection-carousel-title-{{ ai_gen_id }}">{{ collection.title }}</h3>
                <a href="{{ collection.url }}" class="ai-collection-carousel-button-{{ ai_gen_id }}">
                  {{ block.settings.button_text }}
                </a>
              </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</collection-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class CollectionCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.track = null;
        this.cards = [];
        this.observer = null;
      }

      connectedCallback() {
        this.track = this.querySelector('[data-carousel-track]');
        this.cards = Array.from(this.querySelectorAll('[data-card]'));
        
        if (!this.track || this.cards.length === 0) return;

        this.setupIntersectionObserver();
        this.updateActiveCard();
      }

      setupIntersectionObserver() {
        const options = {
          root: this.track,
          threshold: 0.6,
          rootMargin: '0px'
        };

        this.observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              this.cards.forEach(card => card.classList.remove('active'));
              entry.target.classList.add('active');
            }
          });
        }, options);

        this.cards.forEach(card => this.observer.observe(card));
      }

      updateActiveCard() {
        if (this.cards.length > 0) {
          this.cards[0].classList.add('active');
        }
      }

      disconnectedCallback() {
        if (this.observer) {
          this.observer.disconnect();
        }
      }
    }

    customElements.define('collection-carousel-{{ ai_gen_id }}', CollectionCarousel{{ ai_gen_id }});
  })();
</script>

