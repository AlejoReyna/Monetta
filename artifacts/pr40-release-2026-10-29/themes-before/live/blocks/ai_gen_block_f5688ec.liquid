{% doc %}
  @prompt
    Task: Build a high-end, mobile-first horizontal collection carousel. The design must be clean, minimal, and prioritize cards as the main container.
    
    1. Structural Layout (Mobile Focus):
    
    Card Proportions: Each collection must be inside a card with an aspect-ratio of 4:5. Set each card's width to exactly 80% of the screen width (80vw).
    
    Centering: The first card must be perfectly centered on page load. Use a peek effect where the next card is 20% visible on the right to encourage swiping.
    
    Container: Use display: flex with a gap: 12px. Enable scroll-snap-type: x mandatory for a magnetic snapping feel when scrolling.
    
    2. Card Aesthetics & Geometry:
    
    Rounded Contours: Apply a 32px border-radius to the cards. Use overflow: hidden to ensure a perfectly clean and rounded silhouette.
    
    Visual Polish: Use a white background (#FFFFFF) for cards. Add a subtle 1px solid #f0f0f0 border and a very soft, large-radius shadow (rgba(0,0,0,0.04)).
    
    3. Element Sizing & Hierarchy:
    
    Image: The product image inside the card must be centered and scaled to 60% of the card's height to leave breathing room for text.
    
    Information: Below the image, place a Serif title (e.g., "BOLSAS") and a small, minimalist "EXPLORAR" button.
    
    Button Design: The button must be compact (maximum width of 140px) with a clean border and small, uppercase typography.
    
    4. Animation & Interaction:
    
    Smoothness: Implement a buttery-smooth scrolling transition using cubic-bezier(0.25, 1, 0.5, 1).
    
    Focus Scale: Create an interaction where the centered card is scale(1.0) and inactive side cards are scale(0.9) and slightly faded (opacity: 0.6).
    
    5. Content Logic:
    
    Create 3 collection entries: BOLSAS, CARTERAS, and RELOJES.
    
    Hide all scrollbars to maintain a clean app-like interface.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-carousel-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    overflow: hidden;
    position: relative;
  }

  .ai-collection-carousel__wrapper-{{ ai_gen_id }} {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 0 10vw;
  }

  .ai-collection-carousel__wrapper-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-collection-carousel__card-{{ ai_gen_id }} {
    flex: 0 0 80vw;
    width: 80vw;
    aspect-ratio: 4 / 5;
    scroll-snap-align: center;
    background-color: {{ block.settings.card_background }};
    border: 1px solid {{ block.settings.card_border_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 40px 20px;
    box-shadow: 0 8px 40px rgba(0, 0, 0, 0.04);
    transition: transform 0.4s cubic-bezier(0.25, 1, 0.5, 1), opacity 0.4s cubic-bezier(0.25, 1, 0.5, 1);
    transform: scale(0.9);
    opacity: 0.6;
  }

  .ai-collection-carousel__card-{{ ai_gen_id }}.active {
    transform: scale(1);
    opacity: 1;
  }

  .ai-collection-carousel__image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    height: 60%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 24px;
  }

  .ai-collection-carousel__image-{{ ai_gen_id }} {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .ai-collection-carousel__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
  }

  .ai-collection-carousel__placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-collection-carousel__content-{{ ai_gen_id }} {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .ai-collection-carousel__title-{{ ai_gen_id }} {
    font-family: {{ block.settings.title_font.family }}, {{ block.settings.title_font.fallback_families }};
    font-weight: {{ block.settings.title_font.weight }};
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0;
    letter-spacing: 0.5px;
  }

  .ai-collection-carousel__button-{{ ai_gen_id }} {
    display: inline-block;
    max-width: 140px;
    padding: 10px 24px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    border: 1px solid {{ block.settings.button_border_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    text-decoration: none;
    font-size: {{ block.settings.button_font_size }}px;
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: all 0.3s cubic-bezier(0.25, 1, 0.5, 1);
    font-family: {{ block.settings.button_font.family }}, {{ block.settings.button_font.fallback_families }};
    font-weight: {{ block.settings.button_font.weight }};
  }

  .ai-collection-carousel__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
  }

  @media screen and (min-width: 750px) {
    .ai-collection-carousel__wrapper-{{ ai_gen_id }} {
      padding: 0 calc((100% - {{ block.settings.desktop_width_percent }}%) / 2);
    }

    .ai-collection-carousel__card-{{ ai_gen_id }} {
      flex: 0 0 calc({{ block.settings.desktop_width_percent }}% * 0.8);
      width: calc({{ block.settings.desktop_width_percent }}% * 0.8);
    }

    .ai-collection-carousel__title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 1.5);
    }

    .ai-collection-carousel__button-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.button_font_size }}px * 1.2);
    }
  }
{% endstyle %}

<collection-carousel-{{ ai_gen_id }} class="ai-collection-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-collection-carousel__wrapper-{{ ai_gen_id }}" data-carousel-wrapper>
    {% for i in (1..3) %}
      {% liquid
        assign collection_key = 'collection_' | append: i
        assign title_key = 'collection_' | append: i | append: '_title'
        assign button_text_key = 'collection_' | append: i | append: '_button_text'
        
        assign collection = block.settings[collection_key]
        assign title = block.settings[title_key]
        assign button_text = block.settings[button_text_key]
      %}
      
      <div class="ai-collection-carousel__card-{{ ai_gen_id }}" data-card-index="{{ forloop.index0 }}">
        <div class="ai-collection-carousel__image-wrapper-{{ ai_gen_id }}">
          {% if collection and collection.featured_image %}
            <img
              src="{{ collection.featured_image | image_url: width: 600 }}"
              alt="{{ collection.featured_image.alt | escape }}"
              class="ai-collection-carousel__image-{{ ai_gen_id }}"
              loading="lazy"
              width="600"
              height="600"
            >
          {% else %}
            <div class="ai-collection-carousel__placeholder-{{ ai_gen_id }}">
              {{ 'collection-1' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
        
        <div class="ai-collection-carousel__content-{{ ai_gen_id }}">
          {% if title != blank %}
            <h2 class="ai-collection-carousel__title-{{ ai_gen_id }}">{{ title }}</h2>
          {% elsif collection %}
            <h2 class="ai-collection-carousel__title-{{ ai_gen_id }}">{{ collection.title }}</h2>
          {% endif %}
          
          {% if collection %}
            <a href="{{ collection.url }}" class="ai-collection-carousel__button-{{ ai_gen_id }}">
              {% if button_text != blank %}
                {{ button_text }}
              {% else %}
                EXPLORAR
              {% endif %}
            </a>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
</collection-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class CollectionCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.wrapper = this.querySelector('[data-carousel-wrapper]');
        this.cards = this.querySelectorAll('[data-card-index]');
        this.currentIndex = 0;
      }

      connectedCallback() {
        this.setupIntersectionObserver();
        this.wrapper.addEventListener('scroll', this.handleScroll.bind(this));
        this.updateActiveCard();
      }

      setupIntersectionObserver() {
        const options = {
          root: this.wrapper,
          threshold: 0.5
        };

        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              this.cards.forEach(card => card.classList.remove('active'));
              entry.target.classList.add('active');
            }
          });
        }, options);

        this.cards.forEach(card => observer.observe(card));
      }

      handleScroll() {
        clearTimeout(this.scrollTimeout);
        this.scrollTimeout = setTimeout(() => {
          this.updateActiveCard();
        }, 100);
      }

      updateActiveCard() {
        const scrollLeft = this.wrapper.scrollLeft;
        const cardWidth = this.cards[0].offsetWidth + 12;
        const newIndex = Math.round(scrollLeft / cardWidth);
        
        if (newIndex !== this.currentIndex) {
          this.currentIndex = newIndex;
        }
      }
    }

    customElements.define('collection-carousel-{{ ai_gen_id }}', CollectionCarousel{{ ai_gen_id }});
  })();
</script>

