{% doc %}
  @prompt
    Create a fixed 3x3 collection image grid block. The entire grid fits within a single contained block — 3 columns side by side and 3 rows, all visible at once without scrolling. Each card shows ONLY the collection image covering the full card area (object-fit: cover), no text, no title, no overlay. All 9 cards are equal size and arranged tightly in a CSS grid with gap of 8px. Each card has a soft floating shadow (box-shadow: 0 4px 16px rgba(0,0,0,0.10)). Block background is transparent. The grid width is 100% of the section. Cards maintain a square aspect ratio using aspect-ratio: 1/1. No carousel, no scroll, no slider.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-grid-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: transparent;
  }

  .ai-collection-grid__container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(3, 1fr);
    gap: 8px;
    width: 100%;
  }

  .ai-collection-grid__card-{{ ai_gen_id }} {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.10);
    border-radius: {{ block.settings.card_border_radius }}px;
  }

  .ai-collection-grid__link-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    height: 100%;
    text-decoration: none;
  }

  .ai-collection-grid__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-collection-grid__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-collection-grid__placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }
{% endstyle %}

<collection-grid-{{ ai_gen_id }}
  class="ai-collection-grid-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-collection-grid__container-{{ ai_gen_id }}">
    {% for i in (1..9) %}
      {% liquid
        assign collection_key = 'collection_' | append: i
        assign collection = block.settings[collection_key]
      %}

      <div class="ai-collection-grid__card-{{ ai_gen_id }}">
        {% if collection != blank %}
          <a
            href="{{ collection.url }}"
            class="ai-collection-grid__link-{{ ai_gen_id }}"
            aria-label="{{ collection.title | escape }}"
          >
            {% if collection.featured_image %}
              <img
                src="{{ collection.featured_image | image_url: width: 600 }}"
                alt="{{ collection.featured_image.alt | escape }}"
                width="600"
                height="600"
                loading="lazy"
                class="ai-collection-grid__image-{{ ai_gen_id }}"
              >
            {% else %}
              <div class="ai-collection-grid__placeholder-{{ ai_gen_id }}">
                {{ 'collection-1' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </a>
        {% else %}
          <div class="ai-collection-grid__placeholder-{{ ai_gen_id }}">
            {{ 'collection-1' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</collection-grid-{{ ai_gen_id }}>

<script>
  (function() {
    class CollectionGrid{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('collection-grid-{{ ai_gen_id }}', CollectionGrid{{ ai_gen_id }});
  })();
</script>

