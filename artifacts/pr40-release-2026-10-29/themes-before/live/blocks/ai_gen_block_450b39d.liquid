{% doc %}
  @prompt
    "Create a Social Media Cards section for the homepage identical to the one on the Contact page. Display three cards side by side for Instagram, TikTok, and Facebook. Each card should have: the social media icon centered, the platform name below, a subtle hover effect, soft neutral/beige background consistent with a luxury spa brand aesthetic, rounded corners, and a link to each social media profile. Typography should match the rest of the store — elegant, minimal, uppercase labels. Spacing and padding should be generous. Section should be fully responsive."
    
    , HAZ QUE LAS TARJETAS ESTEN JUNTAS A LO ANCHO 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-social-cards-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-social-cards-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-social-cards-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
  }

  .ai-social-card-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.card_padding }}px;
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    text-decoration: none;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-social-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
  }

  .ai-social-icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    margin-bottom: {{ block.settings.icon_spacing }}px;
    fill: {{ block.settings.icon_color }};
    transition: fill 0.3s ease;
  }

  .ai-social-card-{{ ai_gen_id }}:hover .ai-social-icon-{{ ai_gen_id }} {
    fill: {{ block.settings.icon_hover_color }};
  }

  .ai-social-label-{{ ai_gen_id }} {
    font-family: {{ block.settings.label_font.family }}, {{ block.settings.label_font.fallback_families }};
    font-weight: {{ block.settings.label_font.weight }};
    font-size: {{ block.settings.label_size }}px;
    letter-spacing: {{ block.settings.letter_spacing }}px;
    text-transform: uppercase;
    color: {{ block.settings.label_color }};
    transition: color 0.3s ease;
  }

  .ai-social-card-{{ ai_gen_id }}:hover .ai-social-label-{{ ai_gen_id }} {
    color: {{ block.settings.label_hover_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-social-cards-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.card_gap_mobile }}px;
    }

    .ai-social-cards-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top_mobile }}px 0 {{ block.settings.section_padding_bottom_mobile }}px;
    }

    .ai-social-icon-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size_mobile }}px;
      height: {{ block.settings.icon_size_mobile }}px;
    }

    .ai-social-label-{{ ai_gen_id }} {
      font-size: {{ block.settings.label_size_mobile }}px;
    }
  }
{% endstyle %}

<div class="ai-social-cards-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-social-cards-container-{{ ai_gen_id }}">
    <div class="ai-social-cards-grid-{{ ai_gen_id }}">
      {% if block.settings.instagram_url != blank %}
        <a 
          href="{{ block.settings.instagram_url }}" 
          class="ai-social-card-{{ ai_gen_id }}"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Visit our Instagram"
        >
          <svg class="ai-social-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
          <span class="ai-social-label-{{ ai_gen_id }}">{{ block.settings.instagram_label }}</span>
        </a>
      {% endif %}

      {% if block.settings.tiktok_url != blank %}
        <a 
          href="{{ block.settings.tiktok_url }}" 
          class="ai-social-card-{{ ai_gen_id }}"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Visit our TikTok"
        >
          <svg class="ai-social-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"/>
          </svg>
          <span class="ai-social-label-{{ ai_gen_id }}">{{ block.settings.tiktok_label }}</span>
        </a>
      {% endif %}

      {% if block.settings.facebook_url != blank %}
        <a 
          href="{{ block.settings.facebook_url }}" 
          class="ai-social-card-{{ ai_gen_id }}"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Visit our Facebook"
        >
          <svg class="ai-social-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>
          <span class="ai-social-label-{{ ai_gen_id }}">{{ block.settings.facebook_label }}</span>
        </a>
      {% endif %}
    </div>
  </div>
</div>

