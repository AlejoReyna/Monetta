      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "button_border_color",
      "label": "Color del borde",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_hover_border_color",
      "label": "Borde al pasar",
      "default": "#383838"
    }
  ],
  "presets": [
    {
      "name": "Carrusel colecciones"
    }
  ]
