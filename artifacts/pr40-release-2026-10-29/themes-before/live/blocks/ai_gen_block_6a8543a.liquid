{% doc %}
  @prompt
    "Crea un bloque de botón personalizado para mi tema de Shopify con las siguientes características:
    
    Forma redondeada (pill shape, border-radius: 50px o más)
    Color de fondo del botón editable desde el editor del tema
    Color del texto editable desde el editor del tema
    Color hover personalizable (cambia al pasar el cursor)
    Sombra sutil (box-shadow) que le dé profundidad y sensación premium
    Campo de texto para el label del botón
    Campo de URL para el enlace
    Diseño minimalista y elegante, estilo marca de lujo
    El bloque debe instalarse como un theme block en Shopify y ser editable desde el Theme Editor.", AÑADE UN BORDE AL BOTON
    
    ADEMAS DEBE DE TENER UNA SECCION PERSONALIZABLE CON LA OPCION DE PONER EN CENTRO DE LA PAGINA 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-luxury-button-container-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-luxury-button-wrapper-{{ ai_gen_id }} {
    display: flex;
    {% if block.settings.alignment == 'center' %}
      justify-content: center;
    {% elsif block.settings.alignment == 'left' %}
      justify-content: flex-start;
    {% else %}
      justify-content: flex-end;
    {% endif %}
    width: 100%;
  }

  .ai-luxury-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
    font-size: {{ block.settings.font_size }}px;
    font-weight: {{ block.settings.font_weight }};
    text-decoration: none;
    text-transform: {{ block.settings.text_transform }};
    letter-spacing: {{ block.settings.letter_spacing }}px;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: {{ block.settings.shadow_x }}px {{ block.settings.shadow_y }}px {{ block.settings.shadow_blur }}px {{ block.settings.shadow_spread }}px {{ block.settings.shadow_color }};
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-luxury-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.border_hover_color }};
    box-shadow: {{ block.settings.hover_shadow_x }}px {{ block.settings.hover_shadow_y }}px {{ block.settings.hover_shadow_blur }}px {{ block.settings.hover_shadow_spread }}px {{ block.settings.hover_shadow_color }};
    transform: translateY({{ block.settings.hover_lift }}px);
  }

  @media screen and (max-width: 749px) {
    .ai-luxury-button-{{ ai_gen_id }} {
      width: 100%;
      font-size: {{ block.settings.font_size | times: 0.9 }}px;
      padding: {{ block.settings.padding_vertical | times: 0.9 }}px {{ block.settings.padding_horizontal | times: 0.9 }}px;
    }
  }
{% endstyle %}

<ai-luxury-button-{{ ai_gen_id }}
  class="ai-luxury-button-container-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-luxury-button-wrapper-{{ ai_gen_id }}">
    <a
      href="{{ block.settings.button_link }}"
      class="ai-luxury-button-{{ ai_gen_id }}"
    >
      {{ block.settings.button_text }}
    </a>
  </div>
</ai-luxury-button-{{ ai_gen_id }}>

<script>
  (function() {
    class AiLuxuryButton{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.style.display = 'block';
      }
    }

    customElements.define('ai-luxury-button-{{ ai_gen_id }}', AiLuxuryButton{{ ai_gen_id }});
  })();
</script>

