{% doc %}
  @prompt
    Generate HTML and CSS for a Shopify 'Custom Liquid' section consisting ONLY of a horizontal collection carousel with the following specifications:
    
    Layout & Interaction:
    
    Create a horizontal scroll container with scroll-snap-type: x mandatory.
    
    Mobile Visibility (Peek Effect): The active card must be centered, while the subsequent card must be 25% visible on the right side of the viewport to clearly indicate more content is available to swipe.
    
    Hide all scrollbars using ::-webkit-scrollbar { display: none; } and scrollbar-width: none.
    
    Card Design (Premium & Minimalist):
    
    Shape: Apply a border-radius: 32px to each card for a soft, ultra-modern rounded contour.
    
    Aspect Ratio: Each card must have a 4:5 vertical ratio (tall and wide) to fill the screen elegantly.
    
    Aesthetic: Background color #FFFFFF. Add a very subtle, expansive soft shadow: box-shadow: 0 25px 50px rgba(0,0,0,0.04).
    
    Floating Content: Position a transparent PNG image placeholder in the center of the card.
    
    Animation & Physics:
    
    Smooth Motion: Use transition: all 0.6s cubic-bezier(0.22, 1, 0.36, 1) for a high-end, buttery-smooth feel.
    
    Focus Effect: The centered card should be scale(1.0) and opacity: 1. Cards not in focus should automatically transition to scale(0.9) and opacity: 0.5 as the user scrolls.
    
    Content Structure:
    
    Card 1: Title "BOLSAS", Link: "/collections/bolsas", minimalist "EXPLORAR" button.
    
    Card 2: Title "CARTERAS", Link: "/collections/carteras", minimalist "EXPLORAR" button.
    
    Card 3: Title "RELOJES", Link: "/collections/relojes", minimalist "EXPLORAR" button.
    
    Technical Requirements:
    
    Pure HTML and CSS only. No JavaScript.
    
    Use a unique CSS prefix .lux-card-slider- to avoid theme conflicts.
    
    Ensure the design is fully responsive for mobile and desktop.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .lux-card-slider-container-{{ ai_gen_id }} {
    width: 100%;
    overflow: hidden;
    display: block;
  }

  .lux-card-slider-wrapper-{{ ai_gen_id }} {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    gap: 16px;
    padding: 20px 0;
  }

  .lux-card-slider-wrapper-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .lux-card-slider-card-{{ ai_gen_id }} {
    flex: 0 0 auto;
    width: calc(100vw - 80px);
    aspect-ratio: 4 / 5;
    background-color: {{ block.settings.card_background_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    box-shadow: {{ block.settings.card_shadow_x }}px {{ block.settings.card_shadow_y }}px {{ block.settings.card_shadow_blur }}px {{ block.settings.card_shadow_color }};
    scroll-snap-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
    transition: all 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    opacity: {{ block.settings.unfocused_opacity | divided_by: 100.0 }};
    transform: scale({{ block.settings.unfocused_scale | divided_by: 100.0 }});
    text-decoration: none;
    padding: 40px 20px;
  }

  .lux-card-slider-card-{{ ai_gen_id }}:first-child {
    margin-left: calc((100vw - (100vw - 80px)) / 2);
  }

  .lux-card-slider-card-{{ ai_gen_id }}:last-child {
    margin-right: calc((100vw - (100vw - 80px)) / 2);
  }

  .lux-card-slider-card-{{ ai_gen_id }}.lux-card-slider-focused-{{ ai_gen_id }} {
    opacity: 1;
    transform: scale(1);
  }

  .lux-card-slider-image-{{ ai_gen_id }} {
    width: 100%;
    max-width: 300px;
    height: auto;
    margin-bottom: 30px;
  }

  .lux-card-slider-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    max-width: 300px;
    height: 300px;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 30px;
  }

  .lux-card-slider-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
  }

  .lux-card-slider-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_font_size }}px;
    font-weight: {{ block.settings.title_font_weight }};
    color: {{ block.settings.title_color }};
    margin: 0 0 20px 0;
    text-align: center;
    letter-spacing: {{ block.settings.title_letter_spacing }}px;
    text-transform: {{ block.settings.title_text_transform }};
  }

  .lux-card-slider-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_background_color }};
    color: {{ block.settings.button_text_color }};
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: {{ block.settings.button_font_weight }};
    text-decoration: none;
    text-transform: {{ block.settings.button_text_transform }};
    letter-spacing: {{ block.settings.button_letter_spacing }}px;
    transition: all 0.3s ease;
  }

  .lux-card-slider-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background_color }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
  }

  @media screen and (min-width: 750px) {
    .lux-card-slider-card-{{ ai_gen_id }} {
      width: {{ block.settings.desktop_card_width }}px;
    }

    .lux-card-slider-card-{{ ai_gen_id }}:first-child {
      margin-left: calc((100vw - {{ block.settings.desktop_card_width }}px) / 2);
    }

    .lux-card-slider-card-{{ ai_gen_id }}:last-child {
      margin-right: calc((100vw - {{ block.settings.desktop_card_width }}px) / 2);
    }
  }
{% endstyle %}

<lux-card-slider-{{ ai_gen_id }} class="lux-card-slider-container-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="lux-card-slider-wrapper-{{ ai_gen_id }}">
    {% for i in (1..3) %}
      {% liquid
        assign card_title_key = 'card_' | append: i | append: '_title'
        assign card_link_key = 'card_' | append: i | append: '_link'
        assign card_image_key = 'card_' | append: i | append: '_image'
        
        assign card_title = block.settings[card_title_key]
        assign card_link = block.settings[card_link_key]
        assign card_image = block.settings[card_image_key]
      %}
      
      <a 
        href="{{ card_link }}" 
        class="lux-card-slider-card-{{ ai_gen_id }}"
        data-card-index="{{ i }}"
      >
        {% if card_image %}
          <img
            src="{{ card_image | image_url: width: 600 }}"
            alt="{{ card_image.alt | escape }}"
            loading="lazy"
            width="{{ card_image.width }}"
            height="{{ card_image.height }}"
            class="lux-card-slider-image-{{ ai_gen_id }}"
          >
        {% else %}
          <div class="lux-card-slider-image-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}
        
        <h3 class="lux-card-slider-title-{{ ai_gen_id }}">{{ card_title }}</h3>
        <span class="lux-card-slider-button-{{ ai_gen_id }}">{{ block.settings.button_text }}</span>
      </a>
    {% endfor %}
  </div>
</lux-card-slider-{{ ai_gen_id }}>

<script>
  (function() {
    class LuxCardSlider{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.wrapper = this.querySelector('.lux-card-slider-wrapper-{{ ai_gen_id }}');
        this.cards = this.querySelectorAll('.lux-card-slider-card-{{ ai_gen_id }}');
      }

      connectedCallback() {
        this.setupScrollObserver();
        this.updateFocusedCard();
      }

      setupScrollObserver() {
        const options = {
          root: this.wrapper,
          threshold: 0.5
        };

        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              this.cards.forEach(card => card.classList.remove('lux-card-slider-focused-{{ ai_gen_id }}'));
              entry.target.classList.add('lux-card-slider-focused-{{ ai_gen_id }}');
            }
          });
        }, options);

        this.cards.forEach(card => observer.observe(card));
      }

      updateFocusedCard() {
        if (this.cards.length > 0) {
          this.cards[0].classList.add('lux-card-slider-focused-{{ ai_gen_id }}');
        }
      }
    }

    customElements.define('lux-card-slider-{{ ai_gen_id }}', LuxCardSlider{{ ai_gen_id }});
  })();
</script>

