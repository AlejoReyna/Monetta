<script>
(function() {
  class TimelineAccordion{{ bid }} extends HTMLElement {
    constructor() {
      super();
      this.entries = Array.from(this.querySelectorAll('.tl-entry-{{ bid }}'));
      this.toggleBtn = this.querySelector('.tl-toggle-{{ bid }}');
      this.toggleText = this.querySelector('.tl-toggle-text-{{ bid }}');
      this.isExpanded = false;
      this.observer = null;
      this.textMore = '{{ block.settings.button_text_more }}';
      this.textLess = '{{ block.settings.button_text_less }}';
    }

    connectedCallback() {
      this.setupIntersectionObserver();
      if (this.toggleBtn) {
        this.toggleBtn.addEventListener('click', this.handleToggle.bind(this));
      }
      this.observeVisibleEntries();
    }

    setupIntersectionObserver() {
      const options = {
        root: null,
        rootMargin: '0px',
        threshold: 0.1
      };

      this.observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('tl-visible-{{ bid }}');
          }
        });
      }, options);
    }

    observeVisibleEntries() {
      this.entries.forEach((entry) => {
        if (!entry.classList.contains('tl-hidden-{{ bid }}')) {
          this.observer.observe(entry);
        }
      });
    }

    handleToggle() {
      this.isExpanded = !this.isExpanded;
      this.toggleBtn.classList.toggle('tl-expanded-{{ bid }}', this.isExpanded);
      this.toggleBtn.setAttribute('aria-expanded', this.isExpanded);

      if (this.isExpanded) {
        this.expandEntries();
        this.toggleText.textContent = this.textLess;
      } else {
        this.collapseEntries();
        this.toggleText.textContent = this.textMore;
      }
    }

    expandEntries() {
  const hiddenEntries = this.entries.filter((entry) => 
    entry.classList.contains('tl-hidden-{{ bid }}')
  );

  hiddenEntries.forEach((entry, index) => {
    setTimeout(() => {
      entry.classList.remove('tl-hidden-{{ bid }}');
      entry.style.opacity = '0';
      entry.style.transform = 'translateY(20px)';
      
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          entry.classList.add('tl-visible-{{ bid }}');
          entry.style.opacity = '';
          entry.style.transform = '';
        });
      });
    }, index * 80);
  });
}

    collapseEntries() {
  this.entries.forEach((entry, index) => {
    if (index > 0) {
      entry.classList.add('tl-hidden-{{ bid }}');
      entry.classList.remove('tl-visible-{{ bid }}');
      entry.style.opacity = '';
      entry.style.transform = '';
      this.observer.unobserve(entry);
    }
  });
}

    disconnectedCallback() {
      if (this.observer) {
        this.observer.disconnect();
      }
      if (this.toggleBtn) {
        this.toggleBtn.removeEventListener('click', this.handleToggle.bind(this));
      }
    }
  }

  customElements.define('timeline-accordion-{{ bid }}', TimelineAccordion{{ bid }});
})();
</script>

{% schema %}
{
  "name": "Timeline accordion",
  "tag": null,
  "class": "timeline-accordion-section",
  "settings": [
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "text",
      "id": "section_heading",
      "label": "Heading"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 16,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#000000"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "heading_margin_bottom",
      "label": "Heading bottom spacing",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "section_padding_horizontal",
      "label": "Padding horizontal",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Timeline line"
    },
    {
      "type": "color",
      "id": "line_color",
      "label": "Line color",
      "default": "#d4d0cb"
    },
