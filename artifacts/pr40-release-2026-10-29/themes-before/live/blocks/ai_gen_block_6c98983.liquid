{% doc %}
  @prompt
    Task: Create a Premium Mobile Collection Carousel.
    
    1. Layout & Margins: > * Create a horizontal carousel for 3 collections (BOLSAS, CARTERAS, RELOJES).
    
    Standard Spacing: Add 60px padding at the top and bottom of the section.
    
    Mobile Centering: Each card must be 75% of the screen width and perfectly centered. The next card must peek 12.5% from the edge.
    
    2. High-End Card Design:
    
    Shape: 36px border-radius with overflow: hidden.
    
    Image: The product image must be transparent and occupy 70% of the card's height. Center the image with enough internal space.
    
    Style: Pure white cards with a very soft shadow and a 1px light border.
    
    3. Buttery-Smooth Motion:
    
    Transitions: Use a "magnetic" snapping effect. Transitions must be ultra-fluid and professional.
    
    Scaling: The centered card should be full size (scale 1.0) while side cards scale down to 0.9.
    
    4. Details:
    
    Hide all scrollbars. Use an elegant Serif font for titles. Place a compact "EXPLORAR" button at the bottom.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-premium-carousel-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 60px 0;
    overflow: hidden;
    position: relative;
  }

  .ai-premium-carousel-wrapper-{{ ai_gen_id }} {
    display: flex;
    gap: 0;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 0 12.5%;
  }

  .ai-premium-carousel-wrapper-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-premium-carousel-card-{{ ai_gen_id }} {
    flex: 0 0 75%;
    scroll-snap-align: center;
    transition: transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94), opacity 0.5s ease;
    transform: scale(0.9);
    opacity: 0.6;
  }

  .ai-premium-carousel-card-{{ ai_gen_id }}.active {
    transform: scale(1);
    opacity: 1;
  }

  .ai-premium-carousel-card-inner-{{ ai_gen_id }} {
    background: #ffffff;
    border-radius: 36px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    border: 1px solid #f0f0f0;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 40px 30px 30px;
    text-align: center;
  }

  .ai-premium-carousel-image-wrapper-{{ ai_gen_id }} {
    height: 70%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
  }

  .ai-premium-carousel-image-{{ ai_gen_id }} {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .ai-premium-carousel-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #fafafa;
    border-radius: 12px;
  }

  .ai-premium-carousel-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-premium-carousel-content-{{ ai_gen_id }} {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 16px;
  }

  .ai-premium-carousel-title-{{ ai_gen_id }} {
    font-family: {{ block.settings.title_font.family }}, serif;
    font-size: {{ block.settings.title_size }}px;
    font-weight: 400;
    color: {{ block.settings.title_color }};
    margin: 0;
    letter-spacing: 0.5px;
  }

  .ai-premium-carousel-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 10px 24px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    border-radius: 4px;
    transition: all 0.3s ease;
    border: 1px solid {{ block.settings.button_border_color }};
  }

  .ai-premium-carousel-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-premium-carousel-{{ ai_gen_id }} {
      padding: 40px 0;
    }

    .ai-premium-carousel-card-inner-{{ ai_gen_id }} {
      padding: 30px 20px 20px;
    }

    .ai-premium-carousel-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<premium-carousel-{{ ai_gen_id }}
  class="ai-premium-carousel-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-premium-carousel-wrapper-{{ ai_gen_id }}">
    {% for i in (1..3) %}
      {% liquid
        assign collection_key = 'collection_' | append: i
        assign collection = block.settings[collection_key]
      %}

      <div
        class="ai-premium-carousel-card-{{ ai_gen_id }} {% if i == 2 %}active{% endif %}"
        data-card-index="{{ i }}"
      >
        <div class="ai-premium-carousel-card-inner-{{ ai_gen_id }}">
          <div class="ai-premium-carousel-image-wrapper-{{ ai_gen_id }}">
            {% if collection and collection.featured_image %}
              <img
                src="{{ collection.featured_image | image_url: width: 600 }}"
                alt="{{ collection.featured_image.alt | escape }}"
                class="ai-premium-carousel-image-{{ ai_gen_id }}"
                loading="lazy"
                width="600"
                height="600"
              >
            {% else %}
              <div class="ai-premium-carousel-placeholder-{{ ai_gen_id }}">
                {{ 'collection-1' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>

          <div class="ai-premium-carousel-content-{{ ai_gen_id }}">
            {% if collection %}
              <h3 class="ai-premium-carousel-title-{{ ai_gen_id }}">{{ collection.title }}</h3>
              <a
                href="{{ collection.url }}"
                class="ai-premium-carousel-button-{{ ai_gen_id }}"
              >
                {{ block.settings.button_text }}
              </a>
            {% else %}
              <h3 class="ai-premium-carousel-title-{{ ai_gen_id }}">Colección {{ i }}</h3>
              <a
                href="#"
                class="ai-premium-carousel-button-{{ ai_gen_id }}"
              >
                {{ block.settings.button_text }}
              </a>
            {% endif %}
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
</premium-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class PremiumCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.wrapper = this.querySelector('.ai-premium-carousel-wrapper-{{ ai_gen_id }}');
        this.cards = this.querySelectorAll('.ai-premium-carousel-card-{{ ai_gen_id }}');
        this.isScrolling = false;
        this.scrollTimeout = null;
      }

      connectedCallback() {
        this.setupScrollListener();
        this.updateActiveCard();
      }

      setupScrollListener() {
        this.wrapper.addEventListener('scroll', () => {
          clearTimeout(this.scrollTimeout);
          this.scrollTimeout = setTimeout(() => {
            this.updateActiveCard();
          }, 100);
        });
      }

      updateActiveCard() {
        const wrapperRect = this.wrapper.getBoundingClientRect();
        const centerX = wrapperRect.left + wrapperRect.width / 2;

        let closestCard = null;
        let closestDistance = Infinity;

        this.cards.forEach((card) => {
          const cardRect = card.getBoundingClientRect();
          const cardCenterX = cardRect.left + cardRect.width / 2;
          const distance = Math.abs(centerX - cardCenterX);

          if (distance < closestDistance) {
            closestDistance = distance;
            closestCard = card;
          }
        });

        this.cards.forEach((card) => {
          card.classList.remove('active');
        });

        if (closestCard) {
          closestCard.classList.add('active');
        }
      }
    }

    customElements.define('premium-carousel-{{ ai_gen_id }}', PremiumCarousel{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Premium carousel",
  "settings": [
    {
      "type": "header",
      "content": "Collections"
    },
    {
      "type": "collection",
      "id": "collection_1",
      "label": "Collection 1"
    },
    {
      "type": "collection",
      "id": "collection_2",
      "label": "Collection 2"
    },
    {
      "type": "collection",
      "id": "collection_3",
      "label": "Collection 3"
    },
    {
      "type": "header",
      "content": "Title"
    },
    {
      "type": "font_picker",
      "id": "title_font",
      "label": "Font",
      "default": "serif"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Size",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Text",
      "default": "EXPLORAR"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_border_color",
      "label": "Border",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_hover_bg_color",
      "label": "Hover background",
      "default": "#383838"
    },
    {
      "type": "color",
      "id": "button_hover_text_color",
      "label": "Hover text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_hover_border_color",
      "label": "Hover border",
      "default": "#383838"
    }
  ],
  "presets": [
    {
      "name": "Premium carousel"
    }
  ]
}
{% endschema %}
