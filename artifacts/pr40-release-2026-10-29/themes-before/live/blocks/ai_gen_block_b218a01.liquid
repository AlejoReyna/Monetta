{% doc %}
  @prompt
    Create a premium image card carousel block with exactly 3 cards.
    Each card must contain, in this exact order from top to bottom:
    
    1. A full-width image that fills the card edge-to-edge with no white space
       or padding around it. The image must have border-radius on the top-left
       and top-right corners only (50px), matching the card top corners exactly,
       so it blends seamlessly with no gap or white line.
    
    2. A heading (font: Aleo, 26px, color: #000000) below the image,
       with 16px padding on the sides and 12px padding top.
    
    3. A body text paragraph (font: System UI, 15px, color: #666666)
       below the heading, with 16px padding on the sides.
    
    4. A pill-shaped button (border-radius: 50px, background: #dedede,
       text color: #000000, font: Andada Pro, 14px) with hover state that
       changes text to #aa7d44. The button must be INSIDE the card,
       with 16px margin on all sides from the card edges, and 16px
       margin-bottom so it does not touch the card bottom edge.
       The button has a customizable label field and an external URL
       link field (opens in new tab).
    
    5. Below the button and still inside the card, a URL input field
       labeled "Link URL" where the merchant can paste an external link,
       with 16px padding on the sides and 16px padding-bottom.
    
    Card design:
    - Background: #ffffff
    - Border radius: 50px on all corners
    - overflow: hidden on the card so the image clips correctly to the
      rounded corners with NO white line or gap between image and card edge
    - DO NOT add any border, outline, or margin inside the card that
      could create a white line between the image and the card border
    - Premium floating shadow applied to the card WRAPPER (a div outside
      the card), NOT to the card itself, so the shadow is never clipped:
      box-shadow: 0 20px 60px rgba(0,0,0,0.18), 0 6px 20px rgba(0,0,0,0.10)
    - The card wrapper must have padding: 0 and background: transparent
      so the shadow renders freely without any white margin cutting it off
    - Gap between cards: 24px
    - Desktop card width: 85% of carousel viewport
    
    Carousel behavior:
    - Smooth, fluid horizontal scroll with momentum/inertia
    - CSS scroll-snap-type: x mandatory on the container
    - scroll-snap-align: center on each card
    - scroll-behavior: smooth
    - Premium easing on JS navigation arrows: cubic-bezier(0.25, 0.46, 0.45, 0.94)
      with 500ms transition duration
    - Navigation arrows with subtle fade-in on hover, positioned outside
      the cards so they never overlap card content
    - Mobile swipe-friendly with touch events
    
    Section settings:
    - Full-width section
    - Top padding: 63px, Bottom padding: 96px
    - The carousel container must have overflow: visible on the Y axis
      and overflow-x: scroll so shadows are never clipped vertically
    - Center-aligned content
    - No background color
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-carousel-section-{{ ai_gen_id }} {
    padding-top: {{ block.settings.padding_top }}px;
    padding-bottom: {{ block.settings.padding_bottom }}px;
    width: 100%;
    overflow: visible;
  }

  .ai-carousel-container-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-carousel-wrapper-{{ ai_gen_id }} {
    position: relative;
    padding: 0 60px;
  }

  .ai-carousel-track-{{ ai_gen_id }} {
    display: flex;
    gap: 24px;
    overflow-x: scroll;
    overflow-y: visible;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 40px 0;
  }

  .ai-carousel-track-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-carousel-card-wrapper-{{ ai_gen_id }} {
    flex: 0 0 85%;
    scroll-snap-align: center;
    padding: 0;
    background: transparent;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.18), 0 6px 20px rgba(0, 0, 0, 0.10);
    border-radius: 50px;
  }

  .ai-carousel-card-{{ ai_gen_id }} {
    background: #ffffff;
    border-radius: 50px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    height: 100%;
    position: relative;
  }

  .ai-carousel-image-container-{{ ai_gen_id }} {
    width: 100%;
    position: relative;
    overflow: hidden;
    border-radius: 50px 50px 0 0;
  }

  .ai-carousel-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 50px 50px 0 0;
  }

  .ai-carousel-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 4 / 3;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50px 50px 0 0;
  }

  .ai-carousel-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-carousel-content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .ai-carousel-heading-{{ ai_gen_id }} {
    font-family: 'Aleo', serif;
    font-size: 26px;
    color: #000000;
    margin: 0;
    padding: 12px 16px 0 16px;
    line-height: 1.3;
  }

  .ai-carousel-body-{{ ai_gen_id }} {
    font-family: system-ui, -apple-system, sans-serif;
    font-size: 15px;
    color: #666666;
    margin: 0;
    padding: 8px 16px 0 16px;
    line-height: 1.5;
  }

  .ai-carousel-button-{{ ai_gen_id }} {
    display: inline-block;
    margin: 16px;
    padding: 12px 24px;
    background: #dedede;
    color: #000000;
    font-family: 'Andada Pro', serif;
    font-size: 14px;
    text-decoration: none;
    border-radius: 50px;
    text-align: center;
    transition: color 0.3s ease;
    border: none;
    cursor: pointer;
  }

  .ai-carousel-button-{{ ai_gen_id }}:hover {
    color: #aa7d44;
  }

  .ai-carousel-link-display-{{ ai_gen_id }} {
    padding: 0 16px 16px 16px;
    font-family: system-ui, -apple-system, sans-serif;
    font-size: 12px;
    color: #999999;
    word-break: break-all;
  }

  .ai-carousel-nav-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 40px;
    height: 40px;
    background: rgba(255, 255, 255, 0.9);
    border: 1px solid #e6e6e6;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10;
    opacity: 0.7;
    transition: opacity 0.3s ease;
  }

  .ai-carousel-nav-{{ ai_gen_id }}:hover {
    opacity: 1;
  }

  .ai-carousel-nav-prev-{{ ai_gen_id }} {
    left: 10px;
  }

  .ai-carousel-nav-next-{{ ai_gen_id }} {
    right: 10px;
  }

  .ai-carousel-nav-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
    stroke: #000000;
    stroke-width: 2;
  }

  @media screen and (max-width: 749px) {
    .ai-carousel-wrapper-{{ ai_gen_id }} {
      padding: 0 20px;
    }

    .ai-carousel-card-wrapper-{{ ai_gen_id }} {
      flex: 0 0 90%;
    }

    .ai-carousel-heading-{{ ai_gen_id }} {
      font-size: 22px;
    }

    .ai-carousel-body-{{ ai_gen_id }} {
      font-size: 14px;
    }

    .ai-carousel-nav-{{ ai_gen_id }} {
      display: none;
    }
  }
{% endstyle %}

<premium-carousel-{{ ai_gen_id }} class="ai-carousel-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-carousel-container-{{ ai_gen_id }}">
    <div class="ai-carousel-wrapper-{{ ai_gen_id }}">
      <button class="ai-carousel-nav-{{ ai_gen_id }} ai-carousel-nav-prev-{{ ai_gen_id }}" aria-label="Previous card">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <div class="ai-carousel-track-{{ ai_gen_id }}">
        {% for i in (1..3) %}
          {% liquid
            assign image_key = 'card_' | append: i | append: '_image'
            assign heading_key = 'card_' | append: i | append: '_heading'
            assign body_key = 'card_' | append: i | append: '_body'
            assign button_key = 'card_' | append: i | append: '_button_label'
            assign url_key = 'card_' | append: i | append: '_url'

            assign card_image = block.settings[image_key]
            assign card_heading = block.settings[heading_key]
            assign card_body = block.settings[body_key]
            assign card_button = block.settings[button_key]
            assign card_url = block.settings[url_key]
          %}

          <div class="ai-carousel-card-wrapper-{{ ai_gen_id }}">
            <div class="ai-carousel-card-{{ ai_gen_id }}">
              <div class="ai-carousel-image-container-{{ ai_gen_id }}">
                {% if card_image %}
                  <img
                    src="{{ card_image | image_url: width: 1200 }}"
                    alt="{{ card_image.alt | escape }}"
                    loading="lazy"
                    width="{{ card_image.width }}"
                    height="{{ card_image.height }}"
                    class="ai-carousel-image-{{ ai_gen_id }}"
                  >
                {% else %}
                  <div class="ai-carousel-image-placeholder-{{ ai_gen_id }}">
                    {{ 'image' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              </div>

              <div class="ai-carousel-content-{{ ai_gen_id }}">
                {% if card_heading != blank %}
                  <h3 class="ai-carousel-heading-{{ ai_gen_id }}">{{ card_heading }}</h3>
                {% endif %}

                {% if card_body != blank %}
                  <p class="ai-carousel-body-{{ ai_gen_id }}">{{ card_body }}</p>
                {% endif %}

                {% if card_button != blank and card_url != blank %}
                  <a
                    href="{{ card_url }}"
                    class="ai-carousel-button-{{ ai_gen_id }}"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {{ card_button }}
                  </a>
                {% endif %}

                {% if card_url != blank %}
                  <div class="ai-carousel-link-display-{{ ai_gen_id }}">
                    {{ card_url }}
                  </div>
                {% endif %}
              </div>
            </div>
          </div>
        {% endfor %}
      </div>

      <button class="ai-carousel-nav-{{ ai_gen_id }} ai-carousel-nav-next-{{ ai_gen_id }}" aria-label="Next card">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>
  </div>
</premium-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class PremiumCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.track = null;
        this.prevButton = null;
        this.nextButton = null;
        this.currentIndex = 0;
        this.cardWidth = 0;
        this.gap = 24;
      }

      connectedCallback() {
        this.track = this.querySelector('.ai-carousel-track-{{ ai_gen_id }}');
        this.prevButton = this.querySelector('.ai-carousel-nav-prev-{{ ai_gen_id }}');
        this.nextButton = this.querySelector('.ai-carousel-nav-next-{{ ai_gen_id }}');

        if (!this.track || !this.prevButton || !this.nextButton) return;

        this.setupEventListeners();
        this.updateCardWidth();
      }

      setupEventListeners() {
        this.prevButton.addEventListener('click', () => this.navigate(-1));
        this.nextButton.addEventListener('click', () => this.navigate(1));

        window.addEventListener('resize', () => this.updateCardWidth());
      }

      updateCardWidth() {
        const firstCard = this.track.querySelector('.ai-carousel-card-wrapper-{{ ai_gen_id }}');
        if (firstCard) {
          this.cardWidth = firstCard.offsetWidth;
        }
      }

      navigate(direction) {
        const maxIndex = 2;
        this.currentIndex = Math.max(0, Math.min(maxIndex, this.currentIndex + direction));

        const scrollAmount = this.currentIndex * (this.cardWidth + this.gap);

        this.track.style.transition = 'none';
        this.track.scrollTo({
          left: scrollAmount,
          behavior: 'auto'
        });

        requestAnimationFrame(() => {
          this.track.style.transition = '';
          this.track.scrollTo({
            left: scrollAmount,
            behavior: 'smooth'
          });
        });

        setTimeout(() => {
          this.track.scrollTo({
            left: scrollAmount,
            behavior: 'smooth'
          });
        }, 10);
      }
    }

    customElements.define('premium-carousel-{{ ai_gen_id }}', PremiumCarousel{{ ai_gen_id }});
  })();
</script>

