{% doc %}
  @prompt
    Task: Create a Custom 3-Row Horizontal Collection Grid (Strictly 9 Linked Cards).
    
    1. Structural Architecture (The 3x3 Scroll Fix):
    
    Generate a new custom HTML/CSS section (do not use a standard Collection template).
    
    Main Wrapper: Add 60px padding at the top and bottom of the entire section. Apply max-width: 100vw and strict overflow: hidden to prevent any horizontal page body stretching. The section background must be Pure White (#FFFFFF).
    
    Grid Track (The Core Fix): Inside the wrapper, create a container (overflow-x: auto) for exactly 9 individual cards. This container MUST use CSS Grid with these exact properties: display: grid, grid-template-rows: repeat(3, 1fr), and grid-auto-flow: column. This forces the 9 cards to stack into exactly 3 rows first, then flow horizontally as a single track.
    
    2. Mobile Sizing & Containment:
    
    Mobile Sizing: Set each column width to 42vw (or similar). This ensures exactly 2 full columns are visible on the mobile screen, leaving a small 16% peek of the next column on the right side to invite swiping.
    
    Gap: Apply a consistent 15px gap between all cards.
    
    3. Card Aesthetics (Minimalist Link-Only):
    
    Content: Cards must display ONLY images. Absolutely NO text, titles, or buttons inside or outside the cards. Each card must act as a direct functional link to its corresponding collection page.
    
    Geometry: 24px border-radius, and a very thin, elegant drop shadow strictly at the bottom of each card for a premium lift. The image must fill the card area completely.
    
    4. High-End Interaction:
    
    Use frictionless horizontal scroll snapping (scroll-snap-type: x mandatory).
    
    Apply a subtle pop-up scaling transition (0.5s ease-out). As a card (column) enters the center of the viewport, it should scale to 1.0, while surrounding cards scale smoothly to 0.9.
    
    Hide all scrollbars. Strictly maintain the horizontal layout; do NOT stack items vertically on mobile.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-grid-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    max-width: 100vw;
    overflow: hidden;
    padding: 60px 0;
    background-color: #FFFFFF;
  }

  .ai-collection-grid-track-{{ ai_gen_id }} {
    display: grid;
    grid-template-rows: repeat(3, 1fr);
    grid-auto-flow: column;
    grid-auto-columns: 42vw;
    gap: 15px;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 0 15px;
  }

  .ai-collection-grid-track-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-collection-grid-card-{{ ai_gen_id }} {
  position: relative;
  border-radius: 24px;
  overflow: hidden;
  scroll-snap-align: start;
  transition: transform 0.5s ease-out;
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.08);
  transform: scale(0.9);
  aspect-ratio: 16 / 9;
   }


  .ai-collection-grid-card-{{ ai_gen_id }}.ai-in-view-{{ ai_gen_id }} {
    transform: scale(1);
  }

  .ai-collection-grid-link-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    height: 100%;
    text-decoration: none;
  }

  .ai-collection-grid-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-collection-grid-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-collection-grid-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
  }
{% endstyle %}

<collection-grid-{{ ai_gen_id }} class="ai-collection-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-collection-grid-track-{{ ai_gen_id }}">
    {% for i in (1..9) %}
      {% liquid
        assign collection_key = 'collection_' | append: i
        assign collection = block.settings[collection_key]
      %}
      <div class="ai-collection-grid-card-{{ ai_gen_id }}" data-card-index="{{ i }}">
        {% if collection != blank %}
          <a href="{{ collection.url }}" class="ai-collection-grid-link-{{ ai_gen_id }}">
            {% if collection.featured_image %}
              <img
                src="{{ collection.featured_image | image_url: width: 800 }}"
                alt="{{ collection.featured_image.alt | escape }}"
                loading="lazy"
                width="800"
                height="800"
                class="ai-collection-grid-image-{{ ai_gen_id }}"
              >
            {% else %}
              <div class="ai-collection-grid-placeholder-{{ ai_gen_id }}">
                {{ 'collection-1' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </a>
        {% else %}
          <div class="ai-collection-grid-placeholder-{{ ai_gen_id }}">
            {{ 'collection-1' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</collection-grid-{{ ai_gen_id }}>

<script>
  (function() {
    class CollectionGrid{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.track = null;
        this.cards = [];
        this.observer = null;
      }

      connectedCallback() {
        this.track = this.querySelector('.ai-collection-grid-track-{{ ai_gen_id }}');
        this.cards = Array.from(this.querySelectorAll('.ai-collection-grid-card-{{ ai_gen_id }}'));
        this.setupIntersectionObserver();
      }

      setupIntersectionObserver() {
        const options = {
          root: this.track,
          threshold: 0.5,
          rootMargin: '0px'
        };

        this.observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('ai-in-view-{{ ai_gen_id }}');
            } else {
              entry.target.classList.remove('ai-in-view-{{ ai_gen_id }}');
            }
          });
        }, options);

        this.cards.forEach((card) => {
          this.observer.observe(card);
        });
      }

      disconnectedCallback() {
        if (this.observer) {
          this.observer.disconnect();
        }
      }
    }

    customElements.define('collection-grid-{{ ai_gen_id }}', CollectionGrid{{ ai_gen_id }});
  })();
</script>

