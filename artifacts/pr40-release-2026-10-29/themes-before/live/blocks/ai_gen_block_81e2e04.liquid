          <polyline points="1 1, 6 6, 11 1"></polyline>
        </svg>
      </button>
    </div>
  {% endif %}
</vertical-timeline-accordion-{{ bid }}>

<script>
(function() {
  class VerticalTimelineAccordion{{ bid }} extends HTMLElement {
    constructor() {
      super();
      this.entries = Array.from(this.querySelectorAll('.tl-entry-{{ bid }}'));
      this.toggleBtn = this.querySelector('.tl-toggle-btn-{{ bid }}');
      this.toggleText = this.querySelector('.tl-toggle-text-{{ bid }}');
      this.isExpanded = false;
      this.observer = null;
    }

    connectedCallback() {
      this.setupIntersectionObserver();
      if (this.toggleBtn) {
        this.toggleBtn.addEventListener('click', () => this.handleToggle());
      }
      this.observeVisibleEntries();
    }

    setupIntersectionObserver() {
      const options = {
        root: null,
        rootMargin: '0px',
        threshold: 0.2
      };

      this.observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const element = entry.target;
            element.classList.add('tl-visible-{{ bid }}');
            
            const dot = element.querySelector('.tl-dot-{{ bid }}');
            if (dot) {
              dot.classList.add('tl-animate-{{ bid }}');
            }
            
            this.observer.unobserve(element);
          }
        });
      }, options);
    }

    observeVisibleEntries() {
      this.entries.forEach(entry => {
        if (!entry.classList.contains('tl-hidden-{{ bid }}')) {
          this.observer.observe(entry);
        }
      });
    }

    handleToggle() {
      this.isExpanded = !this.isExpanded;
      this.toggleBtn.classList.toggle('tl-expanded-{{ bid }}', this.isExpanded);
      this.toggleBtn.setAttribute('aria-expanded', this.isExpanded);

      if (this.isExpanded) {
        this.toggleText.textContent = 'Ver menos';
        this.expandEntries();
      } else {
        this.toggleText.textContent = 'Ver más';
        this.collapseEntries();
      }
    }

    expandEntries() {
      this.entries.forEach((entry, index) => {
        if (index > 0) {
          setTimeout(() => {
            entry.classList.remove('tl-hidden-{{ bid }}');
            entry.style.opacity = '0';
            entry.style.transform = 'translateY(20px)';
            
            requestAnimationFrame(() => {
              this.observer.observe(entry);
            });
          }, index * 80);
        }
      });
    }

    collapseEntries() {
      this.entries.forEach((entry, index) => {
        if (index > 0) {
          entry.classList.add('tl-hidden-{{ bid }}');
          entry.classList.remove('tl-visible-{{ bid }}');
          entry.style.opacity = '0';
          entry.style.transform = 'translateY(20px)';
          
          const dot = entry.querySelector('.tl-dot-{{ bid }}');
          if (dot) {
            dot.classList.remove('tl-animate-{{ bid }}');
          }
        }
      });

      const firstEntry = this.entries[0];
      if (firstEntry) {
        firstEntry.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    }

    disconnectedCallback() {
      if (this.observer) {
        this.observer.disconnect();
      }
      if (this.toggleBtn) {
        this.toggleBtn.removeEventListener('click', this.handleToggle);
      }
    }
  }

  customElements.define('vertical-timeline-accordion-{{ bid }}', VerticalTimelineAccordion{{ bid }});
})();
</script>

