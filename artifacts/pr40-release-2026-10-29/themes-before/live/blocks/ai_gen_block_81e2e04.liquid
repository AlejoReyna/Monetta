          {% if block.settings.entry_1_date != blank %}
            <div class="tl-date-{{ bid }}">{{ block.settings.entry_1_date }}</div>
          {% endif %}
          <h3 class="tl-title-{{ bid }}">{{ block.settings.entry_1_title }}</h3>
          {% if block.settings.entry_1_description != blank %}
            <p class="tl-description-{{ bid }}">{{ block.settings.entry_1_description }}</p>
          {% endif %}
        </div>
      </div>
    {% endif %}

    {% if block.settings.entry_2_title != blank %}
