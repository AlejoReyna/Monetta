{% doc %}
  @prompt
    Shopify Liquid block. Image carousel, 3 cards, mobile-first.
    
    STRUCTURE: One custom element wrapping one scroll div wrapping three card divs.
    
    MANDATORY CSS — do not deviate:
    
    custom-element-tag {
      display: block;
      width: 100%;
      overflow: hidden;
    }
    
    .wrapper {
      display: block;
      width: 100%;
      overflow: hidden;
      padding: 24px 20px;
      box-sizing: border-box;
    }
    
    .scroll-track {
      display: flex;
      gap: 20px;
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      padding: 12px 0;
    }
    
    .card {
      flex: 0 0 80vw;
      max-width: 300px;
      aspect-ratio: 3/4;
      border-radius: 24px;
      overflow: hidden;
      scroll-snap-align: center;
      box-shadow: 0 8px 32px rgba(0,0,0,0.12);
      transition: transform 0.4s cubic-bezier(0.23,1,0.32,1);
    }
    
    .card:hover { transform: translateY(-8px) scale(1.03); }
    
    .card img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    SETTINGS: image_1, image_2, image_3 (image pickers). link_1, link_2, link_3 (URL pickers).
    
    NEVER USE: overflow: visible, width: 100vw, negative margins, force-full-width, position: absolute with large offsets, justify-content: center on scroll track.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  image-carousel-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    overflow: hidden;
  }

  .ai-carousel-wrapper-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    overflow: hidden;
    padding: 24px 20px;
    box-sizing: border-box;
  }

  .ai-carousel-scroll-track-{{ ai_gen_id }} {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding: 12px 0;
  }

  .ai-carousel-scroll-track-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-carousel-card-{{ ai_gen_id }} {
    flex: 0 0 80vw;
    max-width: 300px;
    aspect-ratio: 3/4;
    border-radius: 24px;
    overflow: hidden;
    scroll-snap-align: center;
    box-shadow: 0 8px 32px rgba(0,0,0,0.12);
    transition: transform 0.4s cubic-bezier(0.23,1,0.32,1);
  }

  .ai-carousel-card-{{ ai_gen_id }}:hover {
    transform: translateY(-8px) scale(1.03);
  }

  .ai-carousel-card-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-carousel-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-carousel-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
{% endstyle %}

<image-carousel-{{ ai_gen_id }} {{ block.shopify_attributes }}>
  <div class="ai-carousel-wrapper-{{ ai_gen_id }}">
    <div class="ai-carousel-scroll-track-{{ ai_gen_id }}">
      {% for i in (1..3) %}
        {% assign image_key = 'image_' | append: i %}
        {% assign link_key = 'link_' | append: i %}
        {% assign image = block.settings[image_key] %}
        {% assign link = block.settings[link_key] %}

        {% if link != blank %}
          <a href="{{ link }}" class="ai-carousel-card-{{ ai_gen_id }}">
            {% if image %}
              <img
                src="{{ image | image_url: width: 600 }}"
                alt="{{ image.alt | escape }}"
                loading="lazy"
                width="{{ image.width }}"
                height="{{ image.height }}"
              >
            {% else %}
              <div class="ai-carousel-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </a>
        {% else %}
          <div class="ai-carousel-card-{{ ai_gen_id }}">
            {% if image %}
              <img
                src="{{ image | image_url: width: 600 }}"
                alt="{{ image.alt | escape }}"
                loading="lazy"
                width="{{ image.width }}"
                height="{{ image.height }}"
              >
            {% else %}
              <div class="ai-carousel-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</image-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class ImageCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.scrollTrack = this.querySelector('.ai-carousel-scroll-track-{{ ai_gen_id }}');
      }
    }

    customElements.define('image-carousel-{{ ai_gen_id }}', ImageCarousel{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Image carousel",
  "settings": [
    {
      "type": "header",
      "content": "Card 1"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image"
    },
    {
      "type": "url",
      "id": "link_1",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Card 2"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image"
    },
    {
      "type": "url",
      "id": "link_2",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Card 3"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Image"
    },
    {
      "type": "url",
      "id": "link_3",
      "label": "Link"
    }
  ],
  "presets": [
    {
      "name": "Image carousel"
    }
  ]
}
{% endschema %}
