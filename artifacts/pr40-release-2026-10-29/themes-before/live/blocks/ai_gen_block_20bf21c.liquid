{% doc %}
  @prompt
    Task: Create a Perfectly Centered Mobile Collection Carousel.
    
    1. Rigid Container & Vertical Centering (The Cutoff Fix):
    
    Perfect Vertical Alignment: Set a safe section height. You MUST perfectly center the carousel track vertically within the main section so the bottom of the cards is NEVER cut off. Ensure 60px of padding remains at the top and bottom.
    
    Main Frame: Force the section to a maximum width of 100vw. Apply strict clipping (overflow: hidden) to prevent horizontal scrolling on the page body.
    
    Mobile Behavior: Disable "Stack on mobile". Maintain the side-by-side horizontal layout strictly on all mobile devices.
    
    2. Optimized Mobile Sizing:
    
    Card Width: Set each card to exactly 80% of the screen width.
    
    Asymmetric Depth: Align the active card with a 5% left margin, leaving a 15% peek of the next card on the right to invite swiping.
    
    3. High-End Aesthetic & Proportions:
    
    Card Geometry: 36px border-radius, pure white cards, and a soft, high-diffusion shadow.
    
    Internal Layout: Utilize the maximum possible margins within the card to allocate exactly 40% of the layout space to the image, and the other 60% to texts and buttons.
    
    Image Frame: Add a subtle rounded frame around the image within that top 40% area. This ensures the product image scales optimally without breaking the visual balance.
    
    4. Premium Pop-Up & Fluidity:
    
    Fast Transitions: The snapping between cards must be instantaneous and snappy.
    
    Fluid Pop-Up: Use a smooth scaling effect where the active card is 1.0 and the side cards are 0.9. The transition must be ultra-fluid (use a 0.5s soft curve).
    
    5. Polish:
    
    Use elegant Serif typography for "BOLSAS, CARTERAS, RELOJES". Ensure all texts and buttons are completely centered within their 60% area.
    
    Hide all scrollbars for a clean, app-like experience.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-mobile-carousel-{{ ai_gen_id }} {
    display: block;
    width: 100vw;
    max-width: 100vw;
    overflow: hidden;
    position: relative;
    padding: 60px 0;
  }

  .ai-mobile-carousel-track-wrapper-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
  }

  .ai-mobile-carousel-track-{{ ai_gen_id }} {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 0 5%;
  }

  .ai-mobile-carousel-track-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-mobile-carousel-card-{{ ai_gen_id }} {
    flex: 0 0 80%;
    scroll-snap-align: start;
    background: #ffffff;
    border-radius: 36px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.08);
    transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    transform: scale(0.9);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .ai-mobile-carousel-card-{{ ai_gen_id }}.active {
    transform: scale(1);
  }

  .ai-mobile-carousel-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    height: 40%;
    padding: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-mobile-carousel-image-frame-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    border-radius: 24px;
    overflow: hidden;
    background-color: #f5f5f5;
  }

  .ai-mobile-carousel-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-mobile-carousel-content-{{ ai_gen_id }} {
    height: 60%;
    padding: 30px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 20px;
  }

  .ai-mobile-carousel-title-{{ ai_gen_id }} {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 28px;
    font-weight: 400;
    letter-spacing: 0.5px;
    margin: 0;
    color: #000000;
  }

  .ai-mobile-carousel-description-{{ ai_gen_id }} {
    font-size: 14px;
    line-height: 1.6;
    color: #666666;
    margin: 0;
  }

  .ai-mobile-carousel-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 14px 32px;
    background-color: #000000;
    color: #ffffff;
    text-decoration: none;
    border-radius: 0;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 1px;
    text-transform: uppercase;
    transition: background-color 0.3s ease;
  }

  .ai-mobile-carousel-button-{{ ai_gen_id }}:hover {
    background-color: #383838;
  }

  .ai-mobile-carousel-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-mobile-carousel-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  @media screen and (min-width: 750px) {
    .ai-mobile-carousel-{{ ai_gen_id }} {
      width: {{ block.settings.desktop_width_percent }}%;
      max-width: 100%;
      margin: 0 auto;
    }
  }
{% endstyle %}

<mobile-carousel-{{ ai_gen_id }}
  class="ai-mobile-carousel-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-mobile-carousel-track-wrapper-{{ ai_gen_id }}">
    <div class="ai-mobile-carousel-track-{{ ai_gen_id }}" data-carousel-track>
      {% if block.settings.collection != blank %}
        {% for product in block.settings.collection.products limit: block.settings.products_to_show %}
          <div class="ai-mobile-carousel-card-{{ ai_gen_id }}" data-carousel-card>
            <div class="ai-mobile-carousel-image-wrapper-{{ ai_gen_id }}">
              <div class="ai-mobile-carousel-image-frame-{{ ai_gen_id }}">
                {% if product.featured_image %}
                  <img
                    src="{{ product.featured_image | image_url: width: 800 }}"
                    alt="{{ product.featured_image.alt | escape }}"
                    class="ai-mobile-carousel-image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="800"
                    height="800"
                  >
                {% else %}
                  <div class="ai-mobile-carousel-placeholder-{{ ai_gen_id }}">
                    {{ 'product-1' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              </div>
            </div>
            <div class="ai-mobile-carousel-content-{{ ai_gen_id }}">
              <h3 class="ai-mobile-carousel-title-{{ ai_gen_id }}">{{ product.title }}</h3>
              {% if block.settings.show_description and product.description != blank %}
                <p class="ai-mobile-carousel-description-{{ ai_gen_id }}">
                  {{ product.description | strip_html | truncate: 100 }}
                </p>
              {% endif %}
              <a
                href="{{ product.url }}"
                class="ai-mobile-carousel-button-{{ ai_gen_id }}"
              >
                {{ block.settings.button_text }}
              </a>
            </div>
          </div>
        {% endfor %}
      {% else %}
        {% for i in (1..3) %}
          <div class="ai-mobile-carousel-card-{{ ai_gen_id }}" data-carousel-card>
            <div class="ai-mobile-carousel-image-wrapper-{{ ai_gen_id }}">
              <div class="ai-mobile-carousel-image-frame-{{ ai_gen_id }}">
                <div class="ai-mobile-carousel-placeholder-{{ ai_gen_id }}">
                  {{ 'product-1' | placeholder_svg_tag }}
                </div>
              </div>
            </div>
            <div class="ai-mobile-carousel-content-{{ ai_gen_id }}">
              <h3 class="ai-mobile-carousel-title-{{ ai_gen_id }}">Producto {{ i }}</h3>
              <p class="ai-mobile-carousel-description-{{ ai_gen_id }}">
                Selecciona una colección para mostrar tus productos
              </p>
              <a
                href="#"
                class="ai-mobile-carousel-button-{{ ai_gen_id }}"
              >
                {{ block.settings.button_text }}
              </a>
            </div>
          </div>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</mobile-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class MobileCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.track = null;
        this.cards = [];
        this.observer = null;
      }

      connectedCallback() {
        this.track = this.querySelector('[data-carousel-track]');
        this.cards = Array.from(this.querySelectorAll('[data-carousel-card]'));
        
        if (!this.track || this.cards.length === 0) return;

        this.setupIntersectionObserver();
        this.setupScrollSnap();
      }

      setupIntersectionObserver() {
        const options = {
          root: this.track,
          threshold: 0.6
        };

        this.observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              this.cards.forEach((card) => card.classList.remove('active'));
              entry.target.classList.add('active');
            }
          });
        }, options);

        this.cards.forEach((card) => {
          this.observer.observe(card);
        });
      }

      setupScrollSnap() {
        if (this.cards.length > 0) {
          this.cards[0].classList.add('active');
        }
      }

      disconnectedCallback() {
        if (this.observer) {
          this.observer.disconnect();
        }
      }
    }

    customElements.define('mobile-carousel-{{ ai_gen_id }}', MobileCarousel{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Carrusel móvil",
  "settings": [
    {
      "type": "header",
      "content": "Colección"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Colección"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Productos a mostrar",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "header",
      "content": "Contenido"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Mostrar descripción",
      "default": true
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Texto del botón",
      "default": "Ver producto"
    },
    {
      "type": "header",
      "content": "Diseño"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Ancho en escritorio",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Carrusel móvil"
    }
  ]
}
{% endschema %}
