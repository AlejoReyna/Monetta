{% doc %}
  @prompt
    Shopify liquid block. Horizontally scrollable 3-row × 3-column collection image grid. 9 collections total.
{% enddoc %}

{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  collection-grid-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    max-width: 100%;
    overflow: visible;
  }

  .ai-collection-grid-wrapper-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    max-width: 100%;
    overflow: visible;
    background: transparent;
    padding: 0;
    margin: 0;
    box-sizing: border-box;
    position: relative;
  }

  .ai-collection-grid-scroll-clip-{{ ai_gen_id }} {
    width: 100%;
    overflow-x: hidden;
    overflow-y: visible;
    background: transparent;
  }

  .ai-collection-grid-container-{{ ai_gen_id }} {
    display: grid;
    grid-template-rows: repeat(3, auto);
    grid-auto-flow: column;
    gap: {{ block.settings.card_gap }}px;
    overflow-x: auto;
    overflow-y: visible;
    scroll-snap-type: x mandatory;
    scroll-snap-stop: always;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding: 20px 16px;
    margin: 0;
    background: transparent;
    box-sizing: border-box;
  }

  @media (min-width: 750px) {
    .ai-collection-grid-container-{{ ai_gen_id }} {
      padding: 20px 50px;
    }
  }

  .ai-collection-grid-container-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-collection-card-{{ ai_gen_id }} {
    position: relative;
    aspect-ratio: 2.3 / 1;
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
    background: transparent;
    box-shadow: 0 4px 12px rgba(0, 0, 0, {{ block.settings.shadow_opacity | divided_by: 100.0 }}),
                0 12px 32px rgba(0, 0, 0, {{ block.settings.shadow_opacity | divided_by: 100.0 }});
    transition: transform 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                box-shadow 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    scroll-snap-align: start;
    display: block;
    flex-shrink: 0;
  }

  @media (min-width: 750px) {
    .ai-collection-card-{{ ai_gen_id }} {
      width: {{ block.settings.card_width_desktop }}px;
    }
  }

  @media (max-width: 749px) {
    .ai-collection-card-{{ ai_gen_id }} {
      width: {{ block.settings.card_width_mobile }}px;
    }
  }

  .ai-collection-card-{{ ai_gen_id }}:hover,
  .ai-collection-card-{{ ai_gen_id }}:active {
    transform: translateY(-5px) scale(1.02);
    box-shadow: 0 12px 36px rgba(0, 0, 0, {{ block.settings.shadow_opacity | times: 1.75 | divided_by: 100.0 }});
  }

  .ai-collection-card-link-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }

  .ai-collection-card-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-collection-card-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background: transparent;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-collection-card-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 60%;
    opacity: 0.3;
  }
{% endstyle %}

<collection-grid-{{ ai_gen_id }}
  class="ai-collection-grid-wrapper-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-collection-grid-scroll-clip-{{ ai_gen_id }}">
    <div class="ai-collection-grid-container-{{ ai_gen_id }}" id="ai-scroll-container-{{ ai_gen_id }}">
      {% for i in (1..9) %}
        {% liquid
          assign collection_key = 'collection_' | append: i
          assign collection = block.settings[collection_key]
        %}

        <div class="ai-collection-card-{{ ai_gen_id }}">
          {% if collection != blank %}
            <a href="{{ collection.url }}" class="ai-collection-card-link-{{ ai_gen_id }}">
              {% if collection.featured_image %}
                <img
                  src="{{ collection.featured_image | image_url: width: 600 }}"
                  alt="{{ collection.featured_image.alt | escape }}"
                  loading="lazy"
                  width="600"
                  height="{{ 600 | divided_by: 2.3 | round }}"
                  class="ai-collection-card-image-{{ ai_gen_id }}"
                >
              {% else %}
                <div class="ai-collection-card-placeholder-{{ ai_gen_id }}">
                  {{ 'collection-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </a>
          {% else %}
            <div class="ai-collection-card-placeholder-{{ ai_gen_id }}">
              {{ 'collection-1' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</collection-grid-{{ ai_gen_id }}>

<script>
  (function() {
    class CollectionGrid{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.scrollContainer = this.querySelector('.ai-collection-grid-container-{{ ai_gen_id }}');
      }

      connectedCallback() {
        this.resetScroll();
        document.addEventListener('DOMContentLoaded', () => this.resetScroll());
        window.addEventListener('load', () => this.resetScroll());
        setTimeout(() => this.resetScroll(), 100);
        setTimeout(() => this.resetScroll(), 500);
      }

      resetScroll() {
        if (this.scrollContainer) {
          this.scrollContainer.scrollLeft = 0;
        }
      }
    }

    if (!customElements.get('collection-grid-{{ ai_gen_id }}')) {
      customElements.define('collection-grid-{{ ai_gen_id }}', CollectionGrid{{ ai_gen_id }});
    }
  })();
</script>

