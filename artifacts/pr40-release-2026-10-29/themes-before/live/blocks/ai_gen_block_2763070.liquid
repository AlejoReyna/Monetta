{% doc %}
  @prompt
    Shopify Liquid block. Horizontally scrollable image carousel with 3 full-bleed image cards. No text, no overlay, just the image filling each card completely.
    
    MOBILE OVERFLOW — CRITICAL: Never cause horizontal page overflow or allow the page itself to scroll horizontally instead of the carousel. Apply all of the following without exception: custom element and all wrapper divs must have display: block, width: 100%, max-width: 100%, overflow: hidden, margin: 0, box-sizing: border-box. The ONLY element allowed to have overflow-x: auto is the inner scroll track. Never use overflow: visible on any wrapper. Never use force-full-width, negative margins, width: 100vw, or position: absolute/fixed with large offsets. Define custom element in CSS: carousel-[id] { display: block; width: 100%; max-width: 100%; overflow: hidden; }. Use if (!customElements.get(...)) guard before registering.
    
    CARDS: flex: 0 0 78vw, max-width: 300px, aspect-ratio: 3/4, border-radius: 24px, overflow: hidden, scroll-snap-align: center, will-change: transform. Image: object-fit: cover, width: 100%, height: 100%, display: block, pointer-events: none. Zero padding inside card. No background color. Shadow: 0 2px 4px rgba(0,0,0,0.04), 0 8px 16px rgba(0,0,0,0.08), 0 24px 48px rgba(0,0,0,0.12), 0 48px 80px rgba(0,0,0,0.08).
    
    HOVER/TOUCH POP: transform: translateY(-16px) scale(1.05). Shadow: 0 4px 8px rgba(0,0,0,0.06), 0 16px 32px rgba(0,0,0,0.14), 0 40px 80px rgba(0,0,0,0.20), 0 80px 120px rgba(0,0,0,0.12). Transition: 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) on transform and box-shadow — spring overshoot effect.
    
    SCROLL TRACK: display: flex, flex-direction: row, gap: 24px, overflow-x: auto, overflow-y: hidden, scroll-snap-type: x mandatory, scroll-snap-stop: always, -webkit-overflow-scrolling: touch, scrollbar-width: none, scroll-behavior: smooth, padding: 40px 24px, margin: 0. Each card: scroll-snap-align: center. Never use justify-content: center or margin: auto on the scroll track.
    
    SCROLL RESET: Force scrollLeft = 0 on DOMContentLoaded, window load, setTimeout 100ms and 500ms.
    
    SETTINGS: 3 image pickers (image_1, image_2, image_3), 3 link pickers (link_1, link_2, link_3), border-radius (default 24px), shadow opacity (default 12%).
    
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  carousel-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    max-width: 100%;
    overflow: hidden;
    margin: 0;
    box-sizing: border-box;
  }

  .ai-carousel-wrapper-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    max-width: 100%;
    overflow: hidden;
    margin: 0;
    box-sizing: border-box;
  }

  .ai-carousel-track-{{ ai_gen_id }} {
    display: flex;
    flex-direction: row;
    gap: 24px;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-snap-stop: always;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    scroll-behavior: smooth;
    padding: 105px 64px;
    margin: 0;
    box-sizing: border-box;
  }

  .ai-carousel-track-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-carousel-card-{{ ai_gen_id }} {
    flex: 0 0 78vw;
    max-width: 300px;
    aspect-ratio: 3/4;
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
    scroll-snap-align: center;
    will-change: transform;
    transition: transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
    box-shadow: 
      0 2px 4px rgba(0, 0, 0, {{ block.settings.shadow_opacity | times: 0.04 | divided_by: 100.0 }}),
      0 8px 16px rgba(0, 0, 0, {{ block.settings.shadow_opacity | times: 0.08 | divided_by: 100.0 }}),
      0 24px 48px rgba(0, 0, 0, {{ block.settings.shadow_opacity | times: 0.12 | divided_by: 100.0 }}),
      0 48px 80px rgba(0, 0, 0, {{ block.settings.shadow_opacity | times: 0.08 | divided_by: 100.0 }});
  }

  .ai-carousel-card-{{ ai_gen_id }}:hover,
  .ai-carousel-card-{{ ai_gen_id }}:active {
    transform: translateY(-16px) scale(1.05);
    box-shadow: 
      0 4px 8px rgba(0, 0, 0, {{ block.settings.shadow_opacity | times: 0.06 | divided_by: 100.0 }}),
      0 16px 32px rgba(0, 0, 0, {{ block.settings.shadow_opacity | times: 0.14 | divided_by: 100.0 }}),
      0 40px 80px rgba(0, 0, 0, {{ block.settings.shadow_opacity | times: 0.20 | divided_by: 100.0 }}),
      0 80px 120px rgba(0, 0, 0, {{ block.settings.shadow_opacity | times: 0.12 | divided_by: 100.0 }});
  }

  .ai-carousel-card-link-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    height: 100%;
    text-decoration: none;
  }

  .ai-carousel-card-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    pointer-events: none;
  }

  .ai-carousel-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: transparent;
  }

  .ai-carousel-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
{% endstyle %}

<carousel-{{ ai_gen_id }} {{ block.shopify_attributes }}>
  <div class="ai-carousel-wrapper-{{ ai_gen_id }}">
    <div class="ai-carousel-track-{{ ai_gen_id }}" data-carousel-track>
      {% for i in (1..3) %}
        {% liquid
          assign image_key = 'image_' | append: i
          assign link_key = 'link_' | append: i
          assign image = block.settings[image_key]
          assign link = block.settings[link_key]
        %}
        
        <div class="ai-carousel-card-{{ ai_gen_id }}">
          {% if link != blank %}
            <a href="{{ link }}" class="ai-carousel-card-link-{{ ai_gen_id }}">
              {% if image != blank %}
                <img
                  src="{{ image | image_url: width: 600 }}"
                  alt="{{ image.alt | escape }}"
                  width="{{ image.width }}"
                  height="{{ image.height }}"
                  loading="lazy"
                  class="ai-carousel-card-image-{{ ai_gen_id }}"
                >
              {% else %}
                <div class="ai-carousel-placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </a>
          {% else %}
            {% if image != blank %}
              <img
                src="{{ image | image_url: width: 600 }}"
                alt="{{ image.alt | escape }}"
                width="{{ image.width }}"
                height="{{ image.height }}"
                loading="lazy"
                class="ai-carousel-card-image-{{ ai_gen_id }}"
              >
            {% else %}
              <div class="ai-carousel-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</carousel-{{ ai_gen_id }}>

<script>
  (function() {
    if (!customElements.get('carousel-{{ ai_gen_id }}')) {
      class Carousel{{ ai_gen_id }} extends HTMLElement {
        constructor() {
          super();
          this.track = null;
        }

        connectedCallback() {
          this.track = this.querySelector('[data-carousel-track]');
          this.resetScroll();
          
          window.addEventListener('DOMContentLoaded', () => this.resetScroll());
          window.addEventListener('load', () => this.resetScroll());
          setTimeout(() => this.resetScroll(), 100);
          setTimeout(() => this.resetScroll(), 500);
        }

        resetScroll() {
          if (this.track) {
            this.track.scrollLeft = 0;
          }
        }
      }

      customElements.define('carousel-{{ ai_gen_id }}', Carousel{{ ai_gen_id }});
    }
  })();
</script>

{% schema %}
{
  "name": "Image carousel",
  "settings": [
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image 1"
    },
    {
      "type": "url",
      "id": "link_1",
      "label": "Link 1"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image 2"
    },
    {
      "type": "url",
      "id": "link_2",
      "label": "Link 2"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Image 3"
    },
    {
      "type": "url",
      "id": "link_3",
      "label": "Link 3"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "shadow_opacity",
      "label": "Shadow opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Image carousel"
    }
  ]
}
{% endschema %}
