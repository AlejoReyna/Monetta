{% doc %}
  @prompt
    Shopify Liquid block. Horizontally scrollable 3-row × 3-column collection image grid. 9 collections total.
    
    MOBILE OVERFLOW — CRITICAL: The block must never cause horizontal page overflow. Apply all of the following: custom element and wrapper must have display: block, width: 100%, max-width: 100%, overflow: hidden, margin: 0, box-sizing: border-box. Never use force-full-width or any class with negative margins or width: 100vw. Placeholder elements must use width: 100% only. Define custom element CSS as collection-grid-[id] { display: block; width: 100%; max-width: 100%; overflow: hidden; }. Use if (!customElements.get(...)) guard before registering.
    
    CARDS: aspect-ratio: 2.3/1, border-radius: 20px, overflow: hidden. Image fills card completely: object-fit: cover, width: 100%, height: 100%. No background, no padding inside card. Shadow: 0 4px 12px rgba(0,0,0,0.08), 0 12px 32px rgba(0,0,0,0.08).
    
    LAYOUT: Wrapper padding: 20px 16px mobile, 20px 50px desktop. Grid gap: 28px. Scroll container: display: grid, grid-template-rows: repeat(3, auto), grid-auto-flow: column, overflow-x: auto, scroll-snap-type: x mandatory, scrollbar-width: none, padding: 20px 0, margin: 0. Never use justify-content: center or margin: auto on the grid.
    
    SCROLL RESET TO LEFT: Force scrollLeft = 0 on DOMContentLoaded, window load, setTimeout 100ms and 500ms.
    
    HOVER: transform: translateY(-5px) scale(1.02), box-shadow: 0 12px 36px rgba(0,0,0,0.14), transition 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94).
    
    SETTINGS: card width desktop (default 200px), card width mobile (default 150px), gap (default 28px), border-radius (default 20px), shadow opacity (default 8%).
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  collection-grid-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    max-width: 100%;
    overflow: hidden;
    margin: 0;
    box-sizing: border-box;
  }

  .ai-collection-grid-wrapper-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    max-width: 100%;
    overflow: hidden;
    margin: 0;
    padding: 20px 16px;
    box-sizing: border-box;
  }

  .ai-collection-grid-scroll-{{ ai_gen_id }} {
    display: grid;
    grid-template-rows: repeat(3, auto);
    grid-auto-flow: column;
    gap: {{ block.settings.gap }}px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding: 20px 0;
    margin: 0;
    box-sizing: border-box;
  }

  .ai-collection-grid-scroll-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-collection-grid-card-{{ ai_gen_id }} {
    width: {{ block.settings.card_width_mobile }}px;
    aspect-ratio: 2.3 / 1;
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
    scroll-snap-align: start;
    position: relative;
    box-shadow: 0 4px 12px rgba(0, 0, 0, {{ block.settings.shadow_opacity | divided_by: 100.0 }}),
                0 12px 32px rgba(0, 0, 0, {{ block.settings.shadow_opacity | divided_by: 100.0 }});
    transition: transform 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                box-shadow 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    display: block;
  }

  .ai-collection-grid-card-{{ ai_gen_id }}:hover {
    transform: translateY(-5px) scale(1.02);
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.14);
  }

  .ai-collection-grid-card-link-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    height: 100%;
    position: relative;
    text-decoration: none;
  }

  .ai-collection-grid-card-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-collection-grid-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
  }

  .ai-collection-grid-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  @media screen and (min-width: 750px) {
    .ai-collection-grid-wrapper-{{ ai_gen_id }} {
      padding: 20px 50px;
    }

    .ai-collection-grid-card-{{ ai_gen_id }} {
      width: {{ block.settings.card_width_desktop }}px;
    }
  }
{% endstyle %}

<collection-grid-{{ ai_gen_id }} {{ block.shopify_attributes }}>
  <div class="ai-collection-grid-wrapper-{{ ai_gen_id }}">
    <div class="ai-collection-grid-scroll-{{ ai_gen_id }}">
      {% for i in (1..9) %}
        {% liquid
          assign collection_key = 'collection_' | append: i
          assign collection = block.settings[collection_key]
        %}
        
        <div class="ai-collection-grid-card-{{ ai_gen_id }}">
          {% if collection != blank %}
            <a href="{{ collection.url }}" class="ai-collection-grid-card-link-{{ ai_gen_id }}">
              {% if collection.featured_image %}
                <img
                  src="{{ collection.featured_image | image_url: width: 600 }}"
                  alt="{{ collection.featured_image.alt | escape }}"
                  class="ai-collection-grid-card-image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="600"
                  height="{{ 600 | divided_by: 2.3 | round }}"
                >
              {% else %}
                <div class="ai-collection-grid-placeholder-{{ ai_gen_id }}">
                  {{ 'collection-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </a>
          {% else %}
            <div class="ai-collection-grid-placeholder-{{ ai_gen_id }}">
              {{ 'collection-1' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</collection-grid-{{ ai_gen_id }}>

<script>
  (function() {
    if (!customElements.get('collection-grid-{{ ai_gen_id }}')) {
      class CollectionGrid{{ ai_gen_id }} extends HTMLElement {
        constructor() {
          super();
        }

        connectedCallback() {
          this.scrollContainer = this.querySelector('.ai-collection-grid-scroll-{{ ai_gen_id }}');
          this.resetScroll();
          
          document.addEventListener('DOMContentLoaded', () => this.resetScroll());
          window.addEventListener('load', () => this.resetScroll());
          setTimeout(() => this.resetScroll(), 100);
          setTimeout(() => this.resetScroll(), 500);
        }

        resetScroll() {
          if (this.scrollContainer) {
            this.scrollContainer.scrollLeft = 0;
          }
        }
      }

      customElements.define('collection-grid-{{ ai_gen_id }}', CollectionGrid{{ ai_gen_id }});
    }
  })();
</script>

