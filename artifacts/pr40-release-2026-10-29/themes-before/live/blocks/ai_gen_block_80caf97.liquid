      "id": "track_padding_horizontal_mobile",
      "label": "Horizontal",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "Image Carousel"
    }
  ]
}
