{% doc %}
  @prompt
    genera un carrusel en donde estemos mostrando los productos mas nuevos, quiero que se muestren 2 productos minimo en el carrusel principal, pero que en total en el carrusel sean mas de 30 productos, todos los mas nuevois
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% assign all_products = collections.all.products %}
{% assign sorted_products = all_products | sort: 'created_at' | reverse %}

{% style %}
  .ai-new-products-carousel-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-new-products-carousel__header-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: {{ block.settings.heading_spacing }}px;
  }

  .ai-new-products-carousel__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0;
  }

  .ai-new-products-carousel__container-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    padding: 0 50px;
  }

  .ai-new-products-carousel__track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.product_gap }}px;
    transition: transform 0.5s ease;
    will-change: transform;
  }

  .ai-new-products-carousel__item-{{ ai_gen_id }} {
    flex: 0 0 calc((100% - {{ block.settings.product_gap }}px) / {{ block.settings.products_per_view }});
    min-width: 0;
  }

  .ai-new-products-carousel__product-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    height: 100%;
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    transition: transform 0.3s ease;
  }

  .ai-new-products-carousel__product-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
  }

  .ai-new-products-carousel__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 100%;
    overflow: hidden;
    background-color: #f5f5f5;
  }

  .ai-new-products-carousel__image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-new-products-carousel__placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
  }

  .ai-new-products-carousel__placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-new-products-carousel__info-{{ ai_gen_id }} {
    padding: {{ block.settings.card_padding }}px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .ai-new-products-carousel__product-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_title_size }}px;
    color: {{ block.settings.product_title_color }};
    margin: 0;
    line-height: 1.3;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .ai-new-products-carousel__price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_size }}px;
    color: {{ block.settings.price_color }};
    font-weight: 600;
  }

  .ai-new-products-carousel__button-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_color }};
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    transition: background-color 0.3s ease;
  }

  .ai-new-products-carousel__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
  }

  .ai-new-products-carousel__button-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-new-products-carousel__button--prev-{{ ai_gen_id }} {
    left: 0;
  }

  .ai-new-products-carousel__button--next-{{ ai_gen_id }} {
    right: 0;
  }

  .ai-new-products-carousel__dots-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 24px;
  }

  .ai-new-products-carousel__dot-{{ ai_gen_id }} {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    border: none;
    cursor: pointer;
    padding: 0;
    transition: background-color 0.3s ease;
  }

  .ai-new-products-carousel__dot-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.dot_active_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-new-products-carousel__item-{{ ai_gen_id }} {
      flex: 0 0 calc((100% - {{ block.settings.product_gap }}px) / {{ block.settings.products_per_view_mobile }});
    }

    .ai-new-products-carousel__container-{{ ai_gen_id }} {
      padding: 0 40px;
    }

    .ai-new-products-carousel__button-{{ ai_gen_id }} {
      width: 32px;
      height: 32px;
    }
  }
{% endstyle %}

<new-products-carousel-{{ ai_gen_id }}
  class="ai-new-products-carousel-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  {% if block.settings.heading != blank %}
    <div class="ai-new-products-carousel__header-{{ ai_gen_id }}">
      <h2 class="ai-new-products-carousel__title-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    </div>
  {% endif %}

  <div class="ai-new-products-carousel__container-{{ ai_gen_id }}">
    <button
      class="ai-new-products-carousel__button-{{ ai_gen_id }} ai-new-products-carousel__button--prev-{{ ai_gen_id }}"
      aria-label="Previous products"
      data-prev
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>

    <div class="ai-new-products-carousel__track-{{ ai_gen_id }}" data-track>
      {% for product in sorted_products limit: block.settings.max_products %}
        <div class="ai-new-products-carousel__item-{{ ai_gen_id }}">
          <a href="{{ product.url }}" class="ai-new-products-carousel__product-{{ ai_gen_id }}">
            <div class="ai-new-products-carousel__image-wrapper-{{ ai_gen_id }}">
              {% if product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 600 }}"
                  alt="{{ product.featured_image.alt | escape }}"
                  class="ai-new-products-carousel__image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="600"
                  height="600"
                >
              {% else %}
                <div class="ai-new-products-carousel__placeholder-{{ ai_gen_id }}">
                  {{ 'product-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>
            <div class="ai-new-products-carousel__info-{{ ai_gen_id }}">
              <h3 class="ai-new-products-carousel__product-title-{{ ai_gen_id }}">{{ product.title }}</h3>
              <div class="ai-new-products-carousel__price-{{ ai_gen_id }}">
                {{ product.price | money }}
              </div>
            </div>
          </a>
        </div>
      {% endfor %}
    </div>

    <button
      class="ai-new-products-carousel__button-{{ ai_gen_id }} ai-new-products-carousel__button--next-{{ ai_gen_id }}"
      aria-label="Next products"
      data-next
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </button>
  </div>

  {% if block.settings.show_dots %}
    <div class="ai-new-products-carousel__dots-{{ ai_gen_id }}" data-dots></div>
  {% endif %}
</new-products-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class NewProductsCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.productsPerView = {{ block.settings.products_per_view }};
        this.productsPerViewMobile = {{ block.settings.products_per_view_mobile }};
      }

      connectedCallback() {
        this.track = this.querySelector('[data-track]');
        this.prevButton = this.querySelector('[data-prev]');
        this.nextButton = this.querySelector('[data-next]');
        this.dotsContainer = this.querySelector('[data-dots]');
        this.items = this.querySelectorAll('.ai-new-products-carousel__item-{{ ai_gen_id }}');
        
        this.updateProductsPerView();
        this.setupEventListeners();
        this.createDots();
        this.updateCarousel();
      }

      updateProductsPerView() {
        if (window.innerWidth <= 749) {
          this.activeProductsPerView = this.productsPerViewMobile;
        } else {
          this.activeProductsPerView = this.productsPerView;
        }
        this.totalSlides = Math.ceil(this.items.length / this.activeProductsPerView);
      }

      setupEventListeners() {
        this.prevButton.addEventListener('click', () => this.prev());
        this.nextButton.addEventListener('click', () => this.next());
        
        window.addEventListener('resize', () => {
          this.updateProductsPerView();
          this.currentIndex = Math.min(this.currentIndex, this.totalSlides - 1);
          this.createDots();
          this.updateCarousel();
        });

        let startX = 0;
        let currentX = 0;
        let isDragging = false;

        this.track.addEventListener('touchstart', (e) => {
          startX = e.touches[0].clientX;
          isDragging = true;
        });

        this.track.addEventListener('touchmove', (e) => {
          if (!isDragging) return;
          currentX = e.touches[0].clientX;
        });

        this.track.addEventListener('touchend', () => {
          if (!isDragging) return;
          const diff = startX - currentX;
          if (Math.abs(diff) > 50) {
            if (diff > 0) {
              this.next();
            } else {
              this.prev();
            }
          }
          isDragging = false;
        });
      }

      createDots() {
        if (!this.dotsContainer) return;
        
        this.dotsContainer.innerHTML = '';
        for (let i = 0; i < this.totalSlides; i++) {
          const dot = document.createElement('button');
          dot.className = 'ai-new-products-carousel__dot-{{ ai_gen_id }}';
          dot.setAttribute('aria-label', `Go to slide ${i + 1}`);
          dot.addEventListener('click', () => this.goToSlide(i));
          this.dotsContainer.appendChild(dot);
        }
      }

      prev() {
        if (this.currentIndex > 0) {
          this.currentIndex--;
          this.updateCarousel();
        }
      }

      next() {
        if (this.currentIndex < this.totalSlides - 1) {
          this.currentIndex++;
          this.updateCarousel();
        }
      }

      goToSlide(index) {
        this.currentIndex = index;
        this.updateCarousel();
      }

      updateCarousel() {
        const itemWidth = this.items[0].offsetWidth;
        const gap = {{ block.settings.product_gap }};
        const offset = -(this.currentIndex * this.activeProductsPerView * (itemWidth + gap));
        
        this.track.style.transform = `translateX(${offset}px)`;

        this.prevButton.disabled = this.currentIndex === 0;
        this.nextButton.disabled = this.currentIndex === this.totalSlides - 1;

        if (this.dotsContainer) {
          const dots = this.dotsContainer.querySelectorAll('.ai-new-products-carousel__dot-{{ ai_gen_id }}');
          dots.forEach((dot, index) => {
            if (index === this.currentIndex) {
              dot.classList.add('active');
            } else {
              dot.classList.remove('active');
            }
          });
        }
      }
    }

    customElements.define('new-products-carousel-{{ ai_gen_id }}', NewProductsCarousel{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Nuevos productos carrusel",
  "settings": [
    {
      "type": "header",
      "content": "Contenido"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Título",
      "default": "Nuevos productos"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Alineación del título",
      "options": [
        {
          "value": "left",
          "label": "Izquierda"
        },
        {
          "value": "center",
          "label": "Centro"
        },
        {
          "value": "right",
          "label": "Derecha"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Máximo de productos",
      "min": 10,
      "max": 50,
      "step": 5,
      "default": 30
    },
    {
      "type": "header",
      "content": "Diseño del carrusel"
    },
    {
      "type": "range",
      "id": "products_per_view",
      "label": "Productos visibles (escritorio)",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "products_per_view_mobile",
      "label": "Productos visibles (móvil)",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "product_gap",
      "label": "Espacio entre productos",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Mostrar indicadores",
      "default": true
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Ancho en escritorio",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Espaciado vertical",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Estilo del título"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Tamaño del título",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "label": "Espacio debajo del título",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Color del título",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Estilo de tarjetas"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Fondo de tarjeta",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "label": "Radio de borde",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Espaciado interno",
      "min": 8,
      "max": 32,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "product_title_size",
      "label": "Tamaño del título del producto",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "color",
      "id": "product_title_color",
      "label": "Color del título del producto",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "price_size",
      "label": "Tamaño del precio",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color",
      "id": "price_color",
      "label": "Color del precio",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Botones de navegación"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Fondo del botón",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_hover_background",
      "label": "Fondo del botón (hover)",
      "default": "#383838"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Color del icono",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Indicadores"
    },
    {
      "type": "color",
      "id": "dot_color",
      "label": "Color del indicador",
      "default": "#cccccc"
    },
    {
      "type": "color",
      "id": "dot_active_color",
      "label": "Color del indicador activo",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "Nuevos productos carrusel"
    }
  ]
}
{% endschema %}
