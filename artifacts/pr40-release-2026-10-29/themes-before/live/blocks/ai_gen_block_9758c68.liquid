{% doc %}
  @prompt
    Shopify Liquid block. Image carousel, 3 cards, mobile-first. Full-bleed images only, no text, all backgrounds transparent.
    
    Never cause horizontal page overflow. Custom element and wrapper: display block, width 100%, max-width 100%, overflow hidden, margin 0, box-sizing border-box. Only the scroll track has overflow-x auto. Never use force-full-width or negative margins.
    
    Cards: flex 0 0 78vw, max-width 300px, aspect-ratio 3/4, border-radius 24px, overflow hidden, background transparent, scroll-snap-align center, will-change transform. Image: width 100%, height 100%, object-fit cover, display block. Shadow: 0 4px 8px rgba(0,0,0,0.10), 0 16px 32px rgba(0,0,0,0.12). Transition: 0.6s cubic-bezier(0.34, 1.56, 0.64, 1).
    
    When card is centered use Intersection Observer threshold 0.85 to apply: transform translateY(-14px) scale(1.04), stronger shadow. On hover: transform translateY(-18px) scale(1.06).
    
    Scroll track: display flex, gap 24px, overflow-x auto, scroll-snap-type x mandatory, -webkit-overflow-scrolling touch, scrollbar-width none, scroll-behavior smooth, padding 48px 24px.
    
    Force scrollLeft 0 on DOMContentLoaded, load, and two setTimeouts.
    
    Settings: image_1 image_2 image_3 as image pickers, link_1 link_2 link_3 as URL pickers, border-radius default 24, shadow-opacity default 10.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-image-carousel-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    max-width: 100%;
    overflow: hidden;
    margin: 0;
    box-sizing: border-box;
  }

  .ai-image-carousel-wrapper-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    max-width: 100%;
    overflow: hidden;
    margin: 0;
    box-sizing: border-box;
  }

  .ai-image-carousel-track-{{ ai_gen_id }} {
    display: flex;
    gap: 24px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    scroll-behavior: smooth;
    padding: 48px 24px;
    box-sizing: border-box;
  }

  .ai-image-carousel-track-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-image-carousel-card-{{ ai_gen_id }} {
    flex: 0 0 78vw;
    max-width: 300px;
    aspect-ratio: 3/4;
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
    background: transparent;
    scroll-snap-align: center;
    will-change: transform;
    box-shadow: 0 4px 8px rgba(0, 0, 0, {{ block.settings.shadow_opacity | divided_by: 100.0 }}), 0 16px 32px rgba(0, 0, 0, {{ block.settings.shadow_opacity | divided_by: 100.0 | times: 1.2 }});
    transition: transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
    position: relative;
  }

  .ai-image-carousel-card-{{ ai_gen_id }}.centered {
    transform: translateY(-14px) scale(1.04);
    box-shadow: 0 8px 16px rgba(0, 0, 0, {{ block.settings.shadow_opacity | divided_by: 100.0 | times: 1.5 }}), 0 24px 48px rgba(0, 0, 0, {{ block.settings.shadow_opacity | divided_by: 100.0 | times: 1.8 }});
  }

  .ai-image-carousel-card-{{ ai_gen_id }}:hover {
    transform: translateY(-18px) scale(1.06);
    box-shadow: 0 10px 20px rgba(0, 0, 0, {{ block.settings.shadow_opacity | divided_by: 100.0 | times: 1.8 }}), 0 28px 56px rgba(0, 0, 0, {{ block.settings.shadow_opacity | divided_by: 100.0 | times: 2.0 }});
  }

  .ai-image-carousel-link-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    height: 100%;
    text-decoration: none;
  }

  .ai-image-carousel-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-image-carousel-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-image-carousel-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
{% endstyle %}

<image-carousel-{{ ai_gen_id }} class="ai-image-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-image-carousel-wrapper-{{ ai_gen_id }}">
    <div class="ai-image-carousel-track-{{ ai_gen_id }}" data-carousel-track>
      {% for i in (1..3) %}
        {% liquid
          assign image_key = 'image_' | append: i
          assign link_key = 'link_' | append: i
          assign image = block.settings[image_key]
          assign link = block.settings[link_key]
        %}
        
        <div class="ai-image-carousel-card-{{ ai_gen_id }}" data-carousel-card>
          {% if link != blank %}
            <a href="{{ link }}" class="ai-image-carousel-link-{{ ai_gen_id }}">
              {% if image != blank %}
                <img
                  src="{{ image | image_url: width: 600 }}"
                  alt="{{ image.alt | escape }}"
                  loading="lazy"
                  width="{{ image.width }}"
                  height="{{ image.height }}"
                  class="ai-image-carousel-image-{{ ai_gen_id }}"
                >
              {% else %}
                <div class="ai-image-carousel-placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </a>
          {% else %}
            {% if image != blank %}
              <img
                src="{{ image | image_url: width: 600 }}"
                alt="{{ image.alt | escape }}"
                loading="lazy"
                width="{{ image.width }}"
                height="{{ image.height }}"
                class="ai-image-carousel-image-{{ ai_gen_id }}"
              >
            {% else %}
              <div class="ai-image-carousel-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</image-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class ImageCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.track = null;
        this.cards = [];
        this.observer = null;
      }

      connectedCallback() {
        this.track = this.querySelector('[data-carousel-track]');
        this.cards = Array.from(this.querySelectorAll('[data-carousel-card]'));
        
        this.forceScrollToStart();
        this.setupIntersectionObserver();
      }

      forceScrollToStart() {
        if (!this.track) return;
        
        this.track.scrollLeft = 0;
        
        window.addEventListener('DOMContentLoaded', () => {
          this.track.scrollLeft = 0;
        });
        
        window.addEventListener('load', () => {
          this.track.scrollLeft = 0;
        });
        
        setTimeout(() => {
          this.track.scrollLeft = 0;
        }, 100);
        
        setTimeout(() => {
          this.track.scrollLeft = 0;
        }, 300);
      }

      setupIntersectionObserver() {
        if (!this.track || this.cards.length === 0) return;

        const options = {
          root: this.track,
          threshold: 0.85
        };

        this.observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('centered');
            } else {
              entry.target.classList.remove('centered');
            }
          });
        }, options);

        this.cards.forEach((card) => {
          this.observer.observe(card);
        });
      }

      disconnectedCallback() {
        if (this.observer) {
          this.observer.disconnect();
        }
      }
    }

    customElements.define('image-carousel-{{ ai_gen_id }}', ImageCarousel{{ ai_gen_id }});
  })();
</script>

