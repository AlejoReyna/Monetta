{% doc %}
  @prompt
    Create a custom button block for a hero section with the following specifications:
    
    Button label: [tu texto aquí, ej. "Shop Now"]
    Button link: [tu URL aquí]
    Style: Outlined / Filled / Ghost (elige uno)
    Position: Absolute positioning within the hero section, with full vertical freedom — allow negative top values and values beyond 100% so the button can be placed anywhere vertically, including above the natural anchor point
    Settings to expose:
    vertical_position_top (range: -200 to 200, in px)
    vertical_position_top_mobile (range: -200 to 200, in px)
    horizontal_alignment (left / center / right)
    desktop_width_percent (10–100%)
    mobile_width_percent (10–100%)
    No min/max clamp on vertical offset — the merchant needs total freedom to push the button above or below its default position
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-hero-button-container-{{ ai_gen_id }} {
    position: absolute;
    top: {{ block.settings.vertical_position_top }}px;
    width: 100%;
    display: flex;
    {% if block.settings.horizontal_alignment == 'left' %}
      justify-content: flex-start;
    {% elsif block.settings.horizontal_alignment == 'center' %}
      justify-content: center;
    {% else %}
      justify-content: flex-end;
    {% endif %}
    z-index: 10;
  }

  .ai-hero-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    font-family: {{ block.settings.button_font.family }}, {{ block.settings.button_font.fallback_families }};
    font-weight: {{ block.settings.button_font.weight }};
    font-size: {{ block.settings.font_size }}px;
    text-decoration: none;
    border-radius: {{ block.settings.border_radius }}px;
    transition: all 0.3s ease;
    cursor: pointer;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    text-transform: {{ block.settings.text_transform }};
  }

  {% if block.settings.button_style == 'filled' %}
    .ai-hero-button-{{ ai_gen_id }} {
      background-color: {{ block.settings.filled_bg_color }};
      color: {{ block.settings.filled_text_color }};
      border: {{ block.settings.border_width }}px solid {{ block.settings.filled_border_color }};
    }

    .ai-hero-button-{{ ai_gen_id }}:hover {
      background-color: {{ block.settings.filled_hover_bg_color }};
      color: {{ block.settings.filled_hover_text_color }};
      border-color: {{ block.settings.filled_hover_border_color }};
    }
  {% elsif block.settings.button_style == 'outlined' %}
    .ai-hero-button-{{ ai_gen_id }} {
      background-color: transparent;
      color: {{ block.settings.outlined_text_color }};
      border: {{ block.settings.border_width }}px solid {{ block.settings.outlined_border_color }};
    }

    .ai-hero-button-{{ ai_gen_id }}:hover {
      background-color: {{ block.settings.outlined_hover_bg_color }};
      color: {{ block.settings.outlined_hover_text_color }};
      border-color: {{ block.settings.outlined_hover_border_color }};
    }
  {% else %}
    .ai-hero-button-{{ ai_gen_id }} {
      background-color: transparent;
      color: {{ block.settings.ghost_text_color }};
      border: none;
    }

    .ai-hero-button-{{ ai_gen_id }}:hover {
      background-color: {{ block.settings.ghost_hover_bg_color }};
      color: {{ block.settings.ghost_hover_text_color }};
    }
  {% endif %}

  @media screen and (max-width: 749px) {
    .ai-hero-button-container-{{ ai_gen_id }} {
      top: {{ block.settings.vertical_position_top_mobile }}px;
    }

    .ai-hero-button-{{ ai_gen_id }} {
      width: {{ block.settings.mobile_width_percent }}%;
      font-size: {{ block.settings.font_size_mobile }}px;
      padding: {{ block.settings.button_padding_vertical_mobile }}px {{ block.settings.button_padding_horizontal_mobile }}px;
    }
  }
{% endstyle %}

<div
  class="ai-hero-button-container-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <a
    href="{{ block.settings.button_link }}"
    class="ai-hero-button-{{ ai_gen_id }}"
  >
    {{ block.settings.button_label }}
  </a>
</div>

