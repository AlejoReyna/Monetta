{%- comment -%}
  Monetta shell for the pages that are not built from Monetta sections: templates the merchant composed with Atelier sections
  in the editor (page.contact, page.mayoreo, page.como-vender) and the pages Shopify renders without a template of their own
  (policies), which always use this layout. Everything a shopper navigates with is the Monetta one, as in layout/monetta.liquid:
  head (snippets/monetta-head.liquid), header and footer groups, phone dock, bag sheet, saved list and live regions. Atelier's
  stylesheets and scripts are still loaded for the sections inside <main>, and snippets/monetta-atelier-bridge.liquid maps their
  fonts, colour schemes and shapes to the Monetta tokens, so leaving the shopping pages never lands on a different-looking store.
  Atelier's own header, footer and header-height script are no longer rendered here; its search dialog still is, for Atelier
  blocks that open it.
{%- endcomment -%}
{%- liquid
  assign t = template.name | default: request.page_type
  assign is_policy = false
  if request.page_type == 'policy'
    assign is_policy = true
  endif
-%}
<!doctype html>
<html lang="es-MX"{% if request.design_mode %} class="shopify-design-mode"{% endif %}>
  <head>
    {%- render 'stylesheets' -%}
    {%- render 'scripts' -%}
    {%- render 'theme-styles-variables' -%}
    {%- render 'color-schemes' -%}
    {% render 'monetta-head' %}
    {% render 'monetta-atelier-bridge' %}

    {% if request.design_mode %}
      {%- render 'theme-editor' -%}
    {% endif %}

    {{ content_for_header }}
  </head>

  <body class="mw mw-atelier has-dock page-width-{{ settings.page_width }} card-hover-effect-{{ settings.card_hover_effect }}" data-template="{{ t }}" data-dock-active="">
    <a class="skip-link" href="#MainContent">Saltar al contenido</a>

    <div id="page">
      <div class="site-top" id="site-top" data-template="{{ t }}">
        {%- sections 'monetta-header-group' -%}
      </div>
      <main
        id="MainContent"
        class="content-for-layout"
        tabindex="-1"
        data-page-transition-enabled="false"
        data-product-transition="false"
        data-template="{{ template }}"
      >
        {%- if is_policy -%}
          {%- comment -%}The policy text is the store's, written in the store's language: it is marked as such.{%- endcomment -%}
          <div class="container page-shell policy-shell"{% render 'monetta-store-lang' %}>
            <div class="page-prose rte">{{ content_for_layout }}</div>
          </div>
        {%- else -%}
          {{ content_for_layout }}
        {%- endif -%}
      </main>
      <footer class="site-footer" id="site-footer">
        {%- sections 'monetta-footer-group' -%}
      </footer>
      {%- render 'monetta-dock', dock_active: '' -%}
    </div>

    {%- section 'monetta-cart-sheet' -%}
    {% render 'monetta-saved-products' %}
    {%- comment -%}Atelier's search dialog stays available to Atelier blocks on merchant-built pages that open it.{%- endcomment -%}
    {% render 'search-modal' %}
    {% if settings.quick_add or settings.mobile_quick_add %}
      {% render 'quick-add-modal' %}
    {% endif %}
    <div id="toast-root"></div>
    <div class="visually-hidden" id="status-live" role="status" aria-live="polite" aria-atomic="true"></div>
    <div class="visually-hidden" id="alert-live" role="alert" aria-live="assertive" aria-atomic="true"></div>
  </body>
</html>
