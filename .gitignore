# Android
android/.gradle/
android/local.properties
android/key.properties
android/app/google-services.json
**/*.keystore
**/*.jks

# Firebase / secrets — never commit these
ios/Runner/GoogleService-Info.plist
lib/firebase_options.dart
*.p8
*.p12
.env
.env.*
!.env.example
fastlane/report.xml
fastlane/Preview.html

# Filled dart-define files (public tokens still must not be committed as a
# habit — rotate is easier when they only live in CI / local untracked files).
config/dart_defines.staging.json
config/dart_defines.production.json
config/dart_defines.local.json

# Shopify CLI local state / install cache
shopify/node_modules/
shopify/.shopify/
.npm-cache/

# Root Vercel function dependencies
/node_modules/

# Immersive web site: Vercel installs and builds from source (see
# vercel.json), so neither the install cache nor the build output belongs
# in git.
web/node_modules/
web/dist/

# Catalog dashboard SPA: second Vercel project builds from source
# (dashboard/vercel.json) — same rule as web/.
dashboard/node_modules/
dashboard/dist/

# Generated code is COMMITTED on purpose (see docs/ARCHITECTURE.md § Codegen),
# so no *.g.dart / *.freezed.dart ignores here.
.vercel/
.env.local
.vercel
.env*

# Audit fixture runs — manifests, synthetic passwords, local env (brief §4)
.audit-runs/
tools/audit/.env
tools/audit/secrets/
tools/audit/**/secrets.json
*.audit-secrets.json
