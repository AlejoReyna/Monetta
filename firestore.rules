rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // The catalog contains the same public merchandising data exposed by the
    // Shopify storefront. Only trusted Admin SDK code may modify it.
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    // Delivery ids, reconciliation state, and every future collection are
    // backend-only unless a narrower rule is deliberately added.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
