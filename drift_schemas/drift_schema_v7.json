          "sql": "CREATE TABLE IF NOT EXISTS \"checkout_receipts\" (\"operation_id\" TEXT NOT NULL, \"shop_domain\" TEXT NOT NULL, \"account_id\" TEXT NOT NULL, PRIMARY KEY (\"operation_id\"));"
