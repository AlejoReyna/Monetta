  "fixed_sql": [
    {
      "name": "cached_products",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"cached_products\" (\"id\" TEXT NOT NULL, \"handle\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"vendor\" TEXT NOT NULL, \"product_type\" TEXT NOT NULL, \"tags\" TEXT NOT NULL DEFAULT '[]', \"images\" TEXT NOT NULL DEFAULT '[]', \"description_html\" TEXT NOT NULL DEFAULT '', \"collection_handles\" TEXT NOT NULL DEFAULT '[]', \"brand_override\" TEXT NULL, \"category_override\" TEXT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "cached_variants",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"cached_variants\" (\"id\" TEXT NOT NULL, \"product_id\" TEXT NOT NULL REFERENCES cached_products (id) ON DELETE CASCADE, \"title\" TEXT NOT NULL, \"price\" REAL NOT NULL, \"compare_at_price\" REAL NULL, \"available\" INTEGER NOT NULL CHECK (\"available\" IN (0, 1)), \"sku\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "cached_collections",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"cached_collections\" (\"id\" TEXT NOT NULL, \"handle\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"description\" TEXT NOT NULL DEFAULT '', \"image_url\" TEXT NULL, \"product_count\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "sync_cursors",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sync_cursors\" (\"id\" INTEGER NOT NULL DEFAULT 0, \"last_updated_at\" INTEGER NULL, \"last_full_sync_at\" INTEGER NULL, \"shop_domain\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "catalog_states",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"catalog_states\" (\"id\" INTEGER NOT NULL DEFAULT 0, \"source\" TEXT NOT NULL, \"synced_at\" INTEGER NULL, \"product_count\" INTEGER NOT NULL, \"fingerprint\" TEXT NOT NULL, \"status\" TEXT NOT NULL, \"detail\" TEXT NULL, \"shop_domain\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "app_preferences",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_preferences\" (\"id\" INTEGER NOT NULL DEFAULT 0, \"theme_mode\" TEXT NOT NULL DEFAULT 'system', \"onboarding_state\" TEXT NOT NULL DEFAULT 'pending', PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "wishlist_items",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"wishlist_items\" (\"product_id\" TEXT NOT NULL, \"account_id\" TEXT NOT NULL DEFAULT '', \"added_at\" INTEGER NOT NULL, PRIMARY KEY (\"product_id\", \"account_id\"));"
        }
      ]
    },
    {
      "name": "bag_lines",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"bag_lines\" (\"product_id\" TEXT NOT NULL, \"variant_id\" TEXT NOT NULL, \"account_id\" TEXT NOT NULL DEFAULT '', \"quantity\" INTEGER NOT NULL, PRIMARY KEY (\"variant_id\", \"account_id\"));"
        }
      ]
    },
    {
      "name": "interaction_events",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"interaction_events\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"type\" TEXT NOT NULL, \"timestamp\" INTEGER NOT NULL, \"product_id\" TEXT NULL, \"dwell_ms\" INTEGER NULL, \"facet_hint\" TEXT NULL);"
        }
      ]
    },
    {
      "name": "devices",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"devices\" (\"device_id\" TEXT NOT NULL, \"account_id\" TEXT NULL, \"platform\" TEXT NOT NULL, \"app_version\" TEXT NOT NULL, \"push_token\" TEXT NULL, \"installed_at\" INTEGER NOT NULL, \"last_seen_at\" INTEGER NOT NULL, PRIMARY KEY (\"device_id\"));"
        }
      ]
    },
    {
      "name": "accounts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"accounts\" (\"local_account_id\" TEXT NOT NULL, \"shopify_customer_id\" TEXT NULL UNIQUE, \"email\" TEXT NULL, \"display_name\" TEXT NULL, \"auth_provider\" TEXT NULL, \"created_at\" INTEGER NOT NULL, \"last_seen_at\" INTEGER NOT NULL, PRIMARY KEY (\"local_account_id\"));"
        }
      ]
    },
    {
      "name": "sessions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sessions\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"account_id\" TEXT NOT NULL REFERENCES accounts (local_account_id) ON DELETE CASCADE, \"secure_storage_key_ref\" TEXT NOT NULL, \"access_token_expires_at\" INTEGER NOT NULL, \"created_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "order_summaries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"order_summaries\" (\"id\" TEXT NOT NULL, \"account_id\" TEXT NOT NULL REFERENCES accounts (local_account_id) ON DELETE CASCADE, \"display_number\" TEXT NULL, \"fulfillment_status\" TEXT NULL, \"shopify_order_id\" TEXT NULL, \"source\" TEXT NOT NULL, \"attribution_code\" TEXT NULL, \"status\" TEXT NOT NULL, \"total_amount\" REAL NOT NULL, \"currency_code\" TEXT NOT NULL, \"placed_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\", \"account_id\"));"
        }
      ]
    },
    {
