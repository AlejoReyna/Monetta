  "contrast": [
    {
      "fg": "ink",
      "bg": "canvas",
      "min": 4.5,
      "use": "texto sobre blanco puro"
    },
    {
      "fg": "ink",
      "bg": "surfaceWarm",
      "min": 4.5,
      "use": "texto sobre superficie tenue (pie gris)"
    },
    {
      "fg": "ink",
      "bg": "surfaceTile",
      "min": 4.5,
      "use": "etiqueta de navegación activa sobre su cápsula"
    },
    {
      "fg": "inkMuted",
      "bg": "canvas",
      "min": 4.5,
      "use": "texto secundario"
    },
    {
      "fg": "inkMuted",
      "bg": "surfaceWarm",
      "min": 4.5,
      "use": "texto secundario en el pie"
    },
    {
      "fg": "inkMuted",
      "bg": "surfaceTile",
      "min": 4.5,
      "use": "texto secundario en cápsulas"
    },
    {
      "fg": "onActionPrimary",
      "bg": "actionPrimary",
      "min": 4.5,
      "use": "botón Glass con halo C: texto oscuro sobre blanco"
    },
    {
      "fg": "onActionDark",
      "bg": "actionDark",
      "min": 4.5,
      "use": "botón oscuro"
    },
    {
      "fg": "accentText",
      "bg": "canvas",
      "min": 4.5,
      "use": "texto de énfasis pequeño (oro no sirve para texto pequeño, §109)"
    },
    {
      "fg": "goldLarge",
      "bg": "canvas",
      "min": 3,
      "use": "oro solo en texto grande/bold ≥20px (ENVÍO GRATIS del registro) e iconos"
    },
    {
      "fg": "navigationActive",
      "bg": "surfaceTile",
      "min": 4.5,
      "use": "destino activo: texto oscuro sobre cápsula"
    },
    {
      "fg": "navigationInactive",
      "bg": "bar",
      "min": 4.5,
      "use": "destino inactivo"
    },
    {
      "fg": "sale",
      "bg": "canvas",
      "min": 4.5,
      "use": "error / X de rechazo #A63535"
    },
    {
      "fg": "sale",
      "bg": "saleSurface",
      "min": 4.5,
      "use": "aviso de error sobre superficie"
    },
    {
      "fg": "success",
      "bg": "canvas",
      "min": 4.5,
      "use": "saldo disponible y check verde"
    },
    {
      "fg": "success",
      "bg": "successSurface",
      "min": 4.5,
      "use": "aviso de éxito"
    },
    {
      "fg": "onSoldBadge",
      "bg": "soldBadge",
      "min": 4.5,
      "use": "etiqueta AGOTADO negra/blanca"
    },
    {
      "fg": "borderControl",
      "bg": "canvas",
      "min": 3,
      "use": "contorno de campo (WCAG 1.4.11)"
    },
    {
      "fg": "focus",
      "bg": "canvas",
      "min": 3,
      "use": "anillo de foco 2px"
    },
    {
      "fg": "gold",
      "bg": "canvas",
      "min": 1,
      "use": "oro decorativo/iconos; registrado para constancia"
    }
  ],
