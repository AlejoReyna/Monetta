      "surfaceTile": "#242220",
      "actionPrimary": "#C49A65",
      "onActionPrimary": "#11100F",
      "actionDark": "#F5F2EC",
      "onActionDark": "#171615",
      "borderControl": "#8E8A85",
      "saleSurface": "#3A1F1B"
