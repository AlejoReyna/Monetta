  "color": {
    "light": {
      "canvas": "#FFFFFF",
      "bar": "#FFFFFF",
      "surface": "#FFFFFF",
      "surfaceWarm": "#F5F6F3",
      "surfaceTile": "#E8ECE7",
      "ink": "#242622",
      "inkMuted": "#595D56",
      "actionPrimary": "#FFFFFF",
      "onActionPrimary": "#242622",
      "actionDark": "#242622",
      "onActionDark": "#FFFFFF",
      "accentText": "#242622",
