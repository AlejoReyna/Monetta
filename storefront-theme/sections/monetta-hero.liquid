{%- comment -%}
  Home hero (HomeEditorialBanner). Full-bleed photograph banner at every width with the search field inside it (as in the
  app). Tablet and desktop overlay a panel with eyebrow, tagline, copy, the search field, two buttons and fact lines. Images are theme settings (with the
  Shopify focal point as object-position); without them the app's bundled banner is used.
{%- endcomment -%}
{%- liquid
  assign phone = section.settings.image_mobile
  assign wide = section.settings.image_desktop
  assign main_image = phone | default: wide
-%}
<h1 class="visually-hidden" tabindex="-1">{{ section.settings.page_heading | default: shop.name | escape }}</h1>
<section class="home-hero" aria-label="Portada" {{ section.shopify_attributes }}>
  <div class="home-hero__photo">
    {%- if main_image -%}
      <picture>
        {%- if wide and phone -%}
          <source media="(min-width: 768px)" srcset="{{ wide | image_url: width: 900 }} 900w, {{ wide | image_url: width: 1400 }} 1400w, {{ wide | image_url: width: 1800 }} 1800w" sizes="(min-width: 1024px) 58vw, 55vw">
        {%- endif -%}
        <img
          src="{{ main_image | image_url: width: 900 }}"
          srcset="{{ main_image | image_url: width: 540 }} 540w, {{ main_image | image_url: width: 900 }} 900w, {{ main_image | image_url: width: 1400 }} 1400w"
          sizes="(min-width: 1024px) 58vw, (min-width: 768px) 55vw, 100vw"
          width="{{ main_image.width }}"
          height="{{ main_image.height }}"
          alt=""
          fetchpriority="high"
          decoding="async"
          {% if main_image.presentation.focal_point %}style="object-position: {{ main_image.presentation.focal_point }}"{% endif %}
        >
      </picture>
    {%- else -%}
      <img src="{{ 'monetta-home-banner.jpg' | asset_url }}" width="736" height="981" alt="" fetchpriority="high" decoding="async">
    {%- endif -%}
  </div>
  {%- if section.settings.show_cta and section.settings.banner_button_label != blank -%}
    <a class="btn btn--outline home-hero__cta" href="{{ section.settings.banner_button_link | default: routes.all_products_collection_url }}">{{ section.settings.banner_button_label | escape }}</a>
  {%- endif -%}
  {%- if section.settings.show_search -%}
  <div class="home-hero__search">
    <form class="home-hero__form" role="search" aria-label="Buscar en la tienda" action="{{ routes.search_url }}" method="get">
      <div class="search-field search-field--hero">
        {% render 'monetta-icon', name: 'search', size: 20 %}
        <label class="visually-hidden" for="hero-search-input">Buscar productos</label>
        <input id="hero-search-input" type="search" name="q" placeholder="{{ section.settings.search_text | escape }}" autocomplete="off" spellcheck="false" enterkeyhint="search">
        <input type="hidden" name="type" value="product">
        <button type="submit" class="icon-button search-field__submit" aria-label="Buscar">{% render 'monetta-icon', name: 'arrowForward', size: 20 %}</button>
      </div>
    </form>
  </div>
  {%- endif -%}
  <div class="home-hero__panel"{% unless section.settings.show_panel %} hidden{% endunless %}>
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}<p class="display display--hero">{{ section.settings.heading | escape }}</p>{%- endif -%}
    {%- if section.settings.text != blank -%}<p class="body-copy">{{ section.settings.text | escape }}</p>{%- endif -%}
    <div class="home-hero__actions">
      {%- if section.settings.button_1_label != blank and section.settings.button_1_link != blank -%}
        <a class="btn btn--primary" href="{{ section.settings.button_1_link }}">{{ section.settings.button_1_label | escape }}</a>
      {%- endif -%}
      {%- if section.settings.button_2_label != blank and section.settings.button_2_link != blank -%}
        <a class="btn btn--outline" href="{{ section.settings.button_2_link }}">{{ section.settings.button_2_label | escape }}</a>
      {%- endif -%}
    </div>
    {%- if section.blocks.size > 0 -%}
      <ul class="home-hero__facts" role="list">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>{% render 'monetta-icon', name: block.settings.icon, size: 16 %} {{ block.settings.text | escape }}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

<script>
  (function () {
    if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var root = document.documentElement;
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) { e.target.classList.add('is-revealed'); io.unobserve(e.target); }
      });
    }, { rootMargin: '0px 0px -8% 0px', threshold: 0.05 });
    function arm() {
      var els = Array.prototype.slice.call(document.querySelectorAll('main .shopify-section:not(:first-child) > .section'));
      els.forEach(function (el) {
        var r = el.getBoundingClientRect();
        if (r.top < innerHeight) { el.classList.add('is-revealed'); } else { el.classList.add('reveal'); io.observe(el); }
      });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', arm); else arm();
  })();
</script>

{% schema %}
{
  "name": "Monetta · Portada",
  "max_blocks": 4,
  "settings": [
    { "type": "image_picker", "id": "image_mobile", "label": "Imagen para teléfono", "info": "Vertical, 1080×1440 o mayor, clara y sin texto. Sin imagen se usa el banner original de la app." },
    { "type": "image_picker", "id": "image_desktop", "label": "Imagen para tablet y escritorio", "info": "Horizontal, 1600×1000 o mayor. Si se omite se reutiliza la del teléfono." },
    { "type": "text", "id": "page_heading", "label": "Encabezado de la página (solo para lectores de pantalla y buscadores)", "default": "Monetta: bolsas, carteras y relojes originales" },
    { "type": "text", "id": "search_text", "label": "Texto del buscador", "default": "Encuentra algo muy tú" },
    { "type": "text", "id": "banner_button_label", "label": "Botón del banner: texto", "default": "Ver productos" },
    { "type": "url", "id": "banner_button_link", "label": "Botón del banner: enlace" },
    { "type": "checkbox", "id": "show_cta", "label": "Mostrar botón en el banner", "default": false },
    { "type": "checkbox", "id": "show_search", "label": "Mostrar buscador en el banner", "default": false },
    { "type": "header", "content": "Panel (tablet y escritorio)" },
    { "type": "checkbox", "id": "show_panel", "label": "Mostrar panel de texto sobre el banner", "default": false, "info": "Apagado, el banner sigue a monetta.mx: foto, botón y buscador." },
    { "type": "text", "id": "eyebrow", "label": "Sobretítulo", "default": "Boutique Monetta" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Bolsas, carteras y relojes originales." },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Piezas importadas de Estados Unidos, elegidas para consentirte o para hacer crecer tu negocio, con envíos a todo México." },
    { "type": "text", "id": "button_1_label", "label": "Botón principal: texto", "default": "Ver novedades" },
    { "type": "url", "id": "button_1_link", "label": "Botón principal: enlace" },
    { "type": "text", "id": "button_2_label", "label": "Botón secundario: texto", "default": "Ver catálogo" },
    { "type": "url", "id": "button_2_link", "label": "Botón secundario: enlace" }
  ],
  "blocks": [
    {
      "type": "fact",
      "name": "Dato",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icono", "default": "check", "options": [
          { "value": "check", "label": "Palomita" },
          { "value": "truck", "label": "Envío" },
          { "value": "work", "label": "Maletín" },
          { "value": "refresh", "label": "Cambios" },
          { "value": "lock", "label": "Candado" }
        ] },
        { "type": "text", "id": "text", "label": "Texto", "default": "Productos originales" }
      ]
    }
  ],
  "presets": [
    { "name": "Monetta · Portada", "blocks": [ { "type": "fact" }, { "type": "fact", "settings": { "icon": "truck", "text": "Envíos a todo México" } } ] }
  ]
}
{% endschema %}
