{%- comment -%}
  Pages of the client guide that the app of PR #33 builds (wholesale_screen.dart, contact_screen.dart,
  rewards_guide_screen.dart, rewards_share_screen.dart), with the app's copy: Mayoreo (slides 21–22), Contacto (27) and
  Monetta Rewards with Comparte y gana (25–26). The owner's own page templates stay untouched; these are new templates
  (page.guia-*), see guia-1a1/RESULTADO.md.
{%- endcomment -%}
{%- liquid
  assign mode = section.settings.mode
  assign heading_id = section.id | append: '-heading'
  assign wa = 'https://wa.me/528261066868'
  assign group_1_url = section.settings.group_1_url
  assign group_2_url = section.settings.group_2_url
  assign facebook_group_url = section.settings.facebook_group_url
-%}
{%- case mode -%}
  {%- when 'mayoreo' -%}
    {%- capture catalog_url -%}{% render 'monetta-guia-url', key: 'catalogo' %}{%- endcapture -%}
    <div class="guia-page guia-page--mayoreo" {{ section.shopify_attributes }}>
      {% render 'monetta-guia-hero', photo: 'mayoreo-banner', banner: 'B32_mayoreo', lettered: true, title: 'Mayoreo', caps: true, italic: true, body: 'Obtén precios especiales en productos originales importados de tus marcas favoritas.', focus: '8% 50%', eager: true %}
      <section class="container guia-steps" aria-labelledby="{{ heading_id }}-steps">
        <h2 class="display display--section" id="{{ heading_id }}-steps">¿Cómo comprar?</h2>
        <ol class="guia-steps__list" tabindex="0" aria-label="Pasos para comprar a mayoreo">
          <li class="guia-step">{% render 'monetta-icon', name: 'bag', size: 30, class: 'guia-step__icon' %}<h3 class="guia-step__title">Elige tus productos</h3><p class="guia-step__body">Arma tu pedido seleccionando entre miles de modelos originales de tus marcas favoritas.</p></li>
          <li class="guia-step"><span class="guia-step__icon">{% render 'monetta-nav-glyph', name: 'cart', size: 30 %}</span><h3 class="guia-step__title">Agrega mínimo 3 piezas</h3><p class="guia-step__body">Consulta qué piezas y descuentos están disponibles para tu pedido.</p></li>
          <li class="guia-step">{% render 'monetta-icon', name: 'wallet', size: 30, class: 'guia-step__icon' %}<h3 class="guia-step__title">Liquida o aparta</h3><p class="guia-step__body">Escríbenos por WhatsApp para conocer las opciones de pago y las condiciones de apartado.</p></li>
        </ol>
        <a class="guia-pill-button guia-steps__cta" href="{{ catalog_url | strip }}">Comienza a vender</a>
      </section>
      {%- if group_1_url != blank or group_2_url != blank -%}
      <section class="container guia-community" aria-labelledby="{{ heading_id }}-community">
        <h2 class="guia-community__title" id="{{ heading_id }}-community">Únete a nuestra comunidad de emprendedores</h2>
        <p class="guia-community__body">Genera ingresos desde hoy muy fácil vendiendo miles de productos originales con nuestro sistema de venta por catálogo.</p>
        <ul class="guia-community__groups" role="list">
          {% if group_1_url != blank %}<li><a class="guia-wa" href="{{ group_1_url | escape }}" target="_blank" rel="noopener">{% render 'monetta-guia-icon', name: 'contacto-whatsapp', size: 40, class: 'guia-wa__icon' %}<span class="guia-wa__pill">Grupo 1</span><span class="visually-hidden"> (se abre en otra pestaña)</span></a></li>{% endif %}
          {% if group_2_url != blank %}<li><a class="guia-wa" href="{{ group_2_url | escape }}" target="_blank" rel="noopener">{% render 'monetta-guia-icon', name: 'contacto-whatsapp', size: 40, class: 'guia-wa__icon' %}<span class="guia-wa__pill">Grupo 2</span><span class="visually-hidden"> (se abre en otra pestaña)</span></a></li>{% endif %}
        </ul>
      </section>
      {%- endif -%}
      <section class="container guia-benefits" aria-labelledby="{{ heading_id }}-benefits">
        <h2 class="display display--section" id="{{ heading_id }}-benefits">Beneficios</h2>
        <ul class="guia-benefits__list" role="list">
          <li>{% render 'monetta-icon', name: 'handshake', size: 28, class: 'guia-benefits__icon' %}<span>Accede a la mejor comunidad de emprendedores</span></li>
          <li>{% render 'monetta-icon', name: 'check', size: 28, class: 'guia-benefits__icon' %}<span>Vende productos originales con garantía de autenticidad</span></li>
          <li>{% render 'monetta-icon', name: 'book', size: 28, class: 'guia-benefits__icon' %}<span>Recibe nuestros catálogos de venta para compartir con tus clientes y amigos.</span></li>
        </ul>
      </section>
      <section class="container guia-doubts-block" aria-labelledby="{{ heading_id }}-doubts">
        <h2 class="display display--section" id="{{ heading_id }}-doubts">¿Tienes dudas?</h2>
        <a class="guia-wa" href="{{ wa }}?text={{ 'Hola Monetta, quisiera información sobre mayoreo y sus condiciones vigentes.' | url_encode }}" target="_blank" rel="noopener">{% render 'monetta-guia-icon', name: 'contacto-whatsapp', size: 40, class: 'guia-wa__icon' %}<span class="guia-wa__pill">Escríbenos por WhatsApp</span><span class="visually-hidden"> (se abre en otra pestaña)</span></a>
      </section>
      <section class="section container" aria-labelledby="{{ heading_id }}-rail">
        {%- assign rail_id = 'rail-' | append: section.id -%}
        {%- assign rail_heading = heading_id | append: '-rail' -%}
        {% render 'monetta-section-header', id: rail_heading, title: 'Productos que te pueden interesar', link_url: catalog_url, link_label: 'Ver todo', rail_id: rail_id %}
        <div class="rail">
          <ul class="rail__track" id="{{ rail_id }}" role="list" aria-label="Productos que te pueden interesar">
            {%- for product in collections.all.products limit: 40 -%}
              <li>{% render 'monetta-card', product: product, density: 'compact', sizes: '(min-width: 1024px) 25vw, 36vw' %}</li>
            {%- endfor -%}
            <li class="v41-close-item"><a class="v41-close" href="{{ catalog_url | strip }}"><span class="v41-close__glass" aria-hidden="true">{% render 'monetta-icon', name: 'chevronRight', size: 22 %}</span><span>Ver todo</span></a></li>
          </ul>
        </div>
      </section>
      {% render 'monetta-rewards-register', heading_id: heading_id %}
    </div>

  {%- when 'contacto' -%}
    <div class="guia-page guia-page--contacto" {{ section.shopify_attributes }}>
      {% render 'monetta-guia-hero', photo: 'contacto-banner', banner: 'B31_contacto', lettered: true, title: 'Tu boutique y proveedor de', accent: 'confianza.', body: 'Bienvenida a nuestro paraíso de modelos originales de marcas que amas, importados y con envíos garantizados a todo México.', focus: '8% 50%', eager: true %}
      <div class="container guia-contact">
        <section class="guia-contact__channels" aria-labelledby="{{ heading_id }}-channels">
          <h2 class="display display--section" id="{{ heading_id }}-channels">Contáctanos</h2>
          <p class="guia-contact__lede">Estamos para ayudarte</p>
          <a class="guia-wa" href="{{ wa }}" target="_blank" rel="noopener">{% render 'monetta-guia-icon', name: 'contacto-whatsapp', size: 40, class: 'guia-wa__icon' %}<span class="guia-wa__pill">Enviar Whatsapp al 826 106 6868</span><span class="visually-hidden"> (se abre en otra pestaña)</span></a>
        </section>
        {%- if group_1_url != blank or group_2_url != blank or facebook_group_url != blank -%}
        <section class="guia-contact__join" aria-labelledby="{{ heading_id }}-join">
          <h2 class="guia-contact__join-title" id="{{ heading_id }}-join">Únete</h2>
          <p class="guia-contact__lede">A nuestros grupos de emprendedores</p>
          <ul class="guia-contact__list" role="list">
            {% if group_1_url != blank %}<li><a class="guia-contact__row" href="{{ group_1_url | escape }}" target="_blank" rel="noopener">{% render 'monetta-guia-icon', name: 'contacto-whatsapp', size: 40, class: 'guia-contact__icon' %}<span class="guia-contact__text"><span class="guia-contact__title">Grupo 1</span><span class="guia-contact__sub">Únete a nuestro grupo de WhatsApp</span></span>{% render 'monetta-icon', name: 'chevronRight', size: 20, class: 'guia-contact__chevron' %}<span class="visually-hidden"> (se abre en otra pestaña)</span></a></li>{% endif %}
            {% if group_2_url != blank %}<li><a class="guia-contact__row" href="{{ group_2_url | escape }}" target="_blank" rel="noopener">{% render 'monetta-guia-icon', name: 'contacto-whatsapp', size: 40, class: 'guia-contact__icon' %}<span class="guia-contact__text"><span class="guia-contact__title">Grupo 2</span><span class="guia-contact__sub">Únete a nuestro grupo de WhatsApp</span></span>{% render 'monetta-icon', name: 'chevronRight', size: 20, class: 'guia-contact__chevron' %}<span class="visually-hidden"> (se abre en otra pestaña)</span></a></li>{% endif %}
            {% if facebook_group_url != blank %}<li><a class="guia-contact__row" href="{{ facebook_group_url | escape }}" target="_blank" rel="noopener">{% render 'monetta-guia-icon', name: 'red-facebook', size: 40, class: 'guia-contact__icon' %}<span class="guia-contact__text"><span class="guia-contact__title">Grupo de Facebook</span><span class="guia-contact__sub">Únete a nuestra comunidad</span></span>{% render 'monetta-icon', name: 'chevronRight', size: 20, class: 'guia-contact__chevron' %}<span class="visually-hidden"> (se abre en otra pestaña)</span></a></li>{% endif %}
          </ul>
        </section>
        {%- endif -%}
        <section class="guia-contact__social" aria-labelledby="{{ heading_id }}-social">
          <h2 class="display display--section" id="{{ heading_id }}-social">Síguenos en redes</h2>
          <p class="guia-contact__lede">Descubre novedades, lanzamientos y más.</p>
          {% render 'monetta-guia-social', class: 'guia-social--contact' %}
        </section>
      </div>
    </div>

  {%- when 'rewards' -%}
    <div class="container guia-page guia-page--rewards" {{ section.shopify_attributes }}>
      <h1 class="display display--page">Monetta Rewards</h1>
      {%- if customer -%}
        <p class="guia-rewards__lede">Consulta tus compras desde tu cuenta Monetta.</p>
        <a class="btn btn--primary" href="{{ routes.account_url }}">Ir a mi cuenta</a>
      {%- elsif shop.customer_accounts_enabled -%}
        <p class="guia-rewards__lede">Accede con tu correo para consultar tu cuenta.</p>
        <a class="btn btn--primary" href="{{ routes.account_login_url }}">Iniciar sesión</a>
      {%- endif -%}
      <a class="btn btn--outline" href="{{ routes.all_products_collection_url }}">Ver catálogo</a>
    </div>
{%- endcase -%}

{% schema %}
{
  "name": "Monetta · Guía (página)",
  "settings": [
    { "type": "url", "id": "group_1_url", "label": "Grupo 1 autorizado" },
    { "type": "url", "id": "group_2_url", "label": "Grupo 2 autorizado" },
    { "type": "url", "id": "facebook_group_url", "label": "Grupo de Facebook autorizado" },
    {
      "type": "select",
      "id": "mode",
      "label": "Página",
      "default": "mayoreo",
      "options": [
        { "value": "mayoreo", "label": "Mayoreo" },
        { "value": "contacto", "label": "Contacto" },
        { "value": "rewards", "label": "Monetta Rewards" }
      ]
    }
  ],
  "presets": [{ "name": "Monetta · Guía (página)" }]
}
{% endschema %}
