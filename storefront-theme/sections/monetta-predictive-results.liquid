{%- comment -%}
  API-only fragment. The client accepts only this response's items, never an entire HTML document. Pieces come first: they
  are what the dropdown under the search field is for.
{%- endcomment -%}
{%- if predictive_search.performed -%}
  {%- liquid
    assign queries = predictive_search.resources.queries
    assign products = predictive_search.resources.products
    assign categories = predictive_search.resources.collections
    assign result_count = queries.size | plus: products.size | plus: categories.size
  -%}
  <div data-monetta-predictive-response data-count="{{ result_count }}">
    <ul data-monetta-predictive-items>
      {%- if products.size > 0 -%}
        <li role="group" aria-label="Productos">
          <p class="monetta-predictive-search__group-title" aria-hidden="true">Productos</p>
          <ul role="presentation">
            {%- for product in products limit: 6 -%}
              <li role="presentation">
                {%- assign predictive_variant = product.selected_or_first_available_variant -%}
                <a class="monetta-predictive-search__option" href="{{ product.url | escape }}" role="option" tabindex="-1" data-monetta-predictive-option data-predictive-kind="product">
                  <span class="monetta-predictive-search__media" aria-hidden="true">
                    {%- assign predictive_image = product.featured_media.preview_image | default: product.featured_image -%}
                    {%- if predictive_image != blank -%}
                      {{ predictive_image | image_url: width: 128 | image_tag: widths: '64, 128', sizes: '64px', width: 64, height: 64, loading: 'eager', alt: '' }}
                    {%- else -%}
                      {% render 'monetta-icon', name: 'bag', size: 28 %}
                    {%- endif -%}
                  </span>
                  <span class="monetta-predictive-search__details">
                    <span class="monetta-predictive-search__vendor" data-predictive-vendor>{{ product.vendor | escape }}</span>
                    <span class="monetta-predictive-search__title">{{ product.title | escape }}</span>
                    <span class="monetta-predictive-search__price">
                      {%- if product.price_varies -%}Desde {% endif -%}
                      {%- if product.price_varies -%}{{ product.price_min | money_without_trailing_zeros }}{%- else -%}{{ predictive_variant.price | money_without_trailing_zeros }}{%- endif -%}
                      {%- if product.available and predictive_variant.compare_at_price > predictive_variant.price -%}
                        <s><span class="visually-hidden">Precio anterior: </span>{{ predictive_variant.compare_at_price | money_without_trailing_zeros }}</s>
                      {%- endif -%}
                    </span>
                  </span>
                </a>
              </li>
            {%- endfor -%}
          </ul>
        </li>
      {%- endif -%}
      {%- if queries.size > 0 -%}
        <li role="group" aria-label="Sugerencias de búsqueda">
          <p class="monetta-predictive-search__group-title" aria-hidden="true">Sugerencias de búsqueda</p>
          <ul role="presentation">
            {%- for query in queries -%}
              <li role="presentation"><a class="monetta-predictive-search__option" href="{{ routes.search_url }}?q={{ query.text | url_encode }}&amp;type=product" role="option" tabindex="-1" data-monetta-predictive-option data-predictive-kind="query" data-monetta-predictive-term="{{ query.text | escape }}"><span>{{ query.styled_text }}</span></a></li>
            {%- endfor -%}
          </ul>
        </li>
      {%- endif -%}
      {%- if categories.size > 0 -%}
        <li role="group" aria-label="Colecciones">
          <p class="monetta-predictive-search__group-title" aria-hidden="true">Colecciones</p>
          <ul role="presentation">
            {%- for collection in categories -%}
              <li role="presentation"><a class="monetta-predictive-search__option" href="{{ collection.url | escape }}" role="option" tabindex="-1" data-monetta-predictive-option data-predictive-kind="collection">{{ collection.title | escape }}</a></li>
            {%- endfor -%}
          </ul>
        </li>
      {%- endif -%}
    </ul>
  </div>
{%- endif -%}
{% schema %}
{ "name": "Monetta · Sugerencias", "settings": [] }
{% endschema %}
