{%- comment -%}
  Product page (product_screen.dart), laid out as the client's 29 Oct reference: gallery with previous / next arrows, the heart
  and a zoom button, thumbnails, brand and name in Playfair, price with the real compare-at and -X%, colour swatches, the trust
  row, «Agregar a bolsa» and «Comprar ahora» (adds the exact variant, then goes to the checkout), availability, the WhatsApp
  apartado, collapsed accordions and app blocks (Loox and the like). The nav bar stays on screen (layout/monetta.liquid).

  Everything commercial is rendered by Shopify at request time: price, compare-at, availability, options, the selected variant.
  When the shopper changes an option, assets/monetta-product.js asks the Section Rendering API for this same section with
  ?variant=ID and swaps the [data-product-dynamic] and [data-purchase-dock] regions, so no price or stock is ever cached or
  recomputed in the browser. The add button posts the exact variant id and never substitutes another: while a choice has not been
  confirmed by Shopify (or its confirmation failed) adding and the accelerated checkout are blocked, and a failed confirmation puts
  the chips back on the variant the page really shows.

  Without JavaScript the chips are plain links to ?variant=ID, so choosing an option is a navigation and the form always sends the
  variant the page shows. monetta-product.js swaps them for the radio group (html.mw-variants-js) because it can confirm each choice
  without a reload.
{%- endcomment -%}
{%- liquid
  assign current = product.selected_or_first_available_variant
  assign form_id = 'product-form-' | append: section.id
  capture brand
    render 'monetta-facet', product: product, kind: 'brands'
  endcapture
  assign brand = brand | strip
  capture category
    render 'monetta-facet', product: product, kind: 'categories'
  endcapture
  assign category = category | strip
  assign brand_query = brand | url_encode
  assign brand_url = routes.search_url | append: '?type=product&q=' | append: brand_query
  assign images = product.media | where: 'media_type', 'image'
  assign selected_index = 0
  for media in images
    if current.featured_media and media.id == current.featured_media.id
      assign selected_index = forloop.index0
    endif
  endfor
  assign pct = 0
  if current.available and current.compare_at_price > current.price
    assign pct = current.compare_at_price | minus: current.price | times: 100.0 | divided_by: current.compare_at_price | round
  endif
  assign whatsapp = section.settings.whatsapp_number | replace: '+', '' | replace: ' ', '' | replace: '-', ''
  assign variant_label = ''
  unless product.has_only_default_variant
    assign variant_label = current.title
  endunless
  assign currency = cart.currency.iso_code
  assign product_link = shop.url | append: product.url | append: '?variant=' | append: current.id
  assign show_pay = false
  if section.settings.show_dynamic_checkout and current.available
    assign show_pay = true
  endif
  assign show_apartado = false
  if section.settings.show_apartado and whatsapp != blank
    assign show_apartado = true
  endif
  assign has_service = false
  for block in section.blocks
    if block.type == 'service' and block.settings.text != blank
      assign has_service = true
    endif
  endfor
-%}
<script type="application/ld+json">
  {{ product | structured_data }}
</script>
<article
  class="product-page"
  data-product-page
  data-section-id="{{ section.id }}"
  data-product-url="{{ product.url }}"
  data-selected-index="{{ selected_index }}"
  {{ section.shopify_attributes }}
>

  <div class="product-layout">
    <section class="gallery{% if images.size <= 1 %} gallery--single{% endif %}" aria-label="Fotos de {{ product.title | escape }}">
      <div class="gallery__main">
        <div class="gallery__track" data-gallery tabindex="0" role="group" aria-roledescription="carrusel" aria-label="Galería: usa las flechas para cambiar de foto">
          {%- for media in images -%}
            <figure class="gallery__slide" id="slide-{{ forloop.index0 }}" data-media-id="{{ media.id }}" aria-label="Foto {{ forloop.index }} de {{ images.size }}">
              {%- assign alt_text = media.alt | default: product.title | append: ', foto ' | append: forloop.index | append: ' de ' | append: images.size -%}
              {% render 'monetta-image', image: media.preview_image, widths: '480,720,1000,1400', sizes: '(min-width: 1024px) 45vw, (min-width: 768px) 52vw, 100vw', alt: alt_text, eager: forloop.first %}
            </figure>
          {%- else -%}
            <figure class="gallery__slide">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</figure>
          {%- endfor -%}
        </div>
        <div class="gallery__seal" data-seal{% if current.available %} hidden{% endif %}><span class="badge badge--seal">Agotado</span></div>
        {%- if images.size > 1 -%}
          <button type="button" class="round-button gallery__arrow gallery__arrow--prev" data-gallery-step="-1" aria-label="Foto anterior"><span class="round-button__circle">{% render 'monetta-icon', name: 'chevronLeft', size: 22 %}</span></button>
          <button type="button" class="round-button gallery__arrow gallery__arrow--next" data-gallery-step="1" aria-label="Foto siguiente"><span class="round-button__circle">{% render 'monetta-icon', name: 'chevronRight', size: 22 %}</span></button>
        {%- endif -%}
        {%- if images.size > 0 -%}
          <button type="button" class="round-button gallery__zoom" data-gallery-zoom aria-haspopup="dialog" aria-label="Ampliar foto"><span class="round-button__circle"><svg class="icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" d="M10.5 17.5a7 7 0 1 0 0-14 7 7 0 0 0 0 14zM15.5 15.5 20.5 20.5M10.5 7.5v6M7.5 10.5h6"/></svg></span></button>
        {%- endif -%}
        <div class="gallery__tools">
          <button type="button" class="round-button" data-save-product="{{ product.handle }}" data-product-title="{{ product.title | escape }}" aria-pressed="false" aria-label="Guardar {{ product.title | escape }}" hidden><span class="round-button__circle">{% render 'monetta-icon', name: 'heart', size: 19, class: 'save-icon--off' %}{% render 'monetta-icon', name: 'heartFilled', size: 19, class: 'save-icon--on' %}</span></button>
          <button type="button" class="round-button" data-share aria-label="Compartir {{ product.title | escape }}"><span class="round-button__circle">{% render 'monetta-icon', name: 'share', size: 19 %}</span></button>
        </div>
        {%- if images.size > 1 -%}
          <div class="gallery__rules" aria-hidden="true">
            {%- for media in images -%}<span data-active="{% if forloop.index0 == selected_index %}true{% else %}false{% endif %}"></span>{%- endfor -%}
          </div>
        {%- endif -%}
      </div>
      {%- if images.size > 1 -%}
        <div class="gallery__thumbs" role="group" aria-label="Miniaturas">
          {%- for media in images -%}
            <button type="button" class="thumb" data-thumb="{{ forloop.index0 }}" aria-label="Ver foto {{ forloop.index }} de {{ images.size }}" aria-current="{% if forloop.index0 == selected_index %}true{% else %}false{% endif %}">
              {% render 'monetta-image', image: media.preview_image, widths: '144,216', sizes: '72px', alt: '' %}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </section>

    <div class="product-panel container-phone" data-panel>
      {%- if brand != blank -%}
        <a class="product-panel__brand" href="{{ brand_url }}">{{ brand | escape }}</a>
      {%- endif -%}
      <h1 class="product-panel__name" tabindex="-1">{{ product.title | escape }}</h1>

      <div data-product-dynamic>
        <div class="product-panel__price" data-price>
          <span class="price">{{ current.price | money_without_trailing_zeros | replace: '$ ', '$' }} {{ currency }}</span>
          {%- if pct > 0 -%}
            <span class="visually-hidden">Precio anterior:</span><s class="price-compare">{{ current.compare_at_price | money_without_trailing_zeros | replace: '$ ', '$' }} {{ currency }}</s><span class="badge badge--sale">-{{ pct }}%</span>
          {%- endif -%}
        </div>


        {%- form 'product', product, id: form_id, class: 'product-form', novalidate: 'novalidate', autocomplete: 'off', data-product-form: 'true' -%}
          <input type="hidden" name="id" value="{{ current.id }}" data-variant-id>

          {%- unless product.has_only_default_variant -%}
            <div class="product-panel__options" data-options>
              {%- for option in product.options_with_values -%}
                {%- assign option_index = forloop.index0 -%}
                <fieldset class="options" data-option-position="{{ forloop.index }}">
                  <legend><span class="eyebrow eyebrow--muted">{% render 'monetta-label', kind: 'option', name: option.name %}</span><span class="options__value" data-option-value>{{ option.selected_value | escape }}</span></legend>
                  <div class="options__list options__list--radios">
                    {%- for value in option.values -%}
                      {%- assign value_variant = value.variant -%}
                      {%- assign value_sold_out = false -%}
                      {%- if value_variant == nil or value_variant.available == false -%}{%- assign value_sold_out = true -%}{%- endif -%}
                      <label class="option-chip{% if value_sold_out %} option-chip--soldout{% endif %}">
                        <input class="visually-hidden" type="radio" name="monetta-option-{{ option.position }}" value="{{ value | escape }}"{% if value.selected %} checked{% endif %} data-option-input>
                        <span class="option-chip__check" aria-hidden="true">{% render 'monetta-icon', name: 'check', size: 16 %}</span>
                        {% render 'monetta-swatch', swatch: value.swatch %}
                        <span class="option-chip__label">{{ value | escape }}</span>
                        {%- if value_sold_out -%}<span class="option-chip__note">Agotado</span>{%- endif -%}
                      </label>
                    {%- endfor -%}
                  </div>
                  <div class="options__list options__list--links">
                    {%- for value in option.values -%}
                      {%- assign value_name = value | append: '' -%}
                      {%- assign target = value.variant -%}
                      {%- if target == nil -%}
                        {%- for candidate in product.variants -%}
                          {%- if candidate.options[option_index] == value_name -%}
                            {%- assign target = candidate -%}
                            {%- break -%}
                          {%- endif -%}
                        {%- endfor -%}
                      {%- endif -%}
                      {%- assign link_sold_out = false -%}
                      {%- if target == nil or target.available == false -%}{%- assign link_sold_out = true -%}{%- endif -%}
                      {%- if target -%}
                        <a class="option-chip option-chip--link{% if link_sold_out %} option-chip--soldout{% endif %}" href="{{ product.url }}?variant={{ target.id }}"{% if value.selected %} aria-current="true"{% endif %}>
                          <span class="option-chip__check" aria-hidden="true">{% render 'monetta-icon', name: 'check', size: 16 %}</span>
                          {% render 'monetta-swatch', swatch: value.swatch %}
                        <span class="option-chip__label">{{ value | escape }}</span>
                          {%- if link_sold_out -%}<span class="option-chip__note">Agotado</span>{%- endif -%}
                        </a>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                </fieldset>
              {%- endfor -%}
              <p class="choice-hint" data-selection-status hidden></p>
            </div>
          {%- endunless -%}

          {%- comment -%}Trust row (product_screen.dart _TrustRow): three columns split by hairlines, line icons, the approved copy.{%- endcomment -%}
          <ul class="guia-trust" role="list">
            <li><svg class="guia-trust__icon" viewBox="0 0 24 24" width="26" height="26" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" d="M12 2.8 20.5 7.4v9.2L12 21.2l-8.5-4.6V7.4zM3.5 7.4 12 12l8.5-4.6M12 12v9.2M7.8 5.1l8.4 4.6"/></svg><span><strong>Entrega estimada</strong><span>3 a 5 días</span></span></li>
            <li><svg class="guia-trust__icon" viewBox="0 0 24 24" width="26" height="26" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" stroke-linecap="round" d="M12 2.8 19.5 5.6v5.6c0 4.6-3.2 8.6-7.5 10-4.3-1.4-7.5-5.4-7.5-10V5.6zM8.6 12.1l2.4 2.4 4.4-4.6"/></svg><span><strong>Productos originales</strong><span>Garantía de autenticidad</span></span></li>
            <li><svg class="guia-trust__icon" viewBox="0 0 24 24" width="26" height="26" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" stroke-linecap="round" d="M3 6.5h18v11H3zM3 10h18M6.5 14.5h3"/></svg><span><strong>Pago seguro</strong><span>Compra con confianza</span></span></li>
          </ul>
          <div class="product-panel__buy">
            {%- if current.available -%}
              <input type="hidden" name="quantity" value="1">
              <div class="buy-stack">
                <button type="submit" name="add" class="btn btn--primary btn--block" data-add><span class="spinner" data-spinner hidden aria-hidden="true"></span><span data-label>Agregar a bolsa</span></button>
                {%- if show_pay -%}
                  {%- comment -%}Without JavaScript Shopify adds the piece and follows return_to; with it monetta-product.js adds through the same
                  exact-variant path and then opens the checkout instead of the bag.{%- endcomment -%}
                  <button type="submit" name="return_to" value="{{ routes.root_url | append: '/checkout' | replace: '//', '/' }}" class="btn btn--outline btn--block" data-add data-buy-now><span class="spinner" data-spinner hidden aria-hidden="true"></span><span data-label>Comprar ahora</span></button>
                {%- endif -%}
              </div>
            {%- else -%}
              <div class="buy-inline">
                <button type="submit" name="add" class="btn btn--primary btn--block" data-add disabled><span class="spinner" data-spinner hidden aria-hidden="true"></span><span data-label>Agotado</span></button>
              </div>
            {%- endif -%}
            <p class="form-error" data-add-error id="add-error-{{ section.id }}" role="alert" hidden>{% render 'monetta-icon', name: 'error', size: 18 %}<span data-error-text></span></p>
          </div>
        {%- liquid
          assign tone = 'stock'
          assign availability_text = 'Disponible.'
          if current.available == false
            assign tone = 'soldout'
            if product.has_only_default_variant
              assign availability_text = 'Agotado por ahora.'
            else
              assign availability_text = 'Esta opción está agotada.'
            endif
          elsif product.metafields.custom.entrega.value == 'Sobre pedido'
            assign tone = 'pedido'
            assign availability_text = 'Sobre pedido.'
          elsif product.tags contains 'Envío inmediato' or product.metafields.custom.entrega.value == 'Envío inmediato'
            assign availability_text = 'Envío inmediato · lista en el inventario de Monetta.'
          endif
        -%}
        <p class="availability availability--{{ tone }}" data-availability><span class="availability__dot" aria-hidden="true"></span><span>{{ availability_text }}</span></p>
          <p class="product-panel__tax">El envío y los descuentos se calculan en el checkout.</p>

          {%- if show_apartado -%}
            <div class="other-ways">
              <h2 class="other-ways__title">Otras formas de comprar</h2>
              {%- if show_apartado -%}
                {%- capture apartado_text -%}Hola, me interesa {% if current.available %}apartar{% else %}preguntar por la disponibilidad de{% endif %}: {{ product.title }}{% if variant_label != blank %} ({{ variant_label }}){% endif %} — {{ current.price | money_with_currency }}. {{ product_link }}{%- endcapture -%}
                <div class="other-ways__apartado">
                  <strong>{% if current.available %}Apartar por WhatsApp{% else %}Preguntar por disponibilidad{% endif %}</strong>
                  <span class="text-muted">{% if current.available %}{{ section.settings.apartado_copy | escape }}{% else %}Te confirmamos por WhatsApp si la pieza volverá o si hay una alternativa.{% endif %}</span>
                  <a class="btn btn--text" style="justify-self:start;padding:0" href="https://wa.me/{{ whatsapp }}?text={{ apartado_text | url_encode }}" target="_blank" rel="noopener">{% if current.available %}Solicitar apartado{% else %}Preguntar por WhatsApp{% endif %} {% render 'monetta-icon', name: 'arrowForward', size: 18 %}<span class="visually-hidden"> (se abre en una pestaña nueva)</span></a>
                </div>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endform -%}

        <script type="application/json" data-product-variants>
          [{% for v in product.variants %}{"id":{{ v.id }},"options":{{ v.options | json }},"available":{{ v.available | json }}}{% unless forloop.last %},{% endunless %}{% endfor %}]
        </script>
      </div>

      {%- if has_service -%}
        <ul class="service-rows" role="list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'service' and block.settings.text != blank -%}
              <li {{ block.shopify_attributes }}>{% render 'monetta-icon', name: block.settings.icon, size: 20 %}<span>{{ block.settings.text | escape }}</span></li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}

      <div class="product-panel__accordions">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'description' -%}
                <details class="accordion"{% if block.settings.open %} open{% endif %} {{ block.shopify_attributes }}>
                  <summary>{{ block.settings.title | escape }}{% render 'monetta-icon', name: 'expand', size: 20 %}</summary>
                  <div class="accordion__body rte">{% if product.description != blank %}{{ product.description }}{% else %}<p>{% if category != blank %}{{ category | escape }}{% if brand != blank %} de {{ brand | escape }}{% endif %}. {% endif %}Consulta los detalles de esta pieza.</p>{% endif %}</div>
                </details>
            {%- when 'details' -%}
              <details class="accordion"{% if block.settings.open %} open{% endif %} {{ block.shopify_attributes }}>
                <summary>{{ block.settings.title | escape }}{% render 'monetta-icon', name: 'expand', size: 20 %}</summary>
                <div class="accordion__body">
                  <dl class="facts" data-variant-details>
                    {%- if brand != blank -%}<div><dt>Marca</dt><dd>{{ brand | escape }}</dd></div>{%- endif -%}
                    {% render 'monetta-product-facts', product: product, category: category %}
                    {%- for option in product.options_with_values -%}
                      {%- unless product.has_only_default_variant -%}
                        <div><dt>{% render 'monetta-label', kind: 'option', name: option.name %} ({{ option.values.size }})</dt><dd>{% for value in option.values %}{{ value | escape }}{% unless forloop.last %} · {% endunless %}{% endfor %}</dd></div>
                      {%- endunless -%}
                    {%- endfor -%}
                    {%- if current.sku != blank -%}<div><dt>SKU</dt><dd>{{ current.sku | escape }}</dd></div>{%- endif -%}
                  </dl>
                </div>
              </details>
            {%- when 'custom' -%}
              {%- if block.settings.content != blank -%}
                <details class="accordion"{% if block.settings.open %} open{% endif %} {{ block.shopify_attributes }}>
                  <summary>{{ block.settings.title | escape }}{% render 'monetta-icon', name: 'expand', size: 20 %}</summary>
                  <div class="accordion__body rte">{{ block.settings.content }}</div>
                </details>
              {%- endif -%}
          {%- endcase -%}
        {%- endfor -%}
      </div>

      {%- for block in section.blocks -%}
        {%- if block.type == '@app' -%}
          <div class="product-panel__app" {{ block.shopify_attributes }}>{% render block %}</div>
        {%- endif -%}
      {%- endfor -%}

      {%- if section.settings.show_whatsapp_question and whatsapp != blank -%}
        {%- capture question_text -%}Hola, tengo una pregunta sobre: {{ product.title }}. {{ product_link }}{%- endcapture -%}
        <a class="whatsapp-link" href="https://wa.me/{{ whatsapp }}?text={{ question_text | url_encode }}" target="_blank" rel="noopener">{% render 'monetta-icon', name: 'chat', size: 18 %} Escribir por WhatsApp<span class="visually-hidden"> (se abre en una pestaña nueva)</span></a>
      {%- endif -%}
    </div>
  </div>

  <div class="purchase-dock" data-purchase-dock>
    {%- if current.available -%}
      <button type="submit" form="{{ form_id }}" name="add" class="btn btn--primary" data-add><span class="spinner" data-spinner hidden aria-hidden="true"></span><span data-label>Agregar a bolsa</span></button>
    {%- else -%}
      <button type="submit" form="{{ form_id }}" name="add" class="btn btn--primary" data-add disabled><span class="spinner" data-spinner hidden aria-hidden="true"></span><span data-label>Agotado</span></button>
    {%- endif -%}
  </div>
</article>

{% schema %}
{
  "name": "Monetta · Producto",
  "settings": [
    { "type": "header", "content": "Compra" },
    { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Mostrar «Comprar ahora»", "default": true, "info": "Agrega la pieza elegida y abre el checkout." },
    { "type": "checkbox", "id": "show_apartado", "label": "Mostrar «Apartar por WhatsApp»", "default": true },
    { "type": "textarea", "id": "apartado_copy", "label": "Texto del apartado", "default": "Solicitud manual. Enviar el mensaje no aparta la pieza ni cobra nada." },
    { "type": "checkbox", "id": "show_whatsapp_question", "label": "Mostrar «Escribir por WhatsApp»", "default": true },
    { "type": "text", "id": "whatsapp_number", "label": "WhatsApp (número con lada)", "default": "528261066868", "info": "Solo dígitos, con 52 al inicio." }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Dato de servicio",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icono", "default": "truck", "options": [
          { "value": "truck", "label": "Envío" },
          { "value": "refresh", "label": "Cambios" },
          { "value": "check", "label": "Palomita" },
          { "value": "lock", "label": "Candado" }
        ] },
        { "type": "text", "id": "text", "label": "Texto", "default": "Envíos a todo México." }
      ]
    },
    {
      "type": "description",
      "name": "Descripción",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "title", "label": "Título", "default": "Descripción" },
        { "type": "checkbox", "id": "open", "label": "Abierto al cargar", "default": false }
      ]
    },
    {
      "type": "details",
      "name": "Detalles",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "title", "label": "Título", "default": "Detalles" },
        { "type": "checkbox", "id": "open", "label": "Abierto al cargar", "default": false }
      ]
    },
    {
      "type": "custom",
      "name": "Texto desplegable",
      "settings": [
        { "type": "text", "id": "title", "label": "Título", "default": "Envíos y devoluciones" },
        { "type": "richtext", "id": "content", "label": "Contenido" },
        { "type": "checkbox", "id": "open", "label": "Abierto al cargar", "default": false }
      ]
    },
    { "type": "@app" }
  ]
}
{% endschema %}
