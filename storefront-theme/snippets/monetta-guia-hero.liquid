{%- doc -%}
  GuideHero: a guide photograph run full bleed, a cream wash on the free side and the copy on it in the guide serif
  (Cormorant Garamond). Brand titles read upright, silhouette and category titles italic light, as on the guide's
  collection banners. The heading level is the caller's.

  @param {string} photo - Base name for monetta-guia-photo, e.g. 'coleccion-coach'.
  @param {string} title - Heading text.
  @param {string} [side] - 'left' (default) or 'right': where the copy sits.
  @param {string} [tag] - Heading element (default 'h1').
  @param {boolean} [caps] - Title in capitals (collection banners).
  @param {boolean} [italic] - Title in the light italic (silhouettes, categories, «MAYOREO»).
  @param {string} [eyebrow] - Line above the title.
  @param {string} [accent] - Script word under the title, underlined in gold («mayoreo»).
  @param {string} [body] - Italic copy under the title.
  @param {string} [body_accent] - Words that close the body, underlined in gold («marcas favoritas»).
  @param {string} [pill_label] - Label of the light gold pill.
  @param {string} [url] - Destination: the pill is a link, or the whole photograph is when there is no pill.
  @param {string} [focus] - object-position of the photograph, e.g. '30% 50%'.
  @param {boolean} [eager] - First viewport only.
  @param {string} [id] - Heading id (for aria-labelledby).
  @param {boolean} [lettered] - The photograph already carries the lettering (the delivered banners B31 / B32): no wash, and the
    title and copy stay in the page only as the single text equivalent for screen readers.
  @param {string} [mobile_title] - Asset of the delivered mobile title lettering (03_banners/lettering_mobile). With
    mobile_body, phones show title, then copy beside the photograph's right side, on the banner's own tone (UI v4.1 hero_typography).
  @param {string} [mobile_title_size] - Its pixel size, 'WxH'.
  @param {string} [mobile_body] - Asset of the delivered mobile copy lettering.
  @param {string} [mobile_body_size] - Its pixel size, 'WxH'.
  @param {string} [tone] - Background colour of the banner, for the phone composition.
{%- enddoc -%}
{%- liquid
  assign side = side | default: 'left'
  assign tag = tag | default: 'h1'
  assign has_mobile = false
  if lettered and mobile_title != blank and mobile_body != blank
    assign has_mobile = true
    assign title_size = mobile_title_size | split: 'x'
    assign body_size = mobile_body_size | split: 'x'
  endif
-%}
<div class="guide-hero guide-hero--text-{{ side }}{% if lettered %} guide-hero--lettered{% endif %}{% if has_mobile %} guide-hero--has-mobile{% endif %}" style="{% if focus != blank %}--hero-focus: {{ focus }};{% endif %}{% if tone != blank %} --hero-tone: {{ tone }};{% endif %}">
  {% render 'monetta-guia-photo', name: photo, class: 'guide-hero__photo', eager: eager %}
  {%- if has_mobile -%}
    <div class="guide-hero__mobile" aria-hidden="true">
      <img class="guide-hero__m-title" src="{{ mobile_title | asset_url }}" width="{{ title_size[0] }}" height="{{ title_size[1] }}" alt="" decoding="async">
      <div class="guide-hero__m-row">
        <img class="guide-hero__m-body" src="{{ mobile_body | asset_url }}" width="{{ body_size[0] }}" height="{{ body_size[1] }}" alt="" decoding="async">
        {% render 'monetta-guia-photo', name: photo, class: 'guide-hero__m-photo', eager: eager %}
      </div>
    </div>
  {%- endif -%}
  {%- unless lettered -%}<span class="guide-hero__scrim" aria-hidden="true"></span>{%- endunless -%}
  {%- if url != blank and pill_label == blank -%}
    <a class="guide-hero__link" href="{{ url }}" aria-label="{{ title | escape }}"></a>
  {%- endif -%}
  <div class="guide-hero__copy{% if lettered %} visually-hidden{% endif %}">
    {%- if eyebrow != blank -%}<p class="guide-hero__eyebrow">{{ eyebrow | escape }}</p>{%- endif -%}
    <{{ tag }} class="guide-hero__title{% if caps %} guide-hero__title--caps{% endif %}{% if italic %} guide-hero__title--italic{% endif %}"{% if id != blank %} id="{{ id }}"{% endif %}>{{ title | escape }}{% if accent != blank %}<span class="visually-hidden"> {{ accent | escape }}</span>{% endif %}</{{ tag }}>
    {%- if accent != blank -%}<p class="guide-hero__accent guide-script guide-script--underlined" aria-hidden="true">{{ accent | escape }}</p>{%- endif -%}
    {%- if body != blank -%}
      <p class="guide-hero__body">{{ body | escape }}{% if body_accent != blank %} <span class="guide-hero__body-accent">{{ body_accent | escape }}</span>{% endif %}</p>
    {%- endif -%}
    {%- if pill_label != blank and url != blank -%}
      <a class="guide-pill" href="{{ url }}"><span class="guide-pill__label">{{ pill_label | escape }}</span></a>
    {%- endif -%}
  </div>
</div>
