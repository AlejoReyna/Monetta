{%- doc -%}
  Prints the destination of a guide category, silhouette, brand or page. A collection or page the owner creates with
  the expected handle wins; until then Shopify's automatic listings stand in (checked on staging: tag filters for the
  silhouettes, product types for carteras and relojes, the vendor listing for brands; guia-1a1/RESULTADO.md, F0).
  Capture it and strip: {% capture url %}{% render 'monetta-guia-url', key: 'tote' %}{% endcapture %}

  @param {string} key - bolsas, carteras, relojes, perfumes, accesorios, crossbody, tote, shoulder, satchel, categorias,
    catalogo, mayoreo, rewards, contacto or brand.
  @param {string} [brand] - The vendor, when key is 'brand'.
{%- enddoc -%}
{%- liquid
  assign handle = ''
  assign alt_handle = ''
  assign fallback = ''
  case key
    when 'bolsas'
      assign handle = 'bolsas'
      if collections['bolsas'].id == blank and collections['guess'].id != blank
        assign guess_title = collections['guess'].title | strip | downcase
        if guess_title == 'bolsas' or guess_title == 'bolsos'
          assign alt_handle = 'guess'
        endif
      endif
      assign fallback = routes.all_products_collection_url | append: '/bolsa'
    when 'carteras'
      assign handle = 'carteras'
      assign alt_handle = 'carteras-1'
      assign fallback = routes.collections_url | append: '/types?q=Cartera'
    when 'calzado'
      assign handle = 'calzado'
      assign fallback = routes.collections_url | append: '/types?q=Calzado'
    when 'ofertas'
      assign handle = 'ofertas'
      assign fallback = routes.all_products_collection_url | append: '?view=ofertas'
    when 'relojes'
      assign handle = 'relojes'
      assign alt_handle = 'relojes-1'
      assign fallback = routes.collections_url | append: '/types?q=Reloj'
    when 'perfumes'
      assign handle = 'perfumes'
      assign fallback = routes.all_products_collection_url | append: '/perfume'
    when 'accesorios'
      assign handle = 'accesorios'
      assign fallback = routes.all_products_collection_url | append: '/accessory'
    when 'crossbody'
      assign handle = 'crossbody'
      assign alt_handle = 'crossbodys'
      assign fallback = routes.all_products_collection_url | append: '/crossbody'
    when 'tote', 'totes'
      assign handle = 'totes'
      assign alt_handle = 'tote'
      assign fallback = routes.all_products_collection_url | append: '/tote'
    when 'shoulder'
      assign handle = 'shoulder'
      assign alt_handle = 'hombro'
      assign fallback = routes.all_products_collection_url | append: '/shoulder'
    when 'satchel', 'bolsos-de-mano'
      assign handle = 'bolsos-de-mano'
      assign alt_handle = 'satchel'
      assign fallback = routes.all_products_collection_url | append: '/satchel'
    when 'brand'
      assign brand_key = brand | handleize
      assign handle = brand_key
      assign fallback = brand | url_for_vendor
      if brand_key == 'guess'
        if collections['guess-1'].id != blank
          assign handle = 'guess-1'
        elsif collections['guess'].id != blank
          assign guess_col_title = collections['guess'].title | strip | downcase
          unless guess_col_title contains 'guess'
            assign handle = 'guess-brand-only'
          endunless
        endif
      elsif brand_key == 'olaplex'
        assign alt_handle = 'olalplex'
      endif
  endcase
-%}
{%- if handle != blank -%}
  {%- if collections[handle].id != blank -%}{{ collections[handle].url }}{%- elsif alt_handle != blank and collections[alt_handle].id != blank -%}{{ collections[alt_handle].url }}{%- else -%}{{ fallback }}{%- endif -%}
{%- else -%}
  {%- case key -%}
    {%- when 'categorias' -%}{{ routes.collections_url }}
    {%- when 'marcas' -%}{{ routes.collections_url }}?view=marcas
    {%- when 'inicio' -%}{{ routes.root_url }}
    {%- when 'catalogo' -%}{{ routes.all_products_collection_url }}
    {%- comment -%}
      Guide pages use the new templates page.guia-mayoreo, -contacto and -rewards; the owner's own templates stay. Until a
      page is assigned its guide template in the admin, the link asks for it with ?view= on the page that exists.
    {%- endcomment -%}
    {%- when 'mayoreo', 'rewards', 'contacto' -%}
      {%- liquid
        assign suffix = 'guia-' | append: key
        assign target = pages[key]
        if key == 'contacto' and target.id == blank
          assign target = pages['contact']
        elsif key == 'mayoreo' and target.id == blank
          assign target = pages['como-vender']
        endif
      -%}
      {%- if target.id != blank and target.template_suffix == suffix -%}
        {{ target.url }}
      {%- elsif target.id != blank -%}
        {{ target.url }}?view={{ suffix }}
      {%- elsif key == 'mayoreo' or key == 'contacto' -%}
        {{ routes.root_url }}?view={{ suffix }}
      {%- endif -%}
  {%- endcase -%}
{%- endif -%}
