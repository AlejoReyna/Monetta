{%- doc -%}
  The Monetta <head> shared by layout/monetta.liquid and layout/theme.liquid: document metadata (Spanish titles for the page types
  whose Shopify title follows the store's English locale), the bundled fonts, the Monetta stylesheets and scripts and the
  MonettaConfig routes. The layouts add {{ content_for_header }} themselves, which only works in a layout file.
{%- enddoc -%}
{%- liquid
  assign t = template.name
  assign og_image = page_image | default: shop.brand.logo
  assign doc_title = page_title
  case request.page_type
    when 'cart'
      assign doc_title = 'Mi bolsa'
    when '404'
      assign doc_title = 'Página no encontrada'
    when 'list-collections'
      assign doc_title = 'Colecciones'
    when 'search'
      if search.performed
        assign doc_title = 'Resultados para «' | append: search.terms | append: '»'
      else
        assign doc_title = 'Buscar'
      endif
    when 'collection'
      if collection.handle == 'all'
        assign seeded_title = collection.title | strip | downcase
        if seeded_title == 'products' or seeded_title == 'all products' or seeded_title == 'all' or seeded_title == 'productos' or seeded_title == 'todos los productos'
          assign doc_title = 'Catálogo'
        endif
      endif
    when 'blog'
      assign blog_key = blog.title | strip | downcase
      if blog.handle == 'news' and blog_key == 'news'
        assign doc_title = 'Noticias'
      endif
  endcase
-%}
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content">
<meta name="theme-color" content="#fbf8f2">
<link rel="canonical" href="{{ canonical_url }}">
<link rel="icon" type="image/png" sizes="32x32" href="{{ 'monetta-favicon-32.png' | asset_url }}">
<link rel="icon" type="image/png" sizes="96x96" href="{{ 'monetta-favicon-96.png' | asset_url }}">

<title>
  {{- doc_title -}}
  {%- if current_tags %} &ndash; etiquetas: {{ current_tags | join: ', ' }}{% endif -%}
  {%- if current_page != 1 %} &ndash; página {{ current_page }}{% endif -%}
  {%- unless doc_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
</title>
{%- if page_description %}
  <meta name="description" content="{{ page_description | escape }}">
{%- endif %}
<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ doc_title | escape }}">
<meta property="og:type" content="{% if t == 'product' %}product{% else %}website{% endif %}">
{%- if page_description %}
  <meta property="og:description" content="{{ page_description | escape }}">
{%- endif %}
{%- if og_image %}
  <meta property="og:image" content="https:{{ og_image | image_url: width: 1200 }}">
{%- endif %}
<meta name="twitter:card" content="summary_large_image">

{% render 'monetta-fonts' %}
{{ 'monetta-tokens.css' | asset_url | stylesheet_tag }}
{{ 'monetta-base.css' | asset_url | stylesheet_tag }}
{{ 'monetta-components.css' | asset_url | stylesheet_tag }}
{{ 'monetta-pages.css' | asset_url | stylesheet_tag }}
{{ 'monetta-home-22oct.css' | asset_url | stylesheet_tag }}
{{ 'monetta-theme.css' | asset_url | stylesheet_tag }}
{{ 'monetta-app-alignment.css' | asset_url | stylesheet_tag }}
{{ 'monetta-guia.css' | asset_url | stylesheet_tag }}
{{ 'monetta-predictive-search.css' | asset_url | stylesheet_tag }}

<script>
  document.documentElement.classList.add('js');
  // The launch reveal (snippets/monetta-intro.liquid) plays once per browser session, as the app's plays once per launch.
  {%- unless request.design_mode %}
  try {
    if (!sessionStorage.getItem('monetta-intro') && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      sessionStorage.setItem('monetta-intro', '1');
      document.documentElement.classList.add('has-intro');
    }
  } catch (error) {}
  {%- endunless %}
  window.MonettaConfig = {
    routes: {
      root: {{ routes.root_url | json }},
      cart: {{ routes.cart_url | json }},
      cartAdd: {{ routes.cart_add_url | append: '.js' | json }},
      cartChange: {{ routes.cart_change_url | append: '.js' | json }},
      cartUpdate: {{ routes.cart_update_url | append: '.js' | json }},
      cartJson: {{ routes.cart_url | append: '.js' | json }},
      search: {{ routes.search_url | json }},
      allProducts: {{ routes.all_products_collection_url | json }}
    },
    template: {{ t | json }},
    currency: {{ cart.currency.iso_code | json }},
    storeLang: {{ request.locale.iso_code | json }}
  };
</script>
<script src="{{ 'monetta-core.js' | asset_url }}" defer></script>
<script src="{{ 'monetta-cart.js' | asset_url }}" defer></script>
<script src="{{ 'monetta-merchandising.js' | asset_url }}" defer></script>
<script src="{{ 'monetta-search-history.js' | asset_url }}" defer></script>
<script src="{{ 'monetta-guia.js' | asset_url }}" defer></script>
<script src="{{ 'monetta-predictive-search.js' | asset_url }}" defer></script>
{%- if t == 'collection' or t == 'search' %}
  <script src="{{ 'monetta-listing.js' | asset_url }}" defer></script>
{%- endif %}
{%- if t == 'product' %}
  <script src="{{ 'monetta-product.js' | asset_url }}" defer></script>
{%- endif %}
