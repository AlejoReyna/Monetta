{%- doc -%}
  One gold wordmark tile of «Tus marcas favoritas» and «Categorías» (GuideBrandTile in the app). A tile with a logo is always
  shown, as the app shows its twelve: when the store sells the brand it opens the brand's listing, otherwise the search for
  its name, because the vendor listing of a brand the store does not sell is Shopify's 404. A text-only tile (no logo) is
  shown only when the store sells the brand.

  @param {string} entry - 'Name', 'Name:art' or 'Name:art:Vendor'. art picks assets/monetta-app-brand-<art>.webp; Vendor is
    the product vendor when it differs from the name shown (Dior is sold as Christian Dior).
{%- enddoc -%}
{%- liquid
  assign parts = entry | split: ':'
  assign name = parts[0]
  assign art = parts[1] | default: ''
  assign vendor = parts[2] | default: name
  assign sold = false
  if shop.vendors contains vendor
    assign sold = true
  endif
-%}
{%- if sold or art != blank -%}
  {%- if sold -%}
    {%- capture url -%}{% render 'monetta-guia-url', key: 'brand', brand: vendor %}{%- endcapture -%}
  {%- else -%}
    {%- capture url -%}{{ routes.search_url }}?type=product&q={{ name | url_encode }}{%- endcapture -%}
  {%- endif -%}
  <li>
    <a class="guia-brand" href="{{ url | strip }}" aria-label="Ver {{ name }}">
      {%- if art != blank -%}
        <img src="{{ 'monetta-app-brand-' | append: art | append: '.webp' | asset_url }}" width="600" height="600" alt="" loading="lazy" decoding="async">
      {%- else -%}
        <span class="guia-brand__name">{{ name }}</span>
      {%- endif -%}
    </a>
  </li>
{%- endif -%}
