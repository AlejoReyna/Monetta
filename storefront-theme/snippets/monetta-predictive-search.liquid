{%- doc -%}
  Standalone native search form using the same enhancement as the header and search page.
  @param {string} instance_id - Unique prefix for the input.
  @param {string} [input_id] - Optional existing input ID.
  @param {string} [placeholder] - Optional merchant placeholder.
  @param {number} [limit] - Suggestions per resource, capped at six.
  @param {number} [recent_limit] - Visible recent searches, capped at five.
  @param {boolean} [search_autofocus] - Preserve the listing focus hook.
  @param {boolean} [include_assets] - Defaults to true.
{%- enddoc -%}
{%- liquid
  assign predictive_id = instance_id | default: section.id | default: 'search'
  assign predictive_input_id = predictive_id | append: '-input'
  if input_id != blank
    assign predictive_input_id = input_id
  endif
-%}
{%- unless include_assets == false -%}
  {{ 'monetta-predictive-search.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'monetta-search-history.js' | asset_url }}" defer></script>
  <script src="{{ 'monetta-predictive-search.js' | asset_url }}" defer></script>
{%- endunless -%}
<monetta-predictive-search class="monetta-predictive-search" lang="es" data-limit="{{ limit | default: 6 | at_least: 1 | at_most: 6 }}" data-recent-limit="{{ recent_limit | default: 5 | at_least: 0 | at_most: 5 }}" data-predictive-url="{{ routes.predictive_search_url | escape }}">
  <form action="{{ routes.search_url }}" method="get" role="search" aria-label="Buscar productos">
    <div class="search-field">
      {% render 'monetta-icon', name: 'search', size: 20 %}
      <label class="visually-hidden" for="{{ predictive_input_id | escape }}">Buscar productos</label>
      <input id="{{ predictive_input_id | escape }}" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ placeholder | default: 'Buscar productos' | escape }}" autocomplete="off" spellcheck="false" enterkeyhint="search"{% if search_autofocus %} data-search-autofocus{% endif %}>
      <input type="hidden" name="type" value="product">
      <button type="button" class="icon-button search-field__clear" data-search-clear aria-label="Borrar búsqueda" hidden>{% render 'monetta-icon', name: 'close', size: 20 %}</button>
    </div>
    <button type="submit" class="btn">Buscar</button>
  </form>
  {% render 'monetta-predictive-panel' %}
</monetta-predictive-search>
