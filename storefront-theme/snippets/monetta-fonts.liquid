{%- doc -%}
  Inter (400/500/600/700) and Playfair Display (400), the app's bundled OFL fonts, served as WOFF2 from the theme's assets.
  Licences: assets/monetta-Inter-OFL.txt and assets/monetta-PlayfairDisplay-OFL.txt. Regular, SemiBold and Playfair are preloaded.
{%- enddoc -%}
{{ 'Inter-Regular.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
{{ 'Inter-SemiBold.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
{{ 'PlayfairDisplay-Regular.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
<style>
  @font-face {
    font-family: 'Inter';
    src: url('{{ 'Inter-Regular.woff2' | asset_url }}') format('woff2');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Inter';
    src: url('{{ 'Inter-Medium.woff2' | asset_url }}') format('woff2');
    font-weight: 500;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Inter';
    src: url('{{ 'Inter-SemiBold.woff2' | asset_url }}') format('woff2');
    font-weight: 600;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Inter';
    src: url('{{ 'Inter-Bold.woff2' | asset_url }}') format('woff2');
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Playfair Display';
    src: url('{{ 'PlayfairDisplay-Regular.woff2' | asset_url }}') format('woff2');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
</style>
