{%- doc -%}
  MONETTA UI v4.1 (§006, tokens_v4.1.json): DM Sans 400/600/700 for UI, product and price; Cormorant Garamond 400/700 for
  editorial titles. Files are the ones delivered in MONETTA_Entrega_Final_v4.1/06_referencias/fuentes (TTF, OFL).
  The guide's Cormorant 300/italic/500 and Mrs Saint Delafield stay only for the older guide lettering until the v4.1
  banner text layers replace it. Licences: assets/monetta-{DMSans,CormorantGaramond,MrsSaintDelafield}-OFL.txt.
  DM Sans 400 and 600 and Cormorant 400 are preloaded.
{%- enddoc -%}
{{ 'DMSans-Regular.ttf' | asset_url | preload_tag: as: 'font', type: 'font/ttf', crossorigin: 'anonymous' }}
{{ 'DMSans-SemiBold.ttf' | asset_url | preload_tag: as: 'font', type: 'font/ttf', crossorigin: 'anonymous' }}
{{ 'CormorantGaramond-Regular.ttf' | asset_url | preload_tag: as: 'font', type: 'font/ttf', crossorigin: 'anonymous' }}
<style>
  @font-face {
    font-family: 'DM Sans';
    src: url('{{ 'DMSans-Regular.ttf' | asset_url }}') format('truetype');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'DM Sans';
    src: url('{{ 'DMSans-SemiBold.ttf' | asset_url }}') format('truetype');
    font-weight: 600;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'DM Sans';
    src: url('{{ 'DMSans-Bold.ttf' | asset_url }}') format('truetype');
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Cormorant Garamond';
    src: url('{{ 'CormorantGaramond-Regular.ttf' | asset_url }}') format('truetype');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
