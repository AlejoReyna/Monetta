{%- doc -%}
  Inter (400/500/600/700) and Playfair Display (400), the app's bundled OFL fonts, served as WOFF2 from the theme's assets.
  The guide's free stand-ins (PR #33): Cormorant Garamond (300, 400, 500; 300 and 400 italic) for text on photographs and
  Mrs Saint Delafield for the script accents. They are never preloaded: they appear below the header, and swap is fine.
  Licences: assets/monetta-{Inter,PlayfairDisplay,CormorantGaramond,MrsSaintDelafield}-OFL.txt. Regular, SemiBold and Playfair
  are preloaded.
{%- enddoc -%}
{{ 'Inter-Regular.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
{{ 'Inter-SemiBold.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
{{ 'PlayfairDisplay-Regular.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
<style>
  @font-face {
    font-family: 'Inter';
    src: url('{{ 'Inter-Regular.woff2' | asset_url }}') format('woff2');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Inter';
    src: url('{{ 'Inter-Medium.woff2' | asset_url }}') format('woff2');
    font-weight: 500;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Inter';
    src: url('{{ 'Inter-SemiBold.woff2' | asset_url }}') format('woff2');
    font-weight: 600;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Inter';
    src: url('{{ 'Inter-Bold.woff2' | asset_url }}') format('woff2');
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Playfair Display';
    src: url('{{ 'PlayfairDisplay-Regular.woff2' | asset_url }}') format('woff2');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Cormorant Garamond';
    src: url('{{ 'CormorantGaramond-Light.woff2' | asset_url }}') format('woff2');
    font-weight: 300;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Cormorant Garamond';
    src: url('{{ 'CormorantGaramond-LightItalic.woff2' | asset_url }}') format('woff2');
    font-weight: 300;
    font-style: italic;
    font-display: swap;
  }
  @font-face {
    font-family: 'Cormorant Garamond';
    src: url('{{ 'CormorantGaramond-Regular.woff2' | asset_url }}') format('woff2');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Cormorant Garamond';
    src: url('{{ 'CormorantGaramond-Italic.woff2' | asset_url }}') format('woff2');
    font-weight: 400;
    font-style: italic;
    font-display: swap;
  }
  @font-face {
    font-family: 'Cormorant Garamond';
    src: url('{{ 'CormorantGaramond-Medium.woff2' | asset_url }}') format('woff2');
    font-weight: 500;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Mrs Saint Delafield';
    src: url('{{ 'MrsSaintDelafield-Regular.woff2' | asset_url }}') format('woff2');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
</style>
