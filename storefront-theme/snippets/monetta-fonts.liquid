    src: url('{{ 'CormorantGaramond-Bold.ttf' | asset_url }}') format('truetype');
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Cormorant Garamond';
    src: url('{{ 'CormorantGaramond-Light.woff2' | asset_url }}') format('woff2');
    font-weight: 300;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Cormorant Garamond';
    src: url('{{ 'CormorantGaramond-LightItalic.woff2' | asset_url }}') format('woff2');
