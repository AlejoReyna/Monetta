{%- doc -%}
  The shared product card (MonettaProductTile), as the client's 29 Oct reference: one warm card with a 6px radius holding a square
  photo multiplied onto the card ground, the heart, brand, name and price in Playfair, then the brown «VER PRODUCTO» pill.
  Tapping the card opens the preview (#quick-view, assets/monetta-guia.js); the pill and a modified click (new tab) open the
  product page, and without JavaScript the whole card is a plain link to it. Everything shown is read from the product at render
  time (price, compare-at, availability); nothing is cached.

  @param {object} product - Shopify product.
  @param {string} [density] - 'grid' (default; two-line name) or 'compact' (one-line name) for Home rails; 'mini' is the product
    page's four-across related row: photo, brand, one-line name and price, no pill.
  @param {boolean} [eager] - Eager-load the photo (first row only).
  @param {string} [sizes] - The sizes attribute of the photo's slot.
  @param {string} [xl_widths] - Additional image candidates from 1280px only; mobile cards and compact rails keep 600px.
  @param {boolean} [listing_card] - Reserve empty metadata slots for XL collection row alignment.
  @param {boolean} [view_button] - Pass false to hide the «VER PRODUCTO» pill; every grid and rail card shows it.
{%- enddoc -%}
{%- liquid
  assign density = density | default: 'grid'
  assign sizes = sizes | default: '(min-width: 1200px) 260px, (min-width: 768px) 33vw, 50vw'
  assign variant = product.selected_or_first_available_variant
  assign in_stock = product.available
  assign currency = cart.currency.iso_code
  assign show_view = true
  if view_button == false or density == 'mini'
    assign show_view = false
  endif
  assign pct = 0
  if in_stock and variant.compare_at_price > variant.price
    assign pct = variant.compare_at_price | minus: variant.price | times: 100.0 | divided_by: variant.compare_at_price | round
  endif
  capture brand
    render 'monetta-facet', product: product, kind: 'brands'
  endcapture
  assign brand = brand | strip
  assign eyebrow = ''
  if in_stock and density != 'mini'
    assign delivery = product.metafields.custom.entrega.value
    if delivery != blank
      assign eyebrow = delivery
    elsif product.tags contains 'Envío inmediato'
      assign eyebrow = 'Envío inmediato'
    endif
  endif
  assign now_seconds = 'now' | date: '%s' | plus: 0
  assign created_seconds = product.created_at | date: '%s' | plus: 0
  assign age_days = now_seconds | minus: created_seconds | divided_by: 86400
  assign is_new = false
  if age_days >= 0 and age_days <= 30
    assign is_new = true
  endif
  assign image = product.featured_image
-%}
<article class="card card--{{ density }}" data-product-handle="{{ product.handle }}">
  <a class="card__link" href="{{ product.url }}" data-quick-view="{{ product.handle }}" data-product-url="{{ product.url }}" aria-haspopup="dialog">
    <div class="card__media">
      {%- if image -%}
        {%- if xl_widths != blank -%}
          <picture>
            <source media="(min-width: 1280px)" sizes="{{ sizes }}" srcset="
              {%- assign width_list = xl_widths | split: ',' -%}
              {%- for w in width_list -%}
                {%- assign wn = w | plus: 0 -%}
                {%- if wn <= image.width -%}{{ image | image_url: width: wn }} {{ wn }}w{% unless forloop.last %}, {% endunless %}{%- endif -%}
              {%- endfor -%}
            ">
        {%- endif -%}
        {% render 'monetta-image', image: image, widths: '240,360,480,600', sizes: sizes, alt: '', eager: eager %}
        {%- if xl_widths != blank -%}</picture>{%- endif -%}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
      {%- if pct > 0 -%}<span class="badge badge--sale card__badge">-{{ pct }}%</span>{%- elsif is_new and in_stock -%}<span class="badge card__badge badge--fresh">Nuevo</span>{%- endif -%}
      {%- unless in_stock -%}<span class="card__soldout"><span class="badge badge--seal">Agotado</span></span>{%- endunless -%}
    </div>
    <div class="card__body">
      {%- if eyebrow != blank -%}<p class="card__eyebrow">{{ eyebrow | escape }}</p>{%- elsif listing_card -%}<p class="card__eyebrow card__slot-empty" aria-hidden="true"></p>{%- endif -%}
      {%- if brand != blank -%}<p class="card__brand">{{ brand | escape }}</p>{%- elsif listing_card -%}<p class="card__brand card__slot-empty" aria-hidden="true"></p>{%- endif -%}
      <h3 class="card__name">{{ product.title | escape }}</h3>
      <p class="card__price">
        <span class="price">
          {%- if product.price_varies -%}Desde {{ product.price_min | money_without_trailing_zeros | replace: '$ ', '$' }} {{ currency }}{%- else -%}{{ variant.price | money_without_trailing_zeros | replace: '$ ', '$' }} {{ currency }}{%- endif -%}
        </span>
        {%- if pct > 0 -%}
          <span class="visually-hidden">, antes</span><s class="price-compare">{{ variant.compare_at_price | money_without_trailing_zeros | replace: '$ ', '$' }} {{ currency }}</s>
        {%- endif -%}
        {%- unless in_stock -%}<span class="visually-hidden">, agotado</span>{%- endunless -%}
      </p>
    </div>
  </a>
  {%- if show_view -%}
    <a class="card__view" href="{{ product.url }}" aria-label="Ver producto: {{ product.title | escape }}">Ver producto</a>
  {%- endif -%}
  <div class="card__actions">
    {%- comment -%}The favourite is browser-local (assets/monetta-merchandising.js shows it once it can read the list).{%- endcomment -%}
    <button type="button" class="card__fav" data-save-product="{{ product.handle }}" data-product-title="{{ product.title | escape }}" aria-pressed="false" aria-label="Guardar {{ product.title | escape }}" hidden>{% render 'monetta-icon', name: 'heart', size: 20, class: 'save-icon--off' %}{% render 'monetta-icon', name: 'heartFilled', size: 20, class: 'save-icon--on' %}</button>
  </div>
</article>
