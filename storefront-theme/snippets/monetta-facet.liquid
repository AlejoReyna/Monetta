{%- comment -%}Generated by build-facets.py from assets/rules/normalization_rules.json v1 and Flutter shopper copy. Metafield override > tags > type > title > vendor (brand only) > collections. No prices or stock inferred. Unknown facts stay empty. Remote Config overrides are not available to Liquid.{%- endcomment -%}
{%- liquid
  assign vocabulary = ''
  assign limit = 1
  case kind
    when 'categories'
      assign vocabulary = 'bolsa::Bolsa::bolsa~bolso~bolsas~bolsos~bag~handbag~bolso mujer~bolsa de mano~bolsa crossbody~bolso tote~bolsa tote~bolsa de hombro~bolso de hombro~bolsa bucket~bolsa camera~bolsa clutch~bolsa messenger~bolsa mini satchel~bolsa satchel~bolsa shoulder~bolsa hobo~bolsa shoulder bag~crossbody~crossbody bag~tote~satchel~shoulder~shoulder bag~mini bag~clutch~hobo~maletin~briefcase~portadocumentos~mochila|cartera::Cartera::cartera~carteras~wallet~billetera~bifold~tipo sobre~cartera hombre~cartera larga~cartera mediana~cartera mini|tarjetero::Tarjetero::tarjetero~tarjeteros~card holder~cardholder~porta tarjetas~card case~id case|monedero::Monedero::monedero~coin purse~portamonedas|reloj::Reloj::reloj~relojes~watch|cosmetiquera::Cosmetiquera::cosmetiquera~neceser~makeup bag~pouch|set::Set::set~set de regalo~kit~caja de regalo~gift set~set de cartera~set de tarjetero y monedero|perfume::Perfume::perfume~perfumes~fragancia~fragancias~eau de parfum~eau de toilette|accesorio::Accesorio::accesorio~accesorios~panuelo~wristlet~munequera~llavero~charm para bolsa~charm~charms~bag charm~correa para bolso~correa para bolsa~correa~chain strap~lentes~lentes de sol' | split: '|'
    when 'silhouettes'
      assign vocabulary = 'tote::Tote::tote~bolso tote~bolsa tote~mini tote~shopper~city tote|crossbody::Crossbody::crossbody~crossbody bag~bolsa crossbody~bandolera~incluye correa crossbody~bolsa camera~camera~bolsa messenger~messenger~flap|shoulder::De hombro::shoulder~shoulder bag~bolsa shoulder~bolsa shoulder bag~bolsa de hombro~bolso de hombro~hombro~de hombro~asa de hombro|satchel::Satchel::satchel~bolsa satchel~bolsa mini satchel~mini satchel~asa de mano~bolsa de mano~bolso de mano|hobo::Hobo::hobo~bolsa hobo~bolsa bucket~bucket|clutch::Clutch::clutch~bolsa clutch~tipo sobre~sobre|mini::Mini::mini~mini bag~micro|wristlet::Muñequera::wristlet~munequera' | split: '|'
    when 'colors'
      assign vocabulary = 'negro::Negro::negro~negra~black~jet|blanco::Blanco::blanco~blanca~white~vanilla~crema~cream|cafe::Café::cafe~brown~chocolate~camel~taupe~natural~conac~yute~saddle~miel~tan|beige::Beige::beige~nude~arena~hueso|gris::Gris::gris~grey~gray~plata~silver|rosa::Rosa::rosa~rosado~pink~rosa claro~rose~fiusha~fucsia~fuchsia~palo de rosa|azul::Azul::azul~blue~azul marino~marino~navy~denim~mezclilla~celeste|rojo::Rojo::rojo~roja~red~vino~burgundy~wine|dorado::Dorado::dorado~dorada~gold~oro~rose gold~cadena dorada|verde::Verde::verde~green~olivo~militar|morado::Morado::morado~lila~purple~iris|amarillo::Amarillo::amarillo~yellow~mostaza|multicolor::Multicolor::multicolor~multi' | split: '|'
      assign limit = 3
    when 'patterns'
      assign vocabulary = 'monograma::Monograma::monograma~monogram~signature~logo|floral::Floral::floral~flores~flower|cerezas::Cerezas::cerezas~cherry~cereza|limones::Limones::limones~limon~lemon|rayas::Rayas::rayas~stripes~striped|animal_print::Animal print::animal print~serpiente~snake~piton~zebra~cebra~leopardo~leopard|relieve::Relieve::relieve~embossed~texturizado|acolchado::Acolchado::acolchado~quilted~matelasse|liso::Liso::liso~lisa~plain~solid' | split: '|'
      assign limit = 2
    when 'brands'
      assign vocabulary = 'guess::Guess::guess|coach::Coach::coach|michael_kors::Michael Kors::michael kors~mk~michael kors collection|steve_madden::Steve Madden::steve madden~stevemadden~madden|tommy_hilfiger::Tommy Hilfiger::tommy hilfiger~tommy|anne_klein::Anne Klein::anne klein~ak anne klein|christian_dior::Christian Dior::christian dior~dior|tory_burch::Tory Burch::tory burch|kate_spade::Kate Spade::kate spade~kate spade new york|marc_jacobs::Marc Jacobs::marc jacobs|olaplex::Olaplex::olaplex~olalplex|the_ordinary::The Ordinary::the ordinary|summer_fridays::Summer Fridays::summer fridays|laneige::Laneige::laneige|rhode::Rhode::rhode|armaf::Armaf::armaf|lattafa::Lattafa::lattafa~lattafa pride|orientica::Orientica::orientica|maison_alhambra::Maison Alhambra::maison alhambra|french_avenue::French Avenue::french avenue|yves_saint_laurent::Yves Saint Laurent::yves saint laurent~ysl|bharara::Bharara::bharara~bharara beauty~bharara mast~bharara mast perfume~mast bharara~mast perfume|rasasi::Rasasi::rasasi|afnan::Afnan::afnan~afnan zimaya|al_haramain::Al Haramain::al haramain|dumont::Dumont::dumont~dumont paris~dumont murjan|maison_asrar::Maison Asrar::maison asrar|rayhaan::Rayhaan::rayhaan|khadlaj::Khadlaj::khadlaj|paris_corner::Paris Corner::paris corner|fragrance_world::Fragrance World::fragrance world|zimaya::Zimaya::zimaya|swiss_arabian::Swiss Arabian::swiss arabian|carolina_herrera::Carolina Herrera::carolina herrera|versace::Versace::versace|dolce_gabbana::Dolce & Gabbana::dolce gabbana|paco_rabanne::Paco Rabanne::paco rabanne~rabanne|jean_paul_gaultier::Jean Paul Gaultier::jean paul gaultier|ariana_grande::Ariana Grande::ariana grande|billie_eilish::Billie Eilish::billie eilish|valentino::Valentino::valentino|burberry::Burberry::burberry|calvin_klein::Calvin Klein::calvin klein|hugo_boss::Hugo Boss::hugo boss~boss|ralph_lauren::Ralph Lauren::ralph lauren|lancome::Lancôme::lancome|givenchy::Givenchy::givenchy|prada::Prada::prada|gucci::Gucci::gucci|chanel::Chanel::chanel|giorgio_armani::Giorgio Armani::giorgio armani~armani|viktor_rolf::Viktor & Rolf::viktor rolf|montblanc::Montblanc::montblanc~mont blanc|lacoste::Lacoste::lacoste|azzaro::Azzaro::azzaro|moschino::Moschino::moschino|mugler::Mugler::mugler~thierry mugler|parfums_de_marly::Parfums de Marly::parfums de marly|xerjoff::Xerjoff::xerjoff|mancera::Mancera::mancera|montale::Montale::montale|creed::Creed::creed|tom_ford::Tom Ford::tom ford|juicy_couture::Juicy Couture::juicy couture|salvatore_ferragamo::Salvatore Ferragamo::salvatore ferragamo|jimmy_choo::Jimmy Choo::jimmy choo|bvlgari::Bvlgari::bvlgari' | split: '|'
  endcase
  assign override = ''
  if kind == 'brands'
    assign override = product.metafields.app.brand_override.value | default: product.metafields.custom.marca.value
  elsif kind == 'categories'
    assign override = product.metafields.app.category_override.value
  endif
-%}
{%- capture sources -%}{{ override }}§{{ product.tags | join: '¦' }}§{{ product.type }}§{{ product.title }}§{% if kind == 'brands' %}{{ product.vendor }}{% endif %}§{% for c in product.collections %}{{ c.handle | replace: '-', ' ' }}{% unless forloop.last %}¦{% endunless %}{% endfor %}{%- endcapture -%}
{%- liquid
  assign tiers = sources | split: '§'
  assign chosen = ''
  for tier in tiers
    assign tier_index = forloop.index0
    assign matches = ''
    assign signals = tier | split: '¦'
    for signal in signals
      capture folded
        render 'monetta-fold', text: signal
      endcapture
      assign folded = folded | strip
      if tier_index == 1
        assign tag_prefix_prov = folded | slice: 0, 10
        assign tag_prefix_mon = folded | slice: 0, 8
        assign tag_prefix_disp = folded | slice: 0, 15
        assign tag_prefix_pend = folded | slice: 0, 10
        assign tag_prefix_img = folded | slice: 0, 16
        if tag_prefix_prov == 'proveedor-' or tag_prefix_mon == 'monetta-' or tag_prefix_disp == 'disponibilidad-' or tag_prefix_pend == 'pendiente-' or tag_prefix_img == 'imagen-original-' or folded == 'venta-sobre-pedido' or folded == 'mk-outlet-us'
          continue
        endif
      endif
      if tier_index == 4 and kind == 'brands'
        if folded == 'monetta' or folded == 'monetta wholesale' or folded == 'monetta wholesale llc'
          continue
        endif
      endif
      assign haystack = folded | prepend: ' ' | append: ' '
      for entry in vocabulary
        assign hit = false
        assign bits = entry | split: '::'
        assign aliases = bits[2] | split: '~'
        for alias in aliases
          assign needle = alias | prepend: ' ' | append: ' '
          if haystack contains needle
            assign hit = true
            assign token = bits[0] | prepend: '|' | append: '|'
            unless matches contains token
              assign matches = matches | append: token
            endunless
            break
          endif
        endfor
        if limit == 1 and hit
          break
        endif
      endfor
    endfor
    if matches != blank
      assign chosen = matches
      break
    elsif tier_index == 0 and override != blank
      if output == 'key'
        echo override | handleize | replace: '-', '_'
      else
        echo override
      endif
      break
    endif
  endfor
  assign emitted = 0
  if kind == 'categories'
    assign priority = 'perfume,reloj,cosmetiquera,tarjetero,monedero,cartera,set,accesorio,bolsa' | split: ','
    for key in priority
      assign token = key | prepend: '|' | append: '|'
      if chosen contains token
        assign chosen = token
        break
      endif
    endfor
  endif
  assign ordered_keys = chosen | split: '|' | uniq
  for chosen_key in ordered_keys
    if chosen_key == blank
      continue
    endif
    for entry in vocabulary
    assign bits = entry | split: '::'
    assign token = bits[0] | prepend: '|' | append: '|'
    if bits[0] == chosen_key
      if emitted > 0
        echo ', '
      endif
      if output == 'key'
        echo bits[0]
      else
        echo bits[1]
      endif
      assign emitted = emitted | plus: 1
      if emitted >= limit
        break
      endif
    endif
    endfor
    if emitted >= limit
      break
    endif
  endfor
-%}
