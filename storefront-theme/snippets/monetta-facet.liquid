{%- comment -%}Generated by build-facets.py from assets/rules/normalization_rules.json v1 and Flutter shopper copy. Metafield override > tags > type > title > vendor (brand only) > collections. No prices or stock inferred. Unknown facts stay empty. Remote Config overrides are not available to Liquid.{%- endcomment -%}
{%- liquid
  assign vocabulary = ''
  assign limit = 1
  case kind
    when 'categories'
      assign vocabulary = 'bolsa::Bolsa::bolsa~bolso~bolsas~bolsos~bag~handbag~bolso mujer~bolsa de mano~bolsa crossbody~bolso tote~bolsa hobo~bolsa shoulder bag~crossbody~crossbody bag~tote~satchel~shoulder~shoulder bag~mini bag~clutch~hobo|cartera::Cartera::cartera~carteras~wallet~billetera~bifold~tipo sobre|tarjetero::Tarjetero::tarjetero~tarjeteros~card holder~cardholder~porta tarjetas|monedero::Monedero::monedero~coin purse~portamonedas|reloj::Reloj::reloj~relojes~watch|cosmetiquera::Cosmetiquera::cosmetiquera~neceser~makeup bag~pouch|set::Set::set~set de regalo~kit~caja de regalo~gift set|perfume::Perfume::perfume~perfumes~fragancia~fragancias|accesorio::Accesorio::accesorio~accesorios~panuelo~wristlet~llavero' | split: '|'
    when 'silhouettes'
      assign vocabulary = 'tote::Tote::tote~bolso tote~mini tote~shopper|crossbody::Crossbody::crossbody~crossbody bag~bolsa crossbody~bandolera~incluye correa crossbody|shoulder::De hombro::shoulder~shoulder bag~bolsa shoulder bag~hombro~de hombro~asa de hombro|satchel::Satchel::satchel~asa de mano|hobo::Hobo::hobo~bolsa hobo|clutch::Clutch::clutch~tipo sobre~sobre|mini::Mini::mini~mini bag~micro|wristlet::Muñequera::wristlet~munequera' | split: '|'
    when 'colors'
      assign vocabulary = 'negro::Negro::negro~negra~black~jet|blanco::Blanco::blanco~blanca~white~vanilla~crema~cream|cafe::Café::cafe~brown~chocolate~camel~taupe~natural~conac~yute~saddle~miel~tan|beige::Beige::beige~nude~arena~hueso|gris::Gris::gris~grey~gray~plata~silver|rosa::Rosa::rosa~rosado~pink~rosa claro~rose~fiusha~fucsia~fuchsia~palo de rosa|azul::Azul::azul~blue~azul marino~marino~navy~denim~mezclilla~celeste|rojo::Rojo::rojo~roja~red~vino~burgundy~wine|dorado::Dorado::dorado~dorada~gold~oro~rose gold~cadena dorada|verde::Verde::verde~green~olivo~militar|morado::Morado::morado~lila~purple~iris|amarillo::Amarillo::amarillo~yellow~mostaza|multicolor::Multicolor::multicolor~multi' | split: '|'
      assign limit = 3
    when 'patterns'
      assign vocabulary = 'monograma::Monograma::monograma~monogram~signature~logo|floral::Floral::floral~flores~flower|cerezas::Cerezas::cerezas~cherry~cereza|limones::Limones::limones~limon~lemon|rayas::Rayas::rayas~stripes~striped|animal_print::Animal print::animal print~serpiente~snake~piton~zebra~cebra~leopardo~leopard|relieve::Relieve::relieve~embossed~texturizado|acolchado::Acolchado::acolchado~quilted~matelasse|liso::Liso::liso~lisa~plain~solid' | split: '|'
      assign limit = 2
    when 'brands'
      assign vocabulary = 'guess::Guess::guess|coach::Coach::coach|michael_kors::Michael Kors::michael kors~mk~michael kors collection|steve_madden::Steve Madden::steve madden~stevemadden~madden|tommy_hilfiger::Tommy Hilfiger::tommy hilfiger~tommy|anne_klein::Anne Klein::anne klein~ak anne klein|christian_dior::Christian Dior::christian dior~dior|olaplex::Olaplex::olaplex~olalplex|the_ordinary::The Ordinary::the ordinary|summer_fridays::Summer Fridays::summer fridays|laneige::Laneige::laneige|rhode::Rhode::rhode' | split: '|'
  endcase
  assign override = ''
  if kind == 'brands'
    assign override = product.metafields.app.brand_override.value | default: product.metafields.custom.marca.value
  elsif kind == 'categories'
    assign override = product.metafields.app.category_override.value
  endif
-%}
{%- capture sources -%}{{ override }}§{{ product.tags | join: '¦' }}§{{ product.type }}§{{ product.title }}§{% if kind == 'brands' %}{{ product.vendor }}{% endif %}§{% for c in product.collections %}{{ c.handle | replace: '-', ' ' }}{% unless forloop.last %}¦{% endunless %}{% endfor %}{%- endcapture -%}
{%- liquid
  assign tiers = sources | split: '§'
  assign chosen = ''
  for tier in tiers
    assign tier_index = forloop.index0
    assign matches = ''
    assign signals = tier | split: '¦'
    for signal in signals
      capture folded
        render 'monetta-fold', text: signal
      endcapture
      assign folded = folded | strip
      if tier_index == 4 and kind == 'brands'
        if folded == 'monetta' or folded == 'monetta wholesale' or folded == 'monetta wholesale llc'
          continue
        endif
      endif
      assign haystack = folded | prepend: ' ' | append: ' '
      for entry in vocabulary
        assign hit = false
        assign bits = entry | split: '::'
        assign aliases = bits[2] | split: '~'
        for alias in aliases
          assign needle = alias | prepend: ' ' | append: ' '
          if haystack contains needle
            assign hit = true
            assign token = bits[0] | prepend: '|' | append: '|'
            unless matches contains token
              assign matches = matches | append: token
            endunless
            break
          endif
        endfor
        if limit == 1 and hit
          break
        endif
      endfor
    endfor
    if matches != blank
      assign chosen = matches
      break
    elsif tier_index == 0 and override != blank
      if output == 'key'
        echo override | handleize | replace: '-', '_'
      else
        echo override
      endif
      break
    endif
  endfor
  assign emitted = 0
  if kind == 'categories'
    assign priority = 'perfume,reloj,cosmetiquera,tarjetero,monedero,cartera,set,accesorio,bolsa' | split: ','
    for key in priority
      assign token = key | prepend: '|' | append: '|'
      if chosen contains token
        assign chosen = token
        break
      endif
    endfor
  endif
  assign ordered_keys = chosen | split: '|' | uniq
  for chosen_key in ordered_keys
    if chosen_key == blank
      continue
    endif
    for entry in vocabulary
    assign bits = entry | split: '::'
    assign token = bits[0] | prepend: '|' | append: '|'
    if bits[0] == chosen_key
      if emitted > 0
        echo ', '
      endif
      if output == 'key'
        echo bits[0]
      else
        echo bits[1]
      endif
      assign emitted = emitted | plus: 1
      if emitted >= limit
        break
      endif
    endif
    endfor
    if emitted >= limit
      break
    endif
  endfor
-%}
