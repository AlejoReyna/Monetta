{%- doc -%}
  ClientGuideServices: the guide's four services with its gold icons. The home variant (kClientGuideHomeServices) opens
  with «Envíos seguros»; the wholesale variant (kClientGuideWholesaleServices) opens with the free-shipping threshold.

  @param {string} [variant] - 'home' (default) or 'wholesale'.
  @param {string} [label] - Accessible name of the list (default «Nuestros servicios»).
{%- enddoc -%}
<ul class="guide-services{% unless variant == 'wholesale' %} guide-services--inicio{% endunless %}" aria-label="{{ label | default: 'Nuestros servicios' | escape }}">
  {%- if variant == 'wholesale' -%}
    <li class="guide-services__item">
      {% render 'monetta-guia-icon', name: 'servicio-envios', size: 72, class: 'guide-services__icon' %}
      <p class="guide-services__title">Envío gratis</p>
      <p class="guide-services__body">En compras mayores a $1,999 MXN</p>
    </li>
    <li class="guide-services__item">
      {% render 'monetta-guia-icon', name: 'servicio-pagos', size: 72, class: 'guide-services__icon' %}
      <p class="guide-services__title">Pagos seguros</p>
      <p class="guide-services__body">Compra con confianza</p>
    </li>
    <li class="guide-services__item">
      {% render 'monetta-guia-icon', name: 'servicio-originales', size: 72, class: 'guide-services__icon' %}
      <p class="guide-services__title">Productos 100% originales</p>
      <p class="guide-services__body">Garantía de autenticidad</p>
    </li>
    <li class="guide-services__item">
      {% render 'monetta-guia-icon', name: 'servicio-atencion', size: 72, class: 'guide-services__icon' %}
      <p class="guide-services__title">Atención personalizada</p>
      <p class="guide-services__body">Estamos para ayudarte</p>
    </li>
  {%- else -%}
    <li class="guide-services__item">
      <img class="guide-services__icon" src="{{ 'monetta-v41-envio.svg' | asset_url }}" width="30" height="30" alt="" loading="lazy" decoding="async">
    </li>
    <li class="guide-services__item">
      <img class="guide-services__icon" src="{{ 'monetta-v41-original.svg' | asset_url }}" width="30" height="30" alt="" loading="lazy" decoding="async">
    </li>
    <li class="guide-services__item">
      <img class="guide-services__icon" src="{{ 'monetta-v41-pago.svg' | asset_url }}" width="30" height="30" alt="" loading="lazy" decoding="async">
    </li>
  {%- endif -%}
</ul>
