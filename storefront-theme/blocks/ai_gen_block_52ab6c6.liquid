{% doc %}
  @prompt
    Shopify Liquid block. Image carousel, 3 cards, mobile-first.
    Each card: vertical image + title + button, all as one unified unit.
    Pop animation applies to the entire outer (image + title + button move together).
    Never cause horizontal page overflow.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  carousel-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    max-width: 100%;
    overflow: hidden;
    background: transparent;
    margin: 0;
    box-sizing: border-box;
  }

  .ai-carousel-wrapper-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    max-width: 100%;
    overflow: hidden;
    margin: 0;
    box-sizing: border-box;
    background: transparent;
  }

  .ai-carousel-track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.card_gap }}px;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-snap-stop: always;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    scroll-behavior: smooth;
    padding: {{ block.settings.track_padding_vertical }}px {{ block.settings.track_padding_horizontal }}px;
    margin: 0;
    box-sizing: border-box;
    align-items: flex-start;
  }

  .ai-carousel-track-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  /* ── OUTER: imagen + título + botón como unidad ── */
  .ai-carousel-card-outer-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: {{ block.settings.card_align }};
    flex: 0 0 65vw;
    max-width: 240px;
    scroll-snap-align: center;
    will-change: transform;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    box-sizing: border-box;
    gap: 0;
  }

  /* ── IMAGEN ── */
  .ai-carousel-card-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: {{ block.settings.card_aspect_ratio }};
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
    background: transparent;
    will-change: transform;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    box-shadow:
      0 {{ block.settings.shadow_offset_y }}px {{ block.settings.shadow_blur }}px rgba({{ block.settings.shadow_color.red }}, {{ block.settings.shadow_color.green }}, {{ block.settings.shadow_color.blue }}, {{ block.settings.shadow_opacity | divided_by: 100.0 }}),
      0 {{ block.settings.shadow_offset_y | times: 2 }}px {{ block.settings.shadow_blur | times: 2 }}px rgba({{ block.settings.shadow_color.red }}, {{ block.settings.shadow_color.green }}, {{ block.settings.shadow_color.blue }}, {{ block.settings.shadow_opacity | divided_by: 100.0 | times: 0.7 }}),
      0 {{ block.settings.shadow_offset_y | times: 3 }}px {{ block.settings.shadow_blur | times: 3 }}px rgba({{ block.settings.shadow_color.red }}, {{ block.settings.shadow_color.green }}, {{ block.settings.shadow_color.blue }}, {{ block.settings.shadow_opacity | divided_by: 100.0 | times: 0.5 }});
    padding: 0;
    box-sizing: border-box;
    position: relative;
    flex-shrink: 0;
    margin-bottom: 0;
  }

  .ai-carousel-card-link-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    height: 100%;
    text-decoration: none;
    padding: 0;
    margin: 0;
  }

  .ai-carousel-card-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    pointer-events: none;
  }

  /* ── TÍTULO ── */
  .ai-carousel-title-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    box-sizing: border-box;
    margin: {{ block.settings.title_gap }}px 0 0 0;
    padding: 0;
    font-family: inherit;
    font-size: {{ block.settings.title_font_size }}px;
    font-weight: {{ block.settings.title_font_weight }};
    color: {{ block.settings.title_color }};
    text-align: {{ block.settings.title_align }};
    letter-spacing: {{ block.settings.title_letter_spacing | divided_by: 100.0 }}em;
    line-height: {{ block.settings.title_line_height | divided_by: 10.0 }};
    transition: opacity 0.4s ease;
  }

  /* ── BOTÓN WRAPPER ── */
  .ai-carousel-btn-wrapper-{{ ai_gen_id }} {
    width: 100%;
    display: flex;
    justify-content: {{ block.settings.btn_align }};
    margin: {{ block.settings.btn_gap }}px 0 0 0;
    padding: 0;
    box-sizing: border-box;
  }

  /* ── BOTÓN ── */
  .ai-carousel-btn-{{ ai_gen_id }} {
    display: inline-block;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    box-sizing: border-box;
    font-family: inherit;
    font-size: {{ block.settings.btn_font_size }}px;
    font-weight: {{ block.settings.btn_font_weight }};
    color: {{ block.settings.btn_text_color }};
    letter-spacing: 0.02em;
    background-color: {{ block.settings.btn_bg_color }};
    border: {{ block.settings.btn_border_width }}px solid {{ block.settings.btn_border_color }};
    border-radius: {{ block.settings.btn_border_radius }}px;
    padding: {{ block.settings.btn_padding_v }}px {{ block.settings.btn_padding_h }}px;
    box-shadow:
      0 {{ block.settings.btn_shadow_offset_y }}px {{ block.settings.btn_shadow_blur }}px rgba({{ block.settings.btn_shadow_color.red }}, {{ block.settings.btn_shadow_color.green }}, {{ block.settings.btn_shadow_color.blue }}, {{ block.settings.btn_shadow_opacity | divided_by: 100.0 }}),
      0 {{ block.settings.btn_shadow_offset_y | times: 2 }}px {{ block.settings.btn_shadow_blur | times: 2 }}px rgba({{ block.settings.btn_shadow_color.red }}, {{ block.settings.btn_shadow_color.green }}, {{ block.settings.btn_shadow_color.blue }}, {{ block.settings.btn_shadow_opacity | divided_by: 100.0 | times: 0.6 }});
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1),
                box-shadow 0.35s cubic-bezier(0.34, 1.56, 0.64, 1),
                background-color 0.2s ease,
                color 0.2s ease;
    will-change: transform;
  }

  .ai-carousel-btn-{{ ai_gen_id }}:hover {
    transform: translateY(-3px) scale(1.03);
    background-color: {{ block.settings.btn_bg_color_hover }};
    color: {{ block.settings.btn_text_color_hover }};
    box-shadow:
      0 {{ block.settings.btn_shadow_offset_y | times: 2 }}px {{ block.settings.btn_shadow_blur | times: 2 }}px rgba({{ block.settings.btn_shadow_color.red }}, {{ block.settings.btn_shadow_color.green }}, {{ block.settings.btn_shadow_color.blue }}, {{ block.settings.btn_shadow_opacity | divided_by: 100.0 }}),
      0 {{ block.settings.btn_shadow_offset_y | times: 3 }}px {{ block.settings.btn_shadow_blur | times: 3 }}px rgba({{ block.settings.btn_shadow_color.red }}, {{ block.settings.btn_shadow_color.green }}, {{ block.settings.btn_shadow_color.blue }}, {{ block.settings.btn_shadow_opacity | divided_by: 100.0 | times: 0.6 }});
  }

  .ai-carousel-btn-{{ ai_gen_id }}:active {
    transform: translateY(0px) scale(0.97);
    transition-duration: 0.15s;
  }

  /* ── RESPONSIVE ── */
  @media screen and (max-width: 749px) {
    carousel-{{ ai_gen_id }},
    .ai-carousel-wrapper-{{ ai_gen_id }} {
      max-width: 100vw;
      overflow: hidden;
    }

    .ai-carousel-track-{{ ai_gen_id }} {
      padding: {{ block.settings.track_padding_vertical_mobile }}px {{ block.settings.track_padding_horizontal_mobile }}px;
      gap: {{ block.settings.card_gap_mobile }}px;
    }

    .ai-carousel-card-outer-{{ ai_gen_id }} {
      flex: 0 0 72vw;
      max-width: 72vw;
    }
  }
{% endstyle %}

<carousel-{{ ai_gen_id }} {{ block.shopify_attributes }}>
  <div class="ai-carousel-wrapper-{{ ai_gen_id }}">
    <div class="ai-carousel-track-{{ ai_gen_id }}">

      {% for i in (1..3) %}
        {% liquid
          assign image_key    = 'image_'    | append: i
          assign link_key     = 'link_'     | append: i
          assign btn_text_key = 'btn_text_' | append: i
          assign btn_link_key = 'btn_link_' | append: i
          assign title_key    = 'title_'    | append: i
          assign image        = block.settings[image_key]
          assign link         = block.settings[link_key]
          assign btn_text     = block.settings[btn_text_key]
          assign btn_link     = block.settings[btn_link_key]
          assign title_text   = block.settings[title_key]
        %}
        {% if image != blank %}
          <div class="ai-carousel-card-outer-{{ ai_gen_id }}" data-card-index="{{ i }}">

            <!-- IMAGEN -->
            <div class="ai-carousel-card-{{ ai_gen_id }}">
              {% if link != blank %}
                <a href="{{ link }}" class="ai-carousel-card-link-{{ ai_gen_id }}">
                  <img
                    src="{{ image | image_url: width: 480 }}"
                    alt="{{ image.alt | escape }}"
                    loading="lazy"
                    width="480"
                    height="640"
                    class="ai-carousel-card-image-{{ ai_gen_id }}"
                  >
                </a>
              {% else %}
                <img
                  src="{{ image | image_url: width: 480 }}"
                  alt="{{ image.alt | escape }}"
                  loading="lazy"
                  width="480"
                  height="640"
                  class="ai-carousel-card-image-{{ ai_gen_id }}"
                >
              {% endif %}
            </div>

            <!-- TÍTULO -->
            {% if title_text != blank %}
              <span class="ai-carousel-title-{{ ai_gen_id }}">{{ title_text }}</span>
            {% endif %}

            <!-- BOTÓN con enlace propio -->
            {% if btn_text != blank %}
              <div class="ai-carousel-btn-wrapper-{{ ai_gen_id }}">
                {% assign resolved_btn_link = btn_link | default: link %}
                {% if resolved_btn_link != blank %}
                  <a href="{{ resolved_btn_link }}" class="ai-carousel-btn-{{ ai_gen_id }}">{{ btn_text }}</a>
                {% else %}
                  <span class="ai-carousel-btn-{{ ai_gen_id }}">{{ btn_text }}</span>
                {% endif %}
              </div>
            {% endif %}

          </div>
        {% endif %}
      {% endfor %}

    </div>
  </div>
</carousel-{{ ai_gen_id }}>

<script>
  (function() {
    if (!customElements.get('carousel-{{ ai_gen_id }}')) {
      class Carousel{{ ai_gen_id }} extends HTMLElement {
        constructor() {
          super();
          this.track  = null;
          this.outers = [];
          this._rafId = null;
        }

        connectedCallback() {
          this.track  = this.querySelector('.ai-carousel-track-{{ ai_gen_id }}');
          this.outers = Array.from(this.querySelectorAll('.ai-carousel-card-outer-{{ ai_gen_id }}'));

          this.resetScroll();
          this.setupAnimationLoop();

          window.addEventListener('DOMContentLoaded', () => this.resetScroll());
          window.addEventListener('load', () => this.resetScroll());
          setTimeout(() => this.resetScroll(), 100);
          setTimeout(() => this.resetScroll(), 500);
        }

        resetScroll() {
          if (this.track) this.track.scrollLeft = 0;
        }

        setupAnimationLoop() {
          const shadowOpacity = {{ block.settings.shadow_opacity }} / 100;
          const shadowR  = {{ block.settings.shadow_color.red }};
          const shadowG  = {{ block.settings.shadow_color.green }};
          const shadowB  = {{ block.settings.shadow_color.blue }};
          const offsetY  = {{ block.settings.shadow_offset_y }};
          const blur     = {{ block.settings.shadow_blur }};

          const state = this.outers.map(() => ({ progress: 0 }));

          const applyCardState = () => {
            const trackRect   = this.track.getBoundingClientRect();
            const trackCenter = trackRect.left + trackRect.width / 2;

            this.outers.forEach((outer, idx) => {
              const card       = outer.querySelector('.ai-carousel-card-{{ ai_gen_id }}');
              const outerRect  = outer.getBoundingClientRect();
              const outerCenter = outerRect.left + outerRect.width / 2;
              const distance   = Math.abs(trackCenter - outerCenter);
              const maxDist    = trackRect.width * 0.65;
              const target     = Math.max(0, 1 - distance / maxDist);

              // Lerp ultra-smooth
              state[idx].progress += (target - state[idx].progress) * 0.12;
              const p = state[idx].progress;

              const translateY = -14 * p;
              const scale      = 1 + 0.04 * p;
              const opBase     = shadowOpacity * (0.4 + 0.6 * p);

              // Transform en el OUTER completo (imagen + título + botón juntos)
              outer.style.transform = `translateY(${translateY}px) scale(${scale})`;

              // Sombra solo en la card imagen
              if (card) {
                card.style.boxShadow = `
                  0 ${offsetY * (1 + p)}px ${blur * (1 + p)}px rgba(${shadowR},${shadowG},${shadowB},${opBase}),
                  0 ${offsetY * (2 + p)}px ${blur * (2 + p)}px rgba(${shadowR},${shadowG},${shadowB},${opBase * 0.7}),
                  0 ${offsetY * (3 + p)}px ${blur * (3 + p)}px rgba(${shadowR},${shadowG},${shadowB},${opBase * 0.5})`;
              }

              // Título: fade sincronizado con el pop
              const titleEl = outer.querySelector('.ai-carousel-title-{{ ai_gen_id }}');
              if (titleEl) {
                titleEl.style.opacity = 0.55 + 0.45 * p;
              }
            });
          };

          const loop = () => {
            applyCardState();
            this._rafId = requestAnimationFrame(loop);
          };

          applyCardState();
          this._rafId = requestAnimationFrame(loop);
        }

        disconnectedCallback() {
          if (this._rafId) cancelAnimationFrame(this._rafId);
        }
      }

      customElements.define('carousel-{{ ai_gen_id }}', Carousel{{ ai_gen_id }});
    }
  })();
</script>

