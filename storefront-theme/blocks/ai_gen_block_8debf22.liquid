{% doc %}
  @prompt
    Task: Create a 100% Mobile-Optimized Collection Carousel (Bolsas, Carteras, Relojes).
    
    1. Structural Layout (Mobile Priority):
    
    Create a horizontal scrolling section with 3 collection cards.
    
    Mobile Width: Each card must be exactly 75% of the screen width.
    
    Snap & Alignment: Center the active card perfectly. Ensure the next card is visible (12.5% peek) to encourage swiping.
    
    Spacing: Add a standard 60px margin at the top and bottom of the section.
    
    2. High-Speed Fluidity:
    
    Transitions: Transitions between cards must be ultra-fast, responsive, and snappy.
    
    Magnetic Snap: Use an instant magnetic snapping effect so the cards lock into place immediately when swiped.
    
    Interactive Scaling: The centered card stays at scale 1.0; side cards scale down to 0.9 instantly during the movement.
    
    3. Premium Card Aesthetic:
    
    Shape: Use a very rounded 36px border-radius with overflow: hidden.
    
    Image Presence: The product image must be large and centered, occupying 75% of the card's height.
    
    Style: Pure white cards with a subtle, clean shadow and no background text.
    
    4. Details:
    
    Use an elegant Serif font for titles. Place a small, minimalist button at the bottom of each card.
    
    Hide all scrollbars for a clean, app-like interface.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-carousel-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 60px 0;
    overflow: hidden;
  }

  .ai-collection-carousel__wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .ai-collection-carousel__track-{{ ai_gen_id }} {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 0 12.5%;
  }

  .ai-collection-carousel__track-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-collection-carousel__card-{{ ai_gen_id }} {
    flex: 0 0 75%;
    scroll-snap-align: center;
    scroll-snap-stop: always;
    transition: transform 0.15s cubic-bezier(0.4, 0, 0.2, 1);
    transform: scale(0.9);
  }

  .ai-collection-carousel__card-{{ ai_gen_id }}.active {
    transform: scale(1);
  }

  .ai-collection-carousel__card-inner-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: 36px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .ai-collection-carousel__image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    height: 0;
    padding-bottom: 100%;
    position: relative;
    overflow: hidden;
  }

  .ai-collection-carousel__image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-collection-carousel__placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-collection-carousel__placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-collection-carousel__content-{{ ai_gen_id }} {
    padding: 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    flex: 1;
  }

  .ai-collection-carousel__title-{{ ai_gen_id }} {
    font-family: {{ block.settings.title_font.family }}, serif;
    font-weight: {{ block.settings.title_font.weight }};
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.text_color }};
    text-align: center;
    margin: 0;
    line-height: 1.2;
  }

  .ai-collection-carousel__button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 10px 24px;
    background-color: {{ block.settings.button_bg }};
    color: {{ block.settings.button_color }};
    text-decoration: none;
    font-size: {{ block.settings.button_size }}px;
    border-radius: {{ block.settings.button_radius }}px;
    transition: all 0.2s ease;
    border: none;
    cursor: pointer;
    font-family: {{ block.settings.title_font.family }}, serif;
  }

  .ai-collection-carousel__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg }};
    color: {{ block.settings.button_hover_color }};
  }

  @media screen and (min-width: 750px) {
    .ai-collection-carousel__card-{{ ai_gen_id }} {
      flex: 0 0 40%;
    }

    .ai-collection-carousel__track-{{ ai_gen_id }} {
      padding: 0 30%;
    }
  }
{% endstyle %}

<mobile-collection-carousel-{{ ai_gen_id }}
  class="ai-collection-carousel-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-collection-carousel__wrapper-{{ ai_gen_id }}">
    <div class="ai-collection-carousel__track-{{ ai_gen_id }}" data-carousel-track>
      {% for i in (1..3) %}
        {% liquid
          assign collection_key = 'collection_' | append: i
          assign collection = block.settings[collection_key]
        %}

        <div class="ai-collection-carousel__card-{{ ai_gen_id }}" data-carousel-card>
          <div class="ai-collection-carousel__card-inner-{{ ai_gen_id }}">
            <div class="ai-collection-carousel__image-wrapper-{{ ai_gen_id }}">
              {% if collection != blank and collection.featured_image %}
                <img
                  src="{{ collection.featured_image | image_url: width: 800 }}"
                  alt="{{ collection.featured_image.alt | escape }}"
                  class="ai-collection-carousel__image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="800"
                  height="800"
                >
              {% else %}
                <div class="ai-collection-carousel__placeholder-{{ ai_gen_id }}">
                  {{ 'collection-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>

            <div class="ai-collection-carousel__content-{{ ai_gen_id }}">
              {% if collection != blank %}
                <h3 class="ai-collection-carousel__title-{{ ai_gen_id }}">
                  {{ collection.title }}
                </h3>
                <a
                  href="{{ collection.url }}"
                  class="ai-collection-carousel__button-{{ ai_gen_id }}"
                >
                  {{ block.settings.button_label }}
                </a>
              {% else %}
                <h3 class="ai-collection-carousel__title-{{ ai_gen_id }}">
                  {% if i == 1 %}
                    Bolsas
                  {% elsif i == 2 %}
                    Carteras
                  {% else %}
                    Relojes
                  {% endif %}
                </h3>
                <a
                  href="#"
                  class="ai-collection-carousel__button-{{ ai_gen_id }}"
                >
                  {{ block.settings.button_label }}
                </a>
              {% endif %}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</mobile-collection-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class MobileCollectionCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.track = null;
        this.cards = [];
        this.isScrolling = false;
        this.scrollTimeout = null;
      }

      connectedCallback() {
        this.track = this.querySelector('[data-carousel-track]');
        this.cards = Array.from(this.querySelectorAll('[data-carousel-card]'));
        
        if (!this.track || this.cards.length === 0) return;

        this.setupScrollSnap();
        this.updateActiveCard();
      }

      setupScrollSnap() {
        this.track.addEventListener('scroll', () => {
          if (this.scrollTimeout) {
            clearTimeout(this.scrollTimeout);
          }

          this.scrollTimeout = setTimeout(() => {
            this.updateActiveCard();
          }, 50);
        });

        this.track.addEventListener('touchstart', () => {
          this.isScrolling = true;
        });

        this.track.addEventListener('touchend', () => {
          setTimeout(() => {
            this.isScrolling = false;
            this.updateActiveCard();
          }, 100);
        });
      }

      updateActiveCard() {
        const trackRect = this.track.getBoundingClientRect();
        const centerX = trackRect.left + trackRect.width / 2;

        let closestCard = null;
        let closestDistance = Infinity;

        this.cards.forEach((card) => {
          const cardRect = card.getBoundingClientRect();
          const cardCenterX = cardRect.left + cardRect.width / 2;
          const distance = Math.abs(centerX - cardCenterX);

          if (distance < closestDistance) {
            closestDistance = distance;
            closestCard = card;
          }
        });

        this.cards.forEach((card) => {
          if (card === closestCard) {
            card.classList.add('active');
          } else {
            card.classList.remove('active');
          }
        });
      }
    }

    customElements.define('mobile-collection-carousel-{{ ai_gen_id }}', MobileCollectionCarousel{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Carrusel colecciones",
  "settings": [
    {
      "type": "header",
      "content": "Colecciones"
    },
    {
      "type": "collection",
      "id": "collection_1",
      "label": "Colección 1"
    },
    {
      "type": "collection",
      "id": "collection_2",
      "label": "Colección 2"
    },
    {
      "type": "collection",
      "id": "collection_3",
      "label": "Colección 3"
    },
    {
      "type": "header",
      "content": "Estilo de tarjeta"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Fondo de tarjeta",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color de texto",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Título"
    },
    {
      "type": "font_picker",
      "id": "title_font",
      "label": "Fuente del título",
      "default": "serif"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Tamaño del título",
      "min": 16,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Botón"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del botón",
      "default": "Ver colección"
    },
    {
      "type": "range",
      "id": "button_size",
      "label": "Tamaño del botón",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "button_radius",
      "label": "Radio del botón",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Fondo del botón",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Texto del botón",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "button_hover_bg",
      "label": "Fondo hover",
      "default": "#383838"
    },
    {
      "type": "color",
      "id": "button_hover_color",
      "label": "Texto hover",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Carrusel colecciones"
    }
  ]
}
{% endschema %}
