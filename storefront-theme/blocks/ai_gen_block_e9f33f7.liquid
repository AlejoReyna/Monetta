{% doc %}
  @prompt
    Generate the HTML and CSS code for a 'Custom Liquid' section. This is a minimalist product carousel for a luxury store.
    
    Design Specifications:
    
    Background: Solid white (#FFFFFF).
    
    Layout: A horizontal carousel with 3 cards.
    
    Visual Style: Each card should feature a high-quality product image placeholder. The images will be transparent PNGs, so they must appear to float elegantly on the white background.
    
    Dimensions: Make the image area tall and wide (aspect ratio 4:5) to ensure a high-end, complete look.
    
    Functionality:
    
    Smooth Transitions: The scrolling must be ultra-smooth. Use scroll-snap-type: x mandatory and a CSS transition of 0.6s cubic-bezier(0.25, 1, 0.5, 1) for a premium feel.
    
    Interactive Effect: When a card is centered, it should be at 100% size and opacity. Cards on the left and right should be slightly smaller (scale 0.9) and slightly faded (opacity 0.6).
    
    Content:
    
    Card 1: Title "BOLSAS", Link to "/collections/all", Button "EXPLORAR".
    
    Card 2: Title "CARTERAS", Link to "/collections/all", Button "EXPLORAR".
    
    Card 3: Title "RELOJES", Link to "/collections/all", Button "EXPLORAR".
    
    Technical: Use scoped CSS with the prefix .luxury-slider- to avoid theme conflicts. Do not use external libraries.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .luxury-slider-container-{{ ai_gen_id }} {
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding }}px 0;
    overflow: hidden;
    display: block;
  }

  .luxury-slider-wrapper-{{ ai_gen_id }} {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    gap: {{ block.settings.card_gap }}px;
    padding: 0 {{ block.settings.side_padding }}px;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .luxury-slider-wrapper-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .luxury-slider-card-{{ ai_gen_id }} {
    flex: 0 0 {{ block.settings.card_width }}%;
    scroll-snap-align: center;
    transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1), opacity 0.6s cubic-bezier(0.25, 1, 0.5, 1);
    opacity: {{ block.settings.inactive_opacity | divided_by: 100.0 }};
    transform: scale({{ block.settings.inactive_scale | divided_by: 100.0 }});
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .luxury-slider-card-{{ ai_gen_id }}.active {
    opacity: 1;
    transform: scale(1);
  }

  .luxury-slider-image-container-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 4 / 5;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: {{ block.settings.content_spacing }}px;
    position: relative;
  }

  .luxury-slider-image-container-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .luxury-slider-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f9f9f9;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .luxury-slider-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .luxury-slider-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: {{ block.settings.title_weight }};
    color: {{ block.settings.title_color }};
    margin: 0 0 {{ block.settings.content_spacing }}px;
    letter-spacing: {{ block.settings.title_letter_spacing }}px;
    text-transform: {{ block.settings.title_transform }};
  }

  .luxury-slider-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: {{ block.settings.button_font_weight }};
    letter-spacing: {{ block.settings.button_letter_spacing }}px;
    text-transform: {{ block.settings.button_text_transform }};
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    transition: all 0.3s ease;
  }

  .luxury-slider-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
  }

  @media screen and (max-width: 749px) {
    .luxury-slider-card-{{ ai_gen_id }} {
      flex: 0 0 {{ block.settings.card_width_mobile }}%;
    }

    .luxury-slider-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }

    .luxury-slider-button-{{ ai_gen_id }} {
      font-size: {{ block.settings.button_font_size | times: 0.9 }}px;
      padding: {{ block.settings.button_padding_vertical | times: 0.8 }}px {{ block.settings.button_padding_horizontal | times: 0.8 }}px;
    }
  }
{% endstyle %}

<luxury-carousel-{{ ai_gen_id }} class="luxury-slider-container-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="luxury-slider-wrapper-{{ ai_gen_id }}" data-carousel-wrapper>
    <div class="luxury-slider-card-{{ ai_gen_id }}" data-carousel-card>
      <div class="luxury-slider-image-container-{{ ai_gen_id }}">
        {% if block.settings.image_1 %}
          <img
            src="{{ block.settings.image_1 | image_url: width: 1000 }}"
            alt="{{ block.settings.title_1 | escape }}"
            loading="lazy"
            width="{{ block.settings.image_1.width }}"
            height="{{ block.settings.image_1.height }}"
          >
        {% else %}
          <div class="luxury-slider-image-placeholder-{{ ai_gen_id }}">
            {{ 'product-1' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>
      <h3 class="luxury-slider-title-{{ ai_gen_id }}">{{ block.settings.title_1 }}</h3>
      <a href="{{ block.settings.link_1 }}" class="luxury-slider-button-{{ ai_gen_id }}">
        {{ block.settings.button_text_1 }}
      </a>
    </div>

    <div class="luxury-slider-card-{{ ai_gen_id }}" data-carousel-card>
      <div class="luxury-slider-image-container-{{ ai_gen_id }}">
        {% if block.settings.image_2 %}
          <img
            src="{{ block.settings.image_2 | image_url: width: 1000 }}"
            alt="{{ block.settings.title_2 | escape }}"
            loading="lazy"
            width="{{ block.settings.image_2.width }}"
            height="{{ block.settings.image_2.height }}"
          >
        {% else %}
          <div class="luxury-slider-image-placeholder-{{ ai_gen_id }}">
            {{ 'product-2' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>
      <h3 class="luxury-slider-title-{{ ai_gen_id }}">{{ block.settings.title_2 }}</h3>
      <a href="{{ block.settings.link_2 }}" class="luxury-slider-button-{{ ai_gen_id }}">
        {{ block.settings.button_text_2 }}
      </a>
    </div>

    <div class="luxury-slider-card-{{ ai_gen_id }}" data-carousel-card>
      <div class="luxury-slider-image-container-{{ ai_gen_id }}">
        {% if block.settings.image_3 %}
          <img
            src="{{ block.settings.image_3 | image_url: width: 1000 }}"
            alt="{{ block.settings.title_3 | escape }}"
            loading="lazy"
            width="{{ block.settings.image_3.width }}"
            height="{{ block.settings.image_3.height }}"
          >
        {% else %}
          <div class="luxury-slider-image-placeholder-{{ ai_gen_id }}">
            {{ 'product-3' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>
      <h3 class="luxury-slider-title-{{ ai_gen_id }}">{{ block.settings.title_3 }}</h3>
      <a href="{{ block.settings.link_3 }}" class="luxury-slider-button-{{ ai_gen_id }}">
        {{ block.settings.button_text_3 }}
      </a>
    </div>
  </div>
</luxury-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class LuxuryCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.wrapper = this.querySelector('[data-carousel-wrapper]');
        this.cards = this.querySelectorAll('[data-carousel-card]');
      }

      connectedCallback() {
        this.setupIntersectionObserver();
        this.wrapper.addEventListener('scroll', this.handleScroll.bind(this));
        this.updateActiveCard();
      }

      setupIntersectionObserver() {
        const options = {
          root: this.wrapper,
          threshold: 0.6
        };

        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              this.cards.forEach((card) => card.classList.remove('active'));
              entry.target.classList.add('active');
            }
          });
        }, options);

        this.cards.forEach((card) => observer.observe(card));
      }

      handleScroll() {
        this.updateActiveCard();
      }

      updateActiveCard() {
        const wrapperCenter = this.wrapper.scrollLeft + this.wrapper.offsetWidth / 2;
        
        let closestCard = null;
        let closestDistance = Infinity;

        this.cards.forEach((card) => {
          const cardCenter = card.offsetLeft + card.offsetWidth / 2;
          const distance = Math.abs(wrapperCenter - cardCenter);

          if (distance < closestDistance) {
            closestDistance = distance;
            closestCard = card;
          }
        });

        if (closestCard) {
          this.cards.forEach((card) => card.classList.remove('active'));
          closestCard.classList.add('active');
        }
      }
    }

    customElements.define('luxury-carousel-{{ ai_gen_id }}', LuxuryCarousel{{ ai_gen_id }});
  })();
</script>

