{% doc %}
  @prompt
    haz un carrusel de 4 tarjetas que pueda poner un logo tipo icono, un header,  y un texto, las tarjetas se deslizan con el dedo al pasar el dedo y no cuentan con sombra 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-carousel-container-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    overflow: hidden;
    display: block;
  }

  .ai-carousel-wrapper-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.card_gap }}px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding: {{ block.settings.container_padding }}px 0;
  }

  .ai-carousel-wrapper-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-carousel-card-{{ ai_gen_id }} {
    flex: 0 0 {{ block.settings.card_width }}%;
    scroll-snap-align: start;
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: {{ block.settings.content_gap }}px;
  }

  .ai-carousel-icon-wrapper-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .ai-carousel-icon-wrapper-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-carousel-icon-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.placeholder_color }};
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-carousel-icon-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-carousel-header-{{ ai_gen_id }} {
    font-size: {{ block.settings.header_size }}px;
    font-weight: 600;
    color: {{ block.settings.header_color }};
    margin: 0;
  }

  .ai-carousel-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.5;
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-carousel-card-{{ ai_gen_id }} {
      flex: 0 0 {{ block.settings.card_width_mobile }}%;
    }
  }
{% endstyle %}

<card-carousel-{{ ai_gen_id }}
  class="ai-carousel-container-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-carousel-wrapper-{{ ai_gen_id }}">
    {% for i in (1..4) %}
      {% liquid
        assign icon_key = 'card_' | append: i | append: '_icon'
        assign header_key = 'card_' | append: i | append: '_header'
        assign text_key = 'card_' | append: i | append: '_text'

        assign card_icon = block.settings[icon_key]
        assign card_header = block.settings[header_key]
        assign card_text = block.settings[text_key]
      %}

      <div class="ai-carousel-card-{{ ai_gen_id }}">
        <div class="ai-carousel-icon-wrapper-{{ ai_gen_id }}">
          {% if card_icon %}
            <img
              src="{{ card_icon | image_url: width: 200 }}"
              alt="{{ card_header | escape }}"
              loading="lazy"
              width="200"
              height="200"
            >
          {% else %}
            <div class="ai-carousel-icon-placeholder-{{ ai_gen_id }}">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
              </svg>
            </div>
          {% endif %}
        </div>

        {% if card_header != blank %}
          <h3 class="ai-carousel-header-{{ ai_gen_id }}">{{ card_header }}</h3>
        {% endif %}

        {% if card_text != blank %}
          <p class="ai-carousel-text-{{ ai_gen_id }}">{{ card_text }}</p>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</card-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class CardCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.wrapper = this.querySelector('.ai-carousel-wrapper-{{ ai_gen_id }}');
        this.setupTouchScroll();
      }

      setupTouchScroll() {
        if (!this.wrapper) return;

        let isDown = false;
        let startX;
        let scrollLeft;

        this.wrapper.addEventListener('mousedown', (e) => {
          isDown = true;
          this.wrapper.style.cursor = 'grabbing';
          startX = e.pageX - this.wrapper.offsetLeft;
          scrollLeft = this.wrapper.scrollLeft;
        });

        this.wrapper.addEventListener('mouseleave', () => {
          isDown = false;
          this.wrapper.style.cursor = 'grab';
        });

        this.wrapper.addEventListener('mouseup', () => {
          isDown = false;
          this.wrapper.style.cursor = 'grab';
        });

        this.wrapper.addEventListener('mousemove', (e) => {
          if (!isDown) return;
          e.preventDefault();
          const x = e.pageX - this.wrapper.offsetLeft;
          const walk = (x - startX) * 2;
          this.wrapper.scrollLeft = scrollLeft - walk;
        });

        this.wrapper.style.cursor = 'grab';
      }
    }

    customElements.define('card-carousel-{{ ai_gen_id }}', CardCarousel{{ ai_gen_id }});
  })();
</script>

