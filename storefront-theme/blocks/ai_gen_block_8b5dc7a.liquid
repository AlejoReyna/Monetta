{% doc %}
  @prompt
    Task: Create a Premium Mobile-First Collection Carousel (Bolsas, Carteras, Relojes).
    
    1. Layout & Anti-Overflow (Crucial):
    
    Create a horizontal carousel that fits strictly within the mobile screen width.
    
    No Page Stretching: Ensure the section does not make the website wider or cause horizontal scrolling on the whole page.
    
    Asymmetric Alignment: Each card should be 85% of the screen width. Align the main card to the left with a 5% margin, allowing a 10% peek of the next card on the right to invite swiping.
    
    2. Fluid Pop-Up Animation:
    
    Transitions: Transitions between cards must be ultra-fluid, fast, and high-end.
    
    Subtle Scale Effect: The active card in the center should be full size, while side cards should slightly shrink (scale down) and have a subtle fade. The movement must feel like a smooth pop-up effect.
    
    3. Elegant Card Design:
    
    Shape: Use a very rounded 36px border-radius for a modern app-like look.
    
    Image: The product image must be large and centered, occupying 75% of the card's height. Use transparent images.
    
    Aesthetic: Pure white cards with a very soft, elegant shadow and 60px vertical spacing (top and bottom) for the whole section.
    
    4. Minimalist Details:
    
    Use an elegant Serif font for titles. Place a compact "EXPLORAR" button at the bottom.
    
    Hide the scrollbar for a clean, professional finish.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-premium-carousel-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    overflow: hidden;
    padding: 60px 0;
    background-color: {{ block.settings.background_color }};
  }

  .ai-premium-carousel-container-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .ai-premium-carousel-track-{{ ai_gen_id }} {
    display: flex;
    gap: 0;
    overflow-x: auto;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 0 5%;
  }

  .ai-premium-carousel-track-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-premium-carousel-card-{{ ai_gen_id }} {
    flex: 0 0 85%;
    scroll-snap-align: start;
    background-color: #ffffff;
    border-radius: 36px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
    padding: 32px 24px 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.4s ease;
    margin-right: 5%;
    min-height: 420px;
  }

  .ai-premium-carousel-card-{{ ai_gen_id }}:last-child {
    margin-right: 0;
  }

  .ai-premium-carousel-card-{{ ai_gen_id }}.ai-card-inactive-{{ ai_gen_id }} {
    transform: scale(0.92);
    opacity: 0.6;
  }

  .ai-premium-carousel-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    height: 75%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
    overflow: hidden;
  }

  .ai-premium-carousel-image-{{ ai_gen_id }} {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .ai-premium-carousel-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f9f9f9;
    border-radius: 16px;
  }

  .ai-premium-carousel-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-premium-carousel-content-{{ ai_gen_id }} {
    text-align: center;
    width: 100%;
  }

  .ai-premium-carousel-title-{{ ai_gen_id }} {
    font-family: {{ block.settings.title_font.family }}, {{ block.settings.title_font.fallback_families }};
    font-weight: {{ block.settings.title_font.weight }};
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 16px;
    line-height: 1.2;
  }

  .ai-premium-carousel-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 12px 32px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: all 0.3s ease;
  }

  .ai-premium-carousel-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    transform: translateY(-2px);
  }

  @media screen and (min-width: 750px) {
    .ai-premium-carousel-{{ ai_gen_id }} {
      padding: 80px 0;
    }

    .ai-premium-carousel-card-{{ ai_gen_id }} {
      min-height: 500px;
      padding: 40px 32px 32px;
    }

    .ai-premium-carousel-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 1.2 }}px;
    }
  }
{% endstyle %}

<premium-carousel-{{ ai_gen_id }} class="ai-premium-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-premium-carousel-container-{{ ai_gen_id }}">
    <div class="ai-premium-carousel-track-{{ ai_gen_id }}" data-carousel-track>
      {% for i in (1..3) %}
        {% liquid
          assign collection_key = 'collection_' | append: i
          assign collection = block.settings[collection_key]
        %}
        
        <div class="ai-premium-carousel-card-{{ ai_gen_id }}" data-card-index="{{ forloop.index0 }}">
          <div class="ai-premium-carousel-image-wrapper-{{ ai_gen_id }}">
            {% if collection and collection.featured_image %}
              <img
                src="{{ collection.featured_image | image_url: width: 600 }}"
                alt="{{ collection.featured_image.alt | escape }}"
                class="ai-premium-carousel-image-{{ ai_gen_id }}"
                loading="lazy"
                width="600"
                height="600"
              >
            {% else %}
              <div class="ai-premium-carousel-placeholder-{{ ai_gen_id }}">
                {{ 'collection-1' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
          
          <div class="ai-premium-carousel-content-{{ ai_gen_id }}">
            {% if collection %}
              <h3 class="ai-premium-carousel-title-{{ ai_gen_id }}">{{ collection.title }}</h3>
              <a href="{{ collection.url }}" class="ai-premium-carousel-button-{{ ai_gen_id }}">
                {{ block.settings.button_text }}
              </a>
            {% else %}
              <h3 class="ai-premium-carousel-title-{{ ai_gen_id }}">Colección {{ i }}</h3>
              <a href="#" class="ai-premium-carousel-button-{{ ai_gen_id }}">
                {{ block.settings.button_text }}
              </a>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</premium-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class PremiumCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.track = null;
        this.cards = [];
        this.currentIndex = 0;
        this.isScrolling = false;
        this.scrollTimeout = null;
      }

      connectedCallback() {
        this.track = this.querySelector('[data-carousel-track]');
        this.cards = Array.from(this.querySelectorAll('[data-card-index]'));
        
        if (!this.track || this.cards.length === 0) return;

        this.setupScrollListener();
        this.updateCardStates();
      }

      setupScrollListener() {
        this.track.addEventListener('scroll', () => {
          if (this.scrollTimeout) {
            clearTimeout(this.scrollTimeout);
          }

          this.isScrolling = true;

          this.scrollTimeout = setTimeout(() => {
            this.isScrolling = false;
            this.snapToNearestCard();
          }, 150);

          this.updateCardStates();
        });
      }

      snapToNearestCard() {
        const scrollLeft = this.track.scrollLeft;
        const cardWidth = this.cards[0].offsetWidth;
        const gap = cardWidth * 0.05;
        const totalCardWidth = cardWidth + gap;
        
        const nearestIndex = Math.round(scrollLeft / totalCardWidth);
        this.currentIndex = Math.max(0, Math.min(nearestIndex, this.cards.length - 1));
        
        const targetScroll = this.currentIndex * totalCardWidth;
        
        this.track.scrollTo({
          left: targetScroll,
          behavior: 'smooth'
        });
      }

      updateCardStates() {
        const scrollLeft = this.track.scrollLeft;
        const trackWidth = this.track.offsetWidth;
        const centerPosition = scrollLeft + (trackWidth * 0.425);

        this.cards.forEach((card, index) => {
          const cardLeft = card.offsetLeft;
          const cardWidth = card.offsetWidth;
          const cardCenter = cardLeft + (cardWidth / 2);
          
          const distanceFromCenter = Math.abs(cardCenter - centerPosition);
          const threshold = cardWidth * 0.3;

          if (distanceFromCenter < threshold) {
            card.classList.remove('ai-card-inactive-{{ ai_gen_id }}');
          } else {
            card.classList.add('ai-card-inactive-{{ ai_gen_id }}');
          }
        });
      }
    }

    customElements.define('premium-carousel-{{ ai_gen_id }}', PremiumCarousel{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Carrusel premium móvil",
  "settings": [
    {
      "type": "header",
      "content": "Colecciones"
    },
    {
      "type": "collection",
      "id": "collection_1",
      "label": "Colección 1"
    },
    {
      "type": "collection",
      "id": "collection_2",
      "label": "Colección 2"
    },
    {
      "type": "collection",
      "id": "collection_3",
      "label": "Colección 3"
    },
    {
      "type": "header",
      "content": "Estilo de tarjeta"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Color de fondo de sección",
      "default": "#f9f9f9"
    },
    {
      "type": "header",
      "content": "Título"
    },
    {
      "type": "font_picker",
      "id": "title_font",
      "label": "Fuente del título",
      "default": "serif"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Tamaño del título",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Color del título",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Botón"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Texto del botón",
      "default": "EXPLORAR"
    },
    {
      "type": "range",
      "id": "button_font_size",
      "label": "Tamaño de fuente",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Color de fondo",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_hover_background",
      "label": "Color de fondo al pasar",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Color de texto",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "label": "Radio de borde del botón",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Carrusel premium móvil"
    }
  ]
}
