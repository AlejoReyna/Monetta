{% doc %}
  @prompt
    Create a custom Liquid block for Shopify with the following layout:
    
    Display 3 circular collection cards in a single horizontal row, all aligned side by side (flexbox, flex-direction: row, justify-content: center). Each card contains only:
    
    A circular image (aspect ratio 1:1, border-radius: 50%) with a premium floating shadow directly on the circle: box-shadow: 0 8px 32px rgba(0,0,0,0.10), 0 2px 8px rgba(0,0,0,0.06)
    Collection name centered below the circle, clean minimal typography
    No card container background, no border-radius wrapper — just bare circle + label + shadow on the image
    Hover effect: transform: scale(1.04) on the circle
    Expandable drawer (2 extra cards):
    
    Below the 3 cards, show a centered chevron arrow (▼)
    When clicked, smoothly reveals 2 additional circular collection cards in the same style, in a horizontal centered row
    The arrow moves to the bottom of the revealed cards and always stays below all visible content
    Clicking again collapses and the arrow returns above
    Shadow fix — critical:
    
    The expandable drawer container must have enough vertical padding (padding-bottom: 24px minimum) so the circle shadows of the revealed cards are never clipped by the overflow hidden used for the animation
    Use overflow: visible on the inner wrapper and only apply overflow: hidden on the outer animated container, with extra bottom padding to prevent shadow cutoff
    Alternatively, use padding-bottom on the animated container large enough to accommodate the shadow bleed (at least 40px)
    Smooth arrow transition — critical:
    
    The arrow movement must feel fluid: use transition: transform 300ms cubic-bezier(0.4, 0, 0.2, 1) for rotation and transition: all 400ms cubic-bezier(0.4, 0, 0.2, 1) for position changes
    Do NOT abruptly reposition the arrow — animate it smoothly as the drawer opens/closes
    The arrow should rotate 180° when expanded (pointing up ▲) as a visual cue, in addition to moving below the revealed cards
    Expand/collapse uses max-height transition with 400ms cubic-bezier(0.4, 0, 0.2, 1) (not linear, not ease — use cubic-bezier for a premium feel)
    Responsive:
    
    First 3 cards always in one horizontal row on all screen sizes (scale down to fit)
    2 extra cards also horizontal when expanded
    On very small screens, allow wrapping only if absolutely necessary
    Total of 5 collection slots, each configurable in the theme editor via collection picker.
    
    Clean minimal CSS, no external dependencies, all logic in vanilla JS within the Liquid block.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-circles-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-collection-circles__main-row-{{ ai_gen_id }} {
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: flex-start;
    gap: {{ block.settings.card_gap }}px;
    flex-wrap: wrap;
  }

  .ai-collection-circles__card-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: {{ block.settings.label_gap }}px;
    text-decoration: none;
    flex: 0 0 auto;
    max-width: {{ block.settings.circle_size }}px;
  }

  .ai-collection-circles__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: {{ block.settings.circle_size }}px;
    height: {{ block.settings.circle_size }}px;
    border-radius: 50%;
    overflow: hidden;
    box-shadow: none
    transition: transform 300ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .ai-collection-circles__card-{{ ai_gen_id }}:hover .ai-collection-circles__image-wrapper-{{ ai_gen_id }} {
    transform: scale(1.04);
  }

  .ai-collection-circles__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-collection-circles__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.placeholder_bg_color }};
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-collection-circles__placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-collection-circles__label-{{ ai_gen_id }} {
    font-size: {{ block.settings.label_font_size }}px;
    color: {{ block.settings.label_color }};
    text-align: center;
    font-weight: {{ block.settings.label_font_weight }};
    text-transform: {{ block.settings.label_text_transform }};
    letter-spacing: {{ block.settings.label_letter_spacing }};
  }

  .ai-collection-circles__toggle-wrapper-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    margin-top: {{ block.settings.arrow_spacing }}px;
    transition: all 400ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .ai-collection-circles__toggle-{{ ai_gen_id }} {
    background: none;
    border: none;
    cursor: pointer;
    padding: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 300ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .ai-collection-circles__toggle-{{ ai_gen_id }}:hover {
    opacity: 0.7;
  }

  .ai-collection-circles__chevron-{{ ai_gen_id }} {
    width: {{ block.settings.arrow_size }}px;
    height: {{ block.settings.arrow_size }}px;
    stroke: {{ block.settings.arrow_color }};
    stroke-width: 2;
    fill: none;
    transition: transform 300ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .ai-collection-circles__drawer-outer-{{ ai_gen_id }} {
    max-height: 0;
    overflow: hidden;
    transition: max-height 400ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .ai-collection-circles__drawer-inner-{{ ai_gen_id }} {
    padding-top: {{ block.settings.drawer_top_padding }}px;
    padding-bottom: {{ block.settings.drawer_bottom_padding }}px;
    overflow: visible;
  }

  .ai-collection-circles__extra-row-{{ ai_gen_id }} {
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: flex-start;
    gap: {{ block.settings.card_gap }}px;
    flex-wrap: wrap;
  }

  @media screen and (max-width: 749px) {
    .ai-collection-circles__image-wrapper-{{ ai_gen_id }} {
      width: {{ block.settings.circle_size_mobile }}px;
      height: {{ block.settings.circle_size_mobile }}px;
    }

    .ai-collection-circles__card-{{ ai_gen_id }} {
      max-width: {{ block.settings.circle_size_mobile }}px;
    }

    .ai-collection-circles__label-{{ ai_gen_id }} {
      font-size: {{ block.settings.label_font_size_mobile }}px;
    }
  }
{% endstyle %}

<collection-circles-{{ ai_gen_id }} class="ai-collection-circles-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-collection-circles__main-row-{{ ai_gen_id }}">
    {% for i in (1..3) %}
      {% liquid
        assign collection_key = 'collection_' | append: i
        assign collection = block.settings[collection_key]
      %}
      {% if collection != blank %}
        <a href="{{ collection.url }}" class="ai-collection-circles__card-{{ ai_gen_id }}">
          <div class="ai-collection-circles__image-wrapper-{{ ai_gen_id }}">
            {% if collection.featured_image %}
              <img
                src="{{ collection.featured_image | image_url: width: 600 }}"
                alt="{{ collection.featured_image.alt | escape }}"
                width="600"
                height="600"
                loading="lazy"
                class="ai-collection-circles__image-{{ ai_gen_id }}"
              >
            {% else %}
              <div class="ai-collection-circles__placeholder-{{ ai_gen_id }}">
                {{ 'collection-1' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
          <div class="ai-collection-circles__label-{{ ai_gen_id }}">
            {{ collection.title }}
          </div>
        </a>
      {% else %}
        <div class="ai-collection-circles__card-{{ ai_gen_id }}">
          <div class="ai-collection-circles__image-wrapper-{{ ai_gen_id }}">
            <div class="ai-collection-circles__placeholder-{{ ai_gen_id }}">
              {{ 'collection-1' | placeholder_svg_tag }}
            </div>
          </div>
          <div class="ai-collection-circles__label-{{ ai_gen_id }}">
            Collection {{ i }}
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>

  {% if block.settings.collection_4 != blank or block.settings.collection_5 != blank %}
    <div class="ai-collection-circles__toggle-wrapper-{{ ai_gen_id }}" data-toggle-wrapper>
      <button
        class="ai-collection-circles__toggle-{{ ai_gen_id }}"
        aria-label="Show more collections"
        aria-expanded="false"
        data-toggle-button
      >
        <svg
          class="ai-collection-circles__chevron-{{ ai_gen_id }}"
          data-chevron
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </button>
    </div>

    <div class="ai-collection-circles__drawer-outer-{{ ai_gen_id }}" data-drawer>
      <div class="ai-collection-circles__drawer-inner-{{ ai_gen_id }}">
        <div class="ai-collection-circles__extra-row-{{ ai_gen_id }}">
          {% for i in (4..5) %}
            {% liquid
              assign collection_key = 'collection_' | append: i
              assign collection = block.settings[collection_key]
            %}
            {% if collection != blank %}
              <a href="{{ collection.url }}" class="ai-collection-circles__card-{{ ai_gen_id }}">
                <div class="ai-collection-circles__image-wrapper-{{ ai_gen_id }}">
                  {% if collection.featured_image %}
                    <img
                      src="{{ collection.featured_image | image_url: width: 600 }}"
                      alt="{{ collection.featured_image.alt | escape }}"
                      width="600"
                      height="600"
                      loading="lazy"
                      class="ai-collection-circles__image-{{ ai_gen_id }}"
                    >
                  {% else %}
                    <div class="ai-collection-circles__placeholder-{{ ai_gen_id }}">
                      {{ 'collection-1' | placeholder_svg_tag }}
                    </div>
                  {% endif %}
                </div>
                <div class="ai-collection-circles__label-{{ ai_gen_id }}">
                  {{ collection.title }}
                </div>
              </a>
            {% else %}
              <div class="ai-collection-circles__card-{{ ai_gen_id }}">
                <div class="ai-collection-circles__image-wrapper-{{ ai_gen_id }}">
                  <div class="ai-collection-circles__placeholder-{{ ai_gen_id }}">
                    {{ 'collection-1' | placeholder_svg_tag }}
                  </div>
                </div>
                <div class="ai-collection-circles__label-{{ ai_gen_id }}">
                  Collection {{ i }}
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
  {% endif %}
</collection-circles-{{ ai_gen_id }}>

<script>
  (function() {
    class CollectionCircles{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.isExpanded = false;
      }

      connectedCallback() {
        this.toggleButton = this.querySelector('[data-toggle-button]');
        this.drawer = this.querySelector('[data-drawer]');
        this.chevron = this.querySelector('[data-chevron]');
        this.toggleWrapper = this.querySelector('[data-toggle-wrapper]');

        if (!this.toggleButton || !this.drawer) return;

        this.toggleButton.addEventListener('click', () => this.toggle());
      }

      toggle() {
        this.isExpanded = !this.isExpanded;

        if (this.isExpanded) {
          const scrollHeight = this.drawer.scrollHeight;
          this.drawer.style.maxHeight = scrollHeight + 'px';
          this.toggleButton.setAttribute('aria-expanded', 'true');
          this.toggleButton.setAttribute('aria-label', 'Show fewer collections');
          this.chevron.style.transform = 'rotate(180deg)';
        } else {
          this.drawer.style.maxHeight = '0';
          this.toggleButton.setAttribute('aria-expanded', 'false');
          this.toggleButton.setAttribute('aria-label', 'Show more collections');
          this.chevron.style.transform = 'rotate(0deg)';
        }
      }
    }

    customElements.define('collection-circles-{{ ai_gen_id }}', CollectionCircles{{ ai_gen_id }});
  })();
</script>

