{% doc %}
  @prompt
    Task: Create a Custom "Horizontal Grid" Section for 9 Collection Cards (Strictly Uniform Sizes).
    
    1. Strict Uniform Sizing (Absolute Priority):
    
    Identical Dimensions: Every single card in the grid MUST be exactly the same size.
    
    Aspect Ratio: Force a strict aspect-ratio: 1 / 1 (perfect square) OR 4 / 5 (vertical rectangle) on the card containers. This guarantees mathematical uniformity.
    
    Image Cropping: Apply object-fit: cover along with width: 100% and height: 100% to all images. The images must perfectly fill their identical containers without ever distorting or breaking the uniform grid.
    
    2. Structural Architecture (The 3x3 Layout):
    
    Generate a section containing exactly 9 Collection Cards.
    
    Arrange them into a 3-row horizontal scrolling grid using display: grid, grid-template-rows: repeat(3, 1fr), and grid-auto-flow: column.
    
    Set mobile columns so 2 full columns are visible, with a 10% peek of the 3rd column.
    
    Apply max-width: 100vw and overflow: hidden to the main section wrapper to prevent page stretching.
    
    3. Minimalist Image-Only Aesthetic:
    
    Show ONLY images. Absolutely no text, titles, or buttons.
    
    Apply a 24px border-radius to the uniform cards.
    
    Add a very thin, elegant drop shadow strictly at the bottom of each card.
    
    Maintain a uniform 15px gap between all cards. Add exactly 60px of vertical padding to the top and bottom of the entire section.
    
    4. Motion & Polish:
    
    Enable horizontal scroll snapping (scroll-snap-type: x mandatory).
    
    Apply a subtle pop-up scaling effect (active columns scale to 1.0, side columns to 0.9).
    
    Hide all scrollbars. The section background must be Pure White (#FFFFFF).
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-horizontal-grid-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    max-width: 100vw;
    overflow: hidden;
    background-color: #FFFFFF;
    padding: 60px 0;
  }

  .ai-horizontal-grid-wrapper-{{ ai_gen_id }} {
    width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .ai-horizontal-grid-wrapper-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-horizontal-grid-container-{{ ai_gen_id }} {
    display: grid;
    grid-template-rows: repeat(3, 1fr);
    grid-auto-flow: column;
    gap: 15px;
    padding: 0 20px;
  }

  .ai-horizontal-grid-card-{{ ai_gen_id }} {
    position: relative;
    width: {{ block.settings.card_width }}px;
    aspect-ratio: {% if block.settings.aspect_ratio == 'square' %}1 / 1{% else %}4 / 5{% endif %};
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
    scroll-snap-align: start;
    transition: transform 0.3s ease;
  }

  .ai-horizontal-grid-card-{{ ai_gen_id }} a {
    display: block;
    width: 100%;
    height: 100%;
  }

  .ai-horizontal-grid-card-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-horizontal-grid-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-horizontal-grid-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  @media screen and (max-width: 749px) {
    .ai-horizontal-grid-container-{{ ai_gen_id }} {
      grid-template-columns: repeat(auto-fill, calc(45vw));
      padding: 0 15px;
    }

    .ai-horizontal-grid-card-{{ ai_gen_id }} {
      width: 45vw;
    }
  }

  @media screen and (min-width: 750px) {
    .ai-horizontal-grid-wrapper-{{ ai_gen_id }} {
      scroll-snap-type: none;
    }

    .ai-horizontal-grid-card-{{ ai_gen_id }}:hover {
      transform: scale(1.02);
    }
  }
{% endstyle %}

<horizontal-grid-{{ ai_gen_id }} class="ai-horizontal-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-horizontal-grid-wrapper-{{ ai_gen_id }}">
    <div class="ai-horizontal-grid-container-{{ ai_gen_id }}">
      {% for i in (1..9) %}
        {% liquid
          assign collection_key = 'collection_' | append: i
          assign collection = block.settings[collection_key]
        %}
        
        <div class="ai-horizontal-grid-card-{{ ai_gen_id }}">
          {% if collection != blank %}
            <a href="{{ collection.url }}">
              {% if collection.featured_image %}
                <img
                  src="{{ collection.featured_image | image_url: width: 800 }}"
                  alt="{{ collection.featured_image.alt | escape }}"
                  loading="lazy"
                  width="800"
                  height="{% if block.settings.aspect_ratio == 'square' %}800{% else %}1000{% endif %}"
                >
              {% else %}
                <div class="ai-horizontal-grid-placeholder-{{ ai_gen_id }}">
                  {{ 'collection-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </a>
          {% else %}
            <div class="ai-horizontal-grid-placeholder-{{ ai_gen_id }}">
              {{ 'collection-1' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</horizontal-grid-{{ ai_gen_id }}>

<script>
  (function() {
    class HorizontalGrid{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.wrapper = this.querySelector('.ai-horizontal-grid-wrapper-{{ ai_gen_id }}');
        this.cards = this.querySelectorAll('.ai-horizontal-grid-card-{{ ai_gen_id }}');
        
        if (window.innerWidth <= 749) {
          this.setupMobileScroll();
        }
      }

      setupMobileScroll() {
        let isScrolling;
        
        this.wrapper.addEventListener('scroll', () => {
          window.clearTimeout(isScrolling);
          
          isScrolling = setTimeout(() => {
            this.updateCardScales();
          }, 50);
        });

        this.updateCardScales();
      }

      updateCardScales() {
        if (window.innerWidth > 749) return;

        const wrapperRect = this.wrapper.getBoundingClientRect();
        const wrapperCenter = wrapperRect.left + wrapperRect.width / 2;

        this.cards.forEach((card) => {
          const cardRect = card.getBoundingClientRect();
          const cardCenter = cardRect.left + cardRect.width / 2;
          const distance = Math.abs(wrapperCenter - cardCenter);
          const maxDistance = wrapperRect.width / 2;
          const scale = Math.max(0.9, 1 - (distance / maxDistance) * 0.1);
          
          card.style.transform = `scale(${scale})`;
        });
      }
    }

    customElements.define('horizontal-grid-{{ ai_gen_id }}', HorizontalGrid{{ ai_gen_id }});
  })();
</script>

