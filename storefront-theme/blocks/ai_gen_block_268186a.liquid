{% doc %}
  @prompt
    Shopify liquid block. Horizontally scrollable 3-row × 3-column collection image grid. 9 collections total.
    
    MOBILE OVERFLOW FIX — CRITICAL: On mobile (max-width: 749px), wrapper must use: width: 100vw, position: relative, left: 50%, transform: translateX(-50%), box-sizing: border-box, overflow: visible. This breaks out of the parent grid column without widening the page. Never use overflow: hidden on the wrapper.
    
    WRAPPER DESKTOP: width: 100%, max-width: 100vw, overflow: visible, background: transparent, padding: 0 32px, box-sizing: border-box.
    
    SCROLL CONTAINER: display: grid, grid-template-rows: repeat(3, auto), grid-auto-flow: column, overflow-x: auto, overflow-y: visible, padding: 28px 16px, gap: 28px, scroll-snap-type: x mandatory, scroll-snap-stop: always, -webkit-overflow-scrolling: touch, scrollbar-width: none. The padding 28px top/bottom gives shadow room to breathe on all sides including bottom — never clip it.
    
    CARDS — SHADOW MUST FOLLOW BORDER RADIUS EXACTLY: Each card must have overflow: hidden, border-radius matching the setting, background: transparent. The box-shadow must use a spread-radius that matches the border-radius so the shadow follows the rounded shape perfectly at any radius value. Use: box-shadow: 0 2px 8px rgba(0,0,0,0.06), 0 8px 24px rgba(0,0,0, [shadow_opacity]), 0 20px 48px rgba(0,0,0,0.04). NO background color on the card — transparent only. The shadow must appear as a soft floating glow around the card shape, not a rectangular halo or outline.
    
    IMAGE FILL: object-fit: cover, width: 100%, height: 100%, display: block. Image must fill every pixel of the card including corners. No gap between image and card edge.
    
    HOVER/TOUCH: transform: translateY(-5px) scale(1.02), box-shadow: 0 8px 24px rgba(0,0,0,0.10), 0 20px 48px rgba(0,0,0,0.10), 0 32px 64px rgba(0,0,0,0.06), transition cubic-bezier(0.25,0.46,0.45,0.94) 0.3s.
    
    SCROLL START: Force scrollLeft = 0 using: immediate execution, DOMContentLoaded, window load, setTimeout 100ms, setTimeout 500ms. Use document.currentScript reference or element ID to target the correct container.
    
    THEME SETTINGS (all editable in theme editor): card width desktop default 200px, card width mobile default 150px, gap default 28px, border-radius default 20px, shadow opacity default 8%, padding horizontal default 32px, vertical padding default 28px.
    
    aspect-ratio: 2.3/1 on all cards. No text, no title, no overlay on cards.
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-grid-wrapper-{{ ai_gen_id }} {
    width: 100%;
    max-width: 100vw;
    overflow: visible;
    background: transparent;
    padding: 0 {{ block.settings.padding_horizontal }}px;
    box-sizing: border-box;
    display: block;
  }

  @media screen and (max-width: 749px) {
    .ai-collection-grid-wrapper-{{ ai_gen_id }} {
      width: 100vw;
      position: relative;
      left: 50%;
      transform: translateX(-50%);
      box-sizing: border-box;
      overflow: visible;
    }
  }

  .ai-collection-grid-container-{{ ai_gen_id }} {
    display: grid;
    grid-template-rows: repeat(3, auto);
    grid-auto-flow: column;
    overflow-x: auto;
    overflow-y: visible;
    padding: {{ block.settings.padding_vertical }}px 16px;
    gap: {{ block.settings.gap }}px;
    scroll-snap-type: x mandatory;
    scroll-snap-stop: always;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .ai-collection-grid-container-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-collection-card-{{ ai_gen_id }} {
    width: {{ block.settings.card_width_desktop }}px;
    aspect-ratio: 2.3 / 1;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
    background: transparent;
    box-shadow: 0 2px 8px rgba(0,0,0,0.06), 0 8px 24px rgba(0,0,0,{{ block.settings.shadow_opacity | divided_by: 100.0 }}), 0 20px 48px rgba(0,0,0,0.04);
    transition: transform 0.3s cubic-bezier(0.25,0.46,0.45,0.94), box-shadow 0.3s cubic-bezier(0.25,0.46,0.45,0.94);
    scroll-snap-align: start;
    position: relative;
  }

  @media screen and (max-width: 749px) {
    .ai-collection-card-{{ ai_gen_id }} {
      width: {{ block.settings.card_width_mobile }}px;
    }
  }

  .ai-collection-card-{{ ai_gen_id }}:hover,
  .ai-collection-card-{{ ai_gen_id }}:active {
    transform: translateY(-5px) scale(1.02);
    box-shadow: 0 8px 24px rgba(0,0,0,0.10), 0 20px 48px rgba(0,0,0,0.10), 0 32px 64px rgba(0,0,0,0.06);
  }

  .ai-collection-card-link-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    height: 100%;
    text-decoration: none;
  }

  .ai-collection-card-image-{{ ai_gen_id }} {
    object-fit: cover;
    width: 100%;
    height: 100%;
    display: block;
  }

  .ai-collection-card-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-collection-card-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }
{% endstyle %}

<collection-grid-{{ ai_gen_id }} class="ai-collection-grid-wrapper-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-collection-grid-container-{{ ai_gen_id }}" id="ai-collection-grid-scroll-{{ ai_gen_id }}">
    {% for i in (1..9) %}
      {% liquid
        assign collection_key = 'collection_' | append: i
        assign collection = block.settings[collection_key]
      %}
      
      <div class="ai-collection-card-{{ ai_gen_id }}">
        {% if collection != blank %}
          <a href="{{ collection.url }}" class="ai-collection-card-link-{{ ai_gen_id }}">
            {% if collection.featured_image %}
              <img
                src="{{ collection.featured_image | image_url: width: 600 }}"
                alt="{{ collection.featured_image.alt | escape }}"
                loading="lazy"
                width="600"
                height="261"
                class="ai-collection-card-image-{{ ai_gen_id }}"
              >
            {% else %}
              <div class="ai-collection-card-placeholder-{{ ai_gen_id }}">
                {{ 'collection-apparel-1' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </a>
        {% else %}
          <div class="ai-collection-card-placeholder-{{ ai_gen_id }}">
            {{ 'collection-apparel-1' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</collection-grid-{{ ai_gen_id }}>

<script>
  (function() {
    class CollectionGrid{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.scrollContainer = this.querySelector('#ai-collection-grid-scroll-{{ ai_gen_id }}');
        this.resetScroll();
      }

      resetScroll() {
        if (!this.scrollContainer) return;

        const forceScrollReset = () => {
          this.scrollContainer.scrollLeft = 0;
        };

        forceScrollReset();

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', forceScrollReset);
        }

        window.addEventListener('load', forceScrollReset);

        setTimeout(forceScrollReset, 100);
        setTimeout(forceScrollReset, 500);
      }
    }

    customElements.define('collection-grid-{{ ai_gen_id }}', CollectionGrid{{ ai_gen_id }});
  })();
</script>

