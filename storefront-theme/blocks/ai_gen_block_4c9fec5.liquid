{% doc %}
  @prompt
    Shopify Liquid block. Image carousel, 3 cards, mobile-first. Full-bleed images only, no text, all backgrounds transparent.
    
    Never cause horizontal page overflow. Custom element and wrapper must have display: block, width: 100%, max-width: 100%, overflow: hidden, margin: 0, box-sizing: border-box. Only the scroll track has overflow-x: auto. Never use overflow: visible, force-full-width, negative margins, or width: 100vw. Define custom element in CSS: carousel-[id] { display: block; width: 100%; max-width: 100%; overflow: hidden; background: transparent; }. Use if (!customElements.get(...)) guard before registering.
    
    Cards: flex: 0 0 65vw, max-width: 240px, aspect-ratio: 3/4, border-radius: 24px, overflow: hidden, background: transparent, scroll-snap-align: center, will-change: transform. Image: width: 100%, height: 100%, object-fit: cover, display: block, pointer-events: none. Zero padding inside card. Resting shadow: 0 4px 8px rgba(0,0,0,0.10), 0 10px 20px rgba(0,0,0,0.10), 0 18px 28px rgba(0,0,0,0.08). Transition: 0.6s cubic-bezier(0.34, 1.56, 0.64, 1).
    
    Scroll-driven pop with Intersection Observer threshold 0.85: centered card gets transform: translateY(-14px) scale(1.04) and shadow: 0 6px 12px rgba(0,0,0,0.12), 0 14px 28px rgba(0,0,0,0.14), 0 24px 40px rgba(0,0,0,0.10). Non-centered cards restore to resting state.
    
    Hover and active: transform: translateY(-18px) scale(1.06), same intensified shadow. Transition: 0.5s cubic-bezier(0.34, 1.56, 0.64, 1).
    
    Scroll track: display: flex, gap: 32px, overflow-x: auto, overflow-y: hidden, scroll-snap-type: x mandatory, scroll-snap-stop: always, -webkit-overflow-scrolling: touch, scrollbar-width: none, scroll-behavior: smooth, padding: 56px 40px, margin: 0.
    
    Force scrollLeft = 0 on DOMContentLoaded, load, setTimeout 100ms and 500ms.
    
    Settings: image_1 image_2 image_3 as image pickers, link_1 link_2 link_3 as URL pickers, border-radius default 24, shadow-opacity default 10.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  carousel-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    max-width: 100%;
    overflow: hidden;
    background: transparent;
    margin: 0;
    box-sizing: border-box;
  }

  .ai-carousel-wrapper-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    max-width: 100%;
    overflow: hidden;
    margin: 0;
    box-sizing: border-box;
  }

  .ai-carousel-track-{{ ai_gen_id }} {
    display: flex;
    gap: 32px;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-snap-stop: always;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    scroll-behavior: smooth;
    padding: 56px 40px;
    margin: 0;
  }

  .ai-carousel-track-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-carousel-card-{{ ai_gen_id }} {
    flex: 0 0 65vw;
    max-width: 240px;
    aspect-ratio: 3/4;
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
    background: transparent;
    scroll-snap-align: center;
    will-change: transform;
    box-shadow: 0 4px 8px rgba(0, 0, 0, {{ block.settings.shadow_opacity | times: 0.01 }}),
                0 10px 20px rgba(0, 0, 0, {{ block.settings.shadow_opacity | times: 0.01 }}),
                0 18px 28px rgba(0, 0, 0, {{ block.settings.shadow_opacity | times: 0.008 }});
    transition: transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1),
                box-shadow 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
    padding: 0;
    box-sizing: border-box;
  }

  .ai-carousel-card-{{ ai_gen_id }}.centered {
    transform: translateY(-14px) scale(1.04);
    box-shadow: 0 6px 12px rgba(0, 0, 0, {{ block.settings.shadow_opacity | times: 0.012 }}),
                0 14px 28px rgba(0, 0, 0, {{ block.settings.shadow_opacity | times: 0.014 }}),
                0 24px 40px rgba(0, 0, 0, {{ block.settings.shadow_opacity | times: 0.01 }});
  }

  .ai-carousel-card-{{ ai_gen_id }}:hover,
  .ai-carousel-card-{{ ai_gen_id }}:active {
    transform: translateY(-18px) scale(1.06);
    box-shadow: 0 6px 12px rgba(0, 0, 0, {{ block.settings.shadow_opacity | times: 0.012 }}),
                0 14px 28px rgba(0, 0, 0, {{ block.settings.shadow_opacity | times: 0.014 }}),
                0 24px 40px rgba(0, 0, 0, {{ block.settings.shadow_opacity | times: 0.01 }});
    transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1),
                box-shadow 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .ai-carousel-card-link-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    height: 100%;
    text-decoration: none;
  }

  .ai-carousel-card-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    pointer-events: none;
  }

  .ai-carousel-card-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-carousel-card-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
{% endstyle %}

<carousel-{{ ai_gen_id }} class="ai-carousel-wrapper-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-carousel-track-{{ ai_gen_id }}">
    {% for i in (1..3) %}
      {% liquid
        assign image_key = 'image_' | append: i
        assign link_key = 'link_' | append: i
        assign image = block.settings[image_key]
        assign link = block.settings[link_key]
      %}
      <div class="ai-carousel-card-{{ ai_gen_id }}" data-card-index="{{ i }}">
        {% if link != blank %}
          <a href="{{ link }}" class="ai-carousel-card-link-{{ ai_gen_id }}">
            {% if image != blank %}
              <img
                src="{{ image | image_url: width: 480 }}"
                alt="{{ image.alt | escape }}"
                width="480"
                height="640"
                loading="lazy"
                class="ai-carousel-card-image-{{ ai_gen_id }}"
              >
            {% else %}
              <div class="ai-carousel-card-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </a>
        {% else %}
          {% if image != blank %}
            <img
              src="{{ image | image_url: width: 480 }}"
              alt="{{ image.alt | escape }}"
              width="480"
              height="640"
              loading="lazy"
              class="ai-carousel-card-image-{{ ai_gen_id }}"
            >
          {% else %}
            <div class="ai-carousel-card-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        {% endif %}
      </div>
    {% endfor %}
  </div>
</carousel-{{ ai_gen_id }}>

<script>
  (function() {
    if (!customElements.get('carousel-{{ ai_gen_id }}')) {
      class Carousel{{ ai_gen_id }} extends HTMLElement {
        constructor() {
          super();
          this.track = this.querySelector('.ai-carousel-track-{{ ai_gen_id }}');
          this.cards = this.querySelectorAll('.ai-carousel-card-{{ ai_gen_id }}');
          this.observer = null;
        }

        connectedCallback() {
          this.resetScroll();
          this.setupIntersectionObserver();
          
          window.addEventListener('DOMContentLoaded', () => this.resetScroll());
          window.addEventListener('load', () => this.resetScroll());
          setTimeout(() => this.resetScroll(), 100);
          setTimeout(() => this.resetScroll(), 500);
        }

        resetScroll() {
          if (this.track) {
            this.track.scrollLeft = 0;
          }
        }

        setupIntersectionObserver() {
          const options = {
            root: this.track,
            threshold: 0.85
          };

          this.observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('centered');
              } else {
                entry.target.classList.remove('centered');
              }
            });
          }, options);

          this.cards.forEach((card) => {
            this.observer.observe(card);
          });
        }

        disconnectedCallback() {
          if (this.observer) {
            this.observer.disconnect();
          }
        }
      }

      customElements.define('carousel-{{ ai_gen_id }}', Carousel{{ ai_gen_id }});
    }
  })();
</script>

