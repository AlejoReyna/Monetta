    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Font",
      "default": "sans-serif"
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "Font size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
