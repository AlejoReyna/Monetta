{% doc %}
  @prompt
    Image with text block — stacked vertical layout. Image on top with configurable shadow and border-radius. Two pill-shaped buttons side by side with configurable shadow. Min font size 12px enforced.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-image-text-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: 0;
  }

  .ai-image-text-container-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

.ai-image-text-image-wrapper-{{ ai_gen_id }} {
  width: 100%;
  margin-bottom: {{ block.settings.image_bottom_margin }}px;
  padding-left: {{ block.settings.image_padding_left }}px;
  padding-right: {{ block.settings.image_padding_right }}px;
}


  .ai-image-text-image-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: {{ block.settings.image_aspect_ratio }};
    object-fit: cover;
    object-position: center;
    border-radius: {{ block.settings.image_border_radius }}px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, {{ block.settings.shadow_opacity | divided_by: 100.0 }});
    display: block;
  }

  .ai-image-text-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: {{ block.settings.image_aspect_ratio }};
    border-radius: {{ block.settings.image_border_radius }}px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, {{ block.settings.shadow_opacity | divided_by: 100.0 }});
    overflow: hidden;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-image-text-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-image-text-content-{{ ai_gen_id }} {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: {{ block.settings.content_gap }}px;
  }

  .ai-image-text-subheading-{{ ai_gen_id }} {
    font-family: {{ block.settings.subheading_font.family }}, {{ block.settings.subheading_font.fallback_families }};
    font-weight: {{ block.settings.subheading_font.weight }};
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.subheading_color }};
    text-transform: uppercase;
    letter-spacing: {{ block.settings.subheading_letter_spacing }}px;
    margin: 0;
  }

  .ai-image-text-heading-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0;
    line-height: 1.2;
  }

  .ai-image-text-body-{{ ai_gen_id }} {
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    font-weight: {{ block.settings.body_font.weight }};
    font-size: {{ block.settings.body_size }}px;
    color: {{ block.settings.body_color }};
    line-height: {{ block.settings.body_line_height }};
    margin: 0;
    max-width: {{ block.settings.body_max_width }}px;
  }

  /* ── BOTONES ── */
  .ai-image-text-buttons-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: nowrap;        /* siempre en la misma línea */
    gap: {{ block.settings.button_gap }}px;
    justify-content: center;
    align-items: center;      /* misma altura */
    margin-top: {{ block.settings.buttons_top_margin }}px;
    width: 100%;
  }

  .ai-image-text-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    border-radius: 999px;
    font-family: {{ block.settings.button_font.family }}, {{ block.settings.button_font.fallback_families }};
    font-weight: {{ block.settings.button_font.weight }};
    font-size: max(12px, {{ block.settings.button_font_size }}px); /* mínimo 12px */
    text-decoration: none;
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    cursor: pointer;
    transition: all 0.3s ease;
    white-space: nowrap;
    box-shadow: 0 4px 16px rgba(0, 0, 0, {{ block.settings.button_shadow_opacity | divided_by: 100.0 }});
  }

  .ai-image-text-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-image-text-container-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-image-text-heading-{{ ai_gen_id }} {
      font-size: max(20px, calc({{ block.settings.heading_size }}px * 0.7));
    }

    .ai-image-text-subheading-{{ ai_gen_id }} {
      font-size: max(12px, calc({{ block.settings.subheading_size }}px * 0.9));
    }

    .ai-image-text-body-{{ ai_gen_id }} {
      font-size: max(12px, calc({{ block.settings.body_size }}px * 0.95));
    }

    .ai-image-text-button-{{ ai_gen_id }} {
      font-size: max(12px, {{ block.settings.button_font_size }}px);
      padding: {{ block.settings.button_padding_vertical }}px calc({{ block.settings.button_padding_horizontal }}px * 0.65);
    }
  }
{% endstyle %}

<ai-image-text-{{ ai_gen_id }} class="ai-image-text-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-image-text-container-{{ ai_gen_id }}">
    <div class="ai-image-text-image-wrapper-{{ ai_gen_id }}">
      {% if block.settings.image %}
        <img
          src="{{ block.settings.image | image_url: width: 2000 }}"
          alt="{{ block.settings.image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.image.width }}"
          height="{{ block.settings.image.height }}"
          class="ai-image-text-image-{{ ai_gen_id }}"
        >
      {% else %}
        <div class="ai-image-text-placeholder-{{ ai_gen_id }}">
          {{ 'hero-apparel-1' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>

    <div class="ai-image-text-content-{{ ai_gen_id }}">
      {% if block.settings.subheading != blank %}
        <p class="ai-image-text-subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</p>
      {% endif %}

      {% if block.settings.heading != blank %}
        <h2 class="ai-image-text-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      {% endif %}

      {% if block.settings.body_text != blank %}
        <div class="ai-image-text-body-{{ ai_gen_id }}">{{ block.settings.body_text }}</div>
      {% endif %}

      {% if block.settings.button_1_text != blank or block.settings.button_2_text != blank %}
        <div class="ai-image-text-buttons-{{ ai_gen_id }}">
          {% if block.settings.button_1_text != blank %}
            <a href="{{ block.settings.button_1_link }}" class="ai-image-text-button-{{ ai_gen_id }}">
              {{ block.settings.button_1_text }}
            </a>
          {% endif %}
          {% if block.settings.button_2_text != blank %}
            <a href="{{ block.settings.button_2_link }}" class="ai-image-text-button-{{ ai_gen_id }}">
              {{ block.settings.button_2_text }}
            </a>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</ai-image-text-{{ ai_gen_id }}>

<script>
  (function() {
    class AiImageText{{ ai_gen_id }} extends HTMLElement {
      connectedCallback() {}
    }
    if (!customElements.get('ai-image-text-{{ ai_gen_id }}')) {
      customElements.define('ai-image-text-{{ ai_gen_id }}', AiImageText{{ ai_gen_id }});
    }
  })();
</script>

{% schema %}
{
  "name": "Image with text",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "content_gap",
      "label": "Content spacing",
      "min": 8,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_aspect_ratio",
      "label": "Aspect ratio",
      "options": [
        { "value": "16 / 9", "label": "16:9 (Horizontal)" },
        { "value": "3 / 1", "label": "3:1 (Wide banner)" },
        { "value": "21 / 9", "label": "21:9 (Ultra wide)" },
        { "value": "4 / 3", "label": "4:3" }
      ],
      "default": "16 / 9"
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "shadow_opacity",
      "label": "Image shadow opacity",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "%",
      "default": 12
    },
    {
      "type": "range",
      "id": "image_bottom_margin",
      "label": "Bottom margin",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Subheading"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "SOBRE MONETTA"
    },
    {
      "type": "font_picker",
      "id": "subheading_font",
      "label": "Font",
      "default": "sans-serif"
    },
    {
      "type": "range",
      "id": "subheading_size",
      "label": "Font size",
      "min": 8,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 11
    },
    {
      "type": "range",
      "id": "subheading_letter_spacing",
      "label": "Letter spacing",
      "min": 0,
      "max": 6,
      "step": 0.5,
      "unit": "px",
      "default": 3
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Color",
      "default": "#666666"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "TEXTO"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Font",
      "default": "serif"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Font size",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Color",
      "default": "#000000"
    },
    {
