{% doc %}
  @prompt Collage de colecciones con carrusel 3x3 deslizable
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .luxury-bento-heading-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-size: {{ block.settings.heading_size | times: 0.75 }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 16px;
    text-align: center;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    display: block;
  }

  .luxury-bento-scroll-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: 100%;
  }

  .luxury-bento-row-{{ ai_gen_id }} {
    display: flex;
    flex-direction: row;
    gap: 8px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    width: 100%;
    box-sizing: border-box;
  }

  .luxury-bento-row-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .luxury-bento-card-{{ ai_gen_id }} {
    flex: 0 0 42%;
    scroll-snap-align: start;
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    display: block;
    text-decoration: none;
    background: #f0f0f0;
    cursor: pointer;
    box-shadow: 0 2px 12px rgba(0,0,0,0.08);
    transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                box-shadow 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    opacity: 1;
    animation: bentoFadeIn-{{ ai_gen_id }} 0.5s ease forwards;
  }

  .luxury-bento-card-{{ ai_gen_id }}:active {
    transform: scale(0.97);
  }

  .luxury-bento-card-image-wrapper-{{ ai_gen_id }} {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .luxury-bento-card-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .luxury-bento-card-{{ ai_gen_id }}:active .luxury-bento-card-image-{{ ai_gen_id }} {
    transform: scale(1.05);
  }

  .luxury-bento-card-label-{{ ai_gen_id }} {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.65) 0%, transparent 100%);
    color: #fff;
    font-size: 0.55rem;
    font-weight: 700;
    text-align: center;
    padding: 16px 4px 6px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .luxury-bento-card-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #f5f5f5, #e8e8e8);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .luxury-bento-card-placeholder-{{ ai_gen_id }} svg {
    width: 50%;
    height: 50%;
    opacity: 0.2;
  }

  {% for i in (1..9) %}
    .luxury-bento-row-{{ ai_gen_id }} > *:nth-child({{ i }}) {
      animation-delay: {{ i | times: 0.06 }}s;
    }
  {% endfor %}

  @keyframes bentoFadeIn-{{ ai_gen_id }} {
    from { opacity: 0; transform: scale(0.95) translateY(6px); }
    to { opacity: 1; transform: scale(1) translateY(0); }
  }

  @media screen and (min-width: 750px) {
    .luxury-bento-card-{{ ai_gen_id }} {
      flex: 0 0 30%;
    }

    .luxury-bento-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size }}px;
    }
  }
{% endstyle %}

{% if block.settings.heading != blank %}
  <span class="luxury-bento-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</span>
{% endif %}

<div class="luxury-bento-scroll-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {%- assign collections = '' | split: '' -%}
  {%- for i in (1..9) -%}
    {%- assign key = 'collection_' | append: i -%}
    {%- assign col = block.settings[key] -%}
    {%- if col != blank -%}
      {%- assign collections = collections | concat: col -%}
    {%- endif -%}
  {%- endfor -%}

  {%- comment -%} Fila 1: colecciones 1-3 {%- endcomment -%}
  <div class="luxury-bento-row-{{ ai_gen_id }}">
    {%- for i in (0..2) -%}
      {%- assign col = collections[i] -%}
      {%- if col != blank -%}
        <a href="{{ col.url }}" class="luxury-bento-card-{{ ai_gen_id }}">
          <div class="luxury-bento-card-image-wrapper-{{ ai_gen_id }}">
            {%- if col.image -%}
              <img src="{{ col.image | image_url: width: 400 }}" alt="{{ col.image.alt | escape }}" loading="lazy" width="400" height="400" class="luxury-bento-card-image-{{ ai_gen_id }}">
            {%- elsif col.products.first and col.products.first.featured_image -%}
              <img src="{{ col.products.first.featured_image | image_url: width: 400 }}" alt="{{ col.products.first.featured_image.alt | escape }}" loading="lazy" width="400" height="400" class="luxury-bento-card-image-{{ ai_gen_id }}">
            {%- else -%}
              <div class="luxury-bento-card-placeholder-{{ ai_gen_id }}">{{ 'collection-apparel-1' | placeholder_svg_tag }}</div>
            {%- endif -%}
          </div>
          <span class="luxury-bento-card-label-{{ ai_gen_id }}">{{ col.title }}</span>
        </a>
      {%- endif -%}
    {%- endfor -%}
  </div>

  {%- comment -%} Fila 2: colecciones 4-6 {%- endcomment -%}
  <div class="luxury-bento-row-{{ ai_gen_id }}">
    {%- for i in (3..5) -%}
      {%- assign col = collections[i] -%}
      {%- if col != blank -%}
        <a href="{{ col.url }}" class="luxury-bento-card-{{ ai_gen_id }}">
          <div class="luxury-bento-card-image-wrapper-{{ ai_gen_id }}">
            {%- if col.image -%}
              <img src="{{ col.image | image_url: width: 400 }}" alt="{{ col.image.alt | escape }}" loading="lazy" width="400" height="400" class="luxury-bento-card-image-{{ ai_gen_id }}">
            {%- elsif col.products.first and col.products.first.featured_image -%}
              <img src="{{ col.products.first.featured_image | image_url: width: 400 }}" alt="{{ col.products.first.featured_image.alt | escape }}" loading="lazy" width="400" height="400" class="luxury-bento-card-image-{{ ai_gen_id }}">
            {%- else -%}
              <div class="luxury-bento-card-placeholder-{{ ai_gen_id }}">{{ 'collection-apparel-1' | placeholder_svg_tag }}</div>
            {%- endif -%}
          </div>
          <span class="luxury-bento-card-label-{{ ai_gen_id }}">{{ col.title }}</span>
        </a>
      {%- endif -%}
    {%- endfor -%}
  </div>

  {%- comment -%} Fila 3: colecciones 7-9 {%- endcomment -%}
  <div class="luxury-bento-row-{{ ai_gen_id }}">
    {%- for i in (6..8) -%}
      {%- assign col = collections[i] -%}
      {%- if col != blank -%}
        <a href="{{ col.url }}" class="luxury-bento-card-{{ ai_gen_id }}">
          <div class="luxury-bento-card-image-wrapper-{{ ai_gen_id }}">
            {%- if col.image -%}
              <img src="{{ col.image | image_url: width: 400 }}" alt="{{ col.image.alt | escape }}" loading="lazy" width="400" height="400" class="luxury-bento-card-image-{{ ai_gen_id }}">
            {%- elsif col.products.first and col.products.first.featured_image -%}
              <img src="{{ col.products.first.featured_image | image_url: width: 400 }}" alt="{{ col.products.first.featured_image.alt | escape }}" loading="lazy" width="400" height="400" class="luxury-bento-card-image-{{ ai_gen_id }}">
            {%- else -%}
              <div class="luxury-bento-card-placeholder-{{ ai_gen_id }}">{{ 'collection-apparel-1' | placeholder_svg_tag }}</div>
            {%- endif -%}
          </div>
          <span class="luxury-bento-card-label-{{ ai_gen_id }}">{{ col.title }}</span>
        </a>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Collage de colecciones",
  "settings": [
    {
      "type": "header",
      "content": "Encabezado"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título principal"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Fuente del título",
      "default": "newsreader_n2"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Tamaño del título",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Color del título",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Colecciones"
    },
    {
      "type": "collection",
      "id": "collection_1",
      "label": "Colección 1"
    },
    {
      "type": "collection",
      "id": "collection_2",
      "label": "Colección 2"
    },
    {
      "type": "collection",
      "id": "collection_3",
      "label": "Colección 3"
    },
    {
      "type": "collection",
      "id": "collection_4",
      "label": "Colección 4"
    },
    {
      "type": "collection",
      "id": "collection_5",
      "label": "Colección 5"
    },
    {
      "type": "collection",
      "id": "collection_6",
      "label": "Colección 6"
    },
    {
      "type": "collection",
      "id": "collection_7",
      "label": "Colección 7"
    },
    {
      "type": "collection",
      "id": "collection_8",
      "label": "Colección 8"
    },
    {
      "type": "collection",
      "id": "collection_9",
      "label": "Colección 9"
    }
  ],
  "presets": [
    {
      "name": "Collage de colecciones"
    }
  ]
}
{% endschema %}
