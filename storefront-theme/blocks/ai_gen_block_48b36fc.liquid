{% doc %}
  @prompt
    Act as a Lead UI/UX Designer for a luxury fashion e-commerce brand. Generate the complete HTML and embedded CSS code for a 'Custom Liquid' section for a high-end Collection Carousel.
    
    Design & Aesthetic Guidelines (Luxury & Clean):
    
    Background: Solid, pure white (#FFFFFF).
    
    Container Borders: Apply a generous border-radius: 30px to the main image containers to create that soft, modern, and rounded look.
    
    Proportions: The image area must be tall and wide (Aspect Ratio 4:5). This prevents the design from looking cramped and ensures a premium, full-screen presence.
    
    Micro-Shadows (Glassmorphism): Instead of harsh borders, add a very subtle, large-spread soft shadow (box-shadow: 0 20px 60px rgba(0,0,0,0.03)) to the rounded containers to make them feel tactile and dimensional.
    
    Typography & Concise Info:
    
    Titles: Use an elegant, traditional Serif font (e.g., Playfair Display) for the collection titles.
    
    Concise Info: Keep text to a minimum. Only include: Title (e.g., "BOLSAS") and a minimalist button.
    
    Button: Create a minimalist button with a thin, pale gold (#D4AF37) border. The text should be small, all-caps (e.g., "EXPLORAR"), with wide letter-spacing.
    
    The Animated Carousel (Premium & Smooth):
    
    Mobile "Next-In-Line" View: Ensure the active centered card is perfectly centered, but the next card is at least 20% visible on the right side. This visual cue makes swiping intuitive and frictionless.
    
    Active/Inactive State: Use CSS transitions to make the active centered card scale(1.0) and opacity: 1, while the adjacent cards smoothly scale down to scale(0.85) and opacity: 0.5.
    
    Easing Curve: Use transition: all 0.7s cubic-bezier(0.23, 1, 0.32, 1) for a buttery-smooth, expensive-feeling deceleration at the end of each swipe.
    
    Hardware Acceleration: Use will-change: transform; for maximum smoothness.
    
    Content & Links:
    
    Three cards: "BOLSAS" (Link: /collections/bolsas), "CARTERAS" (Link: /collections/carteras), "RELOJES" (Link: /collections/relojes).
    
    Technical:
    
    100% Pure HTML/CSS. No external libraries.
    
    Scope everything under the class .premium-collections-slider-.
    
    Hide scrollbars (::-webkit-scrollbar { display: none; }).
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600&display=swap');

  .premium-collections-slider-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: #FFFFFF;
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    overflow: hidden;
  }

  .premium-collections-slider-{{ ai_gen_id }}__wrapper {
    display: flex;
    gap: {{ block.settings.card_gap }}px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    padding: 0 {{ block.settings.side_padding }}px;
  }

  .premium-collections-slider-{{ ai_gen_id }}__wrapper::-webkit-scrollbar {
    display: none;
  }

  .premium-collections-slider-{{ ai_gen_id }}__wrapper {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  .premium-collections-slider-{{ ai_gen_id }}__card {
    flex: 0 0 {{ block.settings.card_width }}%;
    scroll-snap-align: center;
    transition: all 0.7s cubic-bezier(0.23, 1, 0.32, 1);
    will-change: transform;
    opacity: {{ block.settings.inactive_opacity | divided_by: 100.0 }};
    transform: scale({{ block.settings.inactive_scale | divided_by: 100.0 }});
  }

  .premium-collections-slider-{{ ai_gen_id }}__card.active {
    opacity: 1;
    transform: scale(1);
  }

  .premium-collections-slider-{{ ai_gen_id }}__card-inner {
    position: relative;
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
    box-shadow: 0 20px 60px rgba(0, 0, 0, {{ block.settings.shadow_opacity | divided_by: 100.0 }});
    background-color: {{ block.settings.card_background }};
  }

  .premium-collections-slider-{{ ai_gen_id }}__image-container {
    position: relative;
    width: 100%;
    padding-bottom: 125%;
    overflow: hidden;
  }

  .premium-collections-slider-{{ ai_gen_id }}__image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .premium-collections-slider-{{ ai_gen_id }}__content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: {{ block.settings.content_padding }}px;
    text-align: center;
    background: linear-gradient(to top, rgba(0, 0, 0, {{ block.settings.overlay_opacity | divided_by: 100.0 }}), transparent);
  }

  .premium-collections-slider-{{ ai_gen_id }}__title {
    font-family: 'Playfair Display', serif;
    font-size: {{ block.settings.title_size }}px;
    font-weight: 600;
    color: {{ block.settings.title_color }};
    margin: 0 0 {{ block.settings.title_margin }}px;
    letter-spacing: {{ block.settings.letter_spacing }}px;
    text-transform: uppercase;
  }

  .premium-collections-slider-{{ ai_gen_id }}__button {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: {{ block.settings.button_letter_spacing }}px;
    text-decoration: none;
    transition: all 0.3s ease;
    border-radius: {{ block.settings.button_border_radius }}px;
  }

  .premium-collections-slider-{{ ai_gen_id }}__button:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
  }

  @media screen and (max-width: 749px) {
    .premium-collections-slider-{{ ai_gen_id }}__card {
      flex: 0 0 {{ block.settings.mobile_card_width }}%;
    }

    .premium-collections-slider-{{ ai_gen_id }}__title {
      font-size: {{ block.settings.mobile_title_size }}px;
    }

    .premium-collections-slider-{{ ai_gen_id }}__button {
      font-size: {{ block.settings.mobile_button_font_size }}px;
      padding: {{ block.settings.mobile_button_padding_vertical }}px {{ block.settings.mobile_button_padding_horizontal }}px;
    }

    .premium-collections-slider-{{ ai_gen_id }}__content {
      padding: {{ block.settings.mobile_content_padding }}px;
    }
  }
{% endstyle %}

<premium-collections-slider-{{ ai_gen_id }} class="premium-collections-slider-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="premium-collections-slider-{{ ai_gen_id }}__wrapper" data-slider-wrapper>
    {% if block.settings.collection_1 != blank %}
      <div class="premium-collections-slider-{{ ai_gen_id }}__card" data-card>
        <div class="premium-collections-slider-{{ ai_gen_id }}__card-inner">
          <div class="premium-collections-slider-{{ ai_gen_id }}__image-container">
            {% if block.settings.collection_1.featured_image %}
              <img
                src="{{ block.settings.collection_1.featured_image | image_url: width: 1000 }}"
                alt="{{ block.settings.collection_1.title | escape }}"
                class="premium-collections-slider-{{ ai_gen_id }}__image"
                loading="lazy"
                width="1000"
                height="1250"
              >
            {% else %}
              <div class="premium-collections-slider-{{ ai_gen_id }}__image-placeholder">
                {{ 'collection-1' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
          <div class="premium-collections-slider-{{ ai_gen_id }}__content">
            <h3 class="premium-collections-slider-{{ ai_gen_id }}__title">{{ block.settings.collection_1.title }}</h3>
            <a href="{{ block.settings.collection_1.url }}" class="premium-collections-slider-{{ ai_gen_id }}__button">
              {{ block.settings.button_text }}
            </a>
          </div>
        </div>
      </div>
    {% endif %}

    {% if block.settings.collection_2 != blank %}
