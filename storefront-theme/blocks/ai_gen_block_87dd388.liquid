{% doc %}
  @prompt
    Task: Create a Premium 2-Card Social Carousel Section.
    
    1. Structural Layout (Carousel):
    
    Create a section featuring a responsive container with exactly 2 vertical cards.
    
    Desktop: Center the 2 cards horizontally with generous spacing between them.
    
    Mobile Behavior: Strictly implement a horizontal scroll (swipeable carousel/slider) for the cards. Do NOT stack them vertically on mobile. Use scroll-snap-type: x mandatory for a premium swiping experience.
    
    2. High-End Card Aesthetics:
    
    Background: Pure white cards against a very subtle off-white section background.
    
    Shape: Heavy border-radius (e.g., 24px) with a soft, elegant floating drop shadow (box-shadow: 0 15px 40px rgba(0,0,0,0.04)).
    
    3. Card 1 Content (Facebook):
    
    Top: A minimalist, thin-line monochromatic Facebook icon centered.
    
    Middle: A brief, centered description text using a clean Sans-serif font with elegant line-height.
    
    Bottom: EXACTLY ONE (1) large, full-width action button.
    
    4. Card 2 Content (WhatsApp):
    
    Top: A minimalist, thin-line monochromatic WhatsApp icon centered.
    
    Middle: A brief, centered description text matching the style of Card 1.
    
    Bottom: EXACTLY TWO (2) full-width action buttons stacked vertically (e.g., a primary solid button and a secondary outline or text-only button below it).
    
    5. Polish:
    
    Ensure both cards have the exact same height (height: 100% within a stretch flexbox/grid) regardless of the different number of buttons at the bottom.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-social-carousel-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.section_background }};
    padding: {{ block.settings.section_padding }}px 20px;
  }

  .ai-social-carousel-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-social-carousel-cards-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.card_gap }}px;
    justify-content: center;
    align-items: stretch;
  }

  .ai-social-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.04);
    padding: {{ block.settings.card_padding }}px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    text-align: center;
    flex: 1;
    min-width: 0;
    height: 100%;
  }

  .ai-social-card-icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    margin-bottom: {{ block.settings.icon_margin }}px;
    flex-shrink: 0;
  }

  .ai-social-card-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    stroke: {{ block.settings.icon_color }};
    fill: none;
    stroke-width: {{ block.settings.icon_stroke_width }};
  }

  .ai-social-card-description-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.6;
    margin-bottom: {{ block.settings.text_margin }}px;
    flex-grow: 1;
    display: flex;
    align-items: center;
  }

  .ai-social-card-buttons-{{ ai_gen_id }} {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.button_gap }}px;
  }

  .ai-social-card-button-{{ ai_gen_id }} {
    width: 100%;
    padding: {{ block.settings.button_padding }}px;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_text_size }}px;
    font-weight: 600;
    text-decoration: none;
    text-align: center;
    transition: all 0.3s ease;
    display: inline-block;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .ai-social-card-button-primary-{{ ai_gen_id }} {
    background-color: {{ block.settings.button_primary_bg }};
    color: {{ block.settings.button_primary_text }};
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_primary_bg }};
  }

  .ai-social-card-button-primary-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_primary_hover_bg }};
    border-color: {{ block.settings.button_primary_hover_bg }};
    color: {{ block.settings.button_primary_hover_text }};
  }

  .ai-social-card-button-secondary-{{ ai_gen_id }} {
    background-color: {{ block.settings.button_secondary_bg }};
    color: {{ block.settings.button_secondary_text }};
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_secondary_border }};
  }

  .ai-social-card-button-secondary-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_secondary_hover_bg }};
    border-color: {{ block.settings.button_secondary_hover_border }};
    color: {{ block.settings.button_secondary_hover_text }};
  }

  @media screen and (max-width: 749px) {
    .ai-social-carousel-cards-{{ ai_gen_id }} {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      gap: {{ block.settings.card_gap_mobile }}px;
      justify-content: flex-start;
      padding: 0 20px;
      margin: 0 -20px;
    }

    .ai-social-card-{{ ai_gen_id }} {
      flex: 0 0 85%;
      scroll-snap-align: center;
      min-width: 280px;
    }

    .ai-social-carousel-cards-{{ ai_gen_id }}::-webkit-scrollbar {
      display: none;
    }

    .ai-social-carousel-cards-{{ ai_gen_id }} {
      scrollbar-width: none;
    }
  }
{% endstyle %}

<social-carousel-{{ ai_gen_id }} class="ai-social-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-social-carousel-container-{{ ai_gen_id }}">
    <div class="ai-social-carousel-cards-{{ ai_gen_id }}">
      <div class="ai-social-card-{{ ai_gen_id }}">
        <div class="ai-social-card-icon-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
          </svg>
        </div>
        <div class="ai-social-card-description-{{ ai_gen_id }}">
          <p>{{ block.settings.facebook_description }}</p>
        </div>
        <div class="ai-social-card-buttons-{{ ai_gen_id }}">
          {% if block.settings.facebook_button_url != blank %}
            <a href="{{ block.settings.facebook_button_url }}" class="ai-social-card-button-{{ ai_gen_id }} ai-social-card-button-primary-{{ ai_gen_id }}">
              {{ block.settings.facebook_button_text }}
            </a>
          {% endif %}
        </div>
      </div>

      <div class="ai-social-card-{{ ai_gen_id }}">
        <div class="ai-social-card-icon-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
          </svg>
        </div>
        <div class="ai-social-card-description-{{ ai_gen_id }}">
          <p>{{ block.settings.whatsapp_description }}</p>
        </div>
        <div class="ai-social-card-buttons-{{ ai_gen_id }}">
          {% if block.settings.whatsapp_button_1_url != blank %}
            <a href="{{ block.settings.whatsapp_button_1_url }}" class="ai-social-card-button-{{ ai_gen_id }} ai-social-card-button-primary-{{ ai_gen_id }}">
              {{ block.settings.whatsapp_button_1_text }}
            </a>
          {% endif %}
          {% if block.settings.whatsapp_button_2_url != blank %}
            <a href="{{ block.settings.whatsapp_button_2_url }}" class="ai-social-card-button-{{ ai_gen_id }} ai-social-card-button-secondary-{{ ai_gen_id }}">
              {{ block.settings.whatsapp_button_2_text }}
            </a>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</social-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class SocialCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.initCarousel();
      }

      initCarousel() {
        const container = this.querySelector('.ai-social-carousel-cards-{{ ai_gen_id }}');
        if (!container) return;

        let isDown = false;
        let startX;
        let scrollLeft;

        container.addEventListener('mousedown', (e) => {
          isDown = true;
          startX = e.pageX - container.offsetLeft;
          scrollLeft = container.scrollLeft;
        });

        container.addEventListener('mouseleave', () => {
          isDown = false;
        });

        container.addEventListener('mouseup', () => {
          isDown = false;
        });

        container.addEventListener('mousemove', (e) => {
          if (!isDown) return;
          e.preventDefault();
          const x = e.pageX - container.offsetLeft;
          const walk = (x - startX) * 2;
          container.scrollLeft = scrollLeft - walk;
        });
      }
    }

    customElements.define('social-carousel-{{ ai_gen_id }}', SocialCarousel{{ ai_gen_id }});
  })();
</script>

