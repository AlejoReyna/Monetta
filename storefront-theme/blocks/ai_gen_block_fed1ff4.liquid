{% doc %}
  @prompt
    Create a custom Liquid block for Shopify with the following layout:
    
    Display 3 circular collection cards in a single horizontal row, all aligned side by side (flexbox, flex-direction: row, justify-content: center). Each card contains only:
    
    A circular image (aspect ratio 1:1, border-radius: 50%) with a premium floating shadow directly on the circle: box-shadow: 0 8px 32px rgba(0,0,0,0.10), 0 2px 8px rgba(0,0,0,0.06)
    Collection name centered below the circle, clean minimal typography
    No card container background, no border-radius wrapper — just bare circle + label + shadow on the image
    Hover effect: transform: scale(1.04) on the circle
    Arrow behavior — critical, this is the core interaction:
    
    The arrow is rendered once in the DOM, positioned after the first 3 cards
    It is not duplicated — it physically moves in the layout using CSS/JS
    Collapsed state: arrow sits below the first 3 cards, pointing down (▼), acting as an invitation to expand
    When clicked: the drawer opens revealing the 2 extra cards, and the arrow smoothly slides down to sit below the 2 revealed cards, now pointing up (▲) — as if it "pushed" the new cards up and settled at the bottom
    Expanded state: arrow is below all 5 cards, pointing up (▲)
    When clicked again: the 2 extra cards collapse upward, and the arrow smoothly slides back up to its original position below the first 3 cards, pointing down (▼) again
    The arrow movement must feel like it's floating — use transition: all 400ms cubic-bezier(0.4, 0, 0.2, 1) — never a hard jump
    Achieve this by placing the arrow inside the flex column flow, appending/moving it in the DOM after the drawer opens, or using absolute positioning with animated top values — whichever produces the smoothest result
    Shadow fix:
    
    The expandable drawer container must have padding-bottom: 40px minimum so circle shadows are never clipped by overflow: hidden
    Apply overflow: hidden only on the outer animated wrapper, with enough padding to accommodate shadow bleed
    Expand/collapse animation:
    
    max-height transition with 400ms cubic-bezier(0.4, 0, 0.2, 1) for a premium, non-linear feel
    Responsive:
    
    First 3 cards always in one horizontal row on all screen sizes
    2 extra cards also horizontal when expanded
    Wrap only on very small screens if absolutely necessary
    Total of 5 collection slots, each configurable in the theme editor via collection picker.
    
    Clean minimal CSS, no external dependencies, all logic in vanilla JS within the Liquid block.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-cards-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-collection-cards__container-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
  }

  .ai-collection-cards__row-{{ ai_gen_id }} {
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: flex-start;
    gap: {{ block.settings.card_gap }}px;
    width: 100%;
  }

  .ai-collection-cards__drawer-wrapper-{{ ai_gen_id }} {
    width: 100%;
    overflow: hidden;
    transition: max-height 400ms cubic-bezier(0.4, 0, 0.2, 1);
    max-height: 0;
    padding-bottom: 0;
  }

  .ai-collection-cards__drawer-wrapper-{{ ai_gen_id }}.expanded {
    max-height: 500px;
    padding-bottom: 40px;
  }

  .ai-collection-cards__drawer-{{ ai_gen_id }} {
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: flex-start;
    gap: {{ block.settings.card_gap }}px;
    width: 100%;
    padding-top: 24px;
  }

  .ai-collection-card-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    flex-shrink: 0;
  }

  .ai-collection-card__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: {{ block.settings.circle_size }}px;
    height: {{ block.settings.circle_size }}px;
    border-radius: 50%;
    overflow: hidden;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.10), 0 2px 8px rgba(0, 0, 0, 0.06);
    transition: transform 300ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .ai-collection-card-{{ ai_gen_id }}:hover .ai-collection-card__image-wrapper-{{ ai_gen_id }} {
    transform: scale(1.04);
  }

  .ai-collection-card__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-collection-card__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-collection-card__placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-collection-card__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    text-align: center;
    margin: 0;
    font-weight: 400;
    letter-spacing: 0.5px;
  }

  .ai-collection-cards__arrow-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    cursor: pointer;
    padding: 12px;
    transition: all 400ms cubic-bezier(0.4, 0, 0.2, 1);
    color: {{ block.settings.arrow_color }};
    position: relative;
  }

  .ai-collection-cards__arrow-{{ ai_gen_id }}:hover {
    opacity: 0.7;
  }

  .ai-collection-cards__arrow-icon-{{ ai_gen_id }} {
    width: {{ block.settings.arrow_size }}px;
    height: {{ block.settings.arrow_size }}px;
    transition: transform 400ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .ai-collection-cards__arrow-{{ ai_gen_id }}.expanded .ai-collection-cards__arrow-icon-{{ ai_gen_id }} {
    transform: rotate(180deg);
  }

  @media screen and (max-width: 749px) {
    .ai-collection-cards__row-{{ ai_gen_id }},
    .ai-collection-cards__drawer-{{ ai_gen_id }} {
      gap: {{ block.settings.card_gap | times: 0.6 }}px;
    }

    .ai-collection-card__image-wrapper-{{ ai_gen_id }} {
      width: {{ block.settings.circle_size | times: 0.7 }}px;
      height: {{ block.settings.circle_size | times: 0.7 }}px;
    }

    .ai-collection-card__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.85 }}px;
    }
  }

  @media screen and (max-width: 480px) {
    .ai-collection-cards__row-{{ ai_gen_id }},
    .ai-collection-cards__drawer-{{ ai_gen_id }} {
      flex-wrap: wrap;
    }
  }
{% endstyle %}

<collection-cards-{{ ai_gen_id }}
  class="ai-collection-cards-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-collection-cards__container-{{ ai_gen_id }}">
    <div class="ai-collection-cards__row-{{ ai_gen_id }}">
      {% for i in (1..3) %}
        {% liquid
          assign collection_key = 'collection_' | append: i
          assign collection = block.settings[collection_key]
        %}
        {% if collection != blank %}
          <a
            href="{{ collection.url }}"
            class="ai-collection-card-{{ ai_gen_id }}"
          >
            <div class="ai-collection-card__image-wrapper-{{ ai_gen_id }}">
              {% if collection.image %}
                <img
                  src="{{ collection.image | image_url: width: 400 }}"
                  alt="{{ collection.title | escape }}"
                  class="ai-collection-card__image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="400"
                  height="400"
                >
              {% else %}
                <div class="ai-collection-card__placeholder-{{ ai_gen_id }}">
                  {{ 'collection-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>
            <h3 class="ai-collection-card__title-{{ ai_gen_id }}">
              {{ collection.title }}
            </h3>
          </a>
        {% else %}
          <div class="ai-collection-card-{{ ai_gen_id }}">
            <div class="ai-collection-card__image-wrapper-{{ ai_gen_id }}">
              <div class="ai-collection-card__placeholder-{{ ai_gen_id }}">
                {{ 'collection-1' | placeholder_svg_tag }}
              </div>
            </div>
            <h3 class="ai-collection-card__title-{{ ai_gen_id }}">
              Collection {{ i }}
            </h3>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <button
      class="ai-collection-cards__arrow-{{ ai_gen_id }}"
      aria-label="Toggle more collections"
      aria-expanded="false"
    >
      <svg
        class="ai-collection-cards__arrow-icon-{{ ai_gen_id }}"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <polyline points="6 9 12 15 18 9"></polyline>
      </svg>
    </button>

    <div class="ai-collection-cards__drawer-wrapper-{{ ai_gen_id }}">
      <div class="ai-collection-cards__drawer-{{ ai_gen_id }}">
        {% for i in (4..5) %}
          {% liquid
            assign collection_key = 'collection_' | append: i
            assign collection = block.settings[collection_key]
          %}
          {% if collection != blank %}
            <a
              href="{{ collection.url }}"
              class="ai-collection-card-{{ ai_gen_id }}"
            >
              <div class="ai-collection-card__image-wrapper-{{ ai_gen_id }}">
                {% if collection.image %}
                  <img
                    src="{{ collection.image | image_url: width: 400 }}"
                    alt="{{ collection.title | escape }}"
                    class="ai-collection-card__image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="400"
                    height="400"
                  >
                {% else %}
                  <div class="ai-collection-card__placeholder-{{ ai_gen_id }}">
                    {{ 'collection-1' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              </div>
              <h3 class="ai-collection-card__title-{{ ai_gen_id }}">
                {{ collection.title }}
              </h3>
            </a>
          {% else %}
            <div class="ai-collection-card-{{ ai_gen_id }}">
              <div class="ai-collection-card__image-wrapper-{{ ai_gen_id }}">
                <div class="ai-collection-card__placeholder-{{ ai_gen_id }}">
                  {{ 'collection-1' | placeholder_svg_tag }}
                </div>
              </div>
              <h3 class="ai-collection-card__title-{{ ai_gen_id }}">
                Collection {{ i }}
              </h3>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</collection-cards-{{ ai_gen_id }}>

<script>
  (function() {
    class CollectionCards{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.arrow = this.querySelector('.ai-collection-cards__arrow-{{ ai_gen_id }}');
        this.drawer = this.querySelector('.ai-collection-cards__drawer-wrapper-{{ ai_gen_id }}');
        this.container = this.querySelector('.ai-collection-cards__container-{{ ai_gen_id }}');
        this.isExpanded = false;
      }

      connectedCallback() {
        this.arrow.addEventListener('click', () => this.toggleDrawer());
      }

      toggleDrawer() {
        this.isExpanded = !this.isExpanded;

        if (this.isExpanded) {
          this.drawer.classList.add('expanded');
          this.arrow.classList.add('expanded');
          this.arrow.setAttribute('aria-expanded', 'true');
          
          this.container.removeChild(this.arrow);
          this.container.appendChild(this.arrow);
        } else {
          this.drawer.classList.remove('expanded');
          this.arrow.classList.remove('expanded');
          this.arrow.setAttribute('aria-expanded', 'false');
          
          this.container.removeChild(this.arrow);
          this.container.insertBefore(this.arrow, this.drawer);
        }
      }
    }

    customElements.define('collection-cards-{{ ai_gen_id }}', CollectionCards{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Collection circle cards",
  "settings": [
    {
      "type": "header",
      "content": "Collections"
    },
    {
      "type": "collection",
      "id": "collection_1",
      "label": "Collection 1"
    },
    {
      "type": "collection",
      "id": "collection_2",
      "label": "Collection 2"
    },
    {
      "type": "collection",
      "id": "collection_3",
      "label": "Collection 3"
    },
    {
      "type": "collection",
      "id": "collection_4",
      "label": "Collection 4"
    },
    {
      "type": "collection",
      "id": "collection_5",
      "label": "Collection 5"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "circle_size",
      "label": "Circle size",
      "min": 80,
      "max": 240,
      "step": 10,
      "unit": "px",
      "default": 160
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Gap between cards",
      "min": 16,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Arrow"
    },
    {
      "type": "range",
      "id": "arrow_size",
      "label": "Arrow size",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "color",
      "id": "arrow_color",
      "label": "Arrow color",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "Collection circle cards"
    }
  ]
}
{% endschema %}
