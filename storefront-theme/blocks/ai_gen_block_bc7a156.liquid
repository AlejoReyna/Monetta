{% doc %}
  @prompt
    HAZ UN BOTON QUE ME DE UNA COLECCION CON TODOS LOS PRODUCTOS NUEVOS 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-new-products-button-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-new-products-link-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: {{ block.settings.button_padding }}px {{ block.settings.button_padding | times: 2 }}px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    text-decoration: none;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: 600;
    text-transform: {{ block.settings.button_text_transform }};
    transition: all 0.3s ease;
    cursor: pointer;
    width: 100%;
  }

  .ai-new-products-link-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
  }

  .ai-new-products-icon-{{ ai_gen_id }} {
    width: {{ block.settings.button_font_size }}px;
    height: {{ block.settings.button_font_size }}px;
    flex-shrink: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-new-products-button-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<div class="ai-new-products-button-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <a href="{{ block.settings.new_products_collection.url }}" class="ai-new-products-link-{{ ai_gen_id }}">
    {% if block.settings.show_icon %}
      <svg class="ai-new-products-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"></circle>
        <path d="M12 6v6l4 2"></path>
      </svg>
    {% endif %}
    <span>{{ block.settings.button_text }}</span>
  </a>
</div>

{% schema %}
{
  "name": "Botón productos nuevos",
  "settings": [
    {
      "type": "header",
      "content": "Colección"
    },
    {
      "type": "collection",
      "id": "new_products_collection",
      "label": "Colección de productos nuevos"
    },
    {
      "type": "header",
      "content": "Botón"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Texto del botón",
      "default": "Ver productos nuevos"
    },
    {
      "type": "checkbox",
      "id": "show_icon",
      "label": "Mostrar ícono",
      "default": true
    },
    {
      "type": "range",
      "id": "button_font_size",
      "label": "Tamaño de fuente",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "select",
      "id": "button_text_transform",
      "label": "Transformación de texto",
      "options": [
        {
          "value": "none",
          "label": "Normal"
        },
        {
          "value": "uppercase",
          "label": "Mayúsculas"
        }
      ],
      "default": "uppercase"
    },
    {
      "type": "range",
      "id": "button_padding",
      "label": "Espaciado interno",
      "min": 8,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "label": "Radio del borde",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "button_border_width",
      "label": "Ancho del borde",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 2
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Ancho en escritorio",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Colores"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Fondo",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Texto",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_border_color",
      "label": "Borde",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_hover_background",
      "label": "Fondo al pasar el cursor",
      "default": "#383838"
    },
    {
      "type": "color",
      "id": "button_hover_text_color",
      "label": "Texto al pasar el cursor",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_hover_border_color",
      "label": "Borde al pasar el cursor",
      "default": "#383838"
    }
  ],
  "presets": [
    {
      "name": "Botón productos nuevos"
    }
  ]
}
{% endschema %}
