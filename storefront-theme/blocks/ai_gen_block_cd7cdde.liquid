{% doc %}
  @prompt
    Shopify liquid block. Horizontally scrollable 3-row × 3-column collection image grid. 9 collections total.
    
    DO NOT use left/transform breakout technique on mobile. Instead use this approach:
    
    WRAPPER:
      width: 100%
      overflow: visible
      background: transparent
      margin: 0
      padding: 0
      box-sizing: border-box
    
    SCROLL CONTAINER:
      display: grid
      grid-template-rows: repeat(3, auto)
      grid-auto-flow: column
      overflow-x: auto
      overflow-y: visible
      scrollbar-width: none
      -webkit-overflow-scrolling: touch
      scroll-snap-type: x mandatory
      scroll-snap-stop: always
      box-sizing: border-box
    
      Padding — declare each side separately:
      padding-top: {{ block.settings.padding_vertical }}px;
      padding-bottom: {{ block.settings.padding_vertical }}px;
      padding-left: {{ block.settings.padding_horizontal }}px;
      padding-right: {{ block.settings.padding_horizontal }}px;
    
      NEVER use padding shorthand. NEVER hardcode any px value.
    
    CARDS:
      width: {{ block.settings.card_width_desktop }}px
      aspect-ratio: 2.3 / 1
      overflow: hidden
      border-radius: {{ block.settings.border_radius }}px
      background: transparent
      scroll-snap-align: start
      box-shadow:
        0 2px 8px rgba(0,0,0,0.06),
        0 8px 24px rgba(0,0,0,{{ block.settings.shadow_opacity | divided_by: 100.0 }}),
        0 20px 48px rgba(0,0,0,0.04)
      transition: transform 0.3s cubic-bezier(0.25,0.46,0.45,0.94),
                  box-shadow 0.3s cubic-bezier(0.25,0.46,0.45,0.94)
    
      On mobile (max-width: 749px):
      width: {{ block.settings.card_width_mobile }}px
    
    HOVER/TOUCH:
      transform: translateY(-5px) scale(1.02)
      box-shadow:
        0 8px 24px rgba(0,0,0,0.10),
        0 20px 48px rgba(0,0,0,0.10),
        0 32px 64px rgba(0,0,0,0.06)
    
    IMAGE:
      object-fit: cover
      width: 100%
      height: 100%
      display: block
      No text, no title, no overlay on cards.
    
    SCROLL RESET:
      Force scrollLeft = 0 on connectedCallback, DOMContentLoaded,
      window load, setTimeout 100ms, setTimeout 500ms.
    
    THEME SETTINGS:
      card_width_desktop   default: 200  min: 100  max: 400  step: 10  unit: px
      card_width_mobile    default: 150  min: 100  max: 300  step: 10  unit: px
      gap                  default: 20   min: 8    max: 48   step: 4   unit: px
      padding_horizontal   default: 16   min: 0    max: 64   step: 4   unit: px
      padding_vertical     default: 20   min: 0    max: 64   step: 4   unit: px
      border_radius        default: 20   min: 0    max: 40   step: 2   unit: px
      shadow_opacity       default: 8    min: 0    max: 20   step: 1   unit: %
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-grid-wrapper-{{ ai_gen_id }} {
    width: 100%;
    overflow: visible;
    background: transparent;
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    display: block;
  }

  .ai-collection-grid-container-{{ ai_gen_id }} {
    display: grid;
    grid-template-rows: repeat(3, auto);
    grid-auto-flow: column;
    overflow-x: auto;
    overflow-y: visible;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    scroll-snap-type: x mandatory;
    scroll-snap-stop: always;
    box-sizing: border-box;
    gap: {{ block.settings.gap }}px;
    padding-top: {{ block.settings.padding_vertical }}px;
    padding-bottom: {{ block.settings.padding_vertical }}px;
    padding-left: {{ block.settings.padding_horizontal }}px;
    padding-right: {{ block.settings.padding_horizontal }}px;
  }

  .ai-collection-grid-container-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-collection-grid-card-{{ ai_gen_id }} {
    width: {{ block.settings.card_width_desktop }}px;
    aspect-ratio: 2.3 / 1;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
    background: transparent;
    scroll-snap-align: start;
    box-shadow: 0 2px 8px rgba(0,0,0,0.06),
                0 8px 24px rgba(0,0,0,{{ block.settings.shadow_opacity | divided_by: 100.0 }}),
                0 20px 48px rgba(0,0,0,0.04);
    transition: transform 0.3s cubic-bezier(0.25,0.46,0.45,0.94),
                box-shadow 0.3s cubic-bezier(0.25,0.46,0.45,0.94);
    position: relative;
    display: block;
  }

  .ai-collection-grid-card-{{ ai_gen_id }}:hover,
  .ai-collection-grid-card-{{ ai_gen_id }}:active {
    transform: translateY(-5px) scale(1.02);
    box-shadow: 0 8px 24px rgba(0,0,0,0.10),
                0 20px 48px rgba(0,0,0,0.10),
                0 32px 64px rgba(0,0,0,0.06);
  }

  .ai-collection-grid-image-{{ ai_gen_id }} {
    object-fit: cover;
    width: 100%;
    height: 100%;
    display: block;
  }

  .ai-collection-grid-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
  }

  .ai-collection-grid-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  @media screen and (max-width: 749px) {
    .ai-collection-grid-card-{{ ai_gen_id }} {
      width: {{ block.settings.card_width_mobile }}px;
    }
  }
{% endstyle %}

<collection-grid-{{ ai_gen_id }}
  class="ai-collection-grid-wrapper-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-collection-grid-container-{{ ai_gen_id }}">
    {% for i in (1..9) %}
      {% liquid
        assign collection_key = 'collection_' | append: i
        assign collection = block.settings[collection_key]
      %}
      
      {% if collection != blank %}
        <a
          href="{{ collection.url }}"
          class="ai-collection-grid-card-{{ ai_gen_id }}"
          aria-label="{{ collection.title | escape }}"
        >
          {% if collection.featured_image %}
            <img
              src="{{ collection.featured_image | image_url: width: 600 }}"
              alt="{{ collection.featured_image.alt | default: collection.title | escape }}"
              loading="lazy"
              width="600"
              height="261"
              class="ai-collection-grid-image-{{ ai_gen_id }}"
            >
          {% else %}
            <div class="ai-collection-grid-placeholder-{{ ai_gen_id }}">
              {{ 'collection-apparel-1' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </a>
      {% else %}
        <div class="ai-collection-grid-card-{{ ai_gen_id }}">
          <div class="ai-collection-grid-placeholder-{{ ai_gen_id }}">
            {{ 'collection-apparel-1' | placeholder_svg_tag }}
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</collection-grid-{{ ai_gen_id }}>

<script>
  (function() {
    class CollectionGrid{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.container = this.querySelector('.ai-collection-grid-container-{{ ai_gen_id }}');
      }

      connectedCallback() {
        this.resetScroll();
        
        document.addEventListener('DOMContentLoaded', () => {
          this.resetScroll();
        });

        window.addEventListener('load', () => {
          this.resetScroll();
        });

        setTimeout(() => {
          this.resetScroll();
        }, 100);

        setTimeout(() => {
          this.resetScroll();
        }, 500);
      }

      resetScroll() {
        if (this.container) {
          this.container.scrollLeft = 0;
        }
      }
    }

    customElements.define('collection-grid-{{ ai_gen_id }}', CollectionGrid{{ ai_gen_id }});
  })();
</script>

