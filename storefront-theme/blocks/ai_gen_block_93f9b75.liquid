{% doc %}
  @prompt
    Goal: Create a 100% mobile-optimized collection carousel with a clean, app-like interface and balanced vertical spacing for a professional website look.
    
    1. Section Spacing & Layout (The Fix):
    
    Vertical Margins: Apply a standard spacing of 60px at the top and 60px at the bottom of the entire section. This ensures the carousel is separated elegantly from other sections.
    
    Main Container: Set width: 100vw and strictly apply overflow: hidden. The carousel must NOT cause horizontal page overflow.
    
    The Track: Use display: flex. The scrolling track must be contained so that only one card is centered at a time.
    
    2. Card Sizing & "The Peek":
    
    Precise Width: Each card must be exactly 75% of the screen width (75vw).
    
    Centering: Use scroll-snap-align: center. Add a 12.5% padding to the left and right of the main container so the first card is centered and the next one "peeks" 12.5% from the edge.
    
    Aspect Ratio: Use a 4:5 vertical ratio for the cards.
    
    3. Ultra-Clean Rounded Aesthetic:
    
    Borders: Apply a 36px border-radius to the cards. Use overflow: hidden on the card level for a clean, rounded contour.
    
    Styling: Cards must be white (#FFFFFF) with a thin border (1px solid #eeeeee) and a soft shadow (box-shadow: 0 10px 40px rgba(0,0,0,0.03)).
    
    4. Element Proportions:
    
    Image: The product image should be centered and occupy no more than 55% of the card's height.
    
    Button & Text: Use a small Serif font for titles. The "EXPLORAR" button must be compact (max-width 130px) and centered at the bottom.
    
    5. Physics & Animation:
    
    Frictionless Swipe: Use scroll-snap-type: x mandatory for a "magnetic" snap to the next card.
    
    Smoothness: Implement a 0.5s cubic-bezier(0.23, 1, 0.32, 1) transition. Active card scales to 1.0; side cards scale to 0.9.
    
    6. Content & Polish:
    
    Build 3 collection cards: BOLSAS, CARTERAS, RELOJES.
    
    Hide all scrollbars to maintain a clean, high-end mobile app appearance.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-carousel-{{ ai_gen_id }} {
    display: block;
    width: 100vw;
    margin: 60px 0;
    overflow: hidden;
    position: relative;
  }

  .ai-collection-carousel-container-{{ ai_gen_id }} {
    width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 0 12.5%;
  }

  .ai-collection-carousel-container-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-collection-carousel-track-{{ ai_gen_id }} {
    display: flex;
    gap: 20px;
    transition: transform 0.5s cubic-bezier(0.23, 1, 0.32, 1);
  }

  .ai-collection-carousel-card-{{ ai_gen_id }} {
    flex: 0 0 75vw;
    width: 75vw;
    aspect-ratio: 4 / 5;
    scroll-snap-align: center;
    background: #ffffff;
    border: 1px solid #eeeeee;
    border-radius: 36px;
    overflow: hidden;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.03);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    padding: 40px 20px 30px;
    text-decoration: none;
    transition: transform 0.5s cubic-bezier(0.23, 1, 0.32, 1);
    transform: scale(0.9);
  }

  .ai-collection-carousel-card-{{ ai_gen_id }}.active {
    transform: scale(1);
  }

  .ai-collection-carousel-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    height: 55%;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .ai-collection-carousel-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-collection-carousel-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-collection-carousel-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-collection-carousel-content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    width: 100%;
  }

  .ai-collection-carousel-title-{{ ai_gen_id }} {
    font-family: {{ block.settings.title_font.family }}, {{ block.settings.title_font.fallback_families }};
    font-weight: {{ block.settings.title_font.weight }};
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    text-align: center;
    margin: 0;
    letter-spacing: 0.5px;
  }

  .ai-collection-carousel-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 12px 24px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    border: 1px solid {{ block.settings.button_border_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    font-family: {{ block.settings.button_font.family }}, {{ block.settings.button_font.fallback_families }};
    font-weight: {{ block.settings.button_font.weight }};
    font-size: {{ block.settings.button_font_size }}px;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 1px;
    max-width: 130px;
    text-align: center;
    transition: all 0.3s ease;
  }

  .ai-collection-carousel-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
  }
{% endstyle %}

<collection-carousel-{{ ai_gen_id }} class="ai-collection-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-collection-carousel-container-{{ ai_gen_id }}">
    <div class="ai-collection-carousel-track-{{ ai_gen_id }}">
      {% for i in (1..3) %}
        {% liquid
          assign collection_key = 'collection_' | append: i
          assign collection = block.settings[collection_key]
        %}
        
        {% if collection != blank %}
          <a href="{{ collection.url }}" class="ai-collection-carousel-card-{{ ai_gen_id }}" data-card-index="{{ forloop.index0 }}">
            <div class="ai-collection-carousel-image-wrapper-{{ ai_gen_id }}">
              {% if collection.featured_image %}
                <img
                  src="{{ collection.featured_image | image_url: width: 800 }}"
                  alt="{{ collection.featured_image.alt | escape }}"
                  class="ai-collection-carousel-image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="800"
                  height="800"
                >
              {% else %}
                <div class="ai-collection-carousel-placeholder-{{ ai_gen_id }}">
                  {{ 'collection-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>
            <div class="ai-collection-carousel-content-{{ ai_gen_id }}">
              <h3 class="ai-collection-carousel-title-{{ ai_gen_id }}">{{ collection.title }}</h3>
              <span class="ai-collection-carousel-button-{{ ai_gen_id }}">{{ block.settings.button_text }}</span>
            </div>
          </a>
        {% else %}
          <div class="ai-collection-carousel-card-{{ ai_gen_id }}" data-card-index="{{ forloop.index0 }}">
            <div class="ai-collection-carousel-image-wrapper-{{ ai_gen_id }}">
              <div class="ai-collection-carousel-placeholder-{{ ai_gen_id }}">
                {{ 'collection-1' | placeholder_svg_tag }}
              </div>
            </div>
            <div class="ai-collection-carousel-content-{{ ai_gen_id }}">
              <h3 class="ai-collection-carousel-title-{{ ai_gen_id }}">Colección {{ i }}</h3>
              <span class="ai-collection-carousel-button-{{ ai_gen_id }}">{{ block.settings.button_text }}</span>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</collection-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class CollectionCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.container = this.querySelector('.ai-collection-carousel-container-{{ ai_gen_id }}');
        this.cards = this.querySelectorAll('.ai-collection-carousel-card-{{ ai_gen_id }}');
        this.currentIndex = 0;
      }

      connectedCallback() {
        this.setupScrollSnap();
        this.updateActiveCard();
      }

      setupScrollSnap() {
        let scrollTimeout;
        this.container.addEventListener('scroll', () => {
          clearTimeout(scrollTimeout);
          scrollTimeout = setTimeout(() => {
            this.updateActiveCard();
          }, 100);
        });
      }

      updateActiveCard() {
        const containerRect = this.container.getBoundingClientRect();
        const containerCenter = containerRect.left + containerRect.width / 2;

        let closestCard = null;
        let closestDistance = Infinity;

        this.cards.forEach((card) => {
          const cardRect = card.getBoundingClientRect();
          const cardCenter = cardRect.left + cardRect.width / 2;
          const distance = Math.abs(containerCenter - cardCenter);

          if (distance < closestDistance) {
            closestDistance = distance;
            closestCard = card;
          }
        });

        this.cards.forEach((card) => {
          card.classList.remove('active');
        });

        if (closestCard) {
          closestCard.classList.add('active');
        }
      }
    }

    customElements.define('collection-carousel-{{ ai_gen_id }}', CollectionCarousel{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Carrusel de colecciones",
  "settings": [
    {
      "type": "header",
      "content": "Colecciones"
    },
    {
      "type": "collection",
      "id": "collection_1",
      "label": "Colección 1"
    },
    {
      "type": "collection",
      "id": "collection_2",
      "label": "Colección 2"
    },
    {
      "type": "collection",
      "id": "collection_3",
      "label": "Colección 3"
    },
    {
      "type": "header",
      "content": "Título"
    },
    {
      "type": "font_picker",
      "id": "title_font",
      "label": "Fuente del título",
      "default": "serif"
