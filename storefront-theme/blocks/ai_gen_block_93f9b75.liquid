      "unit": "px",
      "default": 24
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Color del título",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Botón"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Texto del botón",
      "default": "EXPLORAR"
    },
    {
      "type": "font_picker",
      "id": "button_font",
      "label": "Fuente del botón",
      "default": "sans-serif"
    },
    {
      "type": "range",
      "id": "button_font_size",
      "label": "Tamaño de fuente",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 11
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Fondo del botón",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Color del texto",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_border_color",
      "label": "Color del borde",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_hover_background",
      "label": "Fondo al pasar",
      "default": "#383838"
    },
    {
      "type": "color",
      "id": "button_hover_text_color",
      "label": "Texto al pasar",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_hover_border_color",
      "label": "Borde al pasar",
      "default": "#383838"
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "label": "Radio del borde",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Carrusel de colecciones"
    }
  ]
}
