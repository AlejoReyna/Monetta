{% doc %}
  @prompt
    Task: Create a High-Visibility "Collection List" Mobile Carousel.
    5 cards: first 3 are collections, last 2 are static (image + heading + custom button link).
    Snap animation, scale effect, no bounce bug.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-carousel-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    position: relative;
    overflow: visible;
    height: 370px;
    padding: 20px 0;
    box-sizing: border-box;
    background-color: transparent;
  }

  .ai-collection-carousel-container-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    width: 100%;
    background-color: #ffffff;
  }

  .ai-collection-carousel-track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.card_gap }}px;
    overflow-x: auto;
    overflow-y: visible;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 20px 8vw;
    background-color: #ffffff;
    align-items: center;
  }

  .ai-collection-carousel-track-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-collection-carousel-card-{{ ai_gen_id }} {
    flex: 0 0 {{ block.settings.mobile_card_width }}vw;
    min-width: {{ block.settings.mobile_card_width }}vw;
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    box-shadow: 0 4px 12px rgba(0, 0, 0, {{ block.settings.shadow_opacity | divided_by: 100.0 }});
    scroll-snap-align: center;
    display: flex;
    flex-direction: column;
    transition: transform 0.3s ease;
    transform: scale(0.85);
    overflow: hidden;
    height: {{ block.settings.mobile_card_height }}px;
    max-height: {{ block.settings.mobile_card_height }}px;
  }

  .ai-collection-carousel-card-{{ ai_gen_id }}.active {
    transform: scale(1.0);
  }

  .ai-collection-carousel-image-wrapper-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    height: {{ block.settings.mobile_image_height }}px;
    flex-shrink: 0;
  }

  .ai-collection-carousel-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-collection-carousel-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f0f0f0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-collection-carousel-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-collection-carousel-content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    text-align: center;
    padding: 10px 15px 20px 15px;
    gap: 20px;
    flex-shrink: 0;
    overflow: hidden;
    flex: 1;
  }

  .ai-collection-carousel-title-{{ ai_gen_id }} {
    font-family: {{ block.settings.title_font.family }}, {{ block.settings.title_font.fallback_families }};
    font-weight: {{ block.settings.title_font.weight }};
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0;
    letter-spacing: 1px;
  }

  .ai-collection-carousel-description-{{ ai_gen_id }} {
    font-family: {{ block.settings.description_font.family }}, {{ block.settings.description_font.fallback_families }};
    font-weight: {{ block.settings.description_font.weight }};
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    margin: 0;
    line-height: 1.6;
  }

  .ai-collection-carousel-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 14px 32px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-family: {{ block.settings.button_font.family }}, {{ block.settings.button_font.fallback_families }};
    font-weight: {{ block.settings.button_font.weight }};
    font-size: {{ block.settings.button_size }}px;
    transition: all 0.3s ease;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .ai-collection-carousel-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
  }

  @media screen and (min-width: 750px) {
    .ai-collection-carousel-{{ ai_gen_id }} {
      height: auto;
      padding: 30px 0;
    }

    .ai-collection-carousel-card-{{ ai_gen_id }} {
      flex: 0 0 {{ block.settings.desktop_card_width }}vw;
      min-width: {{ block.settings.desktop_card_width }}vw;
      height: 390px;
      max-height: 390px;
    }

    .ai-collection-carousel-image-wrapper-{{ ai_gen_id }} {
      height: 255px;
    }
  }
{% endstyle %}

<collection-carousel-{{ ai_gen_id }}
  class="ai-collection-carousel-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-collection-carousel-container-{{ ai_gen_id }}">
    <div class="ai-collection-carousel-track-{{ ai_gen_id }}" data-carousel-track>

      {%- comment -%} TARJETAS 1–3: Colecciones dinámicas {%- endcomment -%}
      {% for i in (1..3) %}
        {% liquid
          assign collection_key = 'collection_' | append: i
          assign collection = block.settings[collection_key]
        %}
        <div class="ai-collection-carousel-card-{{ ai_gen_id }}" data-card-index="{{ forloop.index0 }}">
          <div class="ai-collection-carousel-image-wrapper-{{ ai_gen_id }}">
            {% if collection.featured_image %}
              <img
                src="{{ collection.featured_image | image_url: width: 800 }}"
                alt="{{ collection.featured_image.alt | escape }}"
                loading="lazy"
                width="800"
                height="800"
                class="ai-collection-carousel-image-{{ ai_gen_id }}"
              >
            {% else %}
              <div class="ai-collection-carousel-placeholder-{{ ai_gen_id }}">
                {{ 'collection-1' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
          <div class="ai-collection-carousel-content-{{ ai_gen_id }}">
            <h3 class="ai-collection-carousel-title-{{ ai_gen_id }}">
              {{ collection.title | default: 'Colección' }}
            </h3>
            {% if block.settings.show_description and collection.description != blank %}
              <p class="ai-collection-carousel-description-{{ ai_gen_id }}">
                {{ collection.description | strip_html | truncate: 120 }}
              </p>
            {% endif %}
            <a href="{{ collection.url | default: '#' }}" class="ai-collection-carousel-button-{{ ai_gen_id }}">
              {{ block.settings.button_text }}
            </a>
          </div>
        </div>
      {% endfor %}

      {%- comment -%} TARJETAS 4–5: Tarjetas estáticas personalizables {%- endcomment -%}
      {% for i in (4..5) %}
        {% liquid
          assign static_image_key = 'static_image_' | append: i
          assign static_title_key = 'static_title_' | append: i
          assign static_button_text_key = 'static_button_text_' | append: i
          assign static_button_url_key = 'static_button_url_' | append: i
          assign static_image = block.settings[static_image_key]
          assign static_title = block.settings[static_title_key]
          assign static_button_text = block.settings[static_button_text_key]
          assign static_button_url = block.settings[static_button_url_key]
        %}
        <div class="ai-collection-carousel-card-{{ ai_gen_id }}" data-card-index="{{ forloop.index0 | plus: 3 }}">
          <div class="ai-collection-carousel-image-wrapper-{{ ai_gen_id }}">
            {% if static_image %}
              <img
                src="{{ static_image | image_url: width: 800 }}"
                alt="{{ static_title | escape }}"
                loading="lazy"
                width="800"
                height="800"
                class="ai-collection-carousel-image-{{ ai_gen_id }}"
              >
            {% else %}
              <div class="ai-collection-carousel-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
          <div class="ai-collection-carousel-content-{{ ai_gen_id }}">
            <h3 class="ai-collection-carousel-title-{{ ai_gen_id }}">
              {{ static_title | default: 'Título' }}
            </h3>
            <a
              href="{{ static_button_url | default: '#' }}"
              class="ai-collection-carousel-button-{{ ai_gen_id }}"
            >
              {{ static_button_text | default: 'Ver más' }}
            </a>
          </div>
        </div>
      {% endfor %}

    </div>
  </div>
</collection-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class CollectionCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.track = null;
        this.cards = [];
        this.currentIndex = 0;
        this.isSnapping = false;
      }

      connectedCallback() {
        this.track = this.querySelector('[data-carousel-track]');
        this.cards = Array.from(this.querySelectorAll('[data-card-index]'));

        if (!this.track || this.cards.length === 0) return;

        this.setupScrollListener();

        requestAnimationFrame(() => {
          this.updateActiveCard();
        });
      }

      setupScrollListener() {
        let scrollTimeout;

        this.track.addEventListener('scroll', () => {
          if (this.isSnapping) return;

          clearTimeout(scrollTimeout);
          this.updateActiveCard();

          scrollTimeout = setTimeout(() => {
            this.snapToNearestCard();
          }, 150);
        });
      }

      updateActiveCard() {
        const trackRect = this.track.getBoundingClientRect();
        const trackCenter = trackRect.left + trackRect.width / 2;

        let closestCard = null;
        let closestDistance = Infinity;

        this.cards.forEach((card) => {
          const cardRect = card.getBoundingClientRect();
          const cardCenter = cardRect.left + cardRect.width / 2;
          const distance = Math.abs(trackCenter - cardCenter);

          if (distance < closestDistance) {
            closestDistance = distance;
            closestCard = card;
          }
        });

        this.cards.forEach((card) => card.classList.remove('active'));

        if (closestCard) {
          closestCard.classList.add('active');
          this.currentIndex = parseInt(closestCard.dataset.cardIndex);
        }
      }

      snapToNearestCard() {
        if (this.cards.length === 0) return;

        const activeCard = this.cards[this.currentIndex];
        if (!activeCard) return;

        const trackRect = this.track.getBoundingClientRect();
        const cardRect = activeCard.getBoundingClientRect();
        const trackCenter = trackRect.left + trackRect.width / 2;
        const cardCenter = cardRect.left + cardRect.width / 2;
        const offset = cardCenter - trackCenter;

        if (Math.abs(offset) < 1) return;

        this.isSnapping = true;

        this.track.scrollBy({
          left: offset,
          behavior: 'smooth'
        });

        setTimeout(() => {
          this.isSnapping = false;
          this.updateActiveCard();
        }, 400);
      }
    }

    if (!customElements.get('collection-carousel-{{ ai_gen_id }}')) {
      customElements.define('collection-carousel-{{ ai_gen_id }}', CollectionCarousel{{ ai_gen_id }});
    }
  })();
</script>

