{% doc %}
  @prompt
    "Shopify liquid block. Horizontally scrollable 3-row × 3-column collection image grid. 9 collections total.
    
    SCROLL INITIALIZATION — CRITICAL: On DOMContentLoaded and on window load, force scrollContainer.scrollLeft = 0 using both events to guarantee the leftmost column is always visible first, regardless of browser rendering order.
    
    PREMIUM SCROLL: Apply scroll-behavior: smooth, scroll-snap-type: x mandatory, -webkit-overflow-scrolling: touch. Add momentum-based deceleration feel using scroll-snap-stop: always on each snap point. Hide scrollbar via ::-webkit-scrollbar { display: none } and scrollbar-width: none.
    
    HOVER/TOUCH INTERACTION — PREMIUM LIFT EFFECT: On hover (desktop) and on touchstart (mobile), apply to each card: transform: translateY(-6px) scale(1.03), box-shadow: 0 16px 40px rgba(0,0,0,0.18), transition: transform 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94), box-shadow 0.3s ease. On mouse leave / touchend, smoothly return to resting state.
    
    LAYOUT: Outer wrapper: width: 100%, max-width: 100vw, overflow-x: hidden, padding: 0 32px, box-sizing: border-box. Scroll container: display: grid, grid-template-rows: repeat(3, auto), grid-auto-flow: column, overflow-x: auto, padding: 24px 0, gap: 28px.
    
    CARDS: width: 220px desktop / 160px mobile, aspect-ratio: 2.3/1, border-radius: 12px, overflow: hidden, box-shadow: 0 6px 24px rgba(0,0,0,0.10). Image only — object-fit: cover, width: 100%, height: 100%. No text, no title, no overlay.
    
    THEME EDITOR SETTINGS: Expose card width, gap, padding, border-radius, shadow opacity as editable schema settings. Background transparent."
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-grid-wrapper-{{ ai_gen_id }} {
    width: 100%;
    max-width: 100vw;
    overflow-x: hidden;
    padding: 0 {{ block.settings.outer_padding }}px;
    box-sizing: border-box;
    background: transparent;
    display: block;
  }

  .ai-collection-grid-container-{{ ai_gen_id }} {
    display: grid;
    grid-template-rows: repeat(3, auto);
    grid-auto-flow: column;
    overflow-x: auto;
    padding: {{ block.settings.vertical_padding }}px 0;
    gap: {{ block.settings.gap }}px;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .ai-collection-grid-container-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-collection-grid-card-{{ ai_gen_id }} {
    width: {{ block.settings.card_width_desktop }}px;
    aspect-ratio: 2.3 / 1;
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
    box-shadow: 0 6px 24px rgba(0, 0, 0, {{ block.settings.shadow_opacity | divided_by: 100.0 }});
    scroll-snap-align: start;
    scroll-snap-stop: always;
    transition: transform 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94), box-shadow 0.3s ease;
    position: relative;
    display: block;
  }

  .ai-collection-grid-card-{{ ai_gen_id }}:hover {
    transform: translateY(-6px) scale(1.03);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.18);
  }

  .ai-collection-grid-card-{{ ai_gen_id }}.ai-touch-active-{{ ai_gen_id }} {
    transform: translateY(-6px) scale(1.03);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.18);
  }

  .ai-collection-grid-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-collection-grid-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-collection-grid-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  @media screen and (max-width: 749px) {
    .ai-collection-grid-card-{{ ai_gen_id }} {
      width: {{ block.settings.card_width_mobile }}px;
    }
  }
{% endstyle %}

<ai-collection-grid-{{ ai_gen_id }}
  class="ai-collection-grid-wrapper-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-collection-grid-container-{{ ai_gen_id }}" data-scroll-container>
    {% for i in (1..9) %}
      {% liquid
        assign collection_key = 'collection_' | append: i
        assign collection = block.settings[collection_key]
      %}

      {% if collection != blank %}
        <a
          href="{{ collection.url }}"
          class="ai-collection-grid-card-{{ ai_gen_id }}"
          data-card
        >
          {% if collection.featured_image %}
            <img
              src="{{ collection.featured_image | image_url: width: 600 }}"
              alt="{{ collection.featured_image.alt | escape }}"
              loading="lazy"
              width="600"
              height="261"
              class="ai-collection-grid-image-{{ ai_gen_id }}"
            >
          {% else %}
            <div class="ai-collection-grid-placeholder-{{ ai_gen_id }}">
              {{ 'collection-1' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </a>
      {% else %}
        <div class="ai-collection-grid-card-{{ ai_gen_id }}">
          <div class="ai-collection-grid-placeholder-{{ ai_gen_id }}">
            {{ 'collection-1' | placeholder_svg_tag }}
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</ai-collection-grid-{{ ai_gen_id }}>

<script>
  (function() {
    class AiCollectionGrid{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.scrollContainer = null;
        this.cards = [];
      }

      connectedCallback() {
        this.scrollContainer = this.querySelector('[data-scroll-container]');
        this.cards = Array.from(this.querySelectorAll('[data-card]'));

        this.initializeScroll();
        this.setupTouchInteractions();
      }

      initializeScroll() {
        const resetScroll = () => {
          if (this.scrollContainer) {
            this.scrollContainer.scrollLeft = 0;
          }
        };

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', resetScroll);
        } else {
          resetScroll();
        }

        window.addEventListener('load', resetScroll);
      }

      setupTouchInteractions() {
        this.cards.forEach((card) => {
          card.addEventListener('touchstart', () => {
            card.classList.add('ai-touch-active-{{ ai_gen_id }}');
          });

          card.addEventListener('touchend', () => {
            card.classList.remove('ai-touch-active-{{ ai_gen_id }}');
          });

          card.addEventListener('touchcancel', () => {
            card.classList.remove('ai-touch-active-{{ ai_gen_id }}');
          });
        });
      }
    }

    customElements.define('ai-collection-grid-{{ ai_gen_id }}', AiCollectionGrid{{ ai_gen_id }});
  })();
</script>

