{% doc %}
  @prompt
    Create a premium image-only carousel block for Shopify OS 2.0. No text overlays, no headings, no descriptions — images only.
    
    Card sizing & spacing:
    
    Card width: ~78% of container on mobile, ~58% on desktop (configurable in theme editor)
    Cards have generous internal padding (padding: 12px minimum, configurable) so the shadow is never clipped by the container edge
    The carousel wrapper must have overflow: visible on the track axis and overflow: hidden only on the perpendicular axis, ensuring shadows render fully without being cut off
    Gap between cards is configurable in theme editor (range: 8px–40px, default 16px)
    Card border-radius is configurable (range: 0–32px, default 16px)
    Peek behavior:
    
    The next card always peeks ~18% from the right (and previous from the left after first slide) — never hidden, always hinting at more content
    Peek amount is configurable in theme editor
    Active card focus animation:
    
    Active card: scale(1), opacity: 1
    Inactive/adjacent cards: scale(0.91), opacity: 0.55
    When advancing, the incoming card grows into full scale and full opacity while the outgoing card shrinks and fades slightly — smooth, cinematic transition
    Easing: cubic-bezier(0.25, 0.46, 0.45, 0.94), duration 0.5s
    Use will-change: transform, opacity for GPU-accelerated rendering
    Shadow:
    
    box-shadow: 0 12px 40px rgba(0,0,0,0.10), 0 2px 10px rgba(0,0,0,0.06)
    Active card shadow is slightly stronger; inactive cards have reduced shadow
    Shadow must never be clipped — ensure container padding and overflow: visible on the scroll track accommodate full shadow bleed
    Images:
    
    Full-bleed, object-fit: cover, no distortion
    Aspect ratio configurable: 1:1, 4:5, 3:4, 16:9
    Lazy load all images beyond the first
    Reserve dimensions with CSS aspect-ratio to prevent layout shift
    Navigation:
    
    Touch/drag swipe support (momentum-based, snaps to nearest card)
    Optional prev/next arrow buttons (minimal, icon-only, toggleable)
    Optional dot indicators below (active dot = pill shape, configurable color)
    Optional autoplay with configurable interval
    Theme editor controls (schema settings):
    
    Number of slides (2–8)
    Per-slide: image picker
    Card width (% of container)
    Card internal padding (px)
    Gap between cards (px)
    Border radius (px)
    Peek amount (%)
    Aspect ratio selector
    Toggle: arrows, dots, autoplay
    Autoplay interval (seconds)
    Alignment: left / center (default center)
    Performance & quality:
    
    No layout shift on load
    Smooth 60fps transitions on mobile
    All animations GPU-accelerated via will-change and transform only (no layout-triggering properties)
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-premium-carousel-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    position: relative;
    overflow-x: hidden;
    overflow-y: visible;
  }

  .ai-premium-carousel-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding: {{ block.settings.card_padding }}px 0;
  }

  .ai-premium-carousel-track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.card_gap }}px;
    overflow-x: auto;
    overflow-y: visible;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    {% if block.settings.alignment == 'center' %}
      justify-content: center;
    {% else %}
      justify-content: flex-start;
    {% endif %}
    padding: 12px {{ block.settings.card_padding }}px 24px;
  }

  .ai-premium-carousel-track-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-premium-carousel-slide-{{ ai_gen_id }} {
    flex-shrink: 0;
    scroll-snap-align: center;
    margin: 5px;
    transition: transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94), opacity 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    will-change: transform, opacity;
    transform: scale(0.91);
    opacity: 0.55;
  }

  .ai-premium-carousel-slide-{{ ai_gen_id }}.active {
    transform: scale(1);
    opacity: 1;
  }

  .ai-premium-carousel-card-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: {{ block.settings.border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.10), 0 2px 10px rgba(0, 0, 0, 0.06);
    transition: box-shadow 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .ai-premium-carousel-slide-{{ ai_gen_id }}.active .ai-premium-carousel-card-{{ ai_gen_id }} {
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.14), 0 4px 12px rgba(0, 0, 0, 0.08);
  }

  .ai-premium-carousel-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: {{ block.settings.aspect_ratio }};
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
  }

  .ai-premium-carousel-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-premium-carousel-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-premium-carousel-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-premium-carousel-nav-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    background: rgba(255, 255, 255, 0.9);
    border: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.3s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .ai-premium-carousel-nav-{{ ai_gen_id }}:hover {
    background: rgba(255, 255, 255, 1);
  }

  .ai-premium-carousel-nav-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-premium-carousel-nav-prev-{{ ai_gen_id }} {
    left: 20px;
  }

  .ai-premium-carousel-nav-next-{{ ai_gen_id }} {
    right: 20px;
  }

  .ai-premium-carousel-nav-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
    stroke: #000000;
    stroke-width: 2;
  }

  .ai-premium-carousel-dots-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 24px;
  }

  .ai-premium-carousel-dot-{{ ai_gen_id }} {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: {{ block.settings.dot_color }};
    opacity: 0.3;
    border: none;
    padding: 0;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .ai-premium-carousel-dot-{{ ai_gen_id }}.active {
    width: 24px;
    border-radius: 4px;
    opacity: 1;
  }

  @media screen and (max-width: 749px) {
    .ai-premium-carousel-slide-{{ ai_gen_id }} {
      width: {{ block.settings.card_width_mobile }}%;
    }
  }

  @media screen and (min-width: 750px) {
    .ai-premium-carousel-slide-{{ ai_gen_id }} {
      width: {{ block.settings.card_width_desktop }}%;
    }
  }
{% endstyle %}

<premium-carousel-{{ ai_gen_id }}
  class="ai-premium-carousel-{{ ai_gen_id }}"
  data-autoplay="{{ block.settings.autoplay }}"
  data-autoplay-interval="{{ block.settings.autoplay_interval }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-premium-carousel-wrapper-{{ ai_gen_id }}">
    <div class="ai-premium-carousel-track-{{ ai_gen_id }}" data-carousel-track>
      {% for i in (1..block.settings.slide_count) %}
        {% liquid
          assign image_key = 'slide_' | append: i | append: '_image'
          assign slide_image = block.settings[image_key]
        %}
        <div class="ai-premium-carousel-slide-{{ ai_gen_id }} {% if i == 1 %}active{% endif %}" data-slide-index="{{ forloop.index0 }}">
          <div class="ai-premium-carousel-card-{{ ai_gen_id }}">
            <div class="ai-premium-carousel-image-wrapper-{{ ai_gen_id }}">
              {% if slide_image %}
                <img
                  src="{{ slide_image | image_url: width: 1200 }}"
                  alt="{{ slide_image.alt | escape }}"
                  loading="{% if i == 1 %}eager{% else %}lazy{% endif %}"
                  width="{{ slide_image.width }}"
                  height="{{ slide_image.height }}"
                  class="ai-premium-carousel-image-{{ ai_gen_id }}"
                >
              {% else %}
                <div class="ai-premium-carousel-placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>

    {% if block.settings.show_arrows %}
      <button
        class="ai-premium-carousel-nav-{{ ai_gen_id }} ai-premium-carousel-nav-prev-{{ ai_gen_id }}"
        data-carousel-prev
        aria-label="Previous slide"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none">
          <path d="M15 18l-6-6 6-6" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <button
        class="ai-premium-carousel-nav-{{ ai_gen_id }} ai-premium-carousel-nav-next-{{ ai_gen_id }}"
        data-carousel-next
        aria-label="Next slide"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none">
          <path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    {% endif %}
  </div>

  {% if block.settings.show_dots %}
    <div class="ai-premium-carousel-dots-{{ ai_gen_id }}" data-carousel-dots>
      {% for i in (1..block.settings.slide_count) %}
        <button
          class="ai-premium-carousel-dot-{{ ai_gen_id }} {% if i == 1 %}active{% endif %}"
          data-dot-index="{{ forloop.index0 }}"
          aria-label="Go to slide {{ i }}"
        ></button>
      {% endfor %}
    </div>
  {% endif %}
</premium-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class PremiumCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.track = this.querySelector('[data-carousel-track]');
        this.slides = Array.from(this.querySelectorAll('.ai-premium-carousel-slide-{{ ai_gen_id }}'));
        this.prevButton = this.querySelector('[data-carousel-prev]');
        this.nextButton = this.querySelector('[data-carousel-next]');
        this.dots = Array.from(this.querySelectorAll('[data-dot-index]'));
        this.currentIndex = 0;
        this.autoplayEnabled = this.dataset.autoplay === 'true';
        this.autoplayInterval = parseInt(this.dataset.autoplayInterval) * 1000;
        this.autoplayTimer = null;
        this.isDragging = false;
        this.startX = 0;
        this.scrollLeft = 0;
      }

      connectedCallback() {
        this.setupEventListeners();
        this.updateActiveSlide();
        if (this.autoplayEnabled) {
          this.startAutoplay();
        }
      }

      setupEventListeners() {
        if (this.prevButton) {
          this.prevButton.addEventListener('click', () => this.goToPrevSlide());
        }
        if (this.nextButton) {
          this.nextButton.addEventListener('click', () => this.goToNextSlide());
        }

        this.dots.forEach((dot) => {
          dot.addEventListener('click', (e) => {
            const index = parseInt(e.target.dataset.dotIndex);
            this.goToSlide(index);
          });
        });

        this.track.addEventListener('mousedown', (e) => this.handleDragStart(e));
        this.track.addEventListener('touchstart', (e) => this.handleDragStart(e));
        this.track.addEventListener('mousemove', (e) => this.handleDragMove(e));
        this.track.addEventListener('touchmove', (e) => this.handleDragMove(e));
        this.track.addEventListener('mouseup', () => this.handleDragEnd());
        this.track.addEventListener('touchend', () => this.handleDragEnd());
        this.track.addEventListener('mouseleave', () => this.handleDragEnd());

        this.track.addEventListener('scroll', () => {
          if (!this.isDragging) {
            this.updateActiveSlideFromScroll();
          }
        });

        this.addEventListener('mouseenter', () => this.stopAutoplay());
        this.addEventListener('mouseleave', () => {
          if (this.autoplayEnabled) {
            this.startAutoplay();
          }
        });
      }

      handleDragStart(e) {
        this.isDragging = true;
        this.startX = e.type === 'mousedown' ? e.pageX : e.touches[0].pageX;
        this.scrollLeft = this.track.scrollLeft;
        this.stopAutoplay();
      }

      handleDragMove(e) {
        if (!this.isDragging) return;
        e.preventDefault();
        const x = e.type === 'mousemove' ? e.pageX : e.touches[0].pageX;
        const walk = (x - this.startX) * 2;
        this.track.scrollLeft = this.scrollLeft - walk;
      }

      handleDragEnd() {
        if (!this.isDragging) return;
        this.isDragging = false;
        this.updateActiveSlideFromScroll();
        if (this.autoplayEnabled) {
          this.startAutoplay();
        }
      }

      updateActiveSlideFromScroll() {
        const scrollLeft = this.track.scrollLeft;
        const slideWidth = this.slides[0].offsetWidth;
        const gap = parseInt(getComputedStyle(this.track).gap);
        const newIndex = Math.round(scrollLeft / (slideWidth + gap));
        if (newIndex !== this.currentIndex && newIndex >= 0 && newIndex < this.slides.length) {
          this.currentIndex = newIndex;
          this.updateActiveSlide();
        }
      }

      goToSlide(index) {
        if (index < 0 || index >= this.slides.length) return;
        this.currentIndex = index;
        const slide = this.slides[index];
        const slideWidth = slide.offsetWidth;
        const gap = parseInt(getComputedStyle(this.track).gap);
        const scrollPosition = index * (slideWidth + gap);
        this.track.scrollTo({
          left: scrollPosition,
          behavior: 'smooth'
        });
        this.updateActiveSlide();
        this.resetAutoplay();
      }

      goToPrevSlide() {
        const newIndex = this.currentIndex > 0 ? this.currentIndex - 1 : this.slides.length - 1;
        this.goToSlide(newIndex);
      }

      goToNextSlide() {
        const newIndex = this.currentIndex < this.slides.length - 1 ? this.currentIndex + 1 : 0;
        this.goToSlide(newIndex);
      }

      updateActiveSlide() {
        this.slides.forEach((slide, index) => {
          if (index === this.currentIndex) {
            slide.classList.add('active');
          } else {
            slide.classList.remove('active');
          }
        });

        this.dots.forEach((dot, index) => {
          if (index === this.currentIndex) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });

        if (this.prevButton) {
          this.prevButton.disabled = false;
        }
        if (this.nextButton) {
          this.nextButton.disabled = false;
        }
      }

      startAutoplay() {
        if (!this.autoplayEnabled) return;
        this.stopAutoplay();
        this.autoplayTimer = setInterval(() => {
          this.goToNextSlide();
        }, this.autoplayInterval);
      }

      stopAutoplay() {
        if (this.autoplayTimer) {
          clearInterval(this.autoplayTimer);
          this.autoplayTimer = null;
        }
      }

      resetAutoplay() {
        if (this.autoplayEnabled) {
          this.stopAutoplay();
          this.startAutoplay();
        }
      }

      disconnectedCallback() {
        this.stopAutoplay();
      }
    }

    customElements.define('premium-carousel-{{ ai_gen_id }}', PremiumCarousel{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Premium image carousel",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Slides"
    },
    {
      "type": "range",
      "id": "slide_count",
      "label": "Number of slides",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "image_picker",
      "id": "slide_1_image",
      "label": "Slide 1 image"
    },
    {
      "type": "image_picker",
      "id": "slide_2_image",
      "label": "Slide 2 image"
    },
    {
      "type": "image_picker",
      "id": "slide_3_image",
      "label": "Slide 3 image"
    },
    {
      "type": "image_picker",
      "id": "slide_4_image",
      "label": "Slide 4 image"
    },
    {
      "type": "image_picker",
      "id": "slide_5_image",
      "label": "Slide 5 image"
    },
    {
      "type": "image_picker",
      "id": "slide_6_image",
      "label": "Slide 6 image"
    },
    {
      "type": "image_picker",
      "id": "slide_7_image",
      "label": "Slide 7 image"
    },
    {
      "type": "image_picker",
      "id": "slide_8_image",
      "label": "Slide 8 image"
    },
    {
      "type": "header",
      "content": "Card sizing"
    },
    {
      "type": "range",
      "id": "card_width_mobile",
      "label": "Card width on mobile",
      "min": 50,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 78
    },
    {
      "type": "range",
      "id": "card_width_desktop",
      "label": "Card width on desktop",
      "min": 30,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 58
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Card internal padding",
      "min": 12,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Gap between cards",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Card border radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Image settings"
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Aspect ratio",
      "options": [
        {
          "value": "1 / 1",
          "label": "1:1 (Square)"
        },
        {
          "value": "4 / 5",
          "label": "4:5 (Portrait)"
        },
        {
          "value": "3 / 4",
          "label": "3:4 (Portrait)"
        },
        {
          "value": "16 / 9",
          "label": "16:9 (Landscape)"
        }
      ],
      "default": "4 / 5"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrow buttons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show dot indicators",
      "default": true
    },
    {
      "type": "color",
      "id": "dot_color",
      "label": "Dot color",
      "default": "#000000"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable autoplay",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_interval",
      "label": "Autoplay interval",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5
    }
  ],
  "presets": [
    {
      "name": "Premium image carousel"
    }
  ]
}
{% endschema %}
