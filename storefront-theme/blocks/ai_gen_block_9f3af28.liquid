{% doc %}
  @prompt
    Create a new custom liquid block called "Nuevos productos carrusel". Display all store products sorted by newest first using collections.all.products with sort_by: created-descending. Do NOT use a collection picker.
    
    CRITICAL — Shadow clipping fix: The carousel must use this specific structure to prevent shadow clipping:
    
    Outer wrapper: overflow: visible; width: 100%; — this is what allows shadows to breathe
    Inner scroll container: overflow-x: auto; padding: 20px 20px 20px 40px; margin: -20px -20px -20px -40px; — the negative margins compensate for the padding so the scroll area stays full width while shadows have space to render
    This technique (padding + negative margin) is the only reliable way to show box-shadows inside a scrollable container without clipping
    Carousel behavior (HORIZONTAL only):
    
    Single horizontal row, user swipes LEFT/RIGHT
    On mobile: 2 cards visible side by side
    On desktop: 4 cards visible side by side
    display: flex; flex-direction: row;
    scroll-snap-type: x mandatory on scroll container, scroll-snap-align: start on each card
    Hide scrollbar: scrollbar-width: none and ::-webkit-scrollbar { display: none }
    Cards must have margin: 0 8px for gap between them
    Image format:
    
    All product images in 3:4 portrait ratio (padding-top: 133.33%, position relative, image absolute inside)
    object-fit: cover
    Image container: overflow: hidden; border-radius matches card setting
    On hover: image zooms transform: scale(1.07) inside overflow-hidden container
    Premium animations & hover:
    
    Page load: staggered fade-in per card (opacity 0→1, translateY 20px→0), 80ms delay increment per card
    Hover/touch: card scales 1.03, background changes to hover_background_color, texts change to hover_text_color, shadow intensifies
    All transitions: 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94)
    Text: all card text (title, price, vendor) always text-align: center
    
    Card sizing:
    
    Mobile: flex: 0 0 calc(45vw - 8px)
    Desktop (min-width 750px): flex: 0 0 calc(22% - 8px)
    Theme editor settings:
    
    Heading:
    
    heading_text — text, default "Nuevos productos"
    heading_color — color picker
    heading_size — range 16–48, default 24
    heading_alignment — select left/center/right, default center
    Card texts:
    
    card_title_color — color picker
    card_title_size — range 12–24, default 14
    card_price_color — color picker
    card_price_size — range 12–22, default 14
    card_vendor_color — color picker
    show_price — checkbox, default true
    show_vendor — checkbox, default false
    Hover:
    
    hover_background_color — color picker
    hover_text_color — color picker, default white
    Shadow — normal:
    
    shadow_color — color picker, default #000000
    shadow_opacity — range 0–30, default 8
    shadow_offset_x — range -20 to 20, default 0
    shadow_offset_y — range 0–30, default 4
    shadow_blur — range 0–60, default 12
    shadow_spread — range -10 to 20, default 0
    Shadow — hover:
    
    hover_shadow_opacity — range 0–40, default 18
    hover_shadow_blur — range 0–80, default 28
    hover_shadow_spread — range -10 to 20, default 4
    Card layout:
    
    card_background — color picker, default white
    card_border_radius — range 0–24, default 12
    card_padding — range 8–32, default 12
    products_to_show — range 4–24, default 8
    Non-negotiable requirements:
    
    Use the padding + negative margin technique on the scroll container — this is mandatory to prevent shadow clipping
    Images always 3:4 portrait
    All text always centered
    No hardcoded colors or shadow values in CSS
    Layout always horizontal
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-nuevos-productos-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-nuevos-productos-heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    text-align: {{ block.settings.heading_alignment }};
    margin: 0 0 24px 0;
  }

  .ai-nuevos-productos-outer-{{ ai_gen_id }} {
    overflow: visible;
    width: 100%;
  }

  .ai-nuevos-productos-scroll-{{ ai_gen_id }} {
    display: flex;
    flex-direction: row;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding: 20px 20px 20px 40px;
    margin: -20px -20px -20px -40px;
  }

  .ai-nuevos-productos-scroll-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-nuevos-productos-card-{{ ai_gen_id }} {
    flex: 0 0 calc(45vw - 8px);
    margin: 0 8px;
    scroll-snap-align: start;
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    transition: all 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    opacity: 0;
    transform: translateY(20px);
    animation: ai-nuevos-productos-fade-in-{{ ai_gen_id }} 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
    box-shadow: {{ block.settings.shadow_offset_x }}px {{ block.settings.shadow_offset_y }}px {{ block.settings.shadow_blur }}px {{ block.settings.shadow_spread }}px rgba({{ block.settings.shadow_color | color_extract: 'red' }}, {{ block.settings.shadow_color | color_extract: 'green' }}, {{ block.settings.shadow_color | color_extract: 'blue' }}, {{ block.settings.shadow_opacity | divided_by: 100.0 }});
  }

  @media screen and (min-width: 750px) {
    .ai-nuevos-productos-card-{{ ai_gen_id }} {
      flex: 0 0 calc(22% - 8px);
    }
  }

  .ai-nuevos-productos-card-{{ ai_gen_id }}:hover {
    transform: scale(1.03) translateY(0);
    background-color: {{ block.settings.hover_background_color }};
    box-shadow: {{ block.settings.shadow_offset_x }}px {{ block.settings.shadow_offset_y }}px {{ block.settings.hover_shadow_blur }}px {{ block.settings.hover_shadow_spread }}px rgba({{ block.settings.shadow_color | color_extract: 'red' }}, {{ block.settings.shadow_color | color_extract: 'green' }}, {{ block.settings.shadow_color | color_extract: 'blue' }}, {{ block.settings.hover_shadow_opacity | divided_by: 100.0 }});
  }

  {% for i in (1..24) %}
    .ai-nuevos-productos-card-{{ ai_gen_id }}:nth-child({{ i }}) {
      animation-delay: {{ i | minus: 1 | times: 80 }}ms;
    }
  {% endfor %}

  @keyframes ai-nuevos-productos-fade-in-{{ ai_gen_id }} {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .ai-nuevos-productos-image-container-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-top: 133.33%;
    overflow: hidden;
    border-radius: {{ block.settings.card_border_radius }}px;
    margin-bottom: 12px;
  }

  .ai-nuevos-productos-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .ai-nuevos-productos-card-{{ ai_gen_id }}:hover .ai-nuevos-productos-image-{{ ai_gen_id }} {
    transform: scale(1.07);
  }

  .ai-nuevos-productos-title-{{ ai_gen_id }} {
    color: {{ block.settings.card_title_color }};
    font-size: {{ block.settings.card_title_size }}px;
    text-align: center;
    margin: 0 0 8px 0;
    transition: color 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .ai-nuevos-productos-card-{{ ai_gen_id }}:hover .ai-nuevos-productos-title-{{ ai_gen_id }} {
    color: {{ block.settings.hover_text_color }};
  }

  .ai-nuevos-productos-price-{{ ai_gen_id }} {
    color: {{ block.settings.card_price_color }};
    font-size: {{ block.settings.card_price_size }}px;
    text-align: center;
    margin: 0 0 8px 0;
    transition: color 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .ai-nuevos-productos-card-{{ ai_gen_id }}:hover .ai-nuevos-productos-price-{{ ai_gen_id }} {
    color: {{ block.settings.hover_text_color }};
  }

  .ai-nuevos-productos-vendor-{{ ai_gen_id }} {
    color: {{ block.settings.card_vendor_color }};
    font-size: {{ block.settings.card_title_size }}px;
    text-align: center;
    margin: 0;
    transition: color 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .ai-nuevos-productos-card-{{ ai_gen_id }}:hover .ai-nuevos-productos-vendor-{{ ai_gen_id }} {
    color: {{ block.settings.hover_text_color }};
  }
{% endstyle %}

<nuevos-productos-carousel-{{ ai_gen_id }} class="ai-nuevos-productos-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading_text != blank %}
    <h2 class="ai-nuevos-productos-heading-{{ ai_gen_id }}">{{ block.settings.heading_text }}</h2>
  {% endif %}

  <div class="ai-nuevos-productos-outer-{{ ai_gen_id }}">
    <div class="ai-nuevos-productos-scroll-{{ ai_gen_id }}">
      {% assign sorted_products = collections.all.products | sort: 'created_at' | reverse %}
      {% for product in sorted_products limit: block.settings.products_to_show %}
        <a href="{{ product.url }}" class="ai-nuevos-productos-card-{{ ai_gen_id }}">
          <div class="ai-nuevos-productos-image-container-{{ ai_gen_id }}">
            {% if product.featured_image %}
              <img
                src="{{ product.featured_image | image_url: width: 600 }}"
                alt="{{ product.featured_image.alt | escape }}"
                class="ai-nuevos-productos-image-{{ ai_gen_id }}"
                loading="lazy"
                width="600"
                height="800"
              >
            {% else %}
              <div class="ai-nuevos-productos-image-placeholder-{{ ai_gen_id }}">
                {{ 'product-1' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>

          <h3 class="ai-nuevos-productos-title-{{ ai_gen_id }}">{{ product.title }}</h3>

          {% if block.settings.show_price %}
            <div class="ai-nuevos-productos-price-{{ ai_gen_id }}">
              {{ product.price | money }}
            </div>
          {% endif %}

          {% if block.settings.show_vendor %}
            <div class="ai-nuevos-productos-vendor-{{ ai_gen_id }}">
              {{ product.vendor }}
            </div>
          {% endif %}
        </a>
      {% endfor %}
    </div>
  </div>
</nuevos-productos-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class NuevosProductosCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        const scrollContainer = this.querySelector('.ai-nuevos-productos-scroll-{{ ai_gen_id }}');
        
        if (scrollContainer) {
          let isDown = false;
          let startX;
          let scrollLeft;

          scrollContainer.addEventListener('mousedown', (e) => {
            isDown = true;
            startX = e.pageX - scrollContainer.offsetLeft;
            scrollLeft = scrollContainer.scrollLeft;
          });

          scrollContainer.addEventListener('mouseleave', () => {
            isDown = false;
          });

          scrollContainer.addEventListener('mouseup', () => {
            isDown = false;
          });

          scrollContainer.addEventListener('mousemove', (e) => {
            if (!isDown) return;
            e.preventDefault();
            const x = e.pageX - scrollContainer.offsetLeft;
            const walk = (x - startX) * 2;
            scrollContainer.scrollLeft = scrollLeft - walk;
          });
        }
      }
    }

    customElements.define('nuevos-productos-carousel-{{ ai_gen_id }}', NuevosProductosCarousel{{ ai_gen_id }});
  })();
</script>

