{% doc %}
  @prompt
    Prompt para la IA de Shopify (Fijación de Layout Móvil)
    Task: Create a native section with a strict side-by-side horizontal layout (Image on the left, Text on the right). You must override the default mobile responsive behavior.
    
    1. Forced Horizontal Layout (CRITICAL):
    
    Mobile Configuration: Disable "Stack on mobile" (Do not stack). The layout MUST remain a 2-column horizontal split even on mobile screens.
    
    Placement: The Image block must be permanently locked to the LEFT column. The Text and Button blocks must be permanently locked to the RIGHT column.
    
    Spacing: Apply zero top and bottom padding to the section. Keep the margins extremely tight.
    
    2. Content Blocks (Right Column):
    
    Caption: "SOBRE MONETTA" (Uppercase, small sans-serif).
    
    Heading: "TEXTO" (Large, premium serif font).
    
    Body Text: "Somos una marca comprometida con la excelencia y la autenticidad. Cada producto que creamos cuenta una historia de pasión, dedicación y atención al detalle."
    
    3. Button Configuration (Right Column):
    
    Add a button block directly below the text.
    
    Include 2 buttons: "MAS INFORMACIÓN" and "GRUPOS Y REFERENCIAS".
    
    Layout: Force the buttons to display inline (side-by-side horizontally) within their column.
    
    Style: Outline/Secondary style.
    
    4. Aesthetic:
    
    Pure white background. Minimalist, premium design. Ensure the left image column and right text column are perfectly vertically aligned in the center.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-side-by-side-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: 0;
    margin: 0;
  }

  .ai-side-by-side-container-{{ ai_gen_id }} {
    display: flex;
    flex-direction: row;
    align-items: center;
    width: 100%;
    min-height: {{ block.settings.min_height }}px;
  }

  .ai-side-by-side-image-column-{{ ai_gen_id }} {
    flex: 0 0 50%;
    width: 50%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-side-by-side-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-side-by-side-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-side-by-side-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-side-by-side-text-column-{{ ai_gen_id }} {
    flex: 0 0 50%;
    width: 50%;
    padding: {{ block.settings.text_padding }}px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
  }

  .ai-side-by-side-caption-{{ ai_gen_id }} {
    font-family: {{ block.settings.caption_font.family }}, {{ block.settings.caption_font.fallback_families }};
    font-weight: {{ block.settings.caption_font.weight }};
    font-size: {{ block.settings.caption_size }}px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: {{ block.settings.text_color }};
    margin: 0 0 {{ block.settings.caption_margin }}px 0;
  }

  .ai-side-by-side-heading-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.2;
    color: {{ block.settings.text_color }};
    margin: 0 0 {{ block.settings.heading_margin }}px 0;
  }

  .ai-side-by-side-body-{{ ai_gen_id }} {
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    font-weight: {{ block.settings.body_font.weight }};
    font-size: {{ block.settings.body_size }}px;
    line-height: 1.6;
    color: {{ block.settings.text_color }};
    margin: 0 0 {{ block.settings.body_margin }}px 0;
  }

  .ai-side-by-side-buttons-{{ ai_gen_id }} {
    display: flex;
    flex-direction: row;
    gap: {{ block.settings.button_gap }}px;
    flex-wrap: wrap;
  }

  .ai-side-by-side-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    font-family: {{ block.settings.button_font.family }}, {{ block.settings.button_font.fallback_families }};
    font-weight: {{ block.settings.button_font.weight }};
    font-size: {{ block.settings.button_size }}px;
    text-transform: uppercase;
    text-decoration: none;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .ai-side-by-side-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-side-by-side-container-{{ ai_gen_id }} {
      min-height: {{ block.settings.min_height_mobile }}px;
    }

    .ai-side-by-side-text-column-{{ ai_gen_id }} {
      padding: {{ block.settings.text_padding_mobile }}px;
    }

    .ai-side-by-side-caption-{{ ai_gen_id }} {
      font-size: {{ block.settings.caption_size_mobile }}px;
    }

    .ai-side-by-side-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_mobile }}px;
    }

    .ai-side-by-side-body-{{ ai_gen_id }} {
      font-size: {{ block.settings.body_size_mobile }}px;
    }

    .ai-side-by-side-button-{{ ai_gen_id }} {
      font-size: {{ block.settings.button_size_mobile }}px;
      padding: {{ block.settings.button_padding_vertical_mobile }}px {{ block.settings.button_padding_horizontal_mobile }}px;
    }
  }
{% endstyle %}

<div class="ai-side-by-side-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-side-by-side-container-{{ ai_gen_id }}">
    <div class="ai-side-by-side-image-column-{{ ai_gen_id }}">
      {% if block.settings.image %}
        <img
          src="{{ block.settings.image | image_url: width: 1500 }}"
          alt="{{ block.settings.image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.image.width }}"
          height="{{ block.settings.image.height }}"
          class="ai-side-by-side-image-{{ ai_gen_id }}"
        >
      {% else %}
        <div class="ai-side-by-side-image-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>

    <div class="ai-side-by-side-text-column-{{ ai_gen_id }}">
      {% if block.settings.caption != blank %}
        <div class="ai-side-by-side-caption-{{ ai_gen_id }}">
          {{ block.settings.caption }}
        </div>
      {% endif %}

      {% if block.settings.heading != blank %}
        <h2 class="ai-side-by-side-heading-{{ ai_gen_id }}">
          {{ block.settings.heading }}
        </h2>
      {% endif %}

      {% if block.settings.body_text != blank %}
        <div class="ai-side-by-side-body-{{ ai_gen_id }}">
          {{ block.settings.body_text }}
        </div>
      {% endif %}

      {% if block.settings.button_1_text != blank or block.settings.button_2_text != blank %}
        <div class="ai-side-by-side-buttons-{{ ai_gen_id }}">
          {% if block.settings.button_1_text != blank %}
            <a
              href="{{ block.settings.button_1_link }}"
              class="ai-side-by-side-button-{{ ai_gen_id }}"
            >
              {{ block.settings.button_1_text }}
            </a>
          {% endif %}

          {% if block.settings.button_2_text != blank %}
            <a
              href="{{ block.settings.button_2_link }}"
              class="ai-side-by-side-button-{{ ai_gen_id }}"
            >
              {{ block.settings.button_2_text }}
            </a>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</div>

