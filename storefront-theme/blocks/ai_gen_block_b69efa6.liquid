          </a>
        </div>
      </div>
    {% endif %}

    {% if block.settings.static_card_1_image != blank or block.settings.static_card_1_heading != blank %}
      <div class="ai-collection-carousel-card-{{ ai_gen_id }}" data-card>
        {% if block.settings.static_card_1_image %}
