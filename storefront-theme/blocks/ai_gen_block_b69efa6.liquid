          {% endif %}
          <a href="{{ block.settings.collection_2.url }}" class="ai-collection-carousel-button-{{ ai_gen_id }}">
            {{ block.settings.button_text_collections }}
          </a>
        </div>
      </div>
    {% endif %}

    {% if block.settings.collection_3 != blank %}
      <div class="ai-collection-carousel-card-{{ ai_gen_id }}" data-card>
        {% if block.settings.collection_3.featured_image %}
          <img
