<script>
  (function() {
    class CollectionCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.track = null;
        this.cards = [];
        this.isSnapping = false;
        this.scrollTimeout = null;
        this.rafId = null;
      }

      connectedCallback() {
        this.track = this.querySelector('[data-track]');
        this.cards = Array.from(this.querySelectorAll('[data-card]'));
        
        if (!this.track || this.cards.length === 0) return;

        this.startUpdateLoop();
        this.track.addEventListener('scroll', this.handleScroll.bind(this));
      }

      disconnectedCallback() {
        if (this.rafId) {
          cancelAnimationFrame(this.rafId);
        }
        if (this.scrollTimeout) {
          clearTimeout(this.scrollTimeout);
        }
      }

      startUpdateLoop() {
        const update = () => {
          this.updateScales();
          this.rafId = requestAnimationFrame(update);
        };
        update();
      }

      updateScales() {
        if (!this.track) return;

        const trackRect = this.track.getBoundingClientRect();
        const trackCenter = trackRect.left + trackRect.width / 2;
        const trackWidth = trackRect.width;

        this.cards.forEach(card => {
          const cardRect = card.getBoundingClientRect();
          const cardCenter = cardRect.left + cardRect.width / 2;
          const distance = Math.abs(trackCenter - cardCenter);

          const scale = Math.max(1.0 - (distance / trackWidth) * 0.18, 0.82);
          const opacity = Math.max(1.0 - (distance / trackWidth) * 0.28, 0.72);

          card.style.transform = `scale(${scale})`;
          card.style.opacity = opacity;
        });
      }

      handleScroll() {
        if (this.isSnapping) return;

        if (this.scrollTimeout) {
          clearTimeout(this.scrollTimeout);
        }

        this.scrollTimeout = setTimeout(() => {
          this.snapToNearest();
        }, 150);
      }

      snapToNearest() {
        if (!this.track || this.cards.length === 0) return;

        const trackRect = this.track.getBoundingClientRect();
        const trackCenter = trackRect.left + trackRect.width / 2;

        let closestCard = null;
        let minDistance = Infinity;

        this.cards.forEach(card => {
          const cardRect = card.getBoundingClientRect();
          const cardCenter = cardRect.left + cardRect.width / 2;
          const distance = Math.abs(trackCenter - cardCenter);

          if (distance < minDistance) {
            minDistance = distance;
            closestCard = card;
          }
        });

        if (closestCard) {
          const closestCardRect = closestCard.getBoundingClientRect();
          const closestCardCenter = closestCardRect.left + closestCardRect.width / 2;
          const scrollOffset = closestCardCenter - trackCenter;

          this.isSnapping = true;
          this.track.scrollBy({
            left: scrollOffset,
            behavior: 'smooth'
          });

          setTimeout(() => {
            this.isSnapping = false;
          }, 400);
        }
      }
    }

    customElements.define('collection-carousel-{{ ai_gen_id }}', CollectionCarousel{{ ai_gen_id }});
  })();
</script>

