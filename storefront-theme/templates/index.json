{
  "layout": "monetta",
  "sections": {
    "banners": {
      "type": "monetta-guia-home",
      "settings": {
        "mode": "carousel",
        "show_banner_categorias": false,
        "enabled": false
      }
    },
    "categorias": {
      "type": "monetta-guia-home",
      "settings": { "mode": "categories" }
    },
    "marcas": {
      "type": "monetta-guia-home",
      "settings": { "mode": "brands" }
    },
    "nueva": {
      "type": "monetta-product-rail",
      "settings": {
        "presentation": "feature",
        "heading": "Nueva colección",
        "collection": "all",
        "products_to_show": 40,
        "link_label": "Ver todo",
        "newest_first": true,
        "show_new_label": false,
        "hide_without_collection": false
      }
    },
    "buscado": {
      "type": "monetta-product-rail",
      "settings": {
        "presentation": "rail",
        "heading": "Lo más buscado",
        "products_to_show": 40,
        "link_label": "Ver todo",
        "newest_first": false,
        "show_new_label": false,
        "hide_without_collection": true
      }
    },
    "para_ti": {
      "type": "monetta-product-rail",
      "settings": {
        "presentation": "feed",
        "heading": "Para ti",
        "collection": "all",
        "products_to_show": 40,
        "link_label": "Ver todo",
        "newest_first": false,
        "show_new_label": false,
        "hide_without_collection": false
      }
    },
    "mayoreo": {
      "type": "monetta-guia-home",
      "settings": { "mode": "offers" }
    },
    "servicios": {
      "type": "monetta-guia-home",
      "settings": { "mode": "services" }
    },
    "registro": {
      "type": "monetta-guia-home",
      "settings": {
        "mode": "register",
        "enabled": false
      }
    }
  },
  "order": [
    "banners",
    "categorias",
    "marcas",
    "nueva",
    "buscado",
    "para_ti",
    "mayoreo",
    "servicios",
    "registro"
