{%- comment -%}
  Monetta storefront layout. Used through the "layout" key of the JSON templates built from Monetta sections: home, collection,
  search, product, cart, page, 404, collections index, blog and article. It loads none of Atelier's base.css or scripts, so the
  ported design CSS runs unchanged. Pages built from Atelier sections (contact, mayoreo, cómo vender) and Shopify's policy pages,
  which cannot choose a layout, use layout/theme.liquid: the same shell (snippets/monetta-head.liquid, header, footer, dock, bag
  sheet, saved list) around Atelier's sections. Commerce stays Shopify's: catalog, cart and checkout come from the store; this
  file only frames them.

  Language: every text this theme writes is Spanish (Mexico), so the document declares es-MX instead of the store locale (the staging
  store's is English, which made a Spanish page announce itself as English). Fragments Shopify renders in the store's own language
  are marked individually with the monetta-store-lang snippet; the store's language setting is not touched and a multilingual
  store is out of scope.
{%- endcomment -%}
{%- liquid
  assign t = template.name
  if template.suffix == 'account' or template.suffix == 'orders'
    assign t = template.suffix
  endif
  assign has_page_bar = false
  assign dock_mode = 'nav'
  assign dock_active = ''
  if t == 'collection' or t == 'search' or t == 'cart'
    assign has_page_bar = true
  endif
  if t == 'product'
    assign dock_mode = 'purchase'
  elsif t == 'cart' and cart.item_count > 0
    assign dock_mode = 'checkout'
  endif
  case t
    when 'index'
      assign dock_active = 'home'
    when 'collection', 'search'
      assign dock_active = 'catalog'
    when 'cart'
      assign dock_active = 'cart'
    when 'account', 'orders'
      assign dock_active = 'account'
  endcase
-%}
<!doctype html>
<html lang="es-MX"{% if request.design_mode %} class="shopify-design-mode"{% endif %}>
  <head>
    {% render 'monetta-head' %}

    {{ content_for_header }}
  </head>

  <body
    class="mw {% case dock_mode %}{% when 'nav' %}has-dock{% when 'purchase' %}has-purchase-dock{% else %}has-checkout-bar{% endcase %}{% if has_page_bar %} has-page-bar{% endif %}{% if customer and dock_active == 'account' %} has-account-sidebar{% endif %}"
    data-template="{{ t }}"
    data-dock-active="{{ dock_active }}"
  >
    <a class="skip-link" href="#MainContent">Saltar al contenido</a>

    <div id="page">
      <div class="site-top" id="site-top" data-template="{{ t }}">
        {%- sections 'monetta-header-group' -%}
      </div>
      <main id="MainContent" tabindex="-1">
        {{ content_for_layout }}
      </main>
      <footer class="site-footer" id="site-footer">
        {%- sections 'monetta-footer-group' -%}
      </footer>
      {%- render 'monetta-dock', dock_active: dock_active -%}
    </div>

    {%- section 'monetta-cart-sheet' -%}
    {% render 'monetta-saved-products' %}
    <div id="toast-root"></div>
    <div class="visually-hidden" id="status-live" role="status" aria-live="polite" aria-atomic="true"></div>
    <div class="visually-hidden" id="alert-live" role="alert" aria-live="assertive" aria-atomic="true"></div>
    <noscript><p class="noscript-note">Algunas funciones (galería, cambios de cantidad en el momento) mejoran con JavaScript; puedes comprar sin él.</p></noscript>
  </body>
</html>
