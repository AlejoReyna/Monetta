<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon (API 26+). Foreground and background are the
     Product Designer's 432px layers, scaled into mipmap density buckets.
     Pre-26 devices use the composited mipmap-*/ic_launcher.png files.
     The monochrome layer is the white notification silhouette, inset to
     the adaptive safe zone. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
